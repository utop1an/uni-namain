{
    "predicates": {
        "(anchored ?light - lightbox)": "Source predicate (anchored ?light - lightbox).",
        "(charged ?light - lightbox)": "Source predicate (charged ?light - lightbox).",
        "(created ?character - character ?light - lightbox)": "Source predicate (created ?character - character ?light - lightbox).",
        "(used ?character - character ?light - lightbox)": "Source predicate (used ?character - character ?light - lightbox).",
        "(has ?character - character ?object - object)": "The character possesses the object, which may be an item or a dress.",
        "(alive ?character - character)": "The character is alive.",
        "(wearing ?character - character ?dress - dress)": "Source predicate (wearing ?character - character ?dress - dress).",
        "(damaged ?dress - dress)": "Source predicate (damaged ?dress - dress).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(in-stasis ?character - character)": "Source predicate (in-stasis ?character - character).",
        "(ancient-technology ?object - object)": "Source predicate (ancient-technology ?object - object).",
        "(propellant-device ?object - object)": "Source predicate (propellant-device ?object - object).",
        "(shielded ?object - object)": "Source predicate (shielded ?object - object).",
        "(requested-tow ?character - character ?place - place)": "Source predicate (requested-tow ?character - character ?place - place)."
    },
    "operators": {
        "charge-lightbox": "(:action charge-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (anchored ?lightbox) (created ?character ?lightbox))\n :effect (charged ?lightbox)\n)",
        "create-lightbox :parameters (?actor - character ?object - lightbox) :precondition (alive ?actor) :effect (and (created ?actor ?object) (has ?actor ?object)))": "(:action create-lightbox :parameters (?actor - character ?object - lightbox) :precondition (alive ?actor) :effect (and (created ?actor ?object) (has ?actor ?object)))",
        "anchor-light :parameters (?character - character ?object - lightbox) :precondition (and (alive ?character) (created ?character ?object) (has ?character ?object)) :effect (anchored ?object))": "(:action anchor-light :parameters (?character - character ?object - lightbox) :precondition (and (alive ?character) (created ?character ?object) (has ?character ?object)) :effect (anchored ?object))",
        "use-lightbox :parameters (?character - character ?object - lightbox) :precondition (and (alive ?character) (charged ?object) (created ?character ?object) (has ?character ?object)) :effect (and (used ?character ?object) (not (charged ?object))))": "(:action use-lightbox :parameters (?character - character ?object - lightbox) :precondition (and (alive ?character) (charged ?object) (created ?character ?object) (has ?character ?object)) :effect (and (used ?character ?object) (not (charged ?object))))",
        "slip": "(:action slip\n :parameters (?character - character ?dress - dress)\n :precondition (and (wearing ?character ?dress) (not (damaged ?dress)))\n :effect (damaged ?dress)\n)",
        "comfort": "(:action comfort\n :parameters (?parent - character ?child - character)\n :precondition (and (not (happy ?child)) (not (= ?parent ?child)))\n :effect (happy ?child)\n)",
        "put-on-dress :parameters (?character - character ?object - dress) :precondition (and (has ?character ?object) (not (wearing ?character ?object))) :effect (wearing ?character ?object))": "(:action put-on-dress :parameters (?character - character ?object - dress) :precondition (and (has ?character ?object) (not (wearing ?character ?object))) :effect (wearing ?character ?object))",
        "get-new-dress :parameters (?character - character ?old-dress - dress ?new-object - object) :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-object))) :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-object)))": "(:action get-new-dress :parameters (?character - character ?old-dress - dress ?new-object - object) :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-object))) :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-object)))",
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)"
    }
}