    "operators": {
        "walk :parameters (?traveler - (either character person) ?source ?destination - house) :precondition (and (alive ?traveler) (at ?traveler ?source) (not (eaten ?traveler))) :effect (and (not (at ?traveler ?source)) (at ?traveler ?destination) (when (and (rescuer ?traveler)) (and (rescuer-at ?destination) (not (rescuer-at ?source))))))": "(:action walk :parameters (?traveler - (either character person) ?source ?destination - house) :precondition (and (alive ?traveler) (at ?traveler ?source) (not (eaten ?traveler))) :effect (and (not (at ?traveler ?source)) (at ?traveler ?destination) (when (and (rescuer ?traveler)) (and (rescuer-at ?destination) (not (rescuer-at ?source))))))",
        "eat :parameters (?m - wolf ?victim - (either character person) ?l - location) :precondition (and (alive ?m) (alive ?victim) (not (eaten ?victim)) (at ?m ?l) (at ?victim ?l) (monster ?m)) :effect (and (eaten ?victim)))": "(:action eat :parameters (?m - wolf ?victim - (either character person) ?l - location) :precondition (and (alive ?m) (alive ?victim) (not (eaten ?victim)) (at ?m ?l) (at ?victim ?l) (monster ?m)) :effect (and (eaten ?victim)))",
        "escape :parameters (?human - human ?captor - character ?location - location) :precondition (and (eaten ?human) (not (alive ?captor)) (at ?captor ?location)) :effect (and (not (eaten ?human)) (rescued ?human) (at ?human ?location)))": "(:action escape :parameters (?human - human ?captor - character ?location - location) :precondition (and (eaten ?human) (not (alive ?captor)) (at ?captor ?location)) :effect (and (not (eaten ?human)) (rescued ?human) (at ?human ?location)))",
        "kill :parameters (?actor - (either character person) ?m - wolf ?a - axe ?l - location) :precondition (and (alive ?actor) (alive ?m) (has ?actor ?a) (at ?actor ?l) (at ?m ?l) (monster ?m) (monster-alive) (rescuer ?actor)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?actor - (either character person) ?m - wolf ?a - axe ?l - location) :precondition (and (alive ?actor) (alive ?m) (has ?actor ?a) (at ?actor ?l) (at ?m ?l) (monster ?m) (monster-alive) (rescuer ?actor)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "snakebite": "(:action snakebite\n :parameters (?c - person)\n :precondition (alive ?c)\n :effect (and (sick ?c snakebite))\n)",
        "die :parameters (?c - (either character person) ?sickness - sickness) :precondition (and (alive ?c) (sick ?c ?sickness)) :effect (not (alive ?c)))": "(:action die :parameters (?c - (either character person) ?sickness - sickness) :precondition (and (alive ?c) (sick ?c ?sickness)) :effect (not (alive ?c)))",
        "travel :parameters (?c - (either character person) ?from - place ?to - place) :precondition (and (alive ?c) (free ?c) (at ?c ?from)) :effect (and (at ?c ?to) (not (at ?c ?from))))": "(:action travel :parameters (?c - (either character person) ?from - place ?to - place) :precondition (and (alive ?c) (free ?c) (at ?c ?from)) :effect (and (at ?c ?to) (not (at ?c ?from))))",
        "forcetravel :parameters (?actor - (either character person) ?captive - (either character person) ?from - place ?to - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?from) (alive ?captive) (not (free ?captive)) (at ?captive ?from)) :effect (and (at ?actor ?to) (not (at ?actor ?from)) (at ?captive ?to) (not (at ?captive ?from))))": "(:action forcetravel :parameters (?actor - (either character person) ?captive - (either character person) ?from - place ?to - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?from) (alive ?captive) (not (free ?captive)) (at ?captive ?from)) :effect (and (at ?actor ?to) (not (at ?actor ?from)) (at ?captive ?to) (not (at ?captive ?from))))",
        "tieup :parameters (?actor - (either character person) ?target - (either character person) ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (at ?target ?place)) :effect (and (not (free ?target))))": "(:action tieup :parameters (?actor - (either character person) ?target - (either character person) ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (at ?target ?place)) :effect (and (not (free ?target))))",
        "untie :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (not (free ?target)) (at ?target ?place)) :effect (free ?target))": "(:action untie :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (not (free ?target)) (at ?target ?place)) :effect (free ?target))",
        "give_owned_thing": "(:action give_owned_thing :parameters (?giver ?receiver - (either character person) ?t - thing ?l - location) :precondition (and (not (eaten ?receiver)) (alive ?giver) (alive ?receiver) (free ?giver) (free ?receiver) (has ?giver ?t) (at ?giver ?l) (at ?receiver ?l) (belongsto ?t ?giver)) :effect (and (has ?receiver ?t) (not (has ?giver ?t)) (belongsto ?t ?receiver)))",
        "take :parameters (?taker - (either character person) ?thing - thing ?previous_owner - (either character person) ?place - place) :precondition (and (not (= ?taker ?previous_owner)) (alive ?taker) (free ?taker) (at ?taker ?place) (alive ?previous_owner) (not (free ?previous_owner)) (at ?previous_owner ?place) (has ?previous_owner ?thing)) :effect (and (has ?taker ?thing) (not (has ?previous_owner ?thing))))": "(:action take :parameters (?taker - (either character person) ?thing - thing ?previous_owner - (either character person) ?place - place) :precondition (and (not (= ?taker ?previous_owner)) (alive ?taker) (free ?taker) (at ?taker ?place) (alive ?previous_owner) (not (free ?previous_owner)) (at ?previous_owner ?place) (has ?previous_owner ?thing)) :effect (and (has ?taker ?thing) (not (has ?previous_owner ?thing))))",
        "heal :parameters (?healer - character ?recipient - person ?sickness - sickness ?medicine - thing ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?healer) (free ?healer) (at ?healer ?place) (has ?healer ?medicine) (alive ?recipient) (at ?recipient ?place) (sick ?recipient ?sickness)) :effect (and (not (sick ?recipient ?sickness)) (not (has ?healer ?medicine))))": "(:action heal :parameters (?healer - character ?recipient - person ?sickness - sickness ?medicine - thing ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?healer) (free ?healer) (at ?healer ?place) (has ?healer ?medicine) (alive ?recipient) (at ?recipient ?place) (sick ?recipient ?sickness)) :effect (and (not (sick ?recipient ?sickness)) (not (has ?healer ?medicine))))",
        "wake-person": "(:action wake-person :parameters (?waker - character ?woken - character ?place - place) :precondition (and (at ?waker ?place) (at ?woken ?place) (asleep ?woken) (not (asleep ?waker))) :effect (not (asleep ?woken)))",
        "move-location": "(:action move-location :parameters (?character - character ?to - location ?from - location) :precondition (and (connected ?to ?from) (not (asleep ?character)) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "take-thing": "(:action take-thing :parameters (?c - character ?t - thing ?place - place) :precondition (and (at ?c ?place) (at ?t ?place) (not (asleep ?c)) (not (enchanted ?t))) :effect (and (not (at ?t ?place)) (has ?c ?t)))",
        "disenchant-thing": "(:action disenchant-thing :parameters (?c - character ?thing - item ?t - thing ?location - location) :precondition (and (at ?c ?location) (at ?thing ?location) (not (asleep ?c)) (has ?c ?t) (enchanted ?thing)) :effect (not (enchanted ?thing)))"
