        "move :parameters (?entity - (either character item) ?from - object ?to - object) :precondition (and (not (= ?from ?to)) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))": "(:action move :parameters (?entity - (either character item) ?from - object ?to - object) :precondition (and (not (= ?from ?to)) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))",
        "dry-place :parameters (?entity - (either character item) ?place - place) :precondition (and (at ?entity ?place) (wet ?place)) :effect (and (not (wet ?place)) (dry ?place)))": "(:action dry-place :parameters (?entity - (either character item) ?place - place) :precondition (and (at ?entity ?place) (wet ?place)) :effect (and (not (wet ?place)) (dry ?place)))",
        "play :parameters (?entity - character ?location - place) :precondition (and (at ?entity ?location) (dry ?location)) :effect (happy ?entity))": "(:action play :parameters (?entity - character ?location - place) :precondition (and (at ?entity ?location) (dry ?location)) :effect (happy ?entity))",
