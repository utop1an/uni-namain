        "transport-object :parameters (?entity - character ?cargo - object ?source - object ?destination - place) :precondition (and (alive ?entity) (at ?entity ?source) (has ?entity ?cargo) (requested-tow ?entity ?destination)) :effect (and (not (at ?entity ?source)) (at ?entity ?destination) (not (has ?entity ?cargo))))": "(:action transport-object :parameters (?entity - character ?cargo - object ?source - object ?destination - place) :precondition (and (alive ?entity) (at ?entity ?source) (has ?entity ?cargo) (requested-tow ?entity ?destination)) :effect (and (not (at ?entity ?source)) (at ?entity ?destination) (not (has ?entity ?cargo))))",
        "make-friends": "(:action make-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (happy ?character1) (happy ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
