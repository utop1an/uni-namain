    "operators": {
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "walk": "(:action walk\n :parameters (?c - character ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1) (not (hospitalised ?c)))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "move": "(:action move\n :parameters (?c - patient ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "lose-consciousness": "(:action lose-consciousness\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?l))\n :effect (and (unconscious ?p) (not (conscious ?p)))\n)",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?current-level ?next-level - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?current-level) (connected ?next-level ?current-level) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?current-level)) (level-of-work ?d ?next-level)))": "(:action admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?current-level ?next-level - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?current-level) (connected ?next-level ?current-level) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?current-level)) (level-of-work ?d ?next-level)))",
        "wake-person :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (asleep ?c2) (not (asleep ?c1))) :effect (not (asleep ?c2)))": "(:action wake-person :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (asleep ?c2) (not (asleep ?c1))) :effect (not (asleep ?c2)))",
        "take-thing :parameters (?c - character ?target - (either item character) ?l - location) :precondition (and (at ?c ?l) (at ?target ?l) (not (asleep ?c)) (not (enchanted ?target))) :effect (and (not (at ?target ?l)) (has ?c ?target)))": "(:action take-thing :parameters (?c - character ?target - (either item character) ?l - location) :precondition (and (at ?c ?l) (at ?target ?l) (not (asleep ?c)) (not (enchanted ?target))) :effect (and (not (at ?target ?l)) (has ?c ?target)))",
        "disenchant-thing :parameters (?c - character ?thing - item ?target - (either item character) ?l - location) :precondition (and (at ?c ?l) (at ?thing ?l) (not (asleep ?c)) (has ?c ?target) (enchanted ?thing)) :effect (not (enchanted ?thing)))": "(:action disenchant-thing :parameters (?c - character ?thing - item ?target - (either item character) ?l - location) :precondition (and (at ?c ?l) (at ?thing ?l) (not (asleep ?c)) (has ?c ?target) (enchanted ?thing)) :effect (not (enchanted ?thing)))",
        "interrogate-character :parameters (?c - character ?s - character ?l - location) :precondition (and (player ?c) (at ?c ?l) (at ?s ?l) (apprehended ?s)) :effect (knows ?c))": "(:action interrogate-character :parameters (?c - character ?s - character ?l - location) :precondition (and (player ?c) (at ?c ?l) (at ?s ?l) (apprehended ?s)) :effect (knows ?c))",
        "save-character :parameters (?saver - character ?saved - character ?other - character ?l - location) :precondition (and (player ?saver) (at ?saver ?l) (at ?saved ?l) (captured ?saved) (captured ?other) (not (at ?other ?l))) :effect (and (saved ?saved ?saver) (not (alive ?other))))": "(:action save-character :parameters (?saver - character ?saved - character ?other - character ?l - location) :precondition (and (player ?saver) (at ?saver ?l) (at ?saved ?l) (captured ?saved) (captured ?other) (not (at ?other ?l))) :effect (and (saved ?saved ?saver) (not (alive ?other))))",
        "move-location :parameters (?character - character ?destination ?source - (either level location)) :precondition (and (connected ?destination ?source) (not (asleep ?character)) (at ?character ?source) (player ?character) (knows ?character)) :effect (and (not (at ?character ?source)) (at ?character ?destination)))": "(:action move-location :parameters (?character - character ?destination ?source - (either level location)) :precondition (and (connected ?destination ?source) (not (asleep ?character)) (at ?character ?source) (player ?character) (knows ?character)) :effect (and (not (at ?character ?source)) (at ?character ?destination)))",
        "place-victim :parameters (?c1 - character ?c2 - character ?source - (either level location) ?destination - (either level location)) :precondition (and (henchman ?c1) (has ?c1 ?c2) (at ?c1 ?source) (connected ?destination ?source)) :effect (and (not (has ?c1 ?c2)) (at ?c2 ?destination) (captured ?c2)))": "(:action place-victim :parameters (?c1 - character ?c2 - character ?source - (either level location) ?destination - (either level location)) :precondition (and (henchman ?c1) (has ?c1 ?c2) (at ?c1 ?source) (connected ?destination ?source)) :effect (and (not (has ?c1 ?c2)) (at ?c2 ?destination) (captured ?c2)))"
    }
