    "operators": {
        "move-location :parameters (?actor - character ?to - location ?from - location) :precondition (and (player ?actor) (connected ?to ?from) (at ?actor ?from) (knows ?actor)) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))": "(:action move-location :parameters (?actor - character ?to - location ?from - location) :precondition (and (player ?actor) (connected ?to ?from) (at ?actor ?from) (knows ?actor)) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))",
        "interrogate-character :parameters (?actor - character ?target - character ?place - location) :precondition (and (player ?actor) (at ?actor ?place) (at ?target ?place) (apprehended ?target)) :effect (knows ?actor))": "(:action interrogate-character :parameters (?actor - character ?target - character ?place - location) :precondition (and (player ?actor) (at ?actor ?place) (at ?target ?place) (apprehended ?target)) :effect (knows ?actor))",
        "save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))",
        "place-victim :parameters (?acting-character - character ?target - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?target) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?target)) (at ?target ?destination-location) (captured ?target)))": "(:action place-victim :parameters (?acting-character - character ?target - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?target) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?target)) (at ?target ?destination-location) (captured ?target)))",
        "read": "(:action read\n :parameters (?character - character)\n :precondition (reads ?character)\n :effect (happy ?character)\n)",
        "smell-soap": "(:action smell-soap\n :parameters (?character - character ?soap - item)\n :precondition (and (on-shelf ?soap) (reads ?character))\n :effect (happy ?character)\n)",
        "find :parameters (?character - character ?target - (either character item)) :precondition (and (not (has ?character ?target)) (reads ?character)) :effect (has ?character ?target))": "(:action find :parameters (?character - character ?target - (either character item)) :precondition (and (not (has ?character ?target)) (reads ?character)) :effect (has ?character ?target))",
        "put-on-shelf :parameters (?character - character ?target - (either character item) ?location - location) :precondition (and (has ?character ?target) (at ?character ?location)) :effect (and (not (has ?character ?target)) (on-shelf ?target) (organized ?location)))": "(:action put-on-shelf :parameters (?character - character ?target - (either character item) ?location - location) :precondition (and (has ?character ?target) (at ?character ?location)) :effect (and (not (has ?character ?target)) (on-shelf ?target) (organized ?location)))",
        "remove-hat": "(:action remove-hat\n :parameters (?remover - character ?wearer - character)\n :precondition (and (not (= ?remover ?wearer)) (wearing-hat ?wearer))\n :effect (not (wearing-hat ?wearer))\n)",
        "transform": "(:action transform\n :parameters (?character - character)\n :precondition (is-dog ?character)\n :effect (and (not (is-dog ?character)) (is-fairy ?character))\n)",
        "give-magic-flower": "(:action give-magic-flower\n :parameters (?giver - character ?receiver - character)\n :precondition (and (not (= ?giver ?receiver)) (is-fairy ?giver))\n :effect (has-magic-flower ?receiver)\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "play-together": "(:action play-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (friends ?character1 ?character2))\n :effect (playing-together ?character1 ?character2)\n)",
        "influence": "(:action influence\n :parameters (?influencer - character ?influenced - character)\n :precondition (and (not (= ?influencer ?influenced)) (not (influenced ?influenced)))\n :effect (influenced ?influenced)\n)",
        "isolate": "(:action isolate\n :parameters (?isolator - character ?isolated - character)\n :precondition (and (not (= ?isolator ?isolated)) (not (isolated ?isolated)))\n :effect (isolated ?isolated)\n)",
        "manipulate": "(:action manipulate\n :parameters (?manipulator - character ?manipulated - character)\n :precondition (and (not (= ?manipulator ?manipulated)) (not (manipulates ?manipulator ?manipulated)))\n :effect (manipulates ?manipulator ?manipulated)\n)",
        "hate": "(:action hate\n :parameters (?hater - character ?hated - character)\n :precondition (and (not (= ?hater ?hated)) (not (hates ?hater ?hated)))\n :effect (hates ?hater ?hated)\n)",
        "despise": "(:action despise\n :parameters (?despiser - character ?despised - character)\n :precondition (and (not (= ?despiser ?despised)) (not (despises ?despiser ?despised)))\n :effect (despises ?despiser ?despised)\n)",
        "apologize": "(:action apologize\n :parameters (?apologizer - character ?apologized - character)\n :precondition (and (not (= ?apologizer ?apologized)) (not (apologized ?apologizer ?apologized)))\n :effect (apologized ?apologizer ?apologized)\n)"
    }
