{
    "predicates": {
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(wearing-pajamas ?animal - animal)": "Source predicate (wearing-pajamas ?animal - animal).",
        "(on-floor ?character - character)": "Source predicate (on-floor ?character - character).",
        "(dressed ?character - character)": "Source predicate (dressed ?character - character).",
        "(holding ?character - character ?object - object)": "Source predicate (holding ?character - character ?object - object).",
        "(walking ?character - character ?direction - direction)": "Source predicate (walking ?character - character ?direction - direction).",
        "(petting ?character - character ?animal - animal)": "Source predicate (petting ?character - character ?animal - animal).",
        "(bites ?animal - animal)": "Source predicate (bites ?animal - animal).",
        "(owns ?character - character ?animal - animal)": "Source predicate (owns ?character - character ?animal - animal).",
        "(life-is-a-joke ?character - character)": "Source predicate (life-is-a-joke ?character - character).",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(has-weapon ?character - character)": "Source predicate (has-weapon ?character - character).",
        "(in-group ?character - character ?group - group)": "Source predicate (in-group ?character - character ?group - group).",
        "(group-exists ?group - group)": "Source predicate (group-exists ?group - group).",
        "(has-electronics ?character - character)": "Source predicate (has-electronics ?character - character).",
        "(believes-in-fairies ?character - character)": "Source predicate (believes-in-fairies ?character - character)."
    },
    "operators": {
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "dress": "(:action dress\n :parameters (?character - character)\n :precondition (and (awake ?character) (on-floor ?character) (not (dressed ?character)))\n :effect (dressed ?character)\n)",
        "pet": "(:action pet\n :parameters (?character - character ?animal - animal)\n :precondition (and (awake ?character) (dressed ?character) (not (bites ?animal)))\n :effect (petting ?character ?animal)\n)",
        "realize-life-is-a-joke": "(:action realize-life-is-a-joke\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (life-is-a-joke ?character)\n)",
        "travel": "(:action travel\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "fight": "(:action fight\n :parameters (?fighter1 - character ?fighter2 - character)\n :precondition (and (not (= ?fighter1 ?fighter2)) (alive ?fighter1) (has-weapon ?fighter1) (alive ?fighter2) (has-weapon ?fighter2))\n :effect (and)\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (not (alive ?character))\n)",
        "acquire-electronics": "(:action acquire-electronics\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-electronics ?character)))\n :effect (has-electronics ?character)\n)",
        "stop-believing": "(:action stop-believing\n :parameters (?character - character)\n :precondition (and (alive ?character) (believes-in-fairies ?character))\n :effect (not (believes-in-fairies ?character))\n)"
    }
}