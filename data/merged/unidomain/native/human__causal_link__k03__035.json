        "place-victim :parameters (?acting-character - character ?held-character - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?held-character) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?held-character)) (at ?held-character ?destination-location) (captured ?held-character)))": "(:action place-victim :parameters (?acting-character - character ?held-character - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?held-character) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?held-character)) (at ?held-character ?destination-location) (captured ?held-character)))",
        "wake-person :parameters (?waker - character ?woken - character ?location - location) :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker))) :effect (not (asleep ?woken)))": "(:action wake-person :parameters (?waker - character ?woken - character ?location - location) :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker))) :effect (not (asleep ?woken)))",
        "take-thing :parameters (?taker - character ?entity - (either character item) ?location - location) :precondition (and (at ?taker ?location) (at ?entity ?location) (not (asleep ?taker)) (not (enchanted ?entity))) :effect (and (not (at ?entity ?location)) (has ?taker ?entity)))": "(:action take-thing :parameters (?taker - character ?entity - (either character item) ?location - location) :precondition (and (at ?taker ?location) (at ?entity ?location) (not (asleep ?taker)) (not (enchanted ?entity))) :effect (and (not (at ?entity ?location)) (has ?taker ?entity)))",
        "disenchant-thing :parameters (?caster - character ?thing - item ?entity - (either character item) ?location - location) :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?entity) (enchanted ?thing)) :effect (not (enchanted ?thing)))": "(:action disenchant-thing :parameters (?caster - character ?thing - item ?entity - (either character item) ?location - location) :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?entity) (enchanted ?thing)) :effect (not (enchanted ?thing)))",
