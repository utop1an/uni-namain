{
    "predicates": {
        "(at ?character - character ?location - object)": "Source predicate (at ?character - character ?location - object).",
        "(assembled ?robot - robot)": "Source predicate (assembled ?robot - robot).",
        "(has-robot ?character - character ?robot - robot)": "Source predicate (has-robot ?character - character ?robot - robot).",
        "(working-on-task ?robot - robot)": "Source predicate (working-on-task ?robot - robot).",
        "(playing-game ?character - character)": "Source predicate (playing-game ?character - character).",
        "(liberated ?character - character)": "Source predicate (liberated ?character - character).",
        "(defeated-illuminati)": "Source predicate (defeated-illuminati).",
        "(alien-exists ?character - character)": "Source predicate (alien-exists ?character - character).",
        "(alien-gone ?character - character)": "Source predicate (alien-gone ?character - character).",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(has-emotion ?character - character ?emotion - emotion)": "Source predicate (has-emotion ?character - character ?emotion - emotion).",
        "(knows-change ?character - character)": "Source predicate (knows-change ?character - character).",
        "(memorize ?character - character)": "Source predicate (memorize ?character - character).",
        "(broken-pedal ?bike - object)": "Source predicate (broken-pedal ?bike - object).",
        "(fixed-pedal ?bike - object)": "Source predicate (fixed-pedal ?bike - object).",
        "(has ?character - character ?bike - object)": "Source predicate (has ?character - character ?bike - object).",
        "(at-shop ?character - character)": "Source predicate (at-shop ?character - character).",
        "(flying ?bike - object)": "Source predicate (flying ?bike - object).",
        "(happy ?character - character)": "The character is happy.",
        "(watches-tv ?character - character)": "Source predicate (watches-tv ?character - character).",
        "(rude ?character - character)": "Source predicate (rude ?character - character).",
        "(nice ?character - character)": "Source predicate (nice ?character - character).",
        "(wants-to-watch-tv ?character - character)": "Source predicate (wants-to-watch-tv ?character - character)."
    },
    "operators": {
        "assemble": "(:action assemble\n :parameters (?character - character ?robot - robot)\n :precondition (and (at ?character garage) (not (assembled ?robot)))\n :effect (and (assembled ?robot) (has-robot ?character ?robot))\n)",
        "start-task": "(:action start-task\n :parameters (?robot - robot)\n :precondition (and (assembled ?robot) (not (working-on-task ?robot)))\n :effect (working-on-task ?robot)\n)",
        "play-game": "(:action play-game\n :parameters (?character - character)\n :precondition (and (at ?character house) (not (playing-game ?character)))\n :effect (playing-game ?character)\n)",
        "stop-game": "(:action stop-game\n :parameters (?character - character)\n :precondition (playing-game ?character)\n :effect (not (playing-game ?character))\n)",
        "liberate": "(:action liberate\n :parameters (?alien - character ?human - character)\n :precondition (and (alien-exists ?alien) (not (liberated ?human)))\n :effect (liberated ?human)\n)",
        "defeat-illuminati": "(:action defeat-illuminati\n :parameters (?alien - character)\n :precondition (and (alien-exists ?alien) (not (defeated-illuminati)))\n :effect (defeated-illuminati)\n)",
        "disappear": "(:action disappear\n :parameters (?alien - character)\n :precondition (alien-exists ?alien)\n :effect (alien-gone ?alien)\n)",
        "reappear": "(:action reappear\n :parameters (?alien - character)\n :precondition (alien-gone ?alien)\n :effect (alien-exists ?alien)\n)",
        "experience-emotion": "(:action experience-emotion\n :parameters (?character - character ?emotion - emotion)\n :precondition (alive ?character)\n :effect (has-emotion ?character ?emotion)\n)",
        "notice-change": "(:action notice-change\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (knows-change ?character)\n)",
        "memorize-appearance": "(:action memorize-appearance\n :parameters (?character - character)\n :precondition (and (alive ?character) (knows-change ?character))\n :effect (memorize ?character)\n)",
        "go-to-shop": "(:action go-to-shop\n :parameters (?character - character)\n :precondition (not (at-shop ?character))\n :effect (at-shop ?character)\n)",
        "fix-pedal": "(:action fix-pedal\n :parameters (?character - character ?bike - object)\n :precondition (and (at-shop ?character) (has ?character ?bike) (broken-pedal ?bike))\n :effect (and (not (broken-pedal ?bike)) (fixed-pedal ?bike))\n)",
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "start-watching-tv": "(:action start-watching-tv\n :parameters (?character - character)\n :precondition (wants-to-watch-tv ?character)\n :effect (watches-tv ?character)\n)",
        "stop-watching-tv": "(:action stop-watching-tv\n :parameters (?character - character)\n :precondition (watches-tv ?character)\n :effect (not (watches-tv ?character))\n)",
        "become-nice": "(:action become-nice\n :parameters (?character - character)\n :precondition (rude ?character)\n :effect (and (not (rude ?character)) (nice ?character))\n)",
        "become-rude": "(:action become-rude\n :parameters (?character - character)\n :precondition (nice ?character)\n :effect (and (not (nice ?character)) (rude ?character))\n)",
        "become-happy": "(:action become-happy :parameters (?character - character) :precondition (not (happy ?character)) :effect (happy ?character))",
        "become-unhappy": "(:action become-unhappy\n :parameters (?character - character)\n :precondition (happy ?character)\n :effect (not (happy ?character))\n)"
    }
}