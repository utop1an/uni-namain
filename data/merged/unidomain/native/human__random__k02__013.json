        "summon :parameters (?a - actor ?g - ismagic ?t - item ?p - place) :precondition (and (confined ?g) (magic ?t) (at ?a ?p) (has ?a ?t) (in ?g ?t) (alive ?a) (not (= ?a ?g)) (magic-char ?g) (magic-char-alive)) :effect (and (at ?g ?p) (controls ?a ?g ?t) (controls-magic ?a ?t) (not (in ?g ?t)) (not (confined ?g))))": "(:action summon :parameters (?a - actor ?g - ismagic ?t - item ?p - place) :precondition (and (confined ?g) (magic ?t) (at ?a ?p) (has ?a ?t) (in ?g ?t) (alive ?a) (not (= ?a ?g)) (magic-char ?g) (magic-char-alive)) :effect (and (at ?g ?p) (controls ?a ?g ?t) (controls-magic ?a ?t) (not (in ?g ?t)) (not (confined ?g))))",
