        "(inside ?character - character)": "Source predicate (inside ?character - character).",
        "(playing ?character - character ?item - item)": "The character is playing with the specified item; a designated unspecified item can represent playing when no item was specified.",
        "(broken ?item - item)": "Source predicate (broken ?item - item).",
        "(cleaned ?character - character)": "Source predicate (cleaned ?character - character).",
        "(forgiven ?forgiver - character ?forgivee - character)": "Source predicate (forgiven ?forgiver - character ?forgivee - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(has ?character - character ?item - object)": "The character has the specified object, which may be an item.",
        "(apologized ?apologizer - character ?apologizee - character)": "The apologizer has apologized to the apologizee.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(locked ?door - object)": "Source predicate (locked ?door - object).",
        "(called-police ?character - character)": "Source predicate (called-police ?character - character).",
        "(death-averted ?character - character)": "Source predicate (death-averted ?character - character).",
        "(follows ?character - character ?officer - character)": "Source predicate (follows ?character - character ?officer - character).",
        "(influenced ?character - character)": "Source predicate (influenced ?character - character).",
        "(isolated ?character - character)": "Source predicate (isolated ?character - character).",
        "(hates ?character1 - character ?character2 - character)": "Source predicate (hates ?character1 - character ?character2 - character).",
        "(manipulates ?character1 - character ?character2 - character)": "Source predicate (manipulates ?character1 - character ?character2 - character).",
        "(despises ?character1 - character ?character2 - character)": "Source predicate (despises ?character1 - character ?character2 - character).",
        "(apologized ?character1 - character ?character2 - character)": "The apologizer has apologized to the apologizee."
    },
    "operators": {
        "stop-raining": "(:action stop-raining\n :parameters ()\n :precondition (raining)\n :effect (and (not (raining)) (sunny))\n)",
        "start-raining": "(:action start-raining\n :parameters ()\n :precondition (sunny)\n :effect (and (not (sunny)) (raining))\n)",
        "clean": "(:action clean\n :parameters (?cleaner - character ?item - item)\n :precondition (broken ?item)\n :effect (cleaned ?cleaner)\n)",
        "break-item": "(:action break-item\n :parameters (?breaker - character ?item - item)\n :precondition (and (not (broken ?item)) (playing ?breaker ?item))\n :effect (broken ?item)\n)",
        "go-outside": "(:action go-outside\n :parameters (?character - character)\n :precondition (and (inside ?character) (sunny))\n :effect (and (not (inside ?character)) (at ?character outside))\n)",
        "go-inside": "(:action go-inside\n :parameters (?character - character)\n :precondition (at ?character outside)\n :effect (and (not (at ?character outside)) (inside ?character) (safe ?character))\n)",
        "become-scared": "(:action become-scared\n :parameters (?character - character)\n :precondition (and (at ?character outside) (not (scared ?character)))\n :effect (scared ?character)\n)",
        "become-brave": "(:action become-brave\n :parameters (?character - character)\n :precondition (and (at ?character outside) (scared ?character))\n :effect (and (not (scared ?character)) (brave ?character))\n)",
        "play-in-mud :parameters (?character - character ?place - place ?item - item) :precondition (and (at ?character ?place) (muddy ?place)) :effect (playing ?character ?item))": "(:action play-in-mud :parameters (?character - character ?place - place ?item - item) :precondition (and (at ?character ?place) (muddy ?place)) :effect (playing ?character ?item))",
        "play :parameters (?character - character ?plaything - item) :precondition (and (not (broken ?plaything)) (has ?character ?plaything)) :effect (playing ?character ?plaything))": "(:action play :parameters (?character - character ?plaything - item) :precondition (and (not (broken ?plaything)) (has ?character ?plaything)) :effect (playing ?character ?plaything))",
        "forgive": "(:action forgive\n :parameters (?forgiver - character ?forgivee - character)\n :precondition (and (not (= ?forgiver ?forgivee)) (apologized ?forgivee ?forgiver))\n :effect (forgiven ?forgiver ?forgivee)\n)",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - object)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "call-police": "(:action call-police\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (called-police ?character)\n)",
        "follow-officer": "(:action follow-officer\n :parameters (?character - character ?officer - character)\n :precondition (and (alive ?character) (alive ?officer))\n :effect (follows ?character ?officer)\n)",
        "influence": "(:action influence\n :parameters (?influencer - character ?influenced - character)\n :precondition (and (not (= ?influencer ?influenced)) (not (influenced ?influenced)))\n :effect (influenced ?influenced)\n)",
        "despise": "(:action despise\n :parameters (?despiser - character ?despised - character)\n :precondition (and (not (= ?despiser ?despised)) (not (despises ?despiser ?despised)))\n :effect (despises ?despiser ?despised)\n)",
        "avert-death": "(:action avert-death\n :parameters (?character - character)\n :precondition (and (alive ?character) (called-police ?character) (exists (?officer - character) (follows ?character ?officer)))\n :effect (death-averted ?character)\n)",
        "isolate": "(:action isolate\n :parameters (?isolator - character ?isolated - character)\n :precondition (and (not (= ?isolator ?isolated)) (not (isolated ?isolated)))\n :effect (isolated ?isolated)\n)",
        "manipulate": "(:action manipulate\n :parameters (?manipulator - character ?manipulated - character)\n :precondition (and (not (= ?manipulator ?manipulated)) (not (manipulates ?manipulator ?manipulated)))\n :effect (manipulates ?manipulator ?manipulated)\n)",
        "hate": "(:action hate\n :parameters (?hater - character ?hated - character)\n :precondition (and (not (= ?hater ?hated)) (not (hates ?hater ?hated)))\n :effect (hates ?hater ?hated)\n)",
        "apologize": "(:action apologize :parameters (?apologizer - character ?apologizee - character) :precondition (and (not (= ?apologizer ?apologizee)) (not (apologized ?apologizer ?apologizee))) :effect (apologized ?apologizer ?apologizee))"
    }
}