    "operators": {
        "travel": "(:action travel\n :parameters (?traveller - character ?from ?to - location)\n :precondition (and (at ?traveller ?from) (alive ?traveller) (not (= ?from ?to)))\n :effect (and (at ?traveller ?to) (not (at ?traveller ?from)))\n)",
        "slay": "(:action slay\n :parameters (?slayer - knight ?m - monster ?place - location)\n :precondition (and (at ?slayer ?place) (at ?m ?place) (alive ?slayer) (alive ?m) (not (= ?slayer ?m)) (intends-not-alive ?slayer ?m))\n :effect (and (not (alive ?m)))\n)",
        "slay-magic-char": "(:action slay-magic-char\n :parameters (?slayer - knight ?m - monster ?place - location)\n :precondition (and (at ?slayer ?place) (at ?m ?place) (alive ?slayer) (not (= ?slayer ?m)) (intends-not-alive ?slayer ?m) (magic-char ?m) (alive ?m) (magic-char-alive))\n :effect (and (not (alive ?m)) (magic-char ?m) (not (magic-char-alive)))\n)",
        "pillage": "(:action pillage\n :parameters (?pillager ?body - character ?t - thing ?place - location)\n :precondition (and (at ?pillager ?place) (at ?body ?place) (alive ?pillager) (not (alive ?body)) (has ?body ?t) (not (has ?pillager ?t)) (not (= ?pillager ?body)))\n :effect (and (has ?pillager ?t) (not (has ?body ?t)))\n)",
        "give": "(:action give\n :parameters (?giver ?givee - character ?t - thing ?place - location)\n :precondition (and (not (= ?giver ?givee)) (at ?giver ?place) (at ?givee ?place) (alive ?givee) (alive ?giver) (has ?giver ?t) (not (has ?givee ?t)) (intends-has ?giver ?givee ?t))\n :effect (and (has ?givee ?t) (not (has ?giver ?t)))\n)",
        "summon": "(:action summon\n :parameters (?char - person ?g - ismagic ?lamp - thing ?place - location)\n :precondition (and (confined ?g) (magic ?lamp) (at ?char ?place) (has ?char ?lamp) (in ?g ?lamp) (alive ?char) (not (= ?char ?g)) (magic-char ?g) (magic-char-alive))\n :effect (and (at ?g ?place) (controls ?char ?g ?lamp) (controls-magic ?char ?lamp) (not (in ?g ?lamp)) (not (confined ?g)))\n)",
        "love-spell": "(:action love-spell\n :parameters (?g - genie ?target - person ?lover - canmarry)\n :precondition (and (not (confined ?g)) (not (loves ?target ?lover)) (magic-char ?g) (magic-char-alive) (alive ?target) (alive ?lover) (not (= ?g ?target)) (not (= ?g ?lover)) (not (= ?target ?lover)) (intends-loves ?g ?target ?lover) (bachelor ?lover))\n :effect (and (loves ?target ?lover) (loves-bachelor ?target))\n)",
        "marry": "(:action marry\n :parameters (?groom - canmarry ?bride - person ?place - location)\n :precondition (and (alive ?groom) (alive ?bride) (at ?groom ?place) (at ?bride ?place) (loves ?groom ?bride) (loves ?bride ?groom) (single ?groom) (bachelor ?groom) (single ?bride) (not (= ?groom ?bride)))\n :effect (and (married-to ?groom ?bride) (married-to ?bride ?groom) (not (single ?groom)) (not (single ?bride)))\n)",
        "fall-in-love": "(:action fall-in-love\n :parameters (?m - canmarry ?f - female ?place - location)\n :precondition (and (bachelor ?m) (at ?m ?place) (at ?f ?place) (single ?m) (alive ?m) (alive ?f) (not (loves ?m ?f)) (beautiful ?f))\n :effect (and (loves ?m ?f) (bachelor-loves ?f))\n)",
        "order": "(:action order\n :parameters (?ki - king ?kn - knight ?place - location ?t - thing)\n :precondition (and (loyal-to ?kn ?ki) (alive ?kn) (alive ?ki) (at ?ki ?place) (at ?kn ?place))\n :effect (and (intends-has ?kn ?ki ?t))\n)",
        "appear-threatening": "(:action appear-threatening\n :parameters (?m - monster ?char - person ?place - location)\n :precondition (and (alive ?m) (alive ?char) (at ?m ?place) (at ?char ?place) (scary ?m) (not (= ?m ?char)))\n :effect (and (intends-not-alive ?char ?m))\n)",
        "command": "(:action command\n :parameters (?char - person ?g - genie ?love - person ?lamp - thing ?place - location)\n :precondition (and (magic ?lamp) (has ?char ?lamp) (controls ?char ?g ?lamp) (alive ?char) (magic-char ?g) (magic-char-alive) (alive ?love) (at ?char ?place) (at ?g ?place) (loves ?char ?love) (not (loves ?love ?char)) (not (= ?char ?g)) (not (= ?char ?love)))\n :effect (and (intends-loves ?g ?love ?char))\n)",
        "experience-pain": "(:action experience-pain\n :parameters (?character - character)\n :precondition (human ?character)\n :effect (in-pain ?character)\n)",
        "transform-into-crow": "(:action transform-into-crow\n :parameters (?character - character)\n :precondition (and (human ?character) (in-pain ?character) (sunlight-available))\n :effect (and (not (human ?character)) (crow ?character) (transformed ?character))\n)",
        "transform-back-into-human": "(:action transform-back-into-human\n :parameters (?character - character)\n :precondition (crow ?character)\n :effect (and (not (crow ?character)) (human ?character))\n)"
    }
