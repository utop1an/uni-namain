    "operators": {
        "fight": "(:action fight\n :parameters (?fighter1 - character ?fighter2 - character)\n :precondition (and (not (= ?fighter1 ?fighter2)) (alive ?fighter1) (has-weapon ?fighter1) (alive ?fighter2) (has-weapon ?fighter2))\n :effect (and)\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (not (alive ?character))\n)",
        "acquire-electronics": "(:action acquire-electronics\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-electronics ?character)))\n :effect (has-electronics ?character)\n)",
        "stop-believing": "(:action stop-believing\n :parameters (?character - character)\n :precondition (and (alive ?character) (believes-in-fairies ?character))\n :effect (not (believes-in-fairies ?character))\n)",
        "travel :parameters (?entity - character ?from - object ?to - object) :precondition (and (not (= ?from ?to)) (alive ?entity) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))": "(:action travel :parameters (?entity - character ?from - object ?to - object) :precondition (and (not (= ?from ?to)) (alive ?entity) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))",
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
        "start-party": "(:action start-party\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (party ?place)\n)",
        "enjoy-party": "(:action enjoy-party\n :parameters (?character - character ?place - object)\n :precondition (and (happy ?character) (party ?place))\n :effect (happy ?character)\n)",
        "put :parameters (?c - character ?entity - (either character item) ?place - object) :precondition (and (happy ?c) (has ?c ?entity)) :effect (at ?entity ?place))": "(:action put :parameters (?c - character ?entity - (either character item) ?place - object) :precondition (and (happy ?c) (has ?c ?entity)) :effect (at ?entity ?place))",
        "walk :parameters (?character - character ?from ?to - house) :precondition (and (alive ?character) (at ?character ?from) (not (eaten ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to) (when (and (rescuer ?character)) (and (rescuer-at ?to) (not (rescuer-at ?from))))))": "(:action walk :parameters (?character - character ?from ?to - house) :precondition (and (alive ?character) (at ?character ?from) (not (eaten ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to) (when (and (rescuer ?character)) (and (rescuer-at ?to) (not (rescuer-at ?from))))))",
        "eat :parameters (?m - wolf ?character - human ?place - object) :precondition (and (alive ?m) (alive ?character) (not (eaten ?character)) (at ?m ?place) (at ?character ?place) (monster ?m)) :effect (and (eaten ?character)))": "(:action eat :parameters (?m - wolf ?character - human ?place - object) :precondition (and (alive ?m) (alive ?character) (not (eaten ?character)) (at ?m ?place) (at ?character ?place) (monster ?m)) :effect (and (eaten ?character)))",
        "escape :parameters (?human - human ?character - character ?place - object) :precondition (and (eaten ?human) (not (alive ?character)) (at ?character ?place)) :effect (and (not (eaten ?human)) (rescued ?human) (at ?human ?place)))": "(:action escape :parameters (?human - human ?character - character ?place - object) :precondition (and (eaten ?human) (not (alive ?character)) (at ?character ?place)) :effect (and (not (eaten ?human)) (rescued ?human) (at ?human ?place)))",
        "kill :parameters (?character - worker ?m - wolf ?a - axe ?place - object) :precondition (and (alive ?character) (alive ?m) (has ?character ?a) (at ?character ?place) (at ?m ?place) (monster ?m) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?character - worker ?m - wolf ?a - axe ?place - object) :precondition (and (alive ?character) (alive ?m) (has ?character ?a) (at ?character ?place) (at ?m ?place) (monster ?m) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "give :parameters (?giving_character ?receiving_character - character ?t - thing ?place - object) :precondition (and (not (eaten ?receiving_character)) (alive ?giving_character) (alive ?receiving_character) (has ?giving_character ?t) (at ?giving_character ?place) (at ?receiving_character ?place)) :effect (and (has ?receiving_character ?t) (not (has ?giving_character ?t))))": "(:action give :parameters (?giving_character ?receiving_character - character ?t - thing ?place - object) :precondition (and (not (eaten ?receiving_character)) (alive ?giving_character) (alive ?receiving_character) (has ?giving_character ?t) (at ?giving_character ?place) (at ?receiving_character ?place)) :effect (and (has ?receiving_character ?t) (not (has ?giving_character ?t))))"
    }
