    "operators": {
        "find": "(:action find\n :parameters (?character - character ?object - object)\n :precondition (not (found ?character ?object))\n :effect (found ?character ?object)\n)",
        "make-handprint": "(:action make-handprint\n :parameters (?character - character)\n :precondition (found ?character colors)\n :effect (made-handprint ?character)\n)",
        "show-handprint": "(:action show-handprint\n :parameters (?shower - character ?viewer - character)\n :precondition (and (made-handprint ?shower) (not (= ?shower ?viewer)))\n :effect (celebrated ?viewer)\n)",
        "celebrate": "(:action celebrate\n :parameters (?celebrator - character ?celebratee - character)\n :precondition (and (celebrated ?celebrator) (not (= ?celebrator ?celebratee)))\n :effect (celebrated ?celebratee)\n)",
        "arrest": "(:action arrest\n :parameters (?p - police ?a - actor ?p1 ?p2 - place ?c - crime)\n :precondition (and (at ?p ?p1) (at ?a ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?p) (alive ?a) (suspect ?a ?c) (arrester ?p))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (at ?p ?p2) (not (at ?p ?p1)) (under-arrest ?a))\n)",
        "play-basketball": "(:action play-basketball\n :parameters (?a ?b - citizen ?p - place)\n :precondition (and (is-basketball-place ?p) (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (not (= ?a ?b)))\n :effect (and (not (angry ?a)) (not (angry ?b)))\n)",
        "findclues": "(:action findclues\n :parameters (?a - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (clue ?c ?i ?p))\n :effect (and (knows-clue ?a ?c ?i))\n)",
        "shareclues": "(:action shareclues\n :parameters (?a ?b - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (clue ?c ?i ?p) (knows-clue ?a ?c ?i))\n :effect (and (knows-clue ?b ?c ?i))\n)",
        "travel": "(:action travel\n :parameters (?a - actor ?c - car ?p1 ?p2 - place)\n :precondition (and (working ?c) (at ?a ?p1) (alive ?a) (has-car ?a ?c))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (when (and (arrester ?a)) (and (arrester-at ?p2) (not (arrester-at ?p1)))))\n)",
        "steal": "(:action steal\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (has ?b ?i) (not (= ?a ?b)) (alive ?a) (is-theft ?c))\n :effect (and (has ?a ?i) (not (has ?b ?i)) (angry ?b) (clue ?c ?i ?p))\n)",
        "kill": "(:action kill\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (alive ?a) (alive ?b) (not (= ?a ?b)) (has ?a ?i) (is-murder ?c) (not (under-arrest ?a)))\n :effect (and (not (alive ?b)) (clue ?c ?i ?p))\n)",
        "suspect-of-crime": "(:action suspect-of-crime\n :parameters (?a - police ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (knows-clue ?a ?c ?i) (has ?b ?i))\n :effect (and (suspect ?b ?c))\n)",
        "become-nervous": "(:action become-nervous\n :parameters (?character - character)\n :precondition (and)\n :effect (nervous ?character)\n)",
        "become-composed": "(:action become-composed\n :parameters (?character - character)\n :precondition (and)\n :effect (composed ?character)\n)",
        "enter :parameters (?c - actor ?p - place) :precondition (not (at ?c ?p)) :effect (at ?c ?p))": "(:action enter :parameters (?c - actor ?p - place) :precondition (not (at ?c ?p)) :effect (at ?c ?p))",
        "notice :parameters (?c - actor ?box - box ?p - place) :precondition (and (at ?c ?p) (at ?box ?p)) :effect (noticed ?c ?box))": "(:action notice :parameters (?c - actor ?box - box ?p - place) :precondition (and (at ?c ?p) (at ?box ?p)) :effect (noticed ?c ?box))",
        "open-box :parameters (?c - actor ?box - box ?p - place) :precondition (and (at ?c ?p) (at ?box ?p) (noticed ?c ?box) (not (opened ?box))) :effect (opened ?box))": "(:action open-box :parameters (?c - actor ?box - box ?p - place) :precondition (and (at ?c ?p) (at ?box ?p) (noticed ?c ?box) (not (opened ?box))) :effect (opened ?box))",
        "declare-war :parameters (?n1 - nation ?n2 - nation) :precondition (not (= ?n1 ?n2)) :effect (at-war ?n1 ?n2))": "(:action declare-war :parameters (?n1 - nation ?n2 - nation) :precondition (not (= ?n1 ?n2)) :effect (at-war ?n1 ?n2))",
        "defeat-navy :parameters (?attacker - nation ?defender - nation) :precondition (and (not (= ?attacker ?defender)) (at-war ?attacker ?defender)) :effect (navy-defeated ?attacker ?defender))": "(:action defeat-navy :parameters (?attacker - nation ?defender - nation) :precondition (and (not (= ?attacker ?defender)) (at-war ?attacker ?defender)) :effect (navy-defeated ?attacker ?defender))",
        "settle :parameters (?n - nation ?p - object) :precondition (and) :effect (settled ?n ?p))": "(:action settle :parameters (?n - nation ?p - object) :precondition (and) :effect (settled ?n ?p))",
        "establish-trading :parameters (?nation - nation) :precondition (and) :effect (trading ?nation))": "(:action establish-trading :parameters (?nation - nation) :precondition (and) :effect (trading ?nation))",
        "establish-plantation :parameters (?n - nation ?p - object) :precondition (and) :effect (plantation ?n ?p))": "(:action establish-plantation :parameters (?n - nation ?p - object) :precondition (and) :effect (plantation ?n ?p))",
        "establish-farm-estate :parameters (?nation - nation ?place - object) :precondition (and) :effect (farm-estate ?nation ?place))": "(:action establish-farm-estate :parameters (?nation - nation ?place - object) :precondition (and) :effect (farm-estate ?nation ?place))",
        "engage-slave-trade :parameters (?n - nation) :precondition (and) :effect (slave-trade ?n))": "(:action engage-slave-trade :parameters (?n - nation) :precondition (and) :effect (slave-trade ?n))",
        "build :parameters (?a - actor ?structure - object ?place - object) :precondition (alive ?a) :effect (built ?a ?structure ?place))": "(:action build :parameters (?a - actor ?structure - object ?place - object) :precondition (alive ?a) :effect (built ?a ?structure ?place))",
        "become-ruler :parameters (?a - actor ?nation - nation) :precondition (alive ?a) :effect (ruler ?a ?nation))": "(:action become-ruler :parameters (?a - actor ?nation - nation) :precondition (alive ?a) :effect (ruler ?a ?nation))"
