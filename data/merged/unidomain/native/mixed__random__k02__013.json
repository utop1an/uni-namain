        "fall-in-love": "(:action fall-in-love\n :parameters (?m - canmarry ?f - female ?place - location)\n :precondition (and (bachelor ?m) (at ?m ?place) (at ?f ?place) (single ?m) (alive ?m) (alive ?f) (not (loves ?m ?f)) (beautiful ?f))\n :effect (and (loves ?m ?f) (bachelor-loves ?f))\n)",
        "appear-threatening": "(:action appear-threatening\n :parameters (?m - monster ?char - person ?place - location)\n :precondition (and (alive ?m) (alive ?char) (at ?m ?place) (at ?char ?place) (scary ?m) (not (= ?m ?char)))\n :effect (and (intends-not-alive ?char ?m))\n)",
