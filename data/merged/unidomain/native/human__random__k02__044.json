    "operators": {
        "unlock": "(:action unlock\n :parameters (?character - character ?key - key ?room - room)\n :precondition (and (locked ?room) (unlocked-by ?room ?key) (has ?character ?key))\n :effect (and (not (locked ?room)))\n)",
        "enter :parameters (?entity - (either character creature) ?locationfrom - (either room place) ?destination - room) :precondition (and (not (locked ?destination)) (at ?entity ?locationfrom)) :effect (and (not (at ?entity ?locationfrom)) (at ?entity ?destination)))": "(:action enter :parameters (?entity - (either character creature) ?locationfrom - (either room place) ?destination - room) :precondition (and (not (locked ?destination)) (at ?entity ?locationfrom)) :effect (and (not (at ?entity ?locationfrom)) (at ?entity ?destination)))",
        "search-for :parameters (?entity - character ?thing - thing ?location - room) :precondition (and (at ?entity ?location) (in ?thing ?location)) :effect (and (has ?entity ?thing) (not (in ?thing ?location))))": "(:action search-for :parameters (?entity - character ?thing - thing ?location - room) :precondition (and (at ?entity ?location) (in ?thing ?location)) :effect (and (has ?entity ?thing) (not (in ?thing ?location))))",
        "walk :parameters (?entity - (either character creature) ?origin - (either room place) ?destination - (either room place)) :precondition (and (not (= ?origin ?destination)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?origin) (habitable ?destination) (safe ?destination) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))) :effect (and (at ?entity ?destination) (not (at ?entity ?origin)) (when (not (safe ?entity)) (safe ?entity))))": "(:action walk :parameters (?entity - (either character creature) ?origin - (either room place) ?destination - (either room place)) :precondition (and (not (= ?origin ?destination)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?origin) (habitable ?destination) (safe ?destination) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))) :effect (and (at ?entity ?destination) (not (at ?entity ?origin)) (when (not (safe ?entity)) (safe ?entity))))",
        "teleport-from-ship :parameters (?entity - creature ?origin - ship ?location - place) :precondition (and (not (= ?origin ?location)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?origin) (habitable ?location) (safe ?location) (captain ?entity ?origin)) :effect (and (at ?entity ?location) (not (at ?entity ?origin)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))": "(:action teleport-from-ship :parameters (?entity - creature ?origin - ship ?location - place) :precondition (and (not (= ?origin ?location)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?origin) (habitable ?location) (safe ?location) (captain ?entity ?origin)) :effect (and (at ?entity ?location) (not (at ?entity ?origin)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))",
        "teleport-to-ship :parameters (?entity - creature ?location - (either room place) ?ship - ship) :precondition (and (not (= ?location ?ship)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?location) (habitable ?ship) (safe ?ship) (captain ?entity ?ship)) :effect (and (at ?entity ?ship) (not (at ?entity ?location)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))": "(:action teleport-to-ship :parameters (?entity - creature ?location - (either room place) ?ship - ship) :precondition (and (not (= ?location ?ship)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?location) (habitable ?ship) (safe ?ship) (captain ?entity ?ship)) :effect (and (at ?entity ?ship) (not (at ?entity ?location)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))",
        "attack :parameters (?attacker - creature ?victim - creature ?location - (either room place)) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (at ?attacker ?location) (alive ?victim) (not (stunned ?victim)) (at ?victim ?location)) :effect (and (fighting ?attacker ?victim)))": "(:action attack :parameters (?attacker - creature ?victim - creature ?location - (either room place)) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (at ?attacker ?location) (alive ?victim) (not (stunned ?victim)) (at ?victim ?location)) :effect (and (fighting ?attacker ?victim)))",
        "kill :parameters (?attacker - creature ?target - creature) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (alive ?target) (or (fighting ?attacker ?target) (fighting ?target ?attacker))) :effect (and (not (alive ?target)) (when (fighting ?attacker ?target) (not (fighting ?attacker ?target))) (when (fighting ?target ?attacker) (not (fighting ?target ?attacker)))))": "(:action kill :parameters (?attacker - creature ?target - creature) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (alive ?target) (or (fighting ?attacker ?target) (fighting ?target ?attacker))) :effect (and (not (alive ?target)) (when (fighting ?attacker ?target) (not (fighting ?attacker ?target))) (when (fighting ?target ?attacker) (not (fighting ?target ?attacker)))))",
        "stun :parameters (?actor - creature ?target - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?target) (not (stunned ?target)) (or (fighting ?actor ?target) (fighting ?target ?actor))) :effect (and (stunned ?target) (when (fighting ?actor ?target) (not (fighting ?actor ?target))) (when (fighting ?target ?actor) (not (fighting ?target ?actor)))))": "(:action stun :parameters (?actor - creature ?target - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?target) (not (stunned ?target)) (or (fighting ?actor ?target) (fighting ?target ?actor))) :effect (and (stunned ?target) (when (fighting ?actor ?target) (not (fighting ?actor ?target))) (when (fighting ?target ?actor) (not (fighting ?target ?actor)))))",
        "break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))": "(:action break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))",
        "make-peace :parameters (?peacemaker - creature ?entity - creature ?location - (either room place)) :precondition (and (alive ?peacemaker) (not (stunned ?peacemaker)) (at ?peacemaker ?location) (alive ?entity) (at ?entity ?location) (not (fighting ?peacemaker ?entity)) (not (fighting ?entity ?peacemaker))) :effect (and (friends ?peacemaker ?entity) (friends ?entity ?peacemaker)))": "(:action make-peace :parameters (?peacemaker - creature ?entity - creature ?location - (either room place)) :precondition (and (alive ?peacemaker) (not (stunned ?peacemaker)) (at ?peacemaker ?location) (alive ?entity) (at ?entity ?location) (not (fighting ?peacemaker ?entity)) (not (fighting ?entity ?peacemaker))) :effect (and (friends ?peacemaker ?entity) (friends ?entity ?peacemaker)))",
        "begin-erupt :parameters (?location - landform) :precondition (and) :effect (and (erupting ?location) (forall (?entity - (either character creature)) (when (at ?entity ?location) (and (not (safe ?entity)))))))": "(:action begin-erupt :parameters (?location - landform) :precondition (and) :effect (and (erupting ?location) (forall (?entity - (either character creature)) (when (at ?entity ?location) (and (not (safe ?entity)))))))",
        "erupt :parameters (?location - landform) :precondition (erupting ?location) :effect (and (not (habitable ?location)) (not (erupting ?location)) (forall (?entity - (either character creature)) (when (at ?entity ?location) (not (alive ?entity))))))": "(:action erupt :parameters (?location - landform) :precondition (erupting ?location) :effect (and (not (habitable ?location)) (not (erupting ?location)) (forall (?entity - (either character creature)) (when (at ?entity ?location) (not (alive ?entity))))))"
    }
