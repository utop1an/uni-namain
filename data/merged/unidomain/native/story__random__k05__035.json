{
    "predicates": {
        "(in-tree ?character - character)": "Source predicate (in-tree ?character - character).",
        "(wants-to-eat ?character - character ?object - object)": "Source predicate (wants-to-eat ?character - character ?object - object).",
        "(hard ?object - object)": "Source predicate (hard ?object - object).",
        "(broken ?object - object)": "Source predicate (broken ?object - object).",
        "(eaten ?object - object)": "Source predicate (eaten ?object - object).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(tired ?character - character)": "Source predicate (tired ?character - character).",
        "(played-together ?character1 - character ?character2 - character)": "Source predicate (played-together ?character1 - character ?character2 - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(knows ?character1 - character ?character2 - character)": "Source predicate (knows ?character1 - character ?character2 - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(missing ?character - character)": "Source predicate (missing ?character - character).",
        "(relationship ?character1 - character ?character2 - character)": "Source predicate (relationship ?character1 - character ?character2 - character).",
        "(searching ?searcher - character ?target - character)": "Source predicate (searching ?searcher - character ?target - character).",
        "(found ?searcher - character ?target - character)": "Source predicate (found ?searcher - character ?target - character).",
        "(has ?character - character ?toy - toy)": "Source predicate (has ?character - character ?toy - toy).",
        "(on-top ?toy - toy ?place - place)": "Source predicate (on-top ?toy - toy ?place - place).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(scared ?character - character)": "Source predicate (scared ?character - character).",
        "(at-carnival ?character - character)": "Source predicate (at-carnival ?character - character).",
        "(wants-to-play ?character - character)": "Source predicate (wants-to-play ?character - character).",
        "(played ?character - character)": "Source predicate (played ?character - character).",
        "(weight-too-low ?character - character)": "Source predicate (weight-too-low ?character - character).",
        "(upset ?character - character)": "Source predicate (upset ?character - character).",
        "(comforted ?character - character)": "Source predicate (comforted ?character - character)."
    },
    "operators": {
        "climb-tree": "(:action climb-tree\n :parameters (?character - character)\n :precondition (not (in-tree ?character))\n :effect (in-tree ?character)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and)\n :effect (helping ?helper ?helpee)\n)",
        "break-object": "(:action break-object\n :parameters (?character - character ?object - object ?helpee - character)\n :precondition (and (hard ?object) (helping ?character ?helpee))\n :effect (broken ?object)\n)",
        "rest": "(:action rest\n :parameters (?character - character)\n :precondition (tired ?character)\n :effect (not (tired ?character))\n)",
        "want-to-eat": "(:action want-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and)\n :effect (wants-to-eat ?character ?object)\n)",
        "try-to-eat": "(:action try-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and (wants-to-eat ?character ?object) (hard ?object))\n :effect (not (eaten ?object))\n)",
        "eat-together": "(:action eat-together\n :parameters (?character1 - character ?character2 - character ?object - object)\n :precondition (and (broken ?object) (helping ?character1 ?character2))\n :effect (eaten ?object)\n)",
        "play": "(:action play\n :parameters (?character1 - character ?character2 - character ?place - place)\n :precondition (and (not (= ?character1 ?character2)) (at ?character1 ?place) (at ?character2 ?place))\n :effect (and (played-together ?character1 ?character2) (happy ?character1) (happy ?character2) (tired ?character1) (tired ?character2))\n)",
        "start-search": "(:action start-search\n :parameters (?searcher - character ?target - character)\n :precondition (and (not (= ?searcher ?target)) (not (searching ?searcher ?target)) (missing ?target))\n :effect (searching ?searcher ?target)\n)",
        "stop-search": "(:action stop-search\n :parameters (?searcher - character ?target - character)\n :precondition (searching ?searcher ?target)\n :effect (not (searching ?searcher ?target))\n)",
        "find": "(:action find\n :parameters (?searcher - character ?target - character)\n :precondition (and (searching ?searcher ?target) (missing ?target))\n :effect (and (not (missing ?target)) (found ?searcher ?target))\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "overcome-fear": "(:action overcome-fear\n :parameters (?character - character)\n :precondition (scared ?character)\n :effect (not (scared ?character))\n)",
        "become-upset": "(:action become-upset\n :parameters (?character - character)\n :precondition (weight-too-low ?character)\n :effect (upset ?character)\n)",
        "comfort": "(:action comfort\n :parameters (?comforter - character ?comforted - character)\n :precondition (and (not (= ?comforter ?comforted)) (upset ?comforted))\n :effect (comforted ?comforted)\n)",
        "start-relationship": "(:action start-relationship\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (not (relationship ?character1 ?character2)) (knows ?character1 ?character2))\n :effect (relationship ?character1 ?character2)\n)",
        "end-relationship": "(:action end-relationship\n :parameters (?character1 - character ?character2 - character)\n :precondition (relationship ?character1 ?character2)\n :effect (not (relationship ?character1 ?character2))\n)",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "retrieve-toy": "(:action retrieve-toy\n :parameters (?character - character ?toy - toy ?place - place)\n :precondition (and (at ?character ?place) (on-top ?toy ?place))\n :effect (and (not (on-top ?toy ?place)) (has ?character ?toy))\n)",
        "go-to-carnival": "(:action go-to-carnival\n :parameters (?character - character)\n :precondition (and)\n :effect (at-carnival ?character)\n)",
        "want-to-play": "(:action want-to-play\n :parameters (?character - character)\n :precondition (at-carnival ?character)\n :effect (wants-to-play ?character)\n)",
        "play-game": "(:action play-game\n :parameters (?character - character)\n :precondition (and (at-carnival ?character) (wants-to-play ?character))\n :effect (and (played ?character) (weight-too-low ?character))\n)"
    }
}