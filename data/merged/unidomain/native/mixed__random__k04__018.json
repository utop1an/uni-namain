        "kill :parameters (?character - character ?m - wolf ?object - object ?p - place) :precondition (and (alive ?character) (alive ?m) (has ?character ?object) (at ?character ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?character - character ?m - wolf ?object - object ?p - place) :precondition (and (alive ?character) (alive ?m) (has ?character ?object) (at ?character ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "give :parameters (?giver ?recipient - character ?object - object ?place - place) :precondition (and (not (eaten ?recipient)) (alive ?giver) (alive ?recipient) (has ?giver ?object) (at ?giver ?place) (at ?recipient ?place)) :effect (and (has ?recipient ?object) (not (has ?giver ?object))))": "(:action give :parameters (?giver ?recipient - character ?object - object ?place - place) :precondition (and (not (eaten ?recipient)) (alive ?giver) (alive ?recipient) (has ?giver ?object) (at ?giver ?place) (at ?recipient ?place)) :effect (and (has ?recipient ?object) (not (has ?giver ?object))))",
