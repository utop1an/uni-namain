        "know-self :parameters (?c - character) :precondition (alive ?c) :effect (knows-self ?c))": "(:action know-self :parameters (?c - character) :precondition (alive ?c) :effect (knows-self ?c))",
        "detect-stasis :parameters (?c - character ?object - object) :precondition (and (alive ?c) (has ?c ?object) (ancient-technology ?object)) :effect (in-stasis ?object))": "(:action detect-stasis :parameters (?c - character ?object - object) :precondition (and (alive ?c) (has ?c ?object) (ancient-technology ?object)) :effect (in-stasis ?object))",
        "move :parameters (?c - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?c) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to)))": "(:action move :parameters (?c - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?c) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to)))",
