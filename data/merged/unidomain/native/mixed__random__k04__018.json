        "discover-technology :parameters (?c - character ?object - object ?place - place) :precondition (and (alive ?c) (at ?c ?place)) :effect (and (has ?c ?object) (ancient-technology ?object)))": "(:action discover-technology :parameters (?c - character ?object - object ?place - place) :precondition (and (alive ?c) (at ?c ?place)) :effect (and (has ?c ?object) (ancient-technology ?object)))",
        "transport-object :parameters (?c - character ?object - object ?from - place ?to - place) :precondition (and (alive ?c) (at ?c ?from) (has ?c ?object) (requested-tow ?c ?to)) :effect (and (not (at ?c ?from)) (at ?c ?to) (not (has ?c ?object))))": "(:action transport-object :parameters (?c - character ?object - object ?from - place ?to - place) :precondition (and (alive ?c) (at ?c ?from) (has ?c ?object) (requested-tow ?c ?to)) :effect (and (not (at ?c ?from)) (at ?c ?to) (not (has ?c ?object))))"
