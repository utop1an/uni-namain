        "put-on-shelf :parameters (?character - character ?object - object ?place - place) :precondition (and (has ?character ?object) (at ?character ?place)) :effect (and (not (has ?character ?object)) (on-shelf ?object) (organized ?place)))": "(:action put-on-shelf :parameters (?character - character ?object - object ?place - place) :precondition (and (has ?character ?object) (at ?character ?place)) :effect (and (not (has ?character ?object)) (on-shelf ?object) (organized ?place)))",
        "try-get": "(:action try-get\n :parameters (?character - character ?object - object)\n :precondition (and (impatient ?character) (on-table ?object))\n :effect (and (not (on-table ?object)) (has ?character ?object))\n)",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - item)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "clean-item :parameters (?character - character ?object - object) :precondition (and (alive ?character) (has ?character ?object) (not (clean ?object))) :effect (clean ?object))": "(:action clean-item :parameters (?character - character ?object - object) :precondition (and (alive ?character) (has ?character ?object) (not (clean ?object))) :effect (clean ?object))",
        "adjust-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (fits ?object ?character))) :effect (fits ?object ?character))": "(:action adjust-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (fits ?object ?character))) :effect (fits ?object ?character))",
        "wear-item": "(:action wear-item :parameters (?character - character ?item - item) :precondition (and (alive ?character) (has ?character ?item) (fits ?item ?character) (not (wearing ?character ?item))) :effect (wearing ?character ?item))"
