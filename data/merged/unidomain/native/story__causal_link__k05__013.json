        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)",
        "read": "(:action read\n :parameters (?character - character)\n :precondition (reads ?character)\n :effect (happy ?character)\n)",
        "smell-soap": "(:action smell-soap\n :parameters (?character - character ?soap - item)\n :precondition (and (on-shelf ?soap) (reads ?character))\n :effect (happy ?character)\n)",
        "find :parameters (?character - character ?object - object) :precondition (and (not (has ?character ?object)) (reads ?character)) :effect (has ?character ?object))": "(:action find :parameters (?character - character ?object - object) :precondition (and (not (has ?character ?object)) (reads ?character)) :effect (has ?character ?object))",
        "smell-nice": "(:action smell-nice\n :parameters (?character - character)\n :precondition (has ?character perfume)\n :effect (smells-nice ?character)\n)",
