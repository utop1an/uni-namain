    "operators": {
        "snakebite": "(:action snakebite\n :parameters (?victim - person)\n :precondition (alive ?victim)\n :effect (and (sick ?victim snakebite))\n)",
        "die": "(:action die\n :parameters (?person - person ?sickness - sickness)\n :precondition (and (alive ?person) (sick ?person ?sickness))\n :effect (not (alive ?person))\n)",
        "start-working": "(:action start-working\n :parameters (?character - character)\n :precondition (and)\n :effect (worker ?character)\n)",
        "clean-factory": "(:action clean-factory\n :parameters (?character - character)\n :precondition (worker ?character)\n :effect (clean factory)\n)",
        "make-toys": "(:action make-toys\n :parameters (?character - character)\n :precondition (worker ?character)\n :effect (makes-toys ?character)\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (worker ?character1) (worker ?character2) (not (= ?character1 ?character2)))\n :effect (friends-with ?character1 ?character2)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (worker ?character)\n :effect (happy ?character)\n)",
        "become-less-nervous": "(:action become-less-nervous\n :parameters (?character - character)\n :precondition (and (worker ?character) (nervous ?character))\n :effect (not (nervous ?character))\n)",
        "travel": "(:action travel\n :parameters (?person - person ?from - place ?to - place)\n :precondition (and (alive ?person) (free ?person) (at ?person ?from))\n :effect (and (at ?person ?to) (not (at ?person ?from)))\n)",
        "forcetravel": "(:action forcetravel\n :parameters (?person - person ?victim - person ?from - place ?to - place)\n :precondition (and (alive ?person) (free ?person) (at ?person ?from) (alive ?victim) (not (free ?victim)) (at ?victim ?from))\n :effect (and (at ?person ?to) (not (at ?person ?from)) (at ?victim ?to) (not (at ?victim ?from)))\n)",
        "give": "(:action give\n :parameters (?giver - person ?receiver - person ?item - item ?place - place)\n :precondition (and (alive ?giver) (free ?giver) (at ?giver ?place) (has ?giver ?item) (alive ?receiver) (free ?receiver) (at ?receiver ?place))\n :effect (and (has ?receiver ?item) (not (has ?giver ?item)) (when (belongsto ?item ?giver) (belongsto ?item ?receiver)))\n)",
        "tieup": "(:action tieup\n :parameters (?person - person ?victim - person ?place - place)\n :precondition (and (alive ?person) (free ?person) (at ?person ?place) (alive ?victim) (at ?victim ?place))\n :effect (and (not (free ?victim)))\n)",
        "untie": "(:action untie\n :parameters (?person - person ?victim - person ?place - place)\n :precondition (and (alive ?person) (free ?person) (at ?person ?place) (alive ?victim) (not (free ?victim)) (at ?victim ?place))\n :effect (free ?victim)\n)",
        "take": "(:action take\n :parameters (?taker - person ?item - item ?victim - person ?place - place)\n :precondition (and (not (= ?taker ?victim)) (alive ?taker) (free ?taker) (at ?taker ?place) (alive ?victim) (not (free ?victim)) (at ?victim ?place) (has ?victim ?item))\n :effect (and (has ?taker ?item) (not (has ?victim ?item)))\n)",
        "heal": "(:action heal\n :parameters (?healer - person ?patient - person ?sickness - sickness ?medicine - item ?place - place)\n :precondition (and (cures ?medicine ?sickness) (alive ?healer) (free ?healer) (at ?healer ?place) (has ?healer ?medicine) (alive ?patient) (at ?patient ?place) (sick ?patient ?sickness))\n :effect (and (not (sick ?patient ?sickness)) (not (has ?healer ?medicine)))\n)",
        "become-important": "(:action become-important\n :parameters (?character - character)\n :precondition (not (important ?character))\n :effect (important ?character)\n)",
        "become-unimportant": "(:action become-unimportant\n :parameters (?character - character)\n :precondition (important ?character)\n :effect (not (important ?character))\n)",
        "bring-to-herenow": "(:action bring-to-herenow\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (not (in-herenow ?master)))\n :effect (in-herenow ?master)\n)",
        "walk": "(:action walk\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (needs-walk ?master))\n :effect (and (not (needs-walk ?master)) (in-herenow ?master))\n)",
        "time-of-passing": "(:action time-of-passing\n :parameters ()\n :precondition (not (time-of-passing))\n :effect (time-of-passing)\n)",
        "move :parameters (?object - object ?place - place) :precondition (and (not (at ?object ?place))) :effect (at ?object ?place))": "(:action move :parameters (?object - object ?place - place) :precondition (and (not (at ?object ?place))) :effect (at ?object ?place))",
        "sit :parameters (?actor - character ?seat - seat) :precondition (and (not (sitting ?actor ?seat)) (not (broken ?seat))) :effect (sitting ?actor ?seat))": "(:action sit :parameters (?actor - character ?seat - seat) :precondition (and (not (sitting ?actor ?seat)) (not (broken ?seat))) :effect (sitting ?actor ?seat))",
        "leave :parameters (?occupant - character ?seat - seat) :precondition (sitting ?occupant ?seat) :effect (not (sitting ?occupant ?seat)))": "(:action leave :parameters (?occupant - character ?seat - seat) :precondition (sitting ?occupant ?seat) :effect (not (sitting ?occupant ?seat)))",
        "break-seat :parameters (?seat - seat) :precondition (not (broken ?seat)) :effect (broken ?seat))": "(:action break-seat :parameters (?seat - seat) :precondition (not (broken ?seat)) :effect (broken ?seat))",
        "remind-ancient-oath :parameters (?dog - character ?master - character) :precondition (and (guardian ?dog) (master ?master) (ancient-oath ?dog)) :effect (needs-walk ?master))": "(:action remind-ancient-oath :parameters (?dog - character ?master - character) :precondition (and (guardian ?dog) (master ?master) (ancient-oath ?dog)) :effect (needs-walk ?master))"
    }
