    "operators": {
        "enter-airlock": "(:action enter-airlock\n :parameters (?character - character)\n :precondition (not (in-airlock ?character))\n :effect (in-airlock ?character)\n)",
        "pressurize-suit": "(:action pressurize-suit\n :parameters (?character - character)\n :precondition (and (in-airlock ?character) (not (suit-pressurized ?character)))\n :effect (suit-pressurized ?character)\n)",
        "jump": "(:action jump\n :parameters (?character - character ?planet - planet)\n :precondition (and (suit-pressurized ?character) (not (on-planet ?character ?planet)))\n :effect (and (reached-altitude ?character) (reached-speed ?character))\n)",
        "land": "(:action land\n :parameters (?character - character ?planet - planet)\n :precondition (and (wingsuit-active ?character) (not (on-planet ?character ?planet)))\n :effect (on-planet ?character ?planet)\n)",
        "start-task": "(:action start-task\n :parameters (?robot - robot)\n :precondition (and (assembled ?robot) (not (working-on-task ?robot)))\n :effect (working-on-task ?robot)\n)",
        "stop-game": "(:action stop-game\n :parameters (?character - character)\n :precondition (playing-game ?character)\n :effect (not (playing-game ?character))\n)",
        "activate-wingsuit :parameters (?entity - character) :precondition (and (reached-altitude ?entity) (reached-speed ?entity) (not (wingsuit-active ?entity))) :effect (wingsuit-active ?entity))": "(:action activate-wingsuit :parameters (?entity - character) :precondition (and (reached-altitude ?entity) (reached-speed ?entity) (not (wingsuit-active ?entity))) :effect (wingsuit-active ?entity))",
        "assemble :parameters (?entity - character ?robot - robot) :precondition (and (at ?entity garage) (not (assembled ?robot))) :effect (and (assembled ?robot) (has-robot ?entity ?robot)))": "(:action assemble :parameters (?entity - character ?robot - robot) :precondition (and (at ?entity garage) (not (assembled ?robot))) :effect (and (assembled ?robot) (has-robot ?entity ?robot)))",
        "play-game :parameters (?entity - character) :precondition (and (at ?entity house) (not (playing-game ?entity))) :effect (playing-game ?entity))": "(:action play-game :parameters (?entity - character) :precondition (and (at ?entity house) (not (playing-game ?entity))) :effect (playing-game ?entity))",
        "talk": "(:action talk\n :parameters (?a - character ?b - character)\n :precondition (and (not (= ?a ?b)) (friend ?a ?b))\n :effect (talks-to ?a ?b)\n)",
        "provide-help": "(:action provide-help\n :parameters (?a - character ?b - character)\n :precondition (and (not (= ?a ?b)) (friend ?a ?b) (needs-help ?b) (talks-to ?a ?b))\n :effect (provides-help ?a ?b)\n)",
        "start-smiling": "(:action start-smiling\n :parameters (?character - character ?a - character)\n :precondition (and (not (smiling ?character)) (provides-help ?a ?character))\n :effect (smiling ?character)\n)",
        "start-laughing": "(:action start-laughing\n :parameters (?character - character ?a - character)\n :precondition (and (not (laughing ?character)) (provides-help ?a ?character))\n :effect (laughing ?character)\n)",
        "stop-playing": "(:action stop-playing\n :parameters (?character - character ?animal - animal)\n :precondition (playing ?character ?animal)\n :effect (not (playing ?character ?animal))\n)",
        "can-run": "(:action can-run\n :parameters (?character - character)\n :precondition (and)\n :effect (can-run ?character)\n)",
        "can-fly": "(:action can-fly\n :parameters (?animal - animal)\n :precondition (and)\n :effect (can-fly ?animal)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (and)\n :effect (happy ?character)\n)",
        "get-sick": "(:action get-sick\n :parameters (?character - character)\n :precondition (and)\n :effect (sick ?character)\n)",
        "feel-better": "(:action feel-better\n :parameters (?character - character)\n :precondition (sick ?character)\n :effect (not (sick ?character))\n)",
        "sit-together": "(:action sit-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (sit-together ?character1 ?character2)\n)",
        "play-chess": "(:action play-chess\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (sick ?character1)) (not (sick ?character2)) (not (= ?character1 ?character2)) (sit-together ?character1 ?character2))\n :effect (and (play-chess ?character1 ?character2) (happy ?character1) (happy ?character2))\n)",
        "play :parameters (?character - character ?animal - animal ?site - object) :precondition (and (at ?character ?site) (at ?animal ?site)) :effect (playing ?character ?animal))": "(:action play :parameters (?character - character ?animal - animal ?site - object) :precondition (and (at ?character ?site) (at ?animal ?site)) :effect (playing ?character ?animal))",
        "move :parameters (?entity - object ?source - object ?destination - object) :precondition (and (not (= ?source ?destination)) (at ?entity ?source)) :effect (and (not (at ?entity ?source)) (at ?entity ?destination)))": "(:action move :parameters (?entity - object ?source - object ?destination - object) :precondition (and (not (= ?source ?destination)) (at ?entity ?source)) :effect (and (not (at ?entity ?source)) (at ?entity ?destination)))"
