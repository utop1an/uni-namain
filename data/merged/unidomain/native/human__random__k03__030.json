        "heal :parameters (?holder - person) :precondition (and (has-medicine ?holder) (not (healthy ?holder)) (theinvalid ?holder) (invalid-unwell)) :effect (and (healthy ?holder) (not (has-medicine ?holder)) (recovered ?holder) (not (invalid-unwell)) (invalid-recovered)))": "(:action heal :parameters (?holder - person) :precondition (and (has-medicine ?holder) (not (healthy ?holder)) (theinvalid ?holder) (invalid-unwell)) :effect (and (healthy ?holder) (not (has-medicine ?holder)) (recovered ?holder) (not (invalid-unwell)) (invalid-recovered)))",
        "recover :parameters (?patient - person) :precondition (and (not (= ?patient thefarmer)) (has-medicine ?patient) (not (healthy ?patient)) (theinvalid ?patient) (invalid-unwell)) :effect (and (healthy ?patient) (not (has-medicine ?patient)) (recovered ?patient) (not (invalid-unwell)) (invalid-recovered)))": "(:action recover :parameters (?patient - person) :precondition (and (not (= ?patient thefarmer)) (has-medicine ?patient) (not (healthy ?patient)) (theinvalid ?patient) (invalid-unwell)) :effect (and (healthy ?patient) (not (has-medicine ?patient)) (recovered ?patient) (not (invalid-unwell)) (invalid-recovered)))",
        "travel-to-city :parameters (?holder - person ?f ?t - place) :precondition (and (= ?t thecity) (not (= ?t ?f)) (has-ticket ?holder) (alive ?holder) (at ?holder ?f) (themover ?holder) (decided-move-city)) :effect (and (moved-to-city) (at ?holder ?t) (not (at ?holder ?t))))": "(:action travel-to-city :parameters (?holder - person ?f ?t - place) :precondition (and (= ?t thecity) (not (= ?t ?f)) (has-ticket ?holder) (alive ?holder) (at ?holder ?f) (themover ?holder) (decided-move-city)) :effect (and (moved-to-city) (at ?holder ?t) (not (at ?holder ?t))))",
        "steal-cash :parameters (?thief ?victim - person ?location - place) :precondition (and (at ?thief ?location) (at ?victim ?location) (has-cash ?victim) (thecriminal ?thief)) :effect (and (has-cash ?thief) (not (has-cash ?victim)) (done-crime ?thief) (crime-done)))": "(:action steal-cash :parameters (?thief ?victim - person ?location - place) :precondition (and (at ?thief ?location) (at ?victim ?location) (has-cash ?victim) (thecriminal ?thief)) :effect (and (has-cash ?thief) (not (has-cash ?victim)) (done-crime ?thief) (crime-done)))",
        "steal-medicine :parameters (?holder - person ?location - place) :precondition (and (at ?holder ?location) (theinvalid ?holder) (invalid-unwell) (not (has-cash ?holder))) :effect (and (has-medicine ?holder)))": "(:action steal-medicine :parameters (?holder - person ?location - place) :precondition (and (at ?holder ?location) (theinvalid ?holder) (invalid-unwell) (not (has-cash ?holder))) :effect (and (has-medicine ?holder)))",
        "get-medicine :parameters (?recipient ?provider - person ?location - place) :precondition (and (has-cash ?recipient) (not (has-medicine ?recipient)) (has-medicine ?provider) (at ?recipient ?location) (at ?provider ?location)) :effect (and (has-medicine ?recipient) (not (has-cash ?recipient)) (has-cash ?provider) (not (has-medicine ?provider))))": "(:action get-medicine :parameters (?recipient ?provider - person ?location - place) :precondition (and (has-cash ?recipient) (not (has-medicine ?recipient)) (has-medicine ?provider) (at ?recipient ?location) (at ?provider ?location)) :effect (and (has-medicine ?recipient) (not (has-cash ?recipient)) (has-cash ?provider) (not (has-medicine ?provider))))",
        "wake-person": "(:action wake-person :parameters (?waker - character ?woken - character ?place - place) :precondition (and (at ?waker ?place) (at ?woken ?place) (asleep ?woken) (not (asleep ?waker))) :effect (not (asleep ?woken)))",
        "move-location :parameters (?object - object ?destination - place ?source - place) :precondition (and (connected ?destination ?source) (not (asleep ?object)) (at ?object ?source)) :effect (and (not (at ?object ?source)) (at ?object ?destination)))": "(:action move-location :parameters (?object - object ?destination - place ?source - place) :precondition (and (connected ?destination ?source) (not (asleep ?object)) (at ?object ?source)) :effect (and (not (at ?object ?source)) (at ?object ?destination)))",
