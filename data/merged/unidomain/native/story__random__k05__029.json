{
    "predicates": {
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(dead ?character - character)": "Source predicate (dead ?character - character).",
        "(has-plan ?character - character)": "Source predicate (has-plan ?character - character).",
        "(has-time ?character - character)": "Source predicate (has-time ?character - character).",
        "(has-idea ?character - character)": "Source predicate (has-idea ?character - character).",
        "(has-tv-show-reference ?character - character)": "Source predicate (has-tv-show-reference ?character - character).",
        "(has-creative-plan ?character - character)": "Source predicate (has-creative-plan ?character - character).",
        "(has-better-plan ?character - character)": "Source predicate (has-better-plan ?character - character).",
        "(needs-walk ?character - character)": "Source predicate (needs-walk ?character - character).",
        "(in-herenow ?character - character)": "Source predicate (in-herenow ?character - character).",
        "(ancient-oath ?dog - character)": "Source predicate (ancient-oath ?dog - character).",
        "(guardian ?dog - character)": "Source predicate (guardian ?dog - character).",
        "(master ?character - character)": "Source predicate (master ?character - character).",
        "(time-of-passing)": "Source predicate (time-of-passing).",
        "(famous ?character - character)": "Source predicate (famous ?character - character).",
        "(wears-earmuffs ?character - character)": "Source predicate (wears-earmuffs ?character - character).",
        "(filled-with-ice ?character - character)": "Source predicate (filled-with-ice ?character - character).",
        "(candidate ?character - character)": "Source predicate (candidate ?character - character).",
        "(president ?character - character)": "Source predicate (president ?character - character).",
        "(endured-pain ?character - character)": "Source predicate (endured-pain ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(sad ?character - character)": "Source predicate (sad ?character - character).",
        "(offered-snack ?giver - character ?receiver - character)": "Source predicate (offered-snack ?giver - character ?receiver - character).",
        "(snack-is-lie ?giver - character ?receiver - character)": "Source predicate (snack-is-lie ?giver - character ?receiver - character).",
        "(trusts ?character1 - character ?character2 - character)": "Source predicate (trusts ?character1 - character ?character2 - character).",
        "(compassionate ?character - character)": "Source predicate (compassionate ?character - character).",
        "(at ?character - character ?location - object)": "The character is at the specified location.",
        "(assembled ?robot - robot)": "Source predicate (assembled ?robot - robot).",
        "(has-robot ?character - character ?robot - robot)": "Source predicate (has-robot ?character - character ?robot - robot).",
        "(working-on-task ?robot - robot)": "Source predicate (working-on-task ?robot - robot).",
        "(playing-game ?character - character)": "Source predicate (playing-game ?character - character)."
    },
    "operators": {
        "present-plan": "(:action present-plan\n :parameters (?character - character)\n :precondition (and (alive ?character) (has-plan ?character))\n :effect (and (has-idea ?character) (when (has-tv-show-reference ?character) (not (has-creative-plan ?character))))\n)",
        "decide-fate": "(:action decide-fate\n :parameters (?council - character ?character - character)\n :precondition (and (alive ?council) (alive ?character) (has-idea ?character))\n :effect (when (has-creative-plan ?character) (and (has-better-plan ?character) (has-time ?character)))\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-time ?character)))\n :effect (dead ?character)\n)",
        "remind-ancient-oath": "(:action remind-ancient-oath\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (ancient-oath ?dog))\n :effect (needs-walk ?master)\n)",
        "bring-to-herenow": "(:action bring-to-herenow\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (not (in-herenow ?master)))\n :effect (in-herenow ?master)\n)",
        "walk": "(:action walk\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (needs-walk ?master))\n :effect (and (not (needs-walk ?master)) (in-herenow ?master))\n)",
        "time-of-passing": "(:action time-of-passing\n :parameters ()\n :precondition (not (time-of-passing))\n :effect (time-of-passing)\n)",
        "become-famous": "(:action become-famous\n :parameters (?character - character)\n :precondition (not (famous ?character))\n :effect (famous ?character)\n)",
        "wear-earmuffs": "(:action wear-earmuffs\n :parameters (?character - character)\n :precondition (and (famous ?character) (not (wears-earmuffs ?character)))\n :effect (wears-earmuffs ?character)\n)",
        "fill-earmuffs-with-ice": "(:action fill-earmuffs-with-ice\n :parameters (?character - character)\n :precondition (and (famous ?character) (wears-earmuffs ?character) (not (filled-with-ice ?character)))\n :effect (filled-with-ice ?character)\n)",
        "become-candidate": "(:action become-candidate\n :parameters (?character - character)\n :precondition (and (famous ?character) (not (candidate ?character)))\n :effect (candidate ?character)\n)",
        "become-president": "(:action become-president\n :parameters (?character - character)\n :precondition (and (candidate ?character) (not (president ?character)))\n :effect (president ?character)\n)",
        "endure-pain": "(:action endure-pain\n :parameters (?character - character)\n :precondition (and (famous ?character) (filled-with-ice ?character) (not (endured-pain ?character)))\n :effect (endured-pain ?character)\n)",
        "learn-lesson": "(:action learn-lesson\n :parameters (?character - character)\n :precondition (and (sad ?character) (not (trusts ?character ?character)))\n :effect (and (not (sad ?character)) (happy ?character))\n)",
        "go-to-place :parameters (?character - character ?location - object) :precondition (and (not (at ?character ?location)) (happy ?character)) :effect (and (at ?character ?location) (not (happy ?character))))": "(:action go-to-place :parameters (?character - character ?location - object) :precondition (and (not (at ?character ?location)) (happy ?character)) :effect (and (at ?character ?location) (not (happy ?character))))",
        "offer-snack :parameters (?snack-giver - character ?snack-receiver - character) :precondition (and (at ?snack-receiver ?snack-giver) (compassionate ?snack-giver)) :effect (offered-snack ?snack-giver ?snack-receiver))": "(:action offer-snack :parameters (?snack-giver - character ?snack-receiver - character) :precondition (and (at ?snack-receiver ?snack-giver) (compassionate ?snack-giver)) :effect (offered-snack ?snack-giver ?snack-receiver))",
        "reveal-lie :parameters (?source - character ?recipient - character) :precondition (and (offered-snack ?source ?recipient) (not (compassionate ?source))) :effect (and (snack-is-lie ?source ?recipient) (not (happy ?recipient)) (sad ?recipient)))": "(:action reveal-lie :parameters (?source - character ?recipient - character) :precondition (and (offered-snack ?source ?recipient) (not (compassionate ?source))) :effect (and (snack-is-lie ?source ?recipient) (not (happy ?recipient)) (sad ?recipient)))",
        "run-away :parameters (?character - character ?location - character) :precondition (and (at ?character ?location) (sad ?character)) :effect (and (not (at ?character ?location)) (not (trusts ?character ?location))))": "(:action run-away :parameters (?character - character ?location - character) :precondition (and (at ?character ?location) (sad ?character)) :effect (and (not (at ?character ?location)) (not (trusts ?character ?location))))",
        "start-task": "(:action start-task\n :parameters (?robot - robot)\n :precondition (and (assembled ?robot) (not (working-on-task ?robot)))\n :effect (working-on-task ?robot)\n)",
        "stop-game": "(:action stop-game\n :parameters (?character - character)\n :precondition (playing-game ?character)\n :effect (not (playing-game ?character))\n)",
        "assemble": "(:action assemble\n :parameters (?character - character ?robot - robot)\n :precondition (and (at ?character garage) (not (assembled ?robot)))\n :effect (and (assembled ?robot) (has-robot ?character ?robot))\n)",
        "play-game": "(:action play-game\n :parameters (?character - character)\n :precondition (and (at ?character house) (not (playing-game ?character)))\n :effect (playing-game ?character)\n)"
    }
}