        "(captured ?character - character)": "Source predicate (captured ?character - character).",
        "(henchman ?henchman - character)": "Source predicate (henchman ?henchman - character).",
        "(at-party ?character - character)": "Source predicate (at-party ?character - character).",
        "(fast ?character - character)": "Source predicate (fast ?character - character).",
        "(cake-transformed)": "Source predicate (cake-transformed).",
        "(has ?character - character ?object - object)": "The character has the specified entity, which may be a character or an object.",
        "(at ?character - character ?location - location)": "The character is at the specified location.",
        "(alive ?character - character)": "The character is alive.",
        "(has ?character - character ?entity - (either character object))": "The character has the specified entity, which may be a character or an object, including an item.",
        "(clean ?item - item)": "Source predicate (clean ?item - item).",
        "(locked ?door - item)": "Source predicate (locked ?door - item).",
        "(wearing ?character - character ?item - item)": "Source predicate (wearing ?character - character ?item - item).",
        "(fits ?item - item ?character - character)": "Source predicate (fits ?item - item ?character - character).",
        "(loves ?lover - character ?loved - character)": "Source predicate (loves ?lover - character ?loved - character).",
        "(confessed ?confessor - character ?confessed-to - character)": "Source predicate (confessed ?confessor - character ?confessed-to - character).",
        "(asked-question ?asker - character ?asked - character)": "Source predicate (asked-question ?asker - character ?asked - character).",
        "(took-pill ?character - character)": "Source predicate (took-pill ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified location.",
        "(has ?character - character ?item - item)": "The character has the specified entity, which may be a character or an object, including an item."
    },
    "operators": {
        "move-location :parameters (?actor - character ?destination - location ?origin - location) :precondition (and (player ?actor) (connected ?destination ?origin) (at ?actor ?origin) (knows ?actor)) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination)))": "(:action move-location :parameters (?actor - character ?destination - location ?origin - location) :precondition (and (player ?actor) (connected ?destination ?origin) (at ?actor ?origin) (knows ?actor)) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination)))",
        "interrogate-character :parameters (?actor - character ?subject - character ?place - location) :precondition (and (player ?actor) (at ?actor ?place) (at ?subject ?place) (apprehended ?subject)) :effect (knows ?actor))": "(:action interrogate-character :parameters (?actor - character ?subject - character ?place - location) :precondition (and (player ?actor) (at ?actor ?place) (at ?subject ?place) (apprehended ?subject)) :effect (knows ?actor))",
        "go-to-party :parameters (?participant - character) :precondition (not (at-party ?participant)) :effect (at-party ?participant))": "(:action go-to-party :parameters (?participant - character) :precondition (not (at-party ?participant)) :effect (at-party ?participant))",
        "magic-trick :parameters (?character - character) :precondition (and (at-party ?character) (not (cake-transformed))) :effect (cake-transformed))": "(:action magic-trick :parameters (?character - character) :precondition (and (at-party ?character) (not (cake-transformed))) :effect (cake-transformed))",
        "eat-cake :parameters (?actor - character) :precondition (and (at-party ?actor) (cake-transformed)) :effect (fast ?actor))": "(:action eat-cake :parameters (?actor - character) :precondition (and (at-party ?actor) (cake-transformed)) :effect (fast ?actor))",
        "play :parameters (?c - character) :precondition (and (at-party ?c) (fast ?c)) :effect (and))": "(:action play :parameters (?c - character) :precondition (and (at-party ?c) (fast ?c)) :effect (and))",
        "save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))",
        "place-victim :parameters (?acting-character - character ?character - character ?current-location - location ?destination - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?character) (at ?acting-character ?current-location) (connected ?destination ?current-location)) :effect (and (not (has ?acting-character ?character)) (at ?character ?destination) (captured ?character)))": "(:action place-victim :parameters (?acting-character - character ?character - character ?current-location - location ?destination - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?character) (at ?acting-character ?current-location) (connected ?destination ?current-location)) :effect (and (not (has ?acting-character ?character)) (at ?character ?destination) (captured ?character)))",
        "take-pill": "(:action take-pill\n :parameters (?character - character)\n :precondition (not (took-pill ?character))\n :effect (took-pill ?character)\n)",
        "ask-love-question": "(:action ask-love-question\n :parameters (?asker - character ?asked - character)\n :precondition (not (asked-question ?asker ?asked))\n :effect (asked-question ?asker ?asked)\n)",
        "confess-love": "(:action confess-love\n :parameters (?confessor - character ?confessed-to - character)\n :precondition (and (not (confessed ?confessor ?confessed-to)) (asked-question ?confessed-to ?confessor) (took-pill ?confessor))\n :effect (and (confessed ?confessor ?confessed-to) (loves ?confessor ?confessed-to))\n)",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - item)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "clean-item :parameters (?character - character ?entity - item) :precondition (and (alive ?character) (has ?character ?entity) (not (clean ?entity))) :effect (clean ?entity))": "(:action clean-item :parameters (?character - character ?entity - item) :precondition (and (alive ?character) (has ?character ?entity) (not (clean ?entity))) :effect (clean ?entity))",
        "adjust-item :parameters (?character - character ?entity - item) :precondition (and (alive ?character) (has ?character ?entity) (not (fits ?entity ?character))) :effect (fits ?entity ?character))": "(:action adjust-item :parameters (?character - character ?entity - item) :precondition (and (alive ?character) (has ?character ?entity) (not (fits ?entity ?character))) :effect (fits ?entity ?character))",
        "wear-item :parameters (?character - character ?entity - (either character object)) :precondition (and (alive ?character) (has ?character ?entity) (fits ?entity ?character) (not (wearing ?character ?entity))) :effect (wearing ?character ?entity))": "(:action wear-item :parameters (?character - character ?entity - (either character object)) :precondition (and (alive ?character) (has ?character ?entity) (fits ?entity ?character) (not (wearing ?character ?entity))) :effect (wearing ?character ?entity))"
    }
