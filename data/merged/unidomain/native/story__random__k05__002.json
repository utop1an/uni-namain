        "bring-to-herenow": "(:action bring-to-herenow\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (not (in-herenow ?master)))\n :effect (in-herenow ?master)\n)",
        "walk": "(:action walk\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (needs-walk ?master))\n :effect (and (not (needs-walk ?master)) (in-herenow ?master))\n)",
        "time-of-passing": "(:action time-of-passing\n :parameters ()\n :precondition (not (time-of-passing))\n :effect (time-of-passing)\n)",
        "enter :parameters (?object - (either box bird) ?place - place) :precondition (not (at ?object ?place)) :effect (at ?object ?place))": "(:action enter :parameters (?object - (either box bird) ?place - place) :precondition (not (at ?object ?place)) :effect (at ?object ?place))",
        "notice :parameters (?entity - character ?target - box ?place - place) :precondition (and (at ?entity ?place) (at ?target ?place)) :effect (noticed ?entity ?target))": "(:action notice :parameters (?entity - character ?target - box ?place - place) :precondition (and (at ?entity ?place) (at ?target ?place)) :effect (noticed ?entity ?target))",
        "open-box :parameters (?character - character ?target - box ?place - place) :precondition (and (at ?character ?place) (at ?target ?place) (noticed ?character ?target) (not (opened ?target))) :effect (opened ?target))": "(:action open-box :parameters (?character - character ?target - box ?place - place) :precondition (and (at ?character ?place) (at ?target ?place) (noticed ?character ?target) (not (opened ?target))) :effect (opened ?target))",
        "remind-ancient-oath :parameters (?g - character ?m - character) :precondition (and (guardian ?g) (master ?m) (ancient-oath ?g)) :effect (needs-walk ?m))": "(:action remind-ancient-oath :parameters (?g - character ?m - character) :precondition (and (guardian ?g) (master ?m) (ancient-oath ?g)) :effect (needs-walk ?m))",
        "fight": "(:action fight\n :parameters (?fighter1 - character ?fighter2 - character)\n :precondition (and (not (= ?fighter1 ?fighter2)) (alive ?fighter1) (has-weapon ?fighter1) (alive ?fighter2) (has-weapon ?fighter2))\n :effect (and)\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (not (alive ?character))\n)",
        "acquire-electronics": "(:action acquire-electronics\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-electronics ?character)))\n :effect (has-electronics ?character)\n)",
        "stop-believing": "(:action stop-believing\n :parameters (?character - character)\n :precondition (and (alive ?character) (believes-in-fairies ?character))\n :effect (not (believes-in-fairies ?character))\n)",
        "start-flying": "(:action start-flying\n :parameters (?bird - bird)\n :precondition (on-ground ?bird)\n :effect (and (not (on-ground ?bird)) (in-sky ?bird))\n)",
        "stop-flying": "(:action stop-flying\n :parameters (?bird - bird)\n :precondition (in-sky ?bird)\n :effect (and (not (in-sky ?bird)) (on-ground ?bird))\n)",
        "make-friends": "(:action make-friends\n :parameters (?bird1 - bird ?bird2 - bird)\n :precondition (and (not (= ?bird1 ?bird2)) (not (friends ?bird1 ?bird2)))\n :effect (friends ?bird1 ?bird2)\n)",
        "become-happy :parameters (?entity - (either bird character)) :precondition (not (happy ?entity)) :effect (happy ?entity))": "(:action become-happy :parameters (?entity - (either bird character)) :precondition (not (happy ?entity)) :effect (happy ?entity))",
        "see-spider": "(:action see-spider\n :parameters (?character - character)\n :precondition (and (not (scared ?character)) (not (spider-on-wall)))\n :effect (and (scared ?character) (spider-on-wall))\n)",
        "remove-spider": "(:action remove-spider\n :parameters (?character - character ?helpee - character)\n :precondition (and (spider-on-wall) (helping ?character ?helpee))\n :effect (not (spider-on-wall))\n)",
        "help :parameters (?supporter - character ?entity - character) :precondition (and (not (= ?supporter ?entity)) (scared ?entity)) :effect (and (not (scared ?entity)) (happy ?entity) (helping ?supporter ?entity)))": "(:action help :parameters (?supporter - character ?entity - character) :precondition (and (not (= ?supporter ?entity)) (scared ?entity)) :effect (and (not (scared ?entity)) (happy ?entity) (helping ?supporter ?entity)))",
        "make-cake :parameters (?entity - (either bird character)) :precondition (and (not (cake-made)) (happy ?entity)) :effect (cake-made))": "(:action make-cake :parameters (?entity - (either bird character)) :precondition (and (not (cake-made)) (happy ?entity)) :effect (cake-made))",
        "travel :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))": "(:action travel :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "move :parameters (?mover - (either character box bird) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (at ?mover ?from)) :effect (and (not (at ?mover ?from)) (at ?mover ?to)))": "(:action move :parameters (?mover - (either character box bird) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (at ?mover ?from)) :effect (and (not (at ?mover ?from)) (at ?mover ?to)))"
