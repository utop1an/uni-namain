    "operators": {
        "start-search": "(:action start-search\n :parameters (?searcher - character ?target - character)\n :precondition (and (not (= ?searcher ?target)) (not (searching ?searcher ?target)) (missing ?target))\n :effect (searching ?searcher ?target)\n)",
        "stop-search": "(:action stop-search\n :parameters (?searcher - character ?target - character)\n :precondition (searching ?searcher ?target)\n :effect (not (searching ?searcher ?target))\n)",
        "find": "(:action find\n :parameters (?searcher - character ?target - character)\n :precondition (and (searching ?searcher ?target) (missing ?target))\n :effect (and (not (missing ?target)) (found ?searcher ?target))\n)",
        "get-stuck :parameters (?entity - character ?place - place) :precondition (and (at ?entity ?place) (not (stuck ?entity ?place))) :effect (stuck ?entity ?place))": "(:action get-stuck :parameters (?entity - character ?place - place) :precondition (and (at ?entity ?place) (not (stuck ?entity ?place))) :effect (stuck ?entity ?place))",
        "help :parameters (?helping_entity - character ?helped_character - character ?location - place) :precondition (and (not (= ?helping_entity ?helped_character)) (at ?helping_entity ?location) (stuck ?helped_character ?location)) :effect (and (not (stuck ?helped_character ?location)) (helped ?helping_entity ?helped_character)))": "(:action help :parameters (?helping_entity - character ?helped_character - character ?location - place) :precondition (and (not (= ?helping_entity ?helped_character)) (at ?helping_entity ?location) (stuck ?helped_character ?location)) :effect (and (not (stuck ?helped_character ?location)) (helped ?helping_entity ?helped_character)))",
        "start-relationship :parameters (?initiator - character ?partner - character) :precondition (and (not (= ?initiator ?partner)) (not (relationship ?initiator ?partner)) (knows ?initiator ?partner)) :effect (relationship ?initiator ?partner))": "(:action start-relationship :parameters (?initiator - character ?partner - character) :precondition (and (not (= ?initiator ?partner)) (not (relationship ?initiator ?partner)) (knows ?initiator ?partner)) :effect (relationship ?initiator ?partner))",
        "end-relationship :parameters (?initiator - character ?partner - character) :precondition (relationship ?initiator ?partner) :effect (not (relationship ?initiator ?partner)))": "(:action end-relationship :parameters (?initiator - character ?partner - character) :precondition (relationship ?initiator ?partner) :effect (not (relationship ?initiator ?partner)))",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - item)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "clean-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (clean ?object))) :effect (clean ?object))": "(:action clean-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (clean ?object))) :effect (clean ?object))",
        "adjust-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (fits ?object ?character))) :effect (fits ?object ?character))": "(:action adjust-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (fits ?object ?character))) :effect (fits ?object ?character))",
        "wear-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (fits ?object ?character) (not (wearing ?character ?object))) :effect (wearing ?character ?object))": "(:action wear-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (fits ?object ?character) (not (wearing ?character ?object))) :effect (wearing ?character ?object))",
        "start-flying": "(:action start-flying\n :parameters (?bird - bird)\n :precondition (on-ground ?bird)\n :effect (and (not (on-ground ?bird)) (in-sky ?bird))\n)",
        "stop-flying": "(:action stop-flying\n :parameters (?bird - bird)\n :precondition (in-sky ?bird)\n :effect (and (not (in-sky ?bird)) (on-ground ?bird))\n)",
        "become-happy": "(:action become-happy\n :parameters (?bird - bird)\n :precondition (not (happy ?bird))\n :effect (happy ?bird)\n)",
        "move": "(:action move :parameters (?entity - (either character bird) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))",
        "walk :parameters (?character - character ?origin ?destination - house) :precondition (and (alive ?character) (at ?character ?origin) (not (eaten ?character))) :effect (and (not (at ?character ?origin)) (at ?character ?destination) (when (and (rescuer ?character)) (and (rescuer-at ?destination) (not (rescuer-at ?origin))))))": "(:action walk :parameters (?character - character ?origin ?destination - house) :precondition (and (alive ?character) (at ?character ?origin) (not (eaten ?character))) :effect (and (not (at ?character ?origin)) (at ?character ?destination) (when (and (rescuer ?character)) (and (rescuer-at ?destination) (not (rescuer-at ?origin))))))",
        "eat :parameters (?eater - wolf ?character - character ?place - place) :precondition (and (alive ?eater) (alive ?character) (not (eaten ?character)) (at ?eater ?place) (at ?character ?place) (monster ?eater)) :effect (and (eaten ?character)))": "(:action eat :parameters (?eater - wolf ?character - character ?place - place) :precondition (and (alive ?eater) (alive ?character) (not (eaten ?character)) (at ?eater ?place) (at ?character ?place) (monster ?eater)) :effect (and (eaten ?character)))",
        "escape :parameters (?person - human ?character - character ?place - place) :precondition (and (eaten ?person) (not (alive ?character)) (at ?character ?place)) :effect (and (not (eaten ?person)) (rescued ?person) (at ?person ?place)))": "(:action escape :parameters (?person - human ?character - character ?place - place) :precondition (and (eaten ?person) (not (alive ?character)) (at ?character ?place)) :effect (and (not (eaten ?person)) (rescued ?person) (at ?person ?place)))",
        "kill :parameters (?character - character ?wolf - wolf ?object - (either item thing) ?location - place) :precondition (and (alive ?character) (alive ?wolf) (has ?character ?object) (at ?character ?location) (at ?wolf ?location) (monster ?wolf) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?wolf)) (not (monster-alive))))": "(:action kill :parameters (?character - character ?wolf - wolf ?object - (either item thing) ?location - place) :precondition (and (alive ?character) (alive ?wolf) (has ?character ?object) (at ?character ?location) (at ?wolf ?location) (monster ?wolf) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?wolf)) (not (monster-alive))))",
        "give :parameters (?giver_character ?receiver_character - character ?object - (either item thing) ?place - place) :precondition (and (not (eaten ?receiver_character)) (alive ?giver_character) (alive ?receiver_character) (has ?giver_character ?object) (at ?giver_character ?place) (at ?receiver_character ?place)) :effect (and (has ?receiver_character ?object) (not (has ?giver_character ?object))))": "(:action give :parameters (?giver_character ?receiver_character - character ?object - (either item thing) ?place - place) :precondition (and (not (eaten ?receiver_character)) (alive ?giver_character) (alive ?receiver_character) (has ?giver_character ?object) (at ?giver_character ?place) (at ?receiver_character ?place)) :effect (and (has ?receiver_character ?object) (not (has ?giver_character ?object))))",
        "become-friends": "(:action become-friends :parameters (?entity1 - character ?entity2 - character) :precondition (and (not (= ?entity1 ?entity2)) (not (friends ?entity1 ?entity2)) (helped ?entity1 ?entity2)) :effect (friends ?entity1 ?entity2))"
