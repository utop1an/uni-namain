{
    "predicates": {
        "(alive ?creature - creature)": "Source predicate (alive ?creature - creature).",
        "(single ?person - person)": "Source predicate (single ?person - person).",
        "(rich ?creature - creature)": "Source predicate (rich ?creature - creature).",
        "(happy ?creature - creature)": "Source predicate (happy ?creature - creature).",
        "(hungry ?creature - creature)": "Source predicate (hungry ?creature - creature).",
        "(at ?object - object ?place - place)": "Source predicate (at ?object - object ?place - place).",
        "(has ?creature - creature ?item - item)": "Source predicate (has ?creature - creature ?item - item).",
        "(belongsto ?item - item ?creature - creature)": "Source predicate (belongsto ?item - item ?creature - creature).",
        "(loves ?lover - creature ?love - creature)": "Source predicate (loves ?lover - creature ?love - creature).",
        "(hasproposed ?proposer - person ?proposee - person)": "Source predicate (hasproposed ?proposer - person ?proposee - person).",
        "(hasaccepted ?person1 - person ?person2 - person)": "Source predicate (hasaccepted ?person1 - person ?person2 - person).",
        "(marriedto ?person1 - person ?person2 - person)": "Source predicate (marriedto ?person1 - person ?person2 - person).",
        "(reading ?character - character)": "Source predicate (reading ?character - character).",
        "(playing ?character - character)": "Source predicate (playing ?character - character).",
        "(calm ?character - character)": "Source predicate (calm ?character - character).",
        "(books-fall)": "Source predicate (books-fall).",
        "(friends ?c1 - character ?c2 - character)": "Source predicate (friends ?c1 - character ?c2 - character).",
        "(kind ?character - character)": "Source predicate (kind ?character - character).",
        "(knows-wisdom ?character - character)": "Source predicate (knows-wisdom ?character - character).",
        "(lost ?character - character)": "Source predicate (lost ?character - character).",
        "(found ?character - character)": "Source predicate (found ?character - character).",
        "(in ?item - item ?room - room)": "Source predicate (in ?item - item ?room - room).",
        "(occupied ?item - item)": "Source predicate (occupied ?item - item).",
        "(plugged-in ?item - item)": "Source predicate (plugged-in ?item - item).",
        "(connected ?item1 - item ?item2 - item)": "Source predicate (connected ?item1 - item ?item2 - item).",
        "(well-lit ?room - room)": "Source predicate (well-lit ?room - room).",
        "(morning)": "Source predicate (morning)."
    },
    "operators": {
        "travel": "(:action travel\n :parameters (?creature - creature ?from - place ?to - place)\n :precondition (and (alive ?creature) (at ?creature ?from))\n :effect (and (at ?creature ?to) (not (at ?creature ?from)))\n)",
        "propose": "(:action propose\n :parameters (?proposer - person ?proposee - person ?place - place)\n :precondition (and (alive ?proposer) (at ?proposer ?place) (alive ?proposee) (at ?proposee ?place) (loves ?proposer ?proposee))\n :effect (hasproposed ?proposer ?proposee)\n)",
        "accept": "(:action accept\n :parameters (?accepter - person ?proposer - person ?place - place)\n :precondition (and (alive ?accepter) (at ?accepter ?place) (alive ?proposer) (at ?proposer ?place) (hasproposed ?proposer ?accepter))\n :effect (hasaccepted ?accepter ?proposer)\n)",
        "marry": "(:action marry\n :parameters (?groom - person ?bride - person ?place - place)\n :precondition (and (alive ?groom) (at ?groom ?place) (hasproposed ?groom ?bride) (single ?groom) (alive ?bride) (at ?bride ?place) (hasaccepted ?bride ?groom) (single ?bride))\n :effect (and (marriedto ?groom ?bride) (marriedto ?bride ?groom) (not (single ?groom)) (not (single ?bride)) (forall (?v - valuable) (when (has ?groom ?v) (rich ?bride))) (when (loves ?groom ?bride) (happy ?groom)) (when (loves ?bride ?groom) (happy ?bride)))\n)",
        "steal": "(:action steal\n :parameters (?thief - creature ?victim - creature ?item - item ?place - place)\n :precondition (and (not (= ?thief ?victim)) (alive ?thief) (at ?thief ?place) (at ?item ?place) (belongsto ?item ?victim))\n :effect (and (has ?thief ?item) (when (forall (?v - valuable) (not (has ?victim ?v))) (not (rich ?victim))))\n)",
        "get-hungry": "(:action get-hungry\n :parameters (?creature - creature)\n :precondition (not (hungry ?creature))\n :effect (and (hungry ?creature))\n)",
        "eat": "(:action eat\n :parameters (?monster - monster ?creature - creature ?place - place)\n :precondition (and (alive ?monster) (at ?monster ?place) (hungry ?monster) (alive ?creature) (at ?creature ?place))\n :effect (and (not (hungry ?monster)) (not (alive ?creature)) (not (rich ?creature)) (not (happy ?creature)))\n)",
        "start-reading": "(:action start-reading\n :parameters (?character - character)\n :precondition (not (reading ?character))\n :effect (reading ?character)\n)",
        "stop-reading": "(:action stop-reading\n :parameters (?character - character)\n :precondition (reading ?character)\n :effect (not (reading ?character))\n)",
        "start-playing": "(:action start-playing\n :parameters (?character - character)\n :precondition (not (playing ?character))\n :effect (playing ?character)\n)",
        "stop-playing": "(:action stop-playing\n :parameters (?character - character)\n :precondition (playing ?character)\n :effect (not (playing ?character))\n)",
        "become-calm": "(:action become-calm\n :parameters (?character - character)\n :precondition (not (calm ?character))\n :effect (calm ?character)\n)",
        "become-uncalm": "(:action become-uncalm\n :parameters (?character - character)\n :precondition (calm ?character)\n :effect (not (calm ?character))\n)",
        "books-fall": "(:action books-fall\n :parameters ()\n :precondition (not (books-fall))\n :effect (books-fall)\n)",
        "become-kind": "(:action become-kind\n :parameters (?character - character)\n :precondition (not (kind ?character))\n :effect (kind ?character)\n)",
        "learn-wisdom": "(:action learn-wisdom\n :parameters (?learner - character ?teacher - character)\n :precondition (and (not (knows-wisdom ?learner)) (knows-wisdom ?teacher))\n :effect (knows-wisdom ?learner)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and (kind ?helper) (lost ?helpee))\n :effect (found ?helpee)\n)",
        "become-friends": "(:action become-friends\n :parameters (?c1 - character ?c2 - character)\n :precondition (and (not (friends ?c1 ?c2)) (not (= ?c1 ?c2)))\n :effect (friends ?c1 ?c2)\n)",
        "move-item": "(:action move-item\n :parameters (?item - item ?from - room ?to - room)\n :precondition (and (not (= ?from ?to)) (in ?item ?from))\n :effect (and (not (in ?item ?from)) (in ?item ?to))\n)",
        "plug-in": "(:action plug-in\n :parameters (?item - item)\n :precondition (not (plugged-in ?item))\n :effect (plugged-in ?item)\n)",
        "connect": "(:action connect\n :parameters (?item1 - item ?item2 - item)\n :precondition (and (not (connected ?item1 ?item2)) (not (= ?item1 ?item2)))\n :effect (connected ?item1 ?item2)\n)",
        "morning-comes": "(:action morning-comes\n :parameters (?room - room)\n :precondition (and (not (well-lit ?room)) (morning))\n :effect (well-lit ?room)\n)",
        "night-falls": "(:action night-falls\n :parameters (?room - room)\n :precondition (and (well-lit ?room) (not (morning)))\n :effect (not (well-lit ?room))\n)",
        "occupy": "(:action occupy\n :parameters (?item - item)\n :precondition (not (occupied ?item))\n :effect (occupied ?item)\n)",
        "unoccupy": "(:action unoccupy\n :parameters (?item - item)\n :precondition (occupied ?item)\n :effect (not (occupied ?item))\n)"
    }
}