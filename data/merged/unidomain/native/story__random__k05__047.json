{
    "predicates": {
        "(has-swing ?character - character)": "Source predicate (has-swing ?character - character).",
        "(playing-together ?character1 - character ?character2 - character)": "Source predicate (playing-together ?character1 - character ?character2 - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(assembled ?robot - robot)": "Source predicate (assembled ?robot - robot).",
        "(has-robot ?character - character ?robot - robot)": "Source predicate (has-robot ?character - character ?robot - robot).",
        "(working-on-task ?robot - robot)": "Source predicate (working-on-task ?robot - robot).",
        "(playing-game ?character - character)": "Source predicate (playing-game ?character - character).",
        "(at ?entity - (either character society) ?location - object)": "The character or society is located at the specified location, which may be a planet.",
        "(has-technology ?society - society ?technology - technology)": "Source predicate (has-technology ?society - society ?technology - technology).",
        "(in-habitable-zone ?planet - planet)": "Source predicate (in-habitable-zone ?planet - planet).",
        "(in-high-wind-zone ?planet - planet)": "Source predicate (in-high-wind-zone ?planet - planet).",
        "(in-low-wind-zone ?planet - planet)": "Source predicate (in-low-wind-zone ?planet - planet).",
        "(explored ?society - society ?planet - planet)": "Source predicate (explored ?society - society ?planet - planet).",
        "(at-party ?character - character)": "Source predicate (at-party ?character - character).",
        "(has ?character - character ?object - object)": "Source predicate (has ?character - character ?object - object).",
        "(fast ?character - character)": "Source predicate (fast ?character - character).",
        "(cake-transformed)": "Source predicate (cake-transformed).",
        "(in-drawer ?toy - toy)": "Source predicate (in-drawer ?toy - toy).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(friends ?character - character ?toy - toy)": "Source predicate (friends ?character - character ?toy - toy).",
        "(wants-to-take ?character - character ?toy - toy)": "Source predicate (wants-to-take ?character - character ?toy - toy).",
        "(brave ?character - character)": "Source predicate (brave ?character - character).",
        "(at ?society - society ?planet - planet)": "The character or society is located at the specified location, which may be a planet."
    },
    "operators": {
        "invite": "(:action invite\n :parameters (?inviter - character ?invitee - character)\n :precondition (and (not (= ?inviter ?invitee)) (has-swing ?inviter))\n :effect (playing-together ?inviter ?invitee)\n)",
        "play-on-swing": "(:action play-on-swing\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (playing-together ?character1 ?character2))\n :effect (and (happy ?character1) (happy ?character2))\n)",
        "start-task": "(:action start-task\n :parameters (?robot - robot)\n :precondition (and (assembled ?robot) (not (working-on-task ?robot)))\n :effect (working-on-task ?robot)\n)",
        "stop-game": "(:action stop-game\n :parameters (?character - character)\n :precondition (playing-game ?character)\n :effect (not (playing-game ?character))\n)",
        "assemble :parameters (?entity - character ?robot - robot) :precondition (and (at ?entity garage) (not (assembled ?robot))) :effect (and (assembled ?robot) (has-robot ?entity ?robot)))": "(:action assemble :parameters (?entity - character ?robot - robot) :precondition (and (at ?entity garage) (not (assembled ?robot))) :effect (and (assembled ?robot) (has-robot ?entity ?robot)))",
        "play-game :parameters (?entity - character) :precondition (and (at ?entity house) (not (playing-game ?entity))) :effect (playing-game ?entity))": "(:action play-game :parameters (?entity - character) :precondition (and (at ?entity house) (not (playing-game ?entity))) :effect (playing-game ?entity))",
        "develop-technology": "(:action develop-technology\n :parameters (?society - society ?technology - technology)\n :precondition (and)\n :effect (has-technology ?society ?technology)\n)",
        "find-toy": "(:action find-toy\n :parameters (?character - character ?toy - toy)\n :precondition (in-drawer ?toy)\n :effect (and (not (in-drawer ?toy)) (friends ?character ?toy))\n)",
        "want-to-take": "(:action want-to-take\n :parameters (?taker - character ?toy - toy ?owner - character)\n :precondition (and (not (= ?taker ?owner)) (friends ?owner ?toy))\n :effect (wants-to-take ?taker ?toy)\n)",
        "stand-up": "(:action stand-up\n :parameters (?defender - character ?taker - character ?toy - toy)\n :precondition (and (not (= ?defender ?taker)) (wants-to-take ?taker ?toy) (friends ?defender ?toy))\n :effect (and (not (wants-to-take ?taker ?toy)) (brave ?defender))\n)",
        "explore :parameters (?entity - society ?location - planet ?technology - technology) :precondition (and (at ?entity ?location) (has-technology ?entity ?technology) (or (in-habitable-zone ?location) (in-high-wind-zone ?location) (in-low-wind-zone ?location))) :effect (explored ?entity ?location))": "(:action explore :parameters (?entity - society ?location - planet ?technology - technology) :precondition (and (at ?entity ?location) (has-technology ?entity ?technology) (or (in-habitable-zone ?location) (in-high-wind-zone ?location) (in-low-wind-zone ?location))) :effect (explored ?entity ?location))",
        "move :parameters (?entity - society ?origin - object ?destination - planet ?technology - technology) :precondition (and (at ?entity ?origin) (has-technology ?entity ?technology) (or (in-habitable-zone ?destination) (in-high-wind-zone ?destination) (in-low-wind-zone ?destination))) :effect (and (not (at ?entity ?origin)) (at ?entity ?destination)))": "(:action move :parameters (?entity - society ?origin - object ?destination - planet ?technology - technology) :precondition (and (at ?entity ?origin) (has-technology ?entity ?technology) (or (in-habitable-zone ?destination) (in-high-wind-zone ?destination) (in-low-wind-zone ?destination))) :effect (and (not (at ?entity ?origin)) (at ?entity ?destination)))",
        "go-to-party :parameters (?entity - character) :precondition (not (at-party ?entity)) :effect (at-party ?entity))": "(:action go-to-party :parameters (?entity - character) :precondition (not (at-party ?entity)) :effect (at-party ?entity))",
        "magic-trick :parameters (?performer - character) :precondition (and (at-party ?performer) (not (cake-transformed))) :effect (cake-transformed))": "(:action magic-trick :parameters (?performer - character) :precondition (and (at-party ?performer) (not (cake-transformed))) :effect (cake-transformed))",
        "eat-cake :parameters (?entity - character) :precondition (and (at-party ?entity) (cake-transformed)) :effect (fast ?entity))": "(:action eat-cake :parameters (?entity - character) :precondition (and (at-party ?entity) (cake-transformed)) :effect (fast ?entity))",
        "play :parameters (?entity - character) :precondition (and (at-party ?entity) (fast ?entity)) :effect (and))": "(:action play :parameters (?entity - character) :precondition (and (at-party ?entity) (fast ?entity)) :effect (and))"
    }
}