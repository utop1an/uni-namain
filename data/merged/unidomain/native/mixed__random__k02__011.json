    "operators": {
        "arrest": "(:action arrest\n :parameters (?s - sheriff ?p - person ?l - place)\n :precondition (and (at ?s ?l) (at ?p ?l) (done-crime ?p) (not (arrested ?p)) (thecriminal ?p) (not (criminal-arrested)) (thearrester ?s))\n :effect (and (arrested ?p) (criminal-arrested))\n)",
        "repair-house": "(:action repair-house\n :parameters (?p - person)\n :precondition (and (alive ?p))\n :effect (and (winter-proofed-house))\n)",
        "prepare-for-winter": "(:action prepare-for-winter\n :parameters (?p - person)\n :precondition (and (autumn) (alive ?p) (winter-proofed-house) (has-firewood ?p))\n :effect (and (prepared-for-winter))\n)",
        "turn-into-winter": "(:action turn-into-winter\n :parameters ()\n :precondition (and (autumn) (prepared-for-winter))\n :effect (and (not (autumn)) (winter))\n)",
        "live-through-winter": "(:action live-through-winter\n :parameters (?p ?f - person)\n :precondition (and (winter) (family ?p ?f) (healthy ?f))\n :effect (and (not (winter)) (spring))\n)",
        "survived": "(:action survived\n :parameters (?p - rancher ?f - person)\n :precondition (and (spring) (thefarmchar ?p) (alive ?p) (family ?p ?f) (alive ?f))\n :effect (and (survived-winter))\n)",
        "travel": "(:action travel\n :parameters (?person - person ?from - place ?to - place)\n :precondition (and (not (= ?to thecity)) (not (= ?to ?from)) (alive ?person) (healthy ?person) (not (arrested ?person)) (at ?person ?from))\n :effect (and (at ?person ?to) (not (at ?person ?from)))\n)",
        "travel-to-city": "(:action travel-to-city\n :parameters (?p - person ?f ?t - place)\n :precondition (and (= ?t thecity) (not (= ?t ?f)) (has-ticket ?p) (alive ?p) (at ?p ?f) (themover ?p) (decided-move-city))\n :effect (and (moved-to-city) (at ?p ?t) (not (at ?p ?t)))\n)",
        "sell-land": "(:action sell-land\n :parameters (?p1 - rancher ?p2 - person ?l - place)\n :precondition (and (owns ?p1 ?l) (wants ?p2 ?l) (has-cash ?p2) (decided-move-city))\n :effect (and (has-cash ?p1) (not (has-cash ?p2)) (owns ?p2 ?l) (not (owns ?p1 ?l)))\n)",
        "decide-to-move-to-city": "(:action decide-to-move-to-city\n :parameters (?p - rancher ?l - place)\n :precondition (and (at ?p ?l) (themover ?p))\n :effect (and (decided-move-city))\n)",
        "buy-ticket": "(:action buy-ticket\n :parameters (?p ?r - person ?l - place)\n :precondition (and (has-cash ?p) (= ?r railwaydeveloper))\n :effect (and (has-ticket ?p) (not (has-cash ?p)) (has-cash ?r))\n)",
        "steal-cash": "(:action steal-cash\n :parameters (?p1 ?p2 - person ?l - place)\n :precondition (and (at ?p1 ?l) (at ?p2 ?l) (has-cash ?p2) (thecriminal ?p1))\n :effect (and (has-cash ?p1) (not (has-cash ?p2)) (done-crime ?p1) (crime-done))\n)",
        "steal-medicine": "(:action steal-medicine\n :parameters (?p - person ?l - place)\n :precondition (and (at ?p ?l) (theinvalid ?p) (invalid-unwell) (not (has-cash ?p)))\n :effect (and (has-medicine ?p))\n)",
        "steal-firewood": "(:action steal-firewood\n :parameters (?p1 ?p2 - person)\n :precondition (and (has-firewood ?p2))\n :effect (and (not (has-firewood ?p2)))\n)",
        "chop-wood": "(:action chop-wood\n :parameters (?p - person)\n :precondition (and (not (has-firewood ?p)))\n :effect (and (has-firewood ?p))\n)",
        "get-snake-bite": "(:action get-snake-bite\n :parameters (?v - person)\n :precondition (and (healthy ?v) (theinvalid ?v))\n :effect (and (not (healthy ?v)) (invalid-unwell) (not (invalid-recovered)))\n)",
        "get-medicine": "(:action get-medicine\n :parameters (?p ?h - person ?l - place)\n :precondition (and (has-cash ?p) (not (has-medicine ?p)) (has-medicine ?h) (at ?p ?l) (at ?h ?l))\n :effect (and (has-medicine ?p) (not (has-cash ?p)) (has-cash ?h) (not (has-medicine ?h)))\n)",
        "heal": "(:action heal\n :parameters (?h - rancher)\n :precondition (and (has-medicine ?h) (not (healthy ?h)) (theinvalid ?h) (invalid-unwell))\n :effect (and (healthy ?h) (not (has-medicine ?h)) (recovered ?h) (not (invalid-unwell)) (invalid-recovered))\n)",
        "recover": "(:action recover\n :parameters (?p - person)\n :precondition (and (not (= ?p thefarmer)) (has-medicine ?p) (not (healthy ?p)) (theinvalid ?p) (invalid-unwell))\n :effect (and (healthy ?p) (not (has-medicine ?p)) (recovered ?p) (not (invalid-unwell)) (invalid-recovered))\n)",
        "talk": "(:action talk\n :parameters (?a - character ?b - character)\n :precondition (and (not (= ?a ?b)) (friend ?a ?b))\n :effect (talks-to ?a ?b)\n)",
        "provide-help": "(:action provide-help\n :parameters (?a - character ?b - character)\n :precondition (and (not (= ?a ?b)) (friend ?a ?b) (needs-help ?b) (talks-to ?a ?b))\n :effect (provides-help ?a ?b)\n)",
        "start-smiling": "(:action start-smiling\n :parameters (?character - character ?a - character)\n :precondition (and (not (smiling ?character)) (provides-help ?a ?character))\n :effect (smiling ?character)\n)",
        "start-laughing": "(:action start-laughing\n :parameters (?character - character ?a - character)\n :precondition (and (not (laughing ?character)) (provides-help ?a ?character))\n :effect (laughing ?character)\n)"
