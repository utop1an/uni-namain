        "(has ?character - character ?cap - cap)": "The character has a target that is either another character or a cap.",
        "(at ?character - character ?place - place)": "The specified society or character is at the specified planet or place."
    },
    "operators": {
        "develop-technology": "(:action develop-technology\n :parameters (?society - society ?technology - technology)\n :precondition (and)\n :effect (has-technology ?society ?technology)\n)",
        "explore :parameters (?entity - society ?location - planet ?technology - technology) :precondition (and (at ?entity ?location) (has-technology ?entity ?technology) (or (in-habitable-zone ?location) (in-high-wind-zone ?location) (in-low-wind-zone ?location))) :effect (explored ?entity ?location))": "(:action explore :parameters (?entity - society ?location - planet ?technology - technology) :precondition (and (at ?entity ?location) (has-technology ?entity ?technology) (or (in-habitable-zone ?location) (in-high-wind-zone ?location) (in-low-wind-zone ?location))) :effect (explored ?entity ?location))",
        "move :parameters (?entity - society ?source - (either planet place) ?destination - planet ?technology - technology) :precondition (and (at ?entity ?source) (has-technology ?entity ?technology) (or (in-habitable-zone ?destination) (in-high-wind-zone ?destination) (in-low-wind-zone ?destination))) :effect (and (not (at ?entity ?source)) (at ?entity ?destination)))": "(:action move :parameters (?entity - society ?source - (either planet place) ?destination - planet ?technology - technology) :precondition (and (at ?entity ?source) (has-technology ?entity ?technology) (or (in-habitable-zone ?destination) (in-high-wind-zone ?destination) (in-low-wind-zone ?destination))) :effect (and (not (at ?entity ?source)) (at ?entity ?destination)))",
        "find :parameters (?character - character ?target - cap) :precondition (and (lost ?character ?target) (forall (?place - place) (searched ?character ?place))) :effect (and (found ?character ?target) (not (lost ?character ?target)) (has ?character ?target)))": "(:action find :parameters (?character - character ?target - cap) :precondition (and (lost ?character ?target) (forall (?place - place) (searched ?character ?place))) :effect (and (found ?character ?target) (not (lost ?character ?target)) (has ?character ?target)))",
        "lose": "(:action lose\n :parameters (?character - character ?target - cap)\n :precondition (has ?character ?target)\n :effect (and (lost ?character ?target) (not (has ?character ?target)))\n)",
        "replace :parameters (?character - character ?old-cap - cap ?new-target - (either character cap)) :precondition (and (found ?character ?old-cap) (not (has ?character ?old-cap)) (has ?character ?new-target)) :effect (and (not (found ?character ?old-cap)) (has ?character ?old-cap) (not (has ?character ?new-target))))": "(:action replace :parameters (?character - character ?old-cap - cap ?new-target - (either character cap)) :precondition (and (found ?character ?old-cap) (not (has ?character ?old-cap)) (has ?character ?new-target)) :effect (and (not (found ?character ?old-cap)) (has ?character ?old-cap) (not (has ?character ?new-target))))",
        "move-location :parameters (?entity - (either society character) ?destination - (either planet place) ?origin - (either planet place)) :precondition (and (player ?entity) (connected ?destination ?origin) (at ?entity ?origin) (knows ?entity)) :effect (and (not (at ?entity ?origin)) (at ?entity ?destination)))": "(:action move-location :parameters (?entity - (either society character) ?destination - (either planet place) ?origin - (either planet place)) :precondition (and (player ?entity) (connected ?destination ?origin) (at ?entity ?origin) (knows ?entity)) :effect (and (not (at ?entity ?origin)) (at ?entity ?destination)))",
        "interrogate-character :parameters (?actor - character ?target - character ?location - (either planet place)) :precondition (and (player ?actor) (at ?actor ?location) (at ?target ?location) (apprehended ?target)) :effect (knows ?actor))": "(:action interrogate-character :parameters (?actor - character ?target - character ?location - (either planet place)) :precondition (and (player ?actor) (at ?actor ?location) (at ?target ?location) (apprehended ?target)) :effect (knows ?actor))",
        "save-character :parameters (?rescuer - character ?rescued - character ?other - character ?location - (either planet place)) :precondition (and (player ?rescuer) (at ?rescuer ?location) (at ?rescued ?location) (captured ?rescued) (captured ?other) (not (at ?other ?location))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?other - character ?location - (either planet place)) :precondition (and (player ?rescuer) (at ?rescuer ?location) (at ?rescued ?location) (captured ?rescued) (captured ?other) (not (at ?other ?location))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))",
        "place-victim :parameters (?acting-character - character ?target - character ?source - (either planet place) ?destination - (either planet place)) :precondition (and (henchman ?acting-character) (has ?acting-character ?target) (at ?acting-character ?source) (connected ?destination ?source)) :effect (and (not (has ?acting-character ?target)) (at ?target ?destination) (captured ?target)))": "(:action place-victim :parameters (?acting-character - character ?target - character ?source - (either planet place) ?destination - (either planet place)) :precondition (and (henchman ?acting-character) (has ?acting-character ?target) (at ?acting-character ?source) (connected ?destination ?source)) :effect (and (not (has ?acting-character ?target)) (at ?target ?destination) (captured ?target)))",
        "search :parameters (?entity - (either society character) ?cap - cap ?location - (either planet place)) :precondition (and (at ?entity ?location) (lost ?entity ?cap)) :effect (searched ?entity ?location))": "(:action search :parameters (?entity - (either society character) ?cap - cap ?location - (either planet place)) :precondition (and (at ?entity ?location) (lost ?entity ?cap)) :effect (searched ?entity ?location))"
    }
