{
    "predicates": {
        "(has-technology ?society - society ?technology - technology)": "Source predicate (has-technology ?society - society ?technology - technology).",
        "(in-habitable-zone ?planet - planet)": "Source predicate (in-habitable-zone ?planet - planet).",
        "(in-high-wind-zone ?planet - planet)": "Source predicate (in-high-wind-zone ?planet - planet).",
        "(in-low-wind-zone ?planet - planet)": "Source predicate (in-low-wind-zone ?planet - planet).",
        "(explored ?society - society ?planet - planet)": "Source predicate (explored ?society - society ?planet - planet).",
        "(at ?entity - (either society character) ?location - (either planet place))": "The specified society or character is at the specified planet or place.",
        "(player ?character - character)": "Source predicate (player ?character - character).",
        "(connected ?to - location ?from - location)": "Source predicate (connected ?to - location ?from - location).",
        "(apprehended ?character - character)": "Source predicate (apprehended ?character - character).",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(saved ?saved - character ?saver - character)": "Source predicate (saved ?saved - character ?saver - character).",
        "(knows ?character - character)": "Source predicate (knows ?character - character).",
        "(captured ?character - character)": "Source predicate (captured ?character - character).",
        "(henchman ?henchman - character)": "Source predicate (henchman ?henchman - character).",
        "(at ?character - character ?location - location)": "The character is at the specified location.",
        "(has ?character - character ?target - (either character cap))": "The character has a target that is either another character or a cap.",
        "(lost ?character - character ?cap - cap)": "Source predicate (lost ?character - character ?cap - cap).",
