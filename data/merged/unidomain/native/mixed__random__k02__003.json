        "accept :parameters (?accepter - person ?proposer - person ?location - location) :precondition (and (alive ?accepter) (at ?accepter ?location) (alive ?proposer) (at ?proposer ?location) (hasproposed ?proposer ?accepter)) :effect (hasaccepted ?accepter ?proposer))": "(:action accept :parameters (?accepter - person ?proposer - person ?location - location) :precondition (and (alive ?accepter) (at ?accepter ?location) (alive ?proposer) (at ?proposer ?location) (hasproposed ?proposer ?accepter)) :effect (hasaccepted ?accepter ?proposer))",
        "steal :parameters (?thief - creature ?victim - creature ?item - item ?location - location) :precondition (and (not (= ?thief ?victim)) (alive ?thief) (at ?thief ?location) (at ?item ?location) (belongsto ?item ?victim)) :effect (and (has ?thief ?item) (when (forall (?v - valuable) (not (has ?victim ?v))) (not (rich ?victim)))))": "(:action steal :parameters (?thief - creature ?victim - creature ?item - item ?location - location) :precondition (and (not (= ?thief ?victim)) (alive ?thief) (at ?thief ?location) (at ?item ?location) (belongsto ?item ?victim)) :effect (and (has ?thief ?item) (when (forall (?v - valuable) (not (has ?victim ?v))) (not (rich ?victim)))))",
        "get-hungry :parameters (?c - creature) :precondition (not (hungry ?c)) :effect (and (hungry ?c)))": "(:action get-hungry :parameters (?c - creature) :precondition (not (hungry ?c)) :effect (and (hungry ?c)))",
        "marry :parameters (?groom_entity - person ?bride_entity - person ?location - location) :precondition (and (alive ?groom_entity) (at ?groom_entity ?location) (hasproposed ?groom_entity ?bride_entity) (single ?groom_entity) (alive ?bride_entity) (at ?bride_entity ?location) (hasaccepted ?bride_entity ?groom_entity) (single ?bride_entity)) :effect (and (marriedto ?groom_entity ?bride_entity) (marriedto ?bride_entity ?groom_entity) (not (single ?groom_entity)) (not (single ?bride_entity)) (forall (?v - valuable) (when (has ?groom_entity ?v) (rich ?bride_entity))) (when (loves ?groom_entity ?bride_entity) (happy ?groom_entity)) (when (loves ?bride_entity ?groom_entity) (happy ?bride_entity))))": "(:action marry :parameters (?groom_entity - person ?bride_entity - person ?location - location) :precondition (and (alive ?groom_entity) (at ?groom_entity ?location) (hasproposed ?groom_entity ?bride_entity) (single ?groom_entity) (alive ?bride_entity) (at ?bride_entity ?location) (hasaccepted ?bride_entity ?groom_entity) (single ?bride_entity)) :effect (and (marriedto ?groom_entity ?bride_entity) (marriedto ?bride_entity ?groom_entity) (not (single ?groom_entity)) (not (single ?bride_entity)) (forall (?v - valuable) (when (has ?groom_entity ?v) (rich ?bride_entity))) (when (loves ?groom_entity ?bride_entity) (happy ?groom_entity)) (when (loves ?bride_entity ?groom_entity) (happy ?bride_entity))))",
        "eat :parameters (?monster - monster ?entity - creature ?location - location) :precondition (and (alive ?monster) (at ?monster ?location) (hungry ?monster) (alive ?entity) (at ?entity ?location)) :effect (and (not (hungry ?monster)) (not (alive ?entity)) (not (rich ?entity)) (not (happy ?entity))))": "(:action eat :parameters (?monster - monster ?entity - creature ?location - location) :precondition (and (alive ?monster) (at ?monster ?location) (hungry ?monster) (alive ?entity) (at ?entity ?location)) :effect (and (not (hungry ?monster)) (not (alive ?entity)) (not (rich ?entity)) (not (happy ?entity))))",
        "stop-playing": "(:action stop-playing\n :parameters (?character - character ?animal - animal)\n :precondition (playing ?character ?animal)\n :effect (not (playing ?character ?animal))\n)",
        "can-run": "(:action can-run\n :parameters (?character - character)\n :precondition (and)\n :effect (can-run ?character)\n)",
