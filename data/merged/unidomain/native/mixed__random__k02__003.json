    "operators": {
        "travel :parameters (?creature - creature ?from_location - location ?to_location - location) :precondition (and (alive ?creature) (at ?creature ?from_location)) :effect (and (at ?creature ?to_location) (not (at ?creature ?from_location))))": "(:action travel :parameters (?creature - creature ?from_location - location ?to_location - location) :precondition (and (alive ?creature) (at ?creature ?from_location)) :effect (and (at ?creature ?to_location) (not (at ?creature ?from_location))))",
