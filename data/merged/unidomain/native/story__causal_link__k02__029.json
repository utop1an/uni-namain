{
    "predicates": {
        "(lost ?character - character ?cap - cap)": "Source predicate (lost ?character - character ?cap - cap).",
        "(searched ?character - character ?place - place)": "Source predicate (searched ?character - character ?place - place).",
        "(found ?character - character ?cap - cap)": "Source predicate (found ?character - character ?cap - cap).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(has ?character - character ?object - object)": "The character possesses the object, including a cap when cap is a subtype of object.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(in-stasis ?character - character)": "Source predicate (in-stasis ?character - character).",
        "(ancient-technology ?object - object)": "Source predicate (ancient-technology ?object - object).",
        "(propellant-device ?object - object)": "Source predicate (propellant-device ?object - object).",
        "(shielded ?object - object)": "Source predicate (shielded ?object - object).",
        "(requested-tow ?character - character ?place - place)": "Source predicate (requested-tow ?character - character ?place - place)."
    },
    "operators": {
        "search": "(:action search\n :parameters (?character - character ?cap - cap ?place - place)\n :precondition (and (at ?character ?place) (lost ?character ?cap))\n :effect (searched ?character ?place)\n)",
        "find :parameters (?character - character ?object - cap) :precondition (and (lost ?character ?object) (forall (?place - place) (searched ?character ?place))) :effect (and (found ?character ?object) (not (lost ?character ?object)) (has ?character ?object)))": "(:action find :parameters (?character - character ?object - cap) :precondition (and (lost ?character ?object) (forall (?place - place) (searched ?character ?place))) :effect (and (found ?character ?object) (not (lost ?character ?object)) (has ?character ?object)))",
        "lose :parameters (?character - character ?object - cap) :precondition (has ?character ?object) :effect (and (lost ?character ?object) (not (has ?character ?object))))": "(:action lose :parameters (?character - character ?object - cap) :precondition (has ?character ?object) :effect (and (lost ?character ?object) (not (has ?character ?object))))",
        "replace :parameters (?character - character ?old-cap - cap ?new-object - object) :precondition (and (found ?character ?old-cap) (not (has ?character ?old-cap)) (has ?character ?new-object)) :effect (and (not (found ?character ?old-cap)) (has ?character ?old-cap) (not (has ?character ?new-object))))": "(:action replace :parameters (?character - character ?old-cap - cap ?new-object - object) :precondition (and (found ?character ?old-cap) (not (has ?character ?old-cap)) (has ?character ?new-object)) :effect (and (not (found ?character ?old-cap)) (has ?character ?old-cap) (not (has ?character ?new-object))))",
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)"
    }
}