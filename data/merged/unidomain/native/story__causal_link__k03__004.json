    },
    "operators": {
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)",
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
        "start-party": "(:action start-party\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (party ?place)\n)",
        "enjoy-party": "(:action enjoy-party\n :parameters (?character - character ?place - object)\n :precondition (and (happy ?character) (party ?place))\n :effect (happy ?character)\n)",
        "make-happy": "(:action make-happy\n :parameters (?character - character ?target - character)\n :precondition (and (not (= ?character ?target)) (not (happy ?target)))\n :effect (happy ?target)\n)",
        "put :parameters (?character - character ?object - object ?place - object) :precondition (and (happy ?character) (has ?character ?object)) :effect (at ?object ?place))": "(:action put :parameters (?character - character ?object - object ?place - object) :precondition (and (happy ?character) (has ?character ?object)) :effect (at ?object ?place))",
        "find :parameters (?entity - character ?object - object ?place - object) :precondition (and (at ?entity ?place) (not (has ?entity ?object))) :effect (has ?entity ?object))": "(:action find :parameters (?entity - character ?object - object ?place - object) :precondition (and (at ?entity ?place) (not (has ?entity ?object))) :effect (has ?entity ?object))",
        "give :parameters (?giver - character ?object - object ?receiver - character ?location - object) :precondition (and (not (= ?giver ?receiver)) (at ?giver ?location) (has ?giver ?object) (at ?receiver ?location)) :effect (and (not (has ?giver ?object)) (has ?receiver ?object) (gave-gift ?giver ?receiver ?object)))": "(:action give :parameters (?giver - character ?object - object ?receiver - character ?location - object) :precondition (and (not (= ?giver ?receiver)) (at ?giver ?location) (has ?giver ?object) (at ?receiver ?location)) :effect (and (not (has ?giver ?object)) (has ?receiver ?object) (gave-gift ?giver ?receiver ?object)))",
        "play :parameters (?entity - character ?object - object ?place - object) :precondition (and (at ?entity ?place) (has ?entity ?object)) :effect (happy ?entity))": "(:action play :parameters (?entity - character ?object - object ?place - object) :precondition (and (at ?entity ?place) (has ?entity ?object)) :effect (happy ?entity))"
    }
}