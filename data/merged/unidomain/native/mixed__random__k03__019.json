{
    "predicates": {
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(drunk ?character - character)": "Source predicate (drunk ?character - character).",
        "(night-show ?place - place)": "Source predicate (night-show ?place - place).",
        "(vomit-stain ?place - place)": "Source predicate (vomit-stain ?place - place).",
        "(at ?character - character ?location - location)": "The character is at the specified location.",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(player ?character - character)": "Source predicate (player ?character - character).",
        "(at ?thing - item ?location - location)": "Source predicate (at ?thing - item ?location - location).",
        "(asleep ?character - character)": "Source predicate (asleep ?character - character).",
        "(connected ?location - location ?oldlocation - location)": "Source predicate (connected ?location - location ?oldlocation - location).",
        "(enchanted ?item - item)": "Source predicate (enchanted ?item - item).",
        "(is ?item - item ?thing - thing)": "Source predicate (is ?item - item ?thing - thing).",
        "(playing-with-toys ?character - character)": "Source predicate (playing-with-toys ?character - character).",
        "(found-blocks ?character - character)": "Source predicate (found-blocks ?character - character).",
        "(stacking-blocks ?character - character)": "Source predicate (stacking-blocks ?character - character).",
        "(stack-tall ?character - character)": "Source predicate (stack-tall ?character - character).",
        "(stack-strong ?character - character)": "Source predicate (stack-strong ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character)."
    },
    "operators": {
        "sober-up": "(:action sober-up\n :parameters (?character - character)\n :precondition (drunk ?character)\n :effect (not (drunk ?character))\n)",
        "vomit :parameters (?character - character ?location - location) :precondition (and (alive ?character) (drunk ?character) (at ?character ?location)) :effect (vomit-stain ?location))": "(:action vomit :parameters (?character - character ?location - location) :precondition (and (alive ?character) (drunk ?character) (at ?character ?location)) :effect (vomit-stain ?location))",
        "drink": "(:action drink\n :parameters (?character - character ?drink - drink)\n :precondition (and (alive ?character) (has ?character ?drink))\n :effect (and (drunk ?character) (not (has ?character ?drink)))\n)",
        "play-with-toys": "(:action play-with-toys\n :parameters (?character - character)\n :precondition (and)\n :effect (playing-with-toys ?character)\n)",
        "find-blocks": "(:action find-blocks\n :parameters (?character - character)\n :precondition (playing-with-toys ?character)\n :effect (found-blocks ?character)\n)",
        "stack-blocks": "(:action stack-blocks\n :parameters (?character - character)\n :precondition (found-blocks ?character)\n :effect (stacking-blocks ?character)\n)",
        "make-stack-tall": "(:action make-stack-tall\n :parameters (?character - character)\n :precondition (stacking-blocks ?character)\n :effect (stack-tall ?character)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and (not (= ?helper ?helpee)) (stack-tall ?helpee))\n :effect (helping ?helper ?helpee)\n)",
        "make-stack-strong": "(:action make-stack-strong\n :parameters (?character - character)\n :precondition (and (stack-tall ?character) (helping ?character ?character))\n :effect (stack-strong ?character)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (stack-strong ?character)\n :effect (happy ?character)\n)",
        "move": "(:action move :parameters (?character - character ?to - location ?from - location) :precondition (and (alive ?character) (not (at ?character ?to)) (connected ?to ?from) (not (asleep ?character)) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "wake-person": "(:action wake-person\n :parameters (?waker - character ?woken - character ?location - location)\n :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker)))\n :effect (not (asleep ?woken))\n)",
        "take-thing": "(:action take-thing\n :parameters (?taker - character ?thing - item ?location - location)\n :precondition (and (at ?taker ?location) (at ?thing ?location) (not (asleep ?taker)) (not (enchanted ?thing)))\n :effect (and (not (at ?thing ?location)) (has ?taker ?thing))\n)",
        "disenchant-thing": "(:action disenchant-thing\n :parameters (?caster - character ?thing - item ?book - book ?location - location)\n :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?book) (enchanted ?thing))\n :effect (not (enchanted ?thing))\n)"
    }
}