    "operators": {
        "stop-riding": "(:action stop-riding\n :parameters (?character - character ?vehicle - vehicle)\n :precondition (and (alive ?character) (riding ?character ?vehicle))\n :effect (not (riding ?character ?vehicle))\n)",
        "start-flying": "(:action start-flying\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (flying ?character)))\n :effect (flying ?character)\n)",
        "stop-flying": "(:action stop-flying\n :parameters (?character - character)\n :precondition (and (alive ?character) (flying ?character))\n :effect (not (flying ?character))\n)",
        "try-relax": "(:action try-relax\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (relaxed ?character)))\n :effect (relaxed ?character)\n)",
        "stop-relax": "(:action stop-relax\n :parameters (?character - character)\n :precondition (and (alive ?character) (relaxed ?character))\n :effect (not (relaxed ?character))\n)",
        "travel": "(:action travel\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "start-riding": "(:action start-riding\n :parameters (?character - character ?vehicle - vehicle)\n :precondition (and (alive ?character) (has ?character ?vehicle) (not (riding ?character ?vehicle)))\n :effect (riding ?character ?vehicle)\n)",
        "apologize": "(:action apologize\n :parameters (?apologizer - character ?apologized - character)\n :precondition (and (not (= ?apologizer ?apologized)) (not (friends ?apologizer ?apologized)))\n :effect (friends ?apologizer ?apologized)\n)",
        "enter :parameters (?character - character ?placefrom - place ?roomto - room) :precondition (and (not (locked ?roomto)) (at ?character ?placefrom)) :effect (and (not (at ?character ?placefrom)) (at ?character ?roomto)))": "(:action enter :parameters (?character - character ?placefrom - place ?roomto - room) :precondition (and (not (locked ?roomto)) (at ?character ?placefrom)) :effect (and (not (at ?character ?placefrom)) (at ?character ?roomto)))",
        "unlock": "(:action unlock\n :parameters (?character - character ?key - key ?room - room)\n :precondition (and (locked ?room) (unlocked-by ?room ?key) (has ?character ?key))\n :effect (and (not (locked ?room)))\n)",
        "try-steal :parameters (?stealer - character ?thing - thing ?owner - character) :precondition (and (not (= ?stealer ?owner)) (has ?owner ?thing) (steal-intention ?stealer ?thing)) :effect (and (not (steal-intention ?stealer ?thing)) (not (friends ?stealer ?owner)) (has ?stealer ?thing) (not (has ?owner ?thing))))": "(:action try-steal :parameters (?stealer - character ?thing - thing ?owner - character) :precondition (and (not (= ?stealer ?owner)) (has ?owner ?thing) (steal-intention ?stealer ?thing)) :effect (and (not (steal-intention ?stealer ?thing)) (not (friends ?stealer ?owner)) (has ?stealer ?thing) (not (has ?owner ?thing))))",
        "clean-item :parameters (?cleaner - character ?thing - thing) :precondition (and (not (clean ?thing)) (has ?cleaner ?thing)) :effect (clean ?thing))": "(:action clean-item :parameters (?cleaner - character ?thing - thing) :precondition (and (not (clean ?thing)) (has ?cleaner ?thing)) :effect (clean ?thing))",
        "drop-in-puddle :parameters (?dropper - character ?thing - thing) :precondition (and (has ?dropper ?thing) (clean ?thing)) :effect (not (clean ?thing)))": "(:action drop-in-puddle :parameters (?dropper - character ?thing - thing) :precondition (and (has ?dropper ?thing) (clean ?thing)) :effect (not (clean ?thing)))",
        "search-for :parameters (?character - character ?thing - thing ?place - place) :precondition (and (at ?character ?place) (in ?thing ?place)) :effect (and (has ?character ?thing) (not (in ?thing ?place))))": "(:action search-for :parameters (?character - character ?thing - thing ?place - place) :precondition (and (at ?character ?place) (in ?thing ?place)) :effect (and (has ?character ?thing) (not (in ?thing ?place))))"
    }
