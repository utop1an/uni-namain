{
    "predicates": {
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character).",
        "(assembled ?robot - robot)": "Source predicate (assembled ?robot - robot).",
        "(has-robot ?character - character ?robot - robot)": "Source predicate (has-robot ?character - character ?robot - robot).",
        "(working-on-task ?robot - robot)": "Source predicate (working-on-task ?robot - robot).",
        "(playing-game ?character - character)": "Source predicate (playing-game ?character - character).",
        "(happy ?character - character)": "The character is happy.",
        "(at ?character - character ?location - object)": "The character is at the specified location.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(knows-survival-skills ?character - character)": "Source predicate (knows-survival-skills ?character - character).",
        "(computers-working)": "Source predicate (computers-working).",
        "(caused-apocalypse ?character - character)": "Source predicate (caused-apocalypse ?character - character).",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(gave-gift ?giver - character ?receiver - character ?item - item)": "Source predicate (gave-gift ?giver - character ?receiver - character ?item - item).",
        "(fierce ?character - character)": "Source predicate (fierce ?character - character).",
        "(scared ?character1 - character ?character2 - character)": "Source predicate (scared ?character1 - character ?character2 - character).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(playing ?character1 - character ?character2 - character)": "Source predicate (playing ?character1 - character ?character2 - character).",
        "(sneezed ?character - character)": "Source predicate (sneezed ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified location."
    },
    "operators": {
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "start-task": "(:action start-task\n :parameters (?robot - robot)\n :precondition (and (assembled ?robot) (not (working-on-task ?robot)))\n :effect (working-on-task ?robot)\n)",
        "stop-game": "(:action stop-game\n :parameters (?character - character)\n :precondition (playing-game ?character)\n :effect (not (playing-game ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)",
        "assemble": "(:action assemble\n :parameters (?character - character ?robot - robot)\n :precondition (and (at ?character garage) (not (assembled ?robot)))\n :effect (and (assembled ?robot) (has-robot ?character ?robot))\n)",
        "play-game": "(:action play-game\n :parameters (?character - character)\n :precondition (and (at ?character house) (not (playing-game ?character)))\n :effect (playing-game ?character)\n)",
        "learn-survival-skills": "(:action learn-survival-skills\n :parameters (?learner - character ?teacher - character)\n :precondition (and (alive ?learner) (alive ?teacher) (knows-survival-skills ?teacher) (not (knows-survival-skills ?learner)))\n :effect (knows-survival-skills ?learner)\n)",
        "cause-apocalypse": "(:action cause-apocalypse\n :parameters (?character - character)\n :precondition (and (alive ?character) (computers-working))\n :effect (and (not (computers-working)) (caused-apocalypse ?character))\n)",
        "kill": "(:action kill\n :parameters (?killer - character ?victim - character)\n :precondition (and (alive ?killer) (alive ?victim) (not (= ?killer ?victim)))\n :effect (not (alive ?victim))\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (not (friends ?character1 ?character2)))\n :effect (friends ?character1 ?character2)\n)",
        "sneeze": "(:action sneeze\n :parameters (?character - character)\n :precondition (and)\n :effect (sneezed ?character)\n)",
        "become-scared": "(:action become-scared\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (fierce ?character2))\n :effect (scared ?character1 ?character2)\n)",
        "stop-being-scared": "(:action stop-being-scared\n :parameters (?character1 - character ?character2 - character)\n :precondition (scared ?character1 ?character2)\n :effect (not (scared ?character1 ?character2))\n)",
        "make-happy": "(:action make-happy\n :parameters (?character - character ?target - character)\n :precondition (and (not (= ?character ?target)) (not (happy ?target)))\n :effect (happy ?target)\n)",
        "find :parameters (?character - character ?item - item ?location - object) :precondition (and (at ?character ?location) (not (has ?character ?item))) :effect (has ?character ?item))": "(:action find :parameters (?character - character ?item - item ?location - object) :precondition (and (at ?character ?location) (not (has ?character ?item))) :effect (has ?character ?item))",
        "give :parameters (?giver - character ?item - item ?receiver - character ?location - object) :precondition (and (not (= ?giver ?receiver)) (at ?giver ?location) (has ?giver ?item) (at ?receiver ?location)) :effect (and (not (has ?giver ?item)) (has ?receiver ?item) (gave-gift ?giver ?receiver ?item)))": "(:action give :parameters (?giver - character ?item - item ?receiver - character ?location - object) :precondition (and (not (= ?giver ?receiver)) (at ?giver ?location) (has ?giver ?item) (at ?receiver ?location)) :effect (and (not (has ?giver ?item)) (has ?receiver ?item) (gave-gift ?giver ?receiver ?item)))",
        "play :parameters (?character1 - character ?character2 - character ?item - item ?location - object) :precondition (and (at ?character1 ?location) (has ?character1 ?item) (not (= ?character1 ?character2)) (friends ?character1 ?character2)) :effect (and (happy ?character1) (playing ?character1 ?character2)))": "(:action play :parameters (?character1 - character ?character2 - character ?item - item ?location - object) :precondition (and (at ?character1 ?location) (has ?character1 ?item) (not (= ?character1 ?character2)) (friends ?character1 ?character2)) :effect (and (happy ?character1) (playing ?character1 ?character2)))"
    }
}