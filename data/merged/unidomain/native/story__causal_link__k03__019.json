        "(pretty ?mop - mop)": "Source predicate (pretty ?mop - mop).",
        "(disgusting ?mop - mop)": "Source predicate (disgusting ?mop - mop).",
        "(selected ?mop - mop)": "Source predicate (selected ?mop - mop).",
        "(has ?character - character ?mop - mop)": "The character possesses the specified object, including a dress or a mop."
    },
    "operators": {
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)",
        "slip": "(:action slip\n :parameters (?character - character ?dress - dress)\n :precondition (and (wearing ?character ?dress) (not (damaged ?dress)))\n :effect (damaged ?dress)\n)",
        "comfort": "(:action comfort\n :parameters (?parent - character ?child - character)\n :precondition (and (not (happy ?child)) (not (= ?parent ?child)))\n :effect (happy ?child)\n)",
        "go-to": "(:action go-to\n :parameters (?character - character ?place - place)\n :precondition (at ?character ?place)\n :effect (at ?character ?place)\n)",
        "put-on-dress :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (not (wearing ?character ?object))) :effect (wearing ?character ?object))": "(:action put-on-dress :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (not (wearing ?character ?object))) :effect (wearing ?character ?object))",
        "get-new-item :parameters (?character - character ?old-dress - dress ?new-object - object) :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-object))) :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-object)))": "(:action get-new-item :parameters (?character - character ?old-dress - dress ?new-object - object) :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-object))) :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-object)))",
        "select-mop :parameters (?character - character ?object - object ?place - place) :precondition (and (at ?character ?place) (has ?character ?object)) :effect (selected ?object))": "(:action select-mop :parameters (?character - character ?object - object ?place - place) :precondition (and (at ?character ?place) (has ?character ?object)) :effect (selected ?object))",
        "receive-item :parameters (?character - character ?dog - character ?object - object ?place - place) :precondition (and (at ?character ?place) (at ?dog ?place) (has ?dog ?object)) :effect (and (not (has ?dog ?object)) (has ?character ?object)))": "(:action receive-item :parameters (?character - character ?dog - character ?object - object ?place - place) :precondition (and (at ?character ?place) (at ?dog ?place) (has ?dog ?object)) :effect (and (not (has ?dog ?object)) (has ?character ?object)))"
    }
}