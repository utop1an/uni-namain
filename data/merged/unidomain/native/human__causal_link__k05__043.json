        "unlock-success": "(:action unlock-success :parameters (?character - character ?key - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?key) (believes-has ?character ?character ?key) (locked ?room) (unlocked-by ?room ?key) (has ?character ?key)) :effect (and (not (locked ?room)) (not (believes-locked ?character ?room))))",
        "place-victim :parameters (?henchman - character ?victim - character ?from - location ?to - location) :precondition (and (henchman ?henchman) (has ?henchman ?victim) (at ?henchman ?from) (connected ?to ?from)) :effect (and (not (has ?henchman ?victim)) (at ?victim ?to) (captured ?victim)))": "(:action place-victim :parameters (?henchman - character ?victim - character ?from - location ?to - location) :precondition (and (henchman ?henchman) (has ?henchman ?victim) (at ?henchman ?from) (connected ?to ?from)) :effect (and (not (has ?henchman ?victim)) (at ?victim ?to) (captured ?victim)))",
        "enter": "(:action enter :parameters (?entity - character ?locationfrom - location ?roomto - room) :precondition (and (player ?entity) (connected ?roomto ?locationfrom) (at ?entity ?locationfrom) (knows ?entity) (not (locked ?roomto)) (not (asleep ?entity))) :effect (and (not (at ?entity ?locationfrom)) (at ?entity ?roomto)))",
        "interrogate-character :parameters (?player-entity - character ?detained-entity - character ?interrogation-location - location) :precondition (and (player ?player-entity) (at ?player-entity ?interrogation-location) (at ?detained-entity ?interrogation-location) (apprehended ?detained-entity)) :effect (knows ?player-entity))": "(:action interrogate-character :parameters (?player-entity - character ?detained-entity - character ?interrogation-location - location) :precondition (and (player ?player-entity) (at ?player-entity ?interrogation-location) (at ?detained-entity ?interrogation-location) (apprehended ?detained-entity)) :effect (knows ?player-entity))",
        "save-character :parameters (?saving-character - character ?captive-character - character ?other-captive-character - character ?location - location) :precondition (and (player ?saving-character) (at ?saving-character ?location) (at ?captive-character ?location) (captured ?captive-character) (captured ?other-captive-character) (not (at ?other-captive-character ?location))) :effect (and (saved ?captive-character ?saving-character) (not (alive ?other-captive-character))))": "(:action save-character :parameters (?saving-character - character ?captive-character - character ?other-captive-character - character ?location - location) :precondition (and (player ?saving-character) (at ?saving-character ?location) (at ?captive-character ?location) (captured ?captive-character) (captured ?other-captive-character) (not (at ?other-captive-character ?location))) :effect (and (saved ?captive-character ?saving-character) (not (alive ?other-captive-character))))",
        "search-for-success": "(:action search-for-success :parameters (?actor - character ?thing - thing ?room - room) :precondition (and (believes-at ?actor ?actor ?room) (believes-in ?actor ?thing ?room) (at ?actor ?room) (in ?thing ?room)) :effect (and (has ?actor ?thing) (not (in ?thing ?room)) (believes-has ?actor ?actor ?thing) (not (believes-in ?actor ?thing ?room))))"
