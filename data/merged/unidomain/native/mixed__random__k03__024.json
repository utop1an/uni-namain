        "place-victim :parameters (?acting-character - character ?target-character - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?target-character) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?target-character)) (at ?target-character ?destination-location) (captured ?target-character)))": "(:action place-victim :parameters (?acting-character - character ?target-character - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?target-character) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?target-character)) (at ?target-character ?destination-location) (captured ?target-character)))",
        "save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))",
        "fight": "(:action fight\n :parameters (?fighter1 - character ?fighter2 - character)\n :precondition (and (not (= ?fighter1 ?fighter2)) (alive ?fighter1) (has-weapon ?fighter1) (alive ?fighter2) (has-weapon ?fighter2))\n :effect (and)\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (not (alive ?character))\n)",
        "acquire-electronics": "(:action acquire-electronics\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-electronics ?character)))\n :effect (has-electronics ?character)\n)",
        "stop-believing": "(:action stop-believing\n :parameters (?character - character)\n :precondition (and (alive ?character) (believes-in-fairies ?character))\n :effect (not (believes-in-fairies ?character))\n)",
        "move-location": "(:action move-location :parameters (?actor - character ?to - location ?from - location) :precondition (and (player ?actor) (connected ?to ?from) (at ?actor ?from) (knows ?actor) (not (= ?from ?to)) (alive ?actor)) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))"
    }
