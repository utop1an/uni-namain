        "move-location": "(:action move-location :parameters (?object - character ?destination - location ?source - location) :precondition (and (not (= ?source ?destination)) (player ?object) (connected ?destination ?source) (at ?object ?source) (knows ?object)) :effect (and (not (at ?object ?source)) (at ?object ?destination)))",
        "interrogate-character :parameters (?questioner - character ?subject - character ?place - location) :precondition (and (player ?questioner) (at ?questioner ?place) (at ?subject ?place) (apprehended ?subject)) :effect (knows ?questioner))": "(:action interrogate-character :parameters (?questioner - character ?subject - character ?place - location) :precondition (and (player ?questioner) (at ?questioner ?place) (at ?subject ?place) (apprehended ?subject)) :effect (knows ?questioner))",
        "save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))",
        "place-victim :parameters (?agent - character ?captive - character ?place - location ?destination - location) :precondition (and (henchman ?agent) (has ?agent ?captive) (at ?agent ?place) (connected ?destination ?place)) :effect (and (not (has ?agent ?captive)) (at ?captive ?destination) (captured ?captive)))": "(:action place-victim :parameters (?agent - character ?captive - character ?place - location ?destination - location) :precondition (and (henchman ?agent) (has ?agent ?captive) (at ?agent ?place) (connected ?destination ?place)) :effect (and (not (has ?agent ?captive)) (at ?captive ?destination) (captured ?captive)))"
    }
