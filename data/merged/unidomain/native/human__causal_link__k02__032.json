    "operators": {
        "get-hungry": "(:action get-hungry\n :parameters (?creature - creature)\n :precondition (not (hungry ?creature))\n :effect (and (hungry ?creature))\n)",
        "travel": "(:action travel\n :parameters (?creature - creature ?from - place ?to - place)\n :precondition (and (alive ?creature) (at ?creature ?from))\n :effect (and (at ?creature ?to) (not (at ?creature ?from)))\n)",
        "propose": "(:action propose\n :parameters (?proposer - person ?proposee - person ?place - place)\n :precondition (and (alive ?proposer) (at ?proposer ?place) (alive ?proposee) (at ?proposee ?place) (loves ?proposer ?proposee))\n :effect (hasproposed ?proposer ?proposee)\n)",
        "accept": "(:action accept\n :parameters (?accepter - person ?proposer - person ?place - place)\n :precondition (and (alive ?accepter) (at ?accepter ?place) (alive ?proposer) (at ?proposer ?place) (hasproposed ?proposer ?accepter))\n :effect (hasaccepted ?accepter ?proposer)\n)",
        "marry": "(:action marry\n :parameters (?groom - person ?bride - person ?place - place)\n :precondition (and (alive ?groom) (at ?groom ?place) (hasproposed ?groom ?bride) (single ?groom) (alive ?bride) (at ?bride ?place) (hasaccepted ?bride ?groom) (single ?bride))\n :effect (and (marriedto ?groom ?bride) (marriedto ?bride ?groom) (not (single ?groom)) (not (single ?bride)) (forall (?v - valuable) (when (has ?groom ?v) (rich ?bride))) (when (loves ?groom ?bride) (happy ?groom)) (when (loves ?bride ?groom) (happy ?bride)))\n)",
        "steal": "(:action steal\n :parameters (?thief - creature ?victim - creature ?item - item ?place - place)\n :precondition (and (not (= ?thief ?victim)) (alive ?thief) (at ?thief ?place) (at ?item ?place) (belongsto ?item ?victim))\n :effect (and (has ?thief ?item) (when (forall (?v - valuable) (not (has ?victim ?v))) (not (rich ?victim))))\n)",
        "eat": "(:action eat\n :parameters (?monster - monster ?creature - creature ?place - place)\n :precondition (and (alive ?monster) (at ?monster ?place) (hungry ?monster) (alive ?creature) (at ?creature ?place))\n :effect (and (not (hungry ?monster)) (not (alive ?creature)) (not (rich ?creature)) (not (happy ?creature)))\n)",
        "begin-erupt :parameters (?landform - landform) :precondition (and) :effect (and (erupting ?landform) (forall (?o - object) (when (at ?o ?landform) (and (not (safe ?o)))))))": "(:action begin-erupt :parameters (?landform - landform) :precondition (and) :effect (and (erupting ?landform) (forall (?o - object) (when (at ?o ?landform) (and (not (safe ?o)))))))",
        "walk :parameters (?object - creature ?from - landform ?to - landform) :precondition (and (not (= ?from ?to)) (alive ?object) (not (stunned ?object)) (at ?object ?from) (habitable ?to) (safe ?to) (forall (?c - creature) (and (not (fighting ?object ?c)) (not (fighting ?c ?object))))) :effect (and (at ?object ?to) (not (at ?object ?from)) (when (not (safe ?object)) (safe ?object))))": "(:action walk :parameters (?object - creature ?from - landform ?to - landform) :precondition (and (not (= ?from ?to)) (alive ?object) (not (stunned ?object)) (at ?object ?from) (habitable ?to) (safe ?to) (forall (?c - creature) (and (not (fighting ?object ?c)) (not (fighting ?c ?object))))) :effect (and (at ?object ?to) (not (at ?object ?from)) (when (not (safe ?object)) (safe ?object))))",
        "teleport-from-ship :parameters (?object - creature ?from - ship ?to - place) :precondition (and (not (= ?from ?to)) (alive ?object) (not (stunned ?object)) (at ?object ?from) (habitable ?to) (safe ?to) (captain ?object ?from)) :effect (and (at ?object ?to) (not (at ?object ?from)) (when (not (safe ?object)) (safe ?object)) (forall (?c - creature) (and (not (fighting ?object ?c)) (not (fighting ?c ?object))))))": "(:action teleport-from-ship :parameters (?object - creature ?from - ship ?to - place) :precondition (and (not (= ?from ?to)) (alive ?object) (not (stunned ?object)) (at ?object ?from) (habitable ?to) (safe ?to) (captain ?object ?from)) :effect (and (at ?object ?to) (not (at ?object ?from)) (when (not (safe ?object)) (safe ?object)) (forall (?c - creature) (and (not (fighting ?object ?c)) (not (fighting ?c ?object))))))",
        "teleport-to-ship :parameters (?object - creature ?from - place ?to - ship) :precondition (and (not (= ?from ?to)) (alive ?object) (not (stunned ?object)) (at ?object ?from) (habitable ?to) (safe ?to) (captain ?object ?to)) :effect (and (at ?object ?to) (not (at ?object ?from)) (when (not (safe ?object)) (safe ?object)) (forall (?c - creature) (and (not (fighting ?object ?c)) (not (fighting ?c ?object))))))": "(:action teleport-to-ship :parameters (?object - creature ?from - place ?to - ship) :precondition (and (not (= ?from ?to)) (alive ?object) (not (stunned ?object)) (at ?object ?from) (habitable ?to) (safe ?to) (captain ?object ?to)) :effect (and (at ?object ?to) (not (at ?object ?from)) (when (not (safe ?object)) (safe ?object)) (forall (?c - creature) (and (not (fighting ?object ?c)) (not (fighting ?c ?object))))))",
        "attack :parameters (?actor - creature ?target - creature ?place - place) :precondition (and (alive ?actor) (not (stunned ?actor)) (at ?actor ?place) (alive ?target) (not (stunned ?target)) (at ?target ?place)) :effect (and (fighting ?actor ?target)))": "(:action attack :parameters (?actor - creature ?target - creature ?place - place) :precondition (and (alive ?actor) (not (stunned ?actor)) (at ?actor ?place) (alive ?target) (not (stunned ?target)) (at ?target ?place)) :effect (and (fighting ?actor ?target)))",
        "kill :parameters (?attacker - creature ?target - creature) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (alive ?target) (or (fighting ?attacker ?target) (fighting ?target ?attacker))) :effect (and (not (alive ?target)) (when (fighting ?attacker ?target) (not (fighting ?attacker ?target))) (when (fighting ?target ?attacker) (not (fighting ?target ?attacker)))))": "(:action kill :parameters (?attacker - creature ?target - creature) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (alive ?target) (or (fighting ?attacker ?target) (fighting ?target ?attacker))) :effect (and (not (alive ?target)) (when (fighting ?attacker ?target) (not (fighting ?attacker ?target))) (when (fighting ?target ?attacker) (not (fighting ?target ?attacker)))))",
        "stun :parameters (?actor - creature ?target - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?target) (not (stunned ?target)) (or (fighting ?actor ?target) (fighting ?target ?actor))) :effect (and (stunned ?target) (when (fighting ?actor ?target) (not (fighting ?actor ?target))) (when (fighting ?target ?actor) (not (fighting ?target ?actor)))))": "(:action stun :parameters (?actor - creature ?target - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?target) (not (stunned ?target)) (or (fighting ?actor ?target) (fighting ?target ?actor))) :effect (and (stunned ?target) (when (fighting ?actor ?target) (not (fighting ?actor ?target))) (when (fighting ?target ?actor) (not (fighting ?target ?actor)))))",
        "break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))": "(:action break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))",
        "make-peace :parameters (?mediator - creature ?participant - creature ?place - place) :precondition (and (alive ?mediator) (not (stunned ?mediator)) (at ?mediator ?place) (alive ?participant) (at ?participant ?place) (not (fighting ?mediator ?participant)) (not (fighting ?participant ?mediator))) :effect (and (friends ?mediator ?participant) (friends ?participant ?mediator)))": "(:action make-peace :parameters (?mediator - creature ?participant - creature ?place - place) :precondition (and (alive ?mediator) (not (stunned ?mediator)) (at ?mediator ?place) (alive ?participant) (at ?participant ?place) (not (fighting ?mediator ?participant)) (not (fighting ?participant ?mediator))) :effect (and (friends ?mediator ?participant) (friends ?participant ?mediator)))",
        "erupt :parameters (?landform - landform) :precondition (erupting ?landform) :effect (and (not (habitable ?landform)) (not (erupting ?landform)) (forall (?o - object) (when (at ?o ?landform) (not (alive ?o))))))": "(:action erupt :parameters (?landform - landform) :precondition (erupting ?landform) :effect (and (not (habitable ?landform)) (not (erupting ?landform)) (forall (?o - object) (when (at ?o ?landform) (not (alive ?o))))))"
    }
