        "(rescuer ?h - character)": "Source predicate (rescuer ?h - character).",
        "(rescuer-at ?h - house)": "Source predicate (rescuer-at ?h - house).",
        "(alive ?c - character)": "Source predicate (alive ?c - character).",
        "(eaten ?c - character)": "Source predicate (eaten ?c - character).",
        "(rescued ?c - human)": "Source predicate (rescued ?c - human).",
        "(stuck ?character - character ?place - place)": "Source predicate (stuck ?character - character ?place - place).",
        "(helped ?helper - character ?helpee - character)": "Source predicate (helped ?helper - character ?helpee - character)."
    },
    "operators": {
        "overcome-fear": "(:action overcome-fear\n :parameters (?character - character)\n :precondition (scared ?character)\n :effect (not (scared ?character))\n)",
        "make-cake": "(:action make-cake\n :parameters (?character - character)\n :precondition (and (not (cake-made)) (happy ?character))\n :effect (cake-made)\n)",
        "remove-spider": "(:action remove-spider\n :parameters (?character - character ?helpee - character)\n :precondition (and (spider-on-wall) (helping ?character ?helpee))\n :effect (not (spider-on-wall))\n)",
        "see-spider": "(:action see-spider\n :parameters (?character - character)\n :precondition (and (not (scared ?character)) (not (spider-on-wall)))\n :effect (and (scared ?character) (spider-on-wall))\n)",
        "retrieve-toy :parameters (?c - character ?t - thing ?place - place) :precondition (and (at ?c ?place) (on-top ?t ?place)) :effect (and (not (on-top ?t ?place)) (has ?c ?t)))": "(:action retrieve-toy :parameters (?c - character ?t - thing ?place - place) :precondition (and (at ?c ?place) (on-top ?t ?place)) :effect (and (not (on-top ?t ?place)) (has ?c ?t)))",
        "become-important": "(:action become-important\n :parameters (?character - character)\n :precondition (not (important ?character))\n :effect (important ?character)\n)",
        "become-unimportant": "(:action become-unimportant\n :parameters (?character - character)\n :precondition (important ?character)\n :effect (not (important ?character))\n)",
        "sit": "(:action sit\n :parameters (?character - character ?seat - seat)\n :precondition (and (not (sitting ?character ?seat)) (not (broken ?seat)))\n :effect (sitting ?character ?seat)\n)",
        "leave": "(:action leave\n :parameters (?character - character ?seat - seat)\n :precondition (sitting ?character ?seat)\n :effect (not (sitting ?character ?seat))\n)",
        "break-seat": "(:action break-seat\n :parameters (?seat - seat)\n :precondition (not (broken ?seat))\n :effect (broken ?seat)\n)",
        "walk :parameters (?character - character ?from ?to - house) :precondition (and (alive ?character) (at ?character ?from) (not (eaten ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to) (when (and (rescuer ?character)) (and (rescuer-at ?to) (not (rescuer-at ?from))))))": "(:action walk :parameters (?character - character ?from ?to - house) :precondition (and (alive ?character) (at ?character ?from) (not (eaten ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to) (when (and (rescuer ?character)) (and (rescuer-at ?to) (not (rescuer-at ?from))))))",
        "eat :parameters (?m - wolf ?c - human ?p - place) :precondition (and (alive ?m) (alive ?c) (not (eaten ?c)) (at ?m ?p) (at ?c ?p) (monster ?m)) :effect (and (eaten ?c)))": "(:action eat :parameters (?m - wolf ?c - human ?p - place) :precondition (and (alive ?m) (alive ?c) (not (eaten ?c)) (at ?m ?p) (at ?c ?p) (monster ?m)) :effect (and (eaten ?c)))",
        "escape :parameters (?c - human ?m - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?m)) (at ?m ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))": "(:action escape :parameters (?c - human ?m - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?m)) (at ?m ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (at ?character ?from) (not (at ?character ?to))) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "get-stuck": "(:action get-stuck\n :parameters (?character - character ?place - place)\n :precondition (and (at ?character ?place) (not (stuck ?character ?place)))\n :effect (stuck ?character ?place)\n)",
        "help": "(:action help :parameters (?helper - character ?helpee - character ?place - place) :precondition (and (not (= ?helper ?helpee)) (scared ?helpee) (at ?helper ?place) (stuck ?helpee ?place)) :effect (and (not (scared ?helpee)) (happy ?helpee) (helping ?helper ?helpee) (not (stuck ?helpee ?place)) (helped ?helper ?helpee)))",
        "kill :parameters (?c - worker ?m - wolf ?a - axe ?p - place) :precondition (and (alive ?c) (alive ?m) (has ?c ?a) (at ?c ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?c)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?c - worker ?m - wolf ?a - axe ?p - place) :precondition (and (alive ?c) (alive ?m) (has ?c ?a) (at ?c ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?c)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "give :parameters (?c1 ?c2 - human ?t - thing ?p - place) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?t) (at ?c1 ?p) (at ?c2 ?p)) :effect (and (has ?c2 ?t) (not (has ?c1 ?t))))": "(:action give :parameters (?c1 ?c2 - human ?t - thing ?p - place) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?t) (at ?c1 ?p) (at ?c2 ?p)) :effect (and (has ?c2 ?t) (not (has ?c1 ?t))))",
        "become-friends": "(:action become-friends :parameters (?character1 - character ?character2 - character) :precondition (and (not (= ?character1 ?character2)) (not (friends ?character1 ?character2)) (helped ?character1 ?character2)) :effect (friends ?character1 ?character2))"
    }
}