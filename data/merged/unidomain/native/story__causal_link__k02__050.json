{
    "predicates": {
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(clean ?item - item)": "Source predicate (clean ?item - item).",
        "(locked ?door - item)": "Source predicate (locked ?door - item).",
        "(wearing ?character - character ?item - item)": "Source predicate (wearing ?character - character ?item - item).",
        "(fits ?item - item ?character - character)": "Source predicate (fits ?item - item ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place, which may be a room.",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(has-key ?character - character)": "Source predicate (has-key ?character - character).",
        "(in ?item - item ?room - room)": "Source predicate (in ?item - item ?room - room).",
        "(sick ?character - character)": "Source predicate (sick ?character - character).",
        "(called-911 ?caller - character ?sick-person - character)": "Source predicate (called-911 ?caller - character ?sick-person - character).",
        "(at ?character - character ?room - room)": "The character is at the specified place, which may be a room."
    },
    "operators": {
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - item)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "clean-item": "(:action clean-item\n :parameters (?character - character ?item - item)\n :precondition (and (alive ?character) (has ?character ?item) (not (clean ?item)))\n :effect (clean ?item)\n)",
        "adjust-item": "(:action adjust-item\n :parameters (?character - character ?item - item)\n :precondition (and (alive ?character) (has ?character ?item) (not (fits ?item ?character)))\n :effect (fits ?item ?character)\n)",
        "wear-item": "(:action wear-item\n :parameters (?character - character ?item - item)\n :precondition (and (alive ?character) (has ?character ?item) (fits ?item ?character) (not (wearing ?character ?item)))\n :effect (wearing ?character ?item)\n)",
        "call-911": "(:action call-911\n :parameters (?caller - character ?sick-person - character)\n :precondition (and (sick ?sick-person) (not (called-911 ?caller ?sick-person)))\n :effect (called-911 ?caller ?sick-person)\n)",
        "move :parameters (?character - character ?from-place - place ?to-place - place) :precondition (and (not (= ?from-place ?to-place)) (at ?character ?from-place)) :effect (and (not (at ?character ?from-place)) (at ?character ?to-place)))": "(:action move :parameters (?character - character ?from-place - place ?to-place - place) :precondition (and (not (= ?from-place ?to-place)) (at ?character ?from-place)) :effect (and (not (at ?character ?from-place)) (at ?character ?to-place)))",
        "take-item :parameters (?character - character ?item - item ?place - room) :precondition (and (at ?character ?place) (in ?item ?place)) :effect (and (not (in ?item ?place)) (has ?character ?item)))": "(:action take-item :parameters (?character - character ?item - item ?place - room) :precondition (and (at ?character ?place) (in ?item ?place)) :effect (and (not (in ?item ?place)) (has ?character ?item)))",
        "leave-item :parameters (?character - character ?item - item ?place - place) :precondition (and (at ?character ?place) (has ?character ?item)) :effect (and (not (has ?character ?item)) (in ?item ?place)))": "(:action leave-item :parameters (?character - character ?item - item ?place - place) :precondition (and (at ?character ?place) (has ?character ?item)) :effect (and (not (has ?character ?item)) (in ?item ?place)))"
    }
