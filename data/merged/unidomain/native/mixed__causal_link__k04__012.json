    "operators": {
        "interrogate-character :parameters (?questioner - character ?subject - character ?place - location) :precondition (and (player ?questioner) (at ?questioner ?place) (at ?subject ?place) (apprehended ?subject)) :effect (knows ?questioner))": "(:action interrogate-character :parameters (?questioner - character ?subject - character ?place - location) :precondition (and (player ?questioner) (at ?questioner ?place) (at ?subject ?place) (apprehended ?subject)) :effect (knows ?questioner))",
        "place-victim :parameters (?character1 - character ?character2 - character ?from - location ?to - location) :precondition (and (henchman ?character1) (has ?character1 ?character2) (at ?character1 ?from) (connected ?to ?from)) :effect (and (not (has ?character1 ?character2)) (at ?character2 ?to) (captured ?character2)))": "(:action place-victim :parameters (?character1 - character ?character2 - character ?from - location ?to - location) :precondition (and (henchman ?character1) (has ?character1 ?character2) (at ?character1 ?from) (connected ?to ?from)) :effect (and (not (has ?character1 ?character2)) (at ?character2 ?to) (captured ?character2)))",
        "save-character :parameters (?rescuer - character ?captive - character ?p - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?captive ?place) (captured ?captive) (captured ?p) (not (at ?p ?place))) :effect (and (saved ?captive ?rescuer) (not (alive ?p))))": "(:action save-character :parameters (?rescuer - character ?captive - character ?p - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?captive ?place) (captured ?captive) (captured ?p) (not (at ?p ?place))) :effect (and (saved ?captive ?rescuer) (not (alive ?p))))",
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "move-location": "(:action move-location :parameters (?traveler - character ?to - location ?from - location) :precondition (and (player ?traveler) (connected ?to ?from) (at ?traveler ?from) (knows ?traveler) (not (hospitalised ?traveler))) :effect (and (not (at ?traveler ?from)) (at ?traveler ?to)))",
        "lose-consciousness :parameters (?p - patient ?t - treatment ?s - symptom ?location - location) :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?location)) :effect (and (unconscious ?p) (not (conscious ?p))))": "(:action lose-consciousness :parameters (?p - patient ?t - treatment ?s - symptom ?location - location) :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?location)) :effect (and (unconscious ?p) (not (conscious ?p))))",
        "hide :parameters (?character - character ?toy - toy ?location - location) :precondition (at ?character ?location) :effect (hidden ?toy ?location))": "(:action hide :parameters (?character - character ?toy - toy ?location - location) :precondition (at ?character ?location) :effect (hidden ?toy ?location))",
        "search :parameters (?character - character ?location - location) :precondition (and (at ?character ?location) (not (searched ?character ?location))) :effect (searched ?character ?location))": "(:action search :parameters (?character - character ?location - location) :precondition (and (at ?character ?location) (not (searched ?character ?location))) :effect (searched ?character ?location))",
        "find :parameters (?character - character ?toy - toy ?location - location) :precondition (and (at ?character ?location) (hidden ?toy ?location) (searched ?character ?location)) :effect (found ?toy))": "(:action find :parameters (?character - character ?toy - toy ?location - location) :precondition (and (at ?character ?location) (hidden ?toy ?location) (searched ?character ?location)) :effect (found ?toy))",
        "move :parameters (?character - character ?source_location ?destination_location - location) :precondition (and (not (= ?source_location ?destination_location)) (at ?character ?source_location)) :effect (and (not (at ?character ?source_location)) (at ?character ?destination_location)))": "(:action move :parameters (?character - character ?source_location ?destination_location - location) :precondition (and (not (= ?source_location ?destination_location)) (at ?character ?source_location)) :effect (and (not (at ?character ?source_location)) (at ?character ?destination_location)))",
        "assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (patient-room ?p ?location) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))": "(:action assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (patient-room ?p ?location) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))",
        "mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - location ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))": "(:action mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - location ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))",
        "treat :parameters (?d - doctor ?p - patient ?t - treatment ?location - location) :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (patient-room ?p ?location) (not (receiving-treatment ?p ?t))) :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t)))": "(:action treat :parameters (?d - doctor ?p - patient ?t - treatment ?location - location) :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (patient-room ?p ?location) (not (receiving-treatment ?p ?t))) :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t)))",
        "recover :parameters (?p - patient ?t - treatment ?s - symptom ?location - location) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?location) (patient-room ?p ?location) (has-symptom ?p ?s)) :effect (and (not (has-symptom ?p ?s))))": "(:action recover :parameters (?p - patient ?t - treatment ?s - symptom ?location - location) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?location) (patient-room ?p ?location) (has-symptom ?p ?s)) :effect (and (not (has-symptom ?p ?s))))",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?location - location)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?location) (patient-room ?p ?location))\n :effect (and (not (alive ?p)))\n)",
        "admit :parameters (?d - doctor ?p - patient ?location - medicalloc ?from ?to - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?location) (at ?d ?location) (not (occupied ?location)) (not (hospitalised ?p)) (level-of-work ?d ?from) (connected ?to ?from) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?location) (occupied ?location) (not (level-of-work ?d ?from)) (level-of-work ?d ?to)))": "(:action admit :parameters (?d - doctor ?p - patient ?location - medicalloc ?from ?to - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?location) (at ?d ?location) (not (occupied ?location)) (not (hospitalised ?p)) (level-of-work ?d ?from) (connected ?to ?from) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?location) (occupied ?location) (not (level-of-work ?d ?from)) (level-of-work ?d ?to)))"
    }
