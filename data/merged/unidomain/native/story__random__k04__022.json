{
    "predicates": {
        "(at ?object - object ?place - location)": "Source predicate (at ?object - object ?place - location).",
        "(can-fly ?animal - animal)": "Source predicate (can-fly ?animal - animal).",
        "(can-run ?character - character)": "Source predicate (can-run ?character - character).",
        "(playing ?character - character ?target - (either animal item))": "The character is playing with an animal or an item.",
        "(broken ?item - item)": "Source predicate (broken ?item - item).",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(apologized ?apologizer - character ?apologizee - character)": "Source predicate (apologized ?apologizer - character ?apologizee - character).",
        "(cleaned ?character - character)": "Source predicate (cleaned ?character - character).",
        "(forgiven ?forgiver - character ?forgivee - character)": "Source predicate (forgiven ?forgiver - character ?forgivee - character).",
        "(playing ?character - character ?item - item)": "The character is playing with an animal or an item.",
        "(happy ?character - character)": "The character is happy.",
        "(worried ?character - character)": "Source predicate (worried ?character - character).",
        "(accepted-to-university ?character - character)": "Source predicate (accepted-to-university ?character - character).",
        "(applauding ?character - character)": "Source predicate (applauding ?character - character).",
        "(hardworking ?character - character)": "Source predicate (hardworking ?character - character).",
        "(dreams-come-true ?character - character)": "Source predicate (dreams-come-true ?character - character).",
        "(needs-walk ?character - character)": "Source predicate (needs-walk ?character - character).",
        "(in-herenow ?character - character)": "Source predicate (in-herenow ?character - character).",
        "(ancient-oath ?dog - character)": "Source predicate (ancient-oath ?dog - character).",
        "(guardian ?dog - character)": "Source predicate (guardian ?dog - character).",
        "(master ?character - character)": "Source predicate (master ?character - character).",
        "(time-of-passing)": "Source predicate (time-of-passing)."
    },
    "operators": {
        "move": "(:action move\n :parameters (?object - object ?from - location ?to - location)\n :precondition (and (not (= ?from ?to)) (at ?object ?from))\n :effect (and (not (at ?object ?from)) (at ?object ?to))\n)",
        "can-run": "(:action can-run\n :parameters (?character - character)\n :precondition (and)\n :effect (can-run ?character)\n)",
        "can-fly": "(:action can-fly\n :parameters (?animal - animal)\n :precondition (and)\n :effect (can-fly ?animal)\n)",
        "stop-playing :parameters (?character - character ?target - (either animal item)) :precondition (playing ?character ?target) :effect (not (playing ?character ?target)))": "(:action stop-playing :parameters (?character - character ?target - (either animal item)) :precondition (playing ?character ?target) :effect (not (playing ?character ?target)))",
        "apologize": "(:action apologize\n :parameters (?apologizer - character ?apologizee - character)\n :precondition (not (= ?apologizer ?apologizee))\n :effect (apologized ?apologizer ?apologizee)\n)",
        "clean": "(:action clean\n :parameters (?cleaner - character ?item - item)\n :precondition (broken ?item)\n :effect (cleaned ?cleaner)\n)",
        "forgive": "(:action forgive\n :parameters (?forgiver - character ?forgivee - character)\n :precondition (and (not (= ?forgiver ?forgivee)) (apologized ?forgivee ?forgiver))\n :effect (forgiven ?forgiver ?forgivee)\n)",
        "play": "(:action play :parameters (?character - character ?target - item ?place - location) :precondition (and (at ?character ?place) (at ?target ?place) (not (broken ?target)) (has ?character ?target)) :effect (playing ?character ?target))",
        "break-item :parameters (?character - character ?target - item) :precondition (and (not (broken ?target)) (playing ?character ?target)) :effect (broken ?target))": "(:action break-item :parameters (?character - character ?target - item) :precondition (and (not (broken ?target)) (playing ?character ?target)) :effect (broken ?target))",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (and)\n :effect (happy ?character)\n)",
        "stop-applauding": "(:action stop-applauding\n :parameters (?character - character)\n :precondition (applauding ?character)\n :effect (not (applauding ?character))\n)",
        "make-dreams-come-true": "(:action make-dreams-come-true\n :parameters (?character - character)\n :precondition (and (accepted-to-university ?character) (hardworking ?character))\n :effect (dreams-come-true ?character)\n)",
        "remind-ancient-oath": "(:action remind-ancient-oath\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (ancient-oath ?dog))\n :effect (needs-walk ?master)\n)",
        "bring-to-herenow": "(:action bring-to-herenow\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (not (in-herenow ?master)))\n :effect (in-herenow ?master)\n)",
        "walk": "(:action walk\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (needs-walk ?master))\n :effect (and (not (needs-walk ?master)) (in-herenow ?master))\n)",
        "time-of-passing": "(:action time-of-passing\n :parameters ()\n :precondition (not (time-of-passing))\n :effect (time-of-passing)\n)",
        "get-accepted": "(:action get-accepted\n :parameters (?character - character)\n :precondition (and (worried ?character) (hardworking ?character))\n :effect (and (accepted-to-university ?character) (not (worried ?character)) (happy ?character))\n)",
        "start-applauding": "(:action start-applauding\n :parameters (?character - character ?other - character)\n :precondition (and (not (applauding ?character)) (happy ?other))\n :effect (applauding ?character)\n)"
    }
}