{
    "predicates": {
        "(in-love ?character1 - character ?character2 - character)": "Source predicate (in-love ?character1 - character ?character2 - character).",
        "(accepts-past ?character1 - character ?character2 - character)": "Source predicate (accepts-past ?character1 - character ?character2 - character).",
        "(knows-self ?character - character)": "Source predicate (knows-self ?character - character).",
        "(sings ?character - character)": "Source predicate (sings ?character - character).",
        "(spirits-present ?character - character)": "Source predicate (spirits-present ?character - character).",
        "(spirits-gone ?character - character)": "Source predicate (spirits-gone ?character - character).",
        "(weak ?character - character)": "Source predicate (weak ?character - character).",
        "(love-driven-away ?character - character)": "Source predicate (love-driven-away ?character - character).",
        "(in-asylum ?character - character)": "Source predicate (in-asylum ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(alive ?character - character)": "The character is alive.",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(riding ?character - character ?vehicle - vehicle)": "Source predicate (riding ?character - character ?vehicle - vehicle).",
        "(relaxed ?character - character)": "Source predicate (relaxed ?character - character).",
        "(flying ?character - character)": "Source predicate (flying ?character - character).",
        "(in-vehicle ?character - character ?vehicle - vehicle)": "Source predicate (in-vehicle ?character - character ?vehicle - vehicle).",
        "(feeling ?character - character)": "Source predicate (feeling ?character - character).",
        "(last-soul ?character - character)": "Source predicate (last-soul ?character - character).",
        "(understand ?character - character)": "Source predicate (understand ?character - character).",
        "(witness ?character - character)": "Source predicate (witness ?character - character).",
        "(end ?character - character)": "Source predicate (end ?character - character)."
    },
    "operators": {
        "sing": "(:action sing\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (sings ?character)\n)",
        "fall-in-love": "(:action fall-in-love\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (alive ?character1) (alive ?character2))\n :effect (in-love ?character1 ?character2)\n)",
        "accept-past": "(:action accept-past\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (alive ?character1) (alive ?character2))\n :effect (accepts-past ?character1 ?character2)\n)",
        "know-self": "(:action know-self\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (knows-self ?character)\n)",
        "become-weak": "(:action become-weak\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (weak ?character)\n)",
        "drive-away-love": "(:action drive-away-love\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (love-driven-away ?character)\n)",
        "end-up-in-asylum": "(:action end-up-in-asylum\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (in-asylum ?character)\n)",
        "ask-spirits-to-leave": "(:action ask-spirits-to-leave\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (and (spirits-gone ?character) (not (spirits-present ?character)))\n)",
        "regret-asking-spirits-to-leave": "(:action regret-asking-spirits-to-leave\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-gone ?character))\n :effect (spirits-present ?character)\n)",
        "start-riding": "(:action start-riding\n :parameters (?character - character ?vehicle - vehicle)\n :precondition (and (alive ?character) (has ?character ?vehicle) (not (riding ?character ?vehicle)))\n :effect (riding ?character ?vehicle)\n)",
        "stop-riding": "(:action stop-riding\n :parameters (?character - character ?vehicle - vehicle)\n :precondition (and (alive ?character) (riding ?character ?vehicle))\n :effect (not (riding ?character ?vehicle))\n)",
        "start-flying": "(:action start-flying\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (flying ?character)))\n :effect (flying ?character)\n)",
        "stop-flying": "(:action stop-flying\n :parameters (?character - character)\n :precondition (and (alive ?character) (flying ?character))\n :effect (not (flying ?character))\n)",
        "try-relax": "(:action try-relax\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (relaxed ?character)))\n :effect (relaxed ?character)\n)",
        "stop-relax": "(:action stop-relax\n :parameters (?character - character)\n :precondition (and (alive ?character) (relaxed ?character))\n :effect (not (relaxed ?character))\n)",
        "start-feeling": "(:action start-feeling\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (feeling ?character)))\n :effect (feeling ?character)\n)",
        "witness-end": "(:action witness-end\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (witness ?character)))\n :effect (witness ?character)\n)",
        "understand-end": "(:action understand-end\n :parameters (?character - character)\n :precondition (and (alive ?character) (witness ?character) (not (understand ?character)))\n :effect (understand ?character)\n)",
        "last-soul-fades": "(:action last-soul-fades\n :parameters (?character - character)\n :precondition (and (alive ?character) (last-soul ?character) (understand ?character))\n :effect (not (alive ?character))\n)",
        "humanity-ends": "(:action humanity-ends\n :parameters (?character - character)\n :precondition (and (alive ?character) (understand ?character) (not (end ?character)))\n :effect (end ?character)\n)",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))"
    }
}