    "operators": {
        "interrogate-character": "(:action interrogate-character\n :parameters (?interrogator - character ?interrogated - character ?location - location)\n :precondition (and (player ?interrogator) (at ?interrogator ?location) (at ?interrogated ?location) (apprehended ?interrogated))\n :effect (knows ?interrogator)\n)",
        "place-victim :parameters (?placer - character ?victim - character ?from - location ?to - location) :precondition (and (henchman ?placer) (has ?placer ?victim) (at ?placer ?from) (connected ?to ?from)) :effect (and (not (has ?placer ?victim)) (at ?victim ?to) (captured ?victim)))": "(:action place-victim :parameters (?placer - character ?victim - character ?from - location ?to - location) :precondition (and (henchman ?placer) (has ?placer ?victim) (at ?placer ?from) (connected ?to ?from)) :effect (and (not (has ?placer ?victim)) (at ?victim ?to) (captured ?victim)))",
        "save-character :parameters (?saver - character ?saved - character ?p - character ?location - location) :precondition (and (player ?saver) (at ?saver ?location) (at ?saved ?location) (captured ?saved) (captured ?p) (not (at ?p ?location))) :effect (and (saved ?saved ?saver) (not (alive ?p))))": "(:action save-character :parameters (?saver - character ?saved - character ?p - character ?location - location) :precondition (and (player ?saver) (at ?saver ?location) (at ?saved ?location) (captured ?saved) (captured ?p) (not (at ?p ?location))) :effect (and (saved ?saved ?saver) (not (alive ?p))))",
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "move-location": "(:action move-location :parameters (?character - character ?destination - location ?origin - location) :precondition (and (player ?character) (connected ?destination ?origin) (at ?character ?origin) (knows ?character) (not (hospitalised ?character))) :effect (and (not (at ?character ?origin)) (at ?character ?destination)))",
        "move :parameters (?thing - character ?location1 ?location2 - location) :precondition (and (at ?thing ?location1)) :effect (and (at ?thing ?location2) (not (at ?thing ?location1))))": "(:action move :parameters (?thing - character ?location1 ?location2 - location) :precondition (and (at ?thing ?location1)) :effect (and (at ?thing ?location2) (not (at ?thing ?location1))))",
        "lose-consciousness :parameters (?thing - patient ?t - treatment ?s - symptom ?location - location) :precondition (and (receiving-treatment ?thing ?t) (conscious ?thing) (at ?thing ?location)) :effect (and (unconscious ?thing) (not (conscious ?thing))))": "(:action lose-consciousness :parameters (?thing - patient ?t - treatment ?s - symptom ?location - location) :precondition (and (receiving-treatment ?thing ?t) (conscious ?thing) (at ?thing ?location)) :effect (and (unconscious ?thing) (not (conscious ?thing))))",
        "assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (patient-room ?p ?location) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))": "(:action assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (patient-room ?p ?location) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))",
        "mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))": "(:action mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?location) (at ?d ?location) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))",
        "treat :parameters (?doctor - doctor ?patient - patient ?treatment - treatment ?location - medicalloc) :precondition (and (treatment-prescribed ?patient ?treatment) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (patient-room ?patient ?location) (not (receiving-treatment ?patient ?treatment))) :effect (and (not (treatment-prescribed ?patient ?treatment)) (receiving-treatment ?patient ?treatment)))": "(:action treat :parameters (?doctor - doctor ?patient - patient ?treatment - treatment ?location - medicalloc) :precondition (and (treatment-prescribed ?patient ?treatment) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (patient-room ?patient ?location) (not (receiving-treatment ?patient ?treatment))) :effect (and (not (treatment-prescribed ?patient ?treatment)) (receiving-treatment ?patient ?treatment)))",
        "recover :parameters (?thing - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?thing ?t) (alive ?thing) (at ?thing ?location) (patient-room ?thing ?location) (has-symptom ?thing ?s)) :effect (and (not (has-symptom ?thing ?s))))": "(:action recover :parameters (?thing - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?thing ?t) (alive ?thing) (at ?thing ?location) (patient-room ?thing ?location) (has-symptom ?thing ?s)) :effect (and (not (has-symptom ?thing ?s))))",
        "die :parameters (?thing - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?thing ?t) (alive ?thing) (at ?thing ?location) (patient-room ?thing ?location)) :effect (and (not (alive ?thing))))": "(:action die :parameters (?thing - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?thing ?t) (alive ?thing) (at ?thing ?location) (patient-room ?thing ?location)) :effect (and (not (alive ?thing))))",
        "admit :parameters (?doctor - doctor ?patient - patient ?location - medicalloc ?from ?to - level) :precondition (and (alive ?doctor) (alive ?patient) (at ?patient ?location) (at ?doctor ?location) (not (occupied ?location)) (not (hospitalised ?patient)) (level-of-work ?doctor ?from) (connected ?to ?from) (the-doctor ?doctor)) :effect (and (the-doctor-treating ?patient) (hospitalised ?patient) (patient-room ?patient ?location) (occupied ?location) (not (level-of-work ?doctor ?from)) (level-of-work ?doctor ?to)))": "(:action admit :parameters (?doctor - doctor ?patient - patient ?location - medicalloc ?from ?to - level) :precondition (and (alive ?doctor) (alive ?patient) (at ?patient ?location) (at ?doctor ?location) (not (occupied ?location)) (not (hospitalised ?patient)) (level-of-work ?doctor ?from) (connected ?to ?from) (the-doctor ?doctor)) :effect (and (the-doctor-treating ?patient) (hospitalised ?patient) (patient-room ?patient ?location) (occupied ?location) (not (level-of-work ?doctor ?from)) (level-of-work ?doctor ?to)))"
    }
