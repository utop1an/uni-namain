    },
    "operators": {
        "wake-person": "(:action wake-person\n :parameters (?waker - character ?woken - character ?location - location)\n :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker)))\n :effect (not (asleep ?woken))\n)",
        "take-thing :parameters (?taker - character ?target - (either item character) ?location - location) :precondition (and (at ?taker ?location) (at ?target ?location) (not (asleep ?taker)) (not (enchanted ?target))) :effect (and (not (at ?target ?location)) (has ?taker ?target)))": "(:action take-thing :parameters (?taker - character ?target - (either item character) ?location - location) :precondition (and (at ?taker ?location) (at ?target ?location) (not (asleep ?taker)) (not (enchanted ?target))) :effect (and (not (at ?target ?location)) (has ?taker ?target)))",
        "disenchant-thing :parameters (?caster - character ?thing - item ?target - (either item character) ?location - location) :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?target) (enchanted ?thing)) :effect (not (enchanted ?thing)))": "(:action disenchant-thing :parameters (?caster - character ?thing - item ?target - (either item character) ?location - location) :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?target) (enchanted ?thing)) :effect (not (enchanted ?thing)))",
        "move-location": "(:action move-location :parameters (?character - character ?to - location ?from - location) :precondition (and (player ?character) (connected ?to ?from) (at ?character ?from) (knows ?character) (not (asleep ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "interrogate-character": "(:action interrogate-character :parameters (?interrogator - character ?interrogated - character ?location - location) :precondition (and (player ?interrogator) (at ?interrogator ?location) (at ?interrogated ?location) (apprehended ?interrogated)) :effect (knows ?interrogator))",
        "save-character": "(:action save-character :parameters (?saver - character ?saved - character ?notsaved - character ?location - location) :precondition (and (player ?saver) (at ?saver ?location) (at ?saved ?location) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?location))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))",
        "place-victim": "(:action place-victim :parameters (?placer - character ?victim - character ?location - location ?placed - location) :precondition (and (henchman ?placer) (has ?placer ?victim) (at ?placer ?location) (connected ?placed ?location)) :effect (and (not (has ?placer ?victim)) (at ?victim ?placed) (captured ?victim)))"
    }
