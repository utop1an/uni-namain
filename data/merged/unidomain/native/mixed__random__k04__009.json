        "die :parameters (?subject - (either creature character)) :precondition (alive ?subject) :effect (not (alive ?subject)))": "(:action die :parameters (?subject - (either creature character)) :precondition (alive ?subject) :effect (not (alive ?subject)))",
        "travel": "(:action travel :parameters (?entity - (either creature character) ?from - place ?to - place) :precondition (and (alive ?entity) (at ?entity ?from) (not (= ?from ?to))) :effect (and (at ?entity ?to) (not (at ?entity ?from))))",
        "kill-wolves :parameters (?object - character ?place - place) :precondition (and (alive ?object) (at ?object ?place) (wolves-attack ?place)) :effect (wolves-killed ?object))": "(:action kill-wolves :parameters (?object - character ?place - place) :precondition (and (alive ?object) (at ?object ?place) (wolves-attack ?place)) :effect (wolves-killed ?object))",
