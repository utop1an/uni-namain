        "accept :parameters (?acceptor - person ?proposer - person ?place - place) :precondition (and (alive ?acceptor) (at ?acceptor ?place) (alive ?proposer) (at ?proposer ?place) (hasproposed ?proposer ?acceptor)) :effect (hasaccepted ?acceptor ?proposer))": "(:action accept :parameters (?acceptor - person ?proposer - person ?place - place) :precondition (and (alive ?acceptor) (at ?acceptor ?place) (alive ?proposer) (at ?proposer ?place) (hasproposed ?proposer ?acceptor)) :effect (hasaccepted ?acceptor ?proposer))",
        "marry :parameters (?entity - person ?partner - person ?place - place) :precondition (and (alive ?entity) (at ?entity ?place) (hasproposed ?entity ?partner) (single ?entity) (alive ?partner) (at ?partner ?place) (hasaccepted ?partner ?entity) (single ?partner)) :effect (and (marriedto ?entity ?partner) (marriedto ?partner ?entity) (not (single ?entity)) (not (single ?partner)) (forall (?item - valuable) (when (has ?entity ?item) (rich ?partner))) (when (loves ?entity ?partner) (happy ?entity)) (when (loves ?partner ?entity) (happy ?partner))))": "(:action marry :parameters (?entity - person ?partner - person ?place - place) :precondition (and (alive ?entity) (at ?entity ?place) (hasproposed ?entity ?partner) (single ?entity) (alive ?partner) (at ?partner ?place) (hasaccepted ?partner ?entity) (single ?partner)) :effect (and (marriedto ?entity ?partner) (marriedto ?partner ?entity) (not (single ?entity)) (not (single ?partner)) (forall (?item - valuable) (when (has ?entity ?item) (rich ?partner))) (when (loves ?entity ?partner) (happy ?entity)) (when (loves ?partner ?entity) (happy ?partner))))",
        "steal :parameters (?entity - (either creature character) ?owner - creature ?item - item ?place - place) :precondition (and (not (= ?entity ?owner)) (alive ?entity) (at ?entity ?place) (at ?item ?place) (belongsto ?item ?owner)) :effect (and (has ?entity ?item) (when (forall (?v - valuable) (not (has ?owner ?v))) (not (rich ?owner)))))": "(:action steal :parameters (?entity - (either creature character) ?owner - creature ?item - item ?place - place) :precondition (and (not (= ?entity ?owner)) (alive ?entity) (at ?entity ?place) (at ?item ?place) (belongsto ?item ?owner)) :effect (and (has ?entity ?item) (when (forall (?v - valuable) (not (has ?owner ?v))) (not (rich ?owner)))))",
        "start-task": "(:action start-task\n :parameters (?robot - robot)\n :precondition (and (assembled ?robot) (not (working-on-task ?robot)))\n :effect (working-on-task ?robot)\n)",
        "stop-game": "(:action stop-game\n :parameters (?character - character)\n :precondition (playing-game ?character)\n :effect (not (playing-game ?character))\n)",
