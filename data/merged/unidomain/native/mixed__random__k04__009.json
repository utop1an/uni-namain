        "read :parameters (?holder - (either creature character) ?book - book) :precondition (and (has ?holder ?book) (not (fell-down ?book))) :effect (and))": "(:action read :parameters (?holder - (either creature character) ?book - book) :precondition (and (has ?holder ?book) (not (fell-down ?book))) :effect (and))",
