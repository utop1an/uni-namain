{
    "predicates": {
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(anchored ?light - lightbox)": "Source predicate (anchored ?light - lightbox).",
        "(charged ?light - lightbox)": "Source predicate (charged ?light - lightbox).",
        "(created ?character - character ?light - lightbox)": "Source predicate (created ?character - character ?light - lightbox).",
        "(used ?character - character ?light - lightbox)": "Source predicate (used ?character - character ?light - lightbox).",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(player ?character - character)": "Source predicate (player ?character - character).",
        "(at ?character - character ?location - location)": "Source predicate (at ?character - character ?location - location).",
        "(at ?thing - item ?location - location)": "Source predicate (at ?thing - item ?location - location).",
        "(asleep ?character - character)": "Source predicate (asleep ?character - character).",
        "(connected ?location - location ?oldlocation - location)": "Source predicate (connected ?location - location ?oldlocation - location).",
        "(enchanted ?item - item)": "Source predicate (enchanted ?item - item).",
        "(is ?item - item ?thing - thing)": "Source predicate (is ?item - item ?thing - thing).",
        "(at-carnival ?character - character)": "Source predicate (at-carnival ?character - character).",
        "(wants-to-play ?character - character)": "Source predicate (wants-to-play ?character - character).",
        "(played ?character - character)": "Source predicate (played ?character - character).",
        "(weight-too-low ?character - character)": "Source predicate (weight-too-low ?character - character).",
        "(upset ?character - character)": "Source predicate (upset ?character - character).",
        "(comforted ?character - character)": "Source predicate (comforted ?character - character)."
    },
    "operators": {
        "charge-lightbox": "(:action charge-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (anchored ?lightbox) (created ?character ?lightbox))\n :effect (charged ?lightbox)\n)",
        "create-lightbox": "(:action create-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (alive ?character)\n :effect (and (created ?character ?lightbox) (has ?character ?lightbox))\n)",
        "anchor-light": "(:action anchor-light\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (created ?character ?lightbox) (has ?character ?lightbox))\n :effect (anchored ?lightbox)\n)",
        "use-lightbox": "(:action use-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (charged ?lightbox) (created ?character ?lightbox) (has ?character ?lightbox))\n :effect (and (used ?character ?lightbox) (not (charged ?lightbox)))\n)",
        "move-location": "(:action move-location\n :parameters (?character - character ?to - location ?from - location)\n :precondition (and (connected ?to ?from) (not (asleep ?character)) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "wake-person": "(:action wake-person\n :parameters (?waker - character ?woken - character ?location - location)\n :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker)))\n :effect (not (asleep ?woken))\n)",
        "go-to-carnival": "(:action go-to-carnival\n :parameters (?character - character)\n :precondition (and)\n :effect (at-carnival ?character)\n)",
        "want-to-play": "(:action want-to-play\n :parameters (?character - character)\n :precondition (at-carnival ?character)\n :effect (wants-to-play ?character)\n)",
        "play-game": "(:action play-game\n :parameters (?character - character)\n :precondition (and (at-carnival ?character) (wants-to-play ?character))\n :effect (and (played ?character) (weight-too-low ?character))\n)",
        "become-upset": "(:action become-upset\n :parameters (?character - character)\n :precondition (weight-too-low ?character)\n :effect (upset ?character)\n)",
        "comfort": "(:action comfort\n :parameters (?comforter - character ?comforted - character)\n :precondition (and (not (= ?comforter ?comforted)) (upset ?comforted))\n :effect (comforted ?comforted)\n)",
        "take-thing": "(:action take-thing\n :parameters (?taker - character ?thing - item ?location - location)\n :precondition (and (at ?taker ?location) (at ?thing ?location) (not (asleep ?taker)) (not (enchanted ?thing)))\n :effect (and (not (at ?thing ?location)) (has ?taker ?thing))\n)",
        "disenchant-thing": "(:action disenchant-thing\n :parameters (?caster - character ?thing - item ?book - book ?location - location)\n :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?book) (enchanted ?thing))\n :effect (not (enchanted ?thing))\n)"
    }
}