        "give :parameters (?c1 ?c2 - human ?t - thing ?location - object) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?t) (at ?c1 ?location) (at ?c2 ?location)) :effect (and (has ?c2 ?t) (not (has ?c1 ?t))))": "(:action give :parameters (?c1 ?c2 - human ?t - thing ?location - object) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?t) (at ?c1 ?location) (at ?c2 ?location)) :effect (and (has ?c2 ?t) (not (has ?c1 ?t))))",
