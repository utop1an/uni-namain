{
    "predicates": {
        "(scared ?character - character)": "Source predicate (scared ?character - character).",
        "(spider-on-wall)": "Source predicate (spider-on-wall).",
        "(cake-made)": "Source predicate (cake-made).",
        "(helping ?helper - character ?helpee - character)": "Character ?helper is helping character ?helpee.",
        "(happy ?character - character)": "The character is happy.",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(on-shelf ?item - item)": "Source predicate (on-shelf ?item - item).",
        "(organized ?place - place)": "Source predicate (organized ?place - place).",
        "(reads ?character - character)": "Source predicate (reads ?character - character).",
        "(playing-with-toys ?character - character)": "Source predicate (playing-with-toys ?character - character).",
        "(found-blocks ?character - character)": "Source predicate (found-blocks ?character - character).",
        "(stacking-blocks ?character - character)": "Source predicate (stacking-blocks ?character - character).",
        "(stack-tall ?character - character)": "Source predicate (stack-tall ?character - character).",
        "(stack-strong ?character - character)": "Source predicate (stack-strong ?character - character)."
    },
    "operators": {
        "see-spider": "(:action see-spider\n :parameters (?character - character)\n :precondition (and (not (scared ?character)) (not (spider-on-wall)))\n :effect (and (scared ?character) (spider-on-wall))\n)",
        "remove-spider": "(:action remove-spider\n :parameters (?character - character ?helpee - character)\n :precondition (and (spider-on-wall) (helping ?character ?helpee))\n :effect (not (spider-on-wall))\n)",
        "make-cake": "(:action make-cake\n :parameters (?character - character)\n :precondition (and (not (cake-made)) (happy ?character))\n :effect (cake-made)\n)",
        "find": "(:action find\n :parameters (?character - character ?item - item)\n :precondition (and (not (has ?character ?item)) (reads ?character))\n :effect (has ?character ?item)\n)",
        "put-on-shelf": "(:action put-on-shelf\n :parameters (?character - character ?item - item ?place - place)\n :precondition (and (has ?character ?item) (at ?character ?place))\n :effect (and (not (has ?character ?item)) (on-shelf ?item) (organized ?place))\n)",
        "play-with-toys": "(:action play-with-toys\n :parameters (?character - character)\n :precondition (and)\n :effect (playing-with-toys ?character)\n)",
        "find-blocks": "(:action find-blocks\n :parameters (?character - character)\n :precondition (playing-with-toys ?character)\n :effect (found-blocks ?character)\n)",
        "stack-blocks": "(:action stack-blocks\n :parameters (?character - character)\n :precondition (found-blocks ?character)\n :effect (stacking-blocks ?character)\n)",
        "make-stack-tall": "(:action make-stack-tall\n :parameters (?character - character)\n :precondition (stacking-blocks ?character)\n :effect (stack-tall ?character)\n)",
        "help": "(:action help :parameters (?helper - character ?helpee - character) :precondition (and (not (= ?helper ?helpee)) (scared ?helpee) (stack-tall ?helpee)) :effect (and (not (scared ?helpee)) (happy ?helpee) (helping ?helper ?helpee)))",
        "make-stack-strong": "(:action make-stack-strong\n :parameters (?character - character)\n :precondition (and (stack-tall ?character) (helping ?character ?character))\n :effect (stack-strong ?character)\n)",
        "read": "(:action read\n :parameters (?character - character)\n :precondition (reads ?character)\n :effect (happy ?character)\n)",
        "smell-soap": "(:action smell-soap\n :parameters (?character - character ?soap - item)\n :precondition (and (on-shelf ?soap) (reads ?character))\n :effect (happy ?character)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (stack-strong ?character)\n :effect (happy ?character)\n)"
    }
}