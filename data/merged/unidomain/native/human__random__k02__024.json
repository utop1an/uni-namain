        "enter :parameters (?c - character ?source - (either house room) ?destination - room) :precondition (and (not (locked ?destination)) (at ?c ?source)) :effect (and (not (at ?c ?source)) (at ?c ?destination)))": "(:action enter :parameters (?c - character ?source - (either house room) ?destination - room) :precondition (and (not (locked ?destination)) (at ?c ?source)) :effect (and (not (at ?c ?source)) (at ?c ?destination)))",
