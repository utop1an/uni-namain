        "kill :parameters (?character - character ?m - wolf ?thing - thing ?location - (either house room)) :precondition (and (alive ?character) (alive ?m) (has ?character ?thing) (at ?character ?location) (at ?m ?location) (monster ?m) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?character - character ?m - wolf ?thing - thing ?location - (either house room)) :precondition (and (alive ?character) (alive ?m) (has ?character ?thing) (at ?character ?location) (at ?m ?location) (monster ?m) (monster-alive) (rescuer ?character)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "give :parameters (?giver ?recipient - human ?thing - thing ?location - (either house room)) :precondition (and (not (eaten ?recipient)) (alive ?giver) (alive ?recipient) (has ?giver ?thing) (at ?giver ?location) (at ?recipient ?location)) :effect (and (has ?recipient ?thing) (not (has ?giver ?thing))))": "(:action give :parameters (?giver ?recipient - human ?thing - thing ?location - (either house room)) :precondition (and (not (eaten ?recipient)) (alive ?giver) (alive ?recipient) (has ?giver ?thing) (at ?giver ?location) (at ?recipient ?location)) :effect (and (has ?recipient ?thing) (not (has ?giver ?thing))))",
