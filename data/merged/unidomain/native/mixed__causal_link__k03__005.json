    "operators": {
        "stop-touching": "(:action stop-touching\n :parameters (?character - character ?object - object)\n :precondition (touching ?character ?object)\n :effect (not (touching ?character ?object))\n)",
        "get-hurt": "(:action get-hurt\n :parameters (?character - character)\n :precondition (not (hurt ?character))\n :effect (hurt ?character)\n)",
        "get-scared": "(:action get-scared\n :parameters (?character - character)\n :precondition (not (scared ?character))\n :effect (scared ?character)\n)",
        "stop-scared": "(:action stop-scared\n :parameters (?character - character)\n :precondition (scared ?character)\n :effect (not (scared ?character))\n)",
        "hug": "(:action hug\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (hugging ?character1 ?character2)) (not (hugging ?character2 ?character1)))\n :effect (hugging ?character1 ?character2)\n)",
        "stop-hug": "(:action stop-hug\n :parameters (?character1 - character ?character2 - character)\n :precondition (hugging ?character1 ?character2)\n :effect (not (hugging ?character1 ?character2))\n)",
        "touch": "(:action touch\n :parameters (?character - character ?object - object ?location - object)\n :precondition (and (not (touching ?character ?object)) (at ?character ?location))\n :effect (touching ?character ?object)\n)",
        "move-location": "(:action move-location :parameters (?actor - character ?destination - location ?origin - location) :precondition (and (not (at ?actor ?destination)) (not (scared ?actor)) (player ?actor) (connected ?destination ?origin) (at ?actor ?origin) (knows ?actor)) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination)))",
        "interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - object) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))": "(:action interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - object) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))",
        "save-character :parameters (?saver - character ?saved - character ?notsaved - character ?location - object) :precondition (and (player ?saver) (at ?saver ?location) (at ?saved ?location) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?location))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))": "(:action save-character :parameters (?saver - character ?saved - character ?notsaved - character ?location - object) :precondition (and (player ?saver) (at ?saver ?location) (at ?saved ?location) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?location))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))",
        "place-victim :parameters (?actor - character ?captive - character ?source - location ?destination - location) :precondition (and (henchman ?actor) (has ?actor ?captive) (at ?actor ?source) (connected ?destination ?source)) :effect (and (not (has ?actor ?captive)) (at ?captive ?destination) (captured ?captive)))": "(:action place-victim :parameters (?actor - character ?captive - character ?source - location ?destination - location) :precondition (and (henchman ?actor) (has ?actor ?captive) (at ?actor ?source) (connected ?destination ?source)) :effect (and (not (has ?actor ?captive)) (at ?captive ?destination) (captured ?captive)))"
    }
