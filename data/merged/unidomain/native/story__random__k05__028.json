    },
    "operators": {
        "sing": "(:action sing\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (sings ?character)\n)",
        "fall-in-love": "(:action fall-in-love\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (alive ?character1) (alive ?character2))\n :effect (in-love ?character1 ?character2)\n)",
        "accept-past": "(:action accept-past\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (alive ?character1) (alive ?character2))\n :effect (accepts-past ?character1 ?character2)\n)",
        "know-self": "(:action know-self\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (knows-self ?character)\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-time ?character)))\n :effect (dead ?character)\n)",
        "present-plan": "(:action present-plan\n :parameters (?character - character)\n :precondition (and (alive ?character) (has-plan ?character))\n :effect (and (has-idea ?character) (when (has-tv-show-reference ?character) (not (has-creative-plan ?character))))\n)",
        "decide-fate": "(:action decide-fate\n :parameters (?council - character ?character - character)\n :precondition (and (alive ?council) (alive ?character) (has-idea ?character))\n :effect (when (has-creative-plan ?character) (and (has-better-plan ?character) (has-time ?character)))\n)",
        "become-nervous": "(:action become-nervous\n :parameters (?character - character)\n :precondition (and)\n :effect (nervous ?character)\n)",
        "become-composed": "(:action become-composed\n :parameters (?character - character)\n :precondition (and)\n :effect (composed ?character)\n)",
        "try": "(:action try\n :parameters (?character - character)\n :precondition (kneel ?character)\n :effect (tried ?character)\n)",
        "reward": "(:action reward\n :parameters (?character - character)\n :precondition (voice-happy ?character)\n :effect (rewarded ?character)\n)",
        "take-skin": "(:action take-skin\n :parameters (?character - character)\n :precondition (and (not (voice-happy ?character)) (has-skin ?character))\n :effect (not (has-skin ?character))\n)",
        "read": "(:action read\n :parameters (?character - character ?book - book)\n :precondition (and (has ?character ?book) (not (fell-down ?book)))\n :effect (and)\n)",
        "sneeze": "(:action sneeze\n :parameters (?character - character)\n :precondition (and)\n :effect (sneezed ?character)\n)",
        "book-fall": "(:action book-fall\n :parameters (?book - book ?bookshelf - bookshelf)\n :precondition (on-shelf ?book ?bookshelf)\n :effect (and (fell-down ?book) (not (on-shelf ?book ?bookshelf)))\n)",
        "get-scared": "(:action get-scared\n :parameters (?character - character)\n :precondition (sneezed ?character)\n :effect (scared ?character)\n)",
        "move-to-kitchen": "(:action move-to-kitchen\n :parameters (?character - character)\n :precondition (in-room ?character)\n :effect (and (not (in-room ?character)) (in-kitchen ?character))\n)",
        "move-to-room": "(:action move-to-room\n :parameters (?character - character)\n :precondition (in-kitchen ?character)\n :effect (and (not (in-kitchen ?character)) (in-room ?character))\n)",
        "enter": "(:action enter\n :parameters (?character - character ?place - place)\n :precondition (not (at ?character ?place))\n :effect (at ?character ?place)\n)",
        "notice": "(:action notice\n :parameters (?character - character ?box - box ?place - place)\n :precondition (and (at ?character ?place) (at ?box ?place))\n :effect (noticed ?character ?box)\n)",
        "open-box": "(:action open-box\n :parameters (?character - character ?box - box ?place - place)\n :precondition (and (at ?character ?place) (at ?box ?place) (noticed ?character ?box) (not (opened ?box)))\n :effect (opened ?box)\n)",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "kneel": "(:action kneel\n :parameters (?character - character)\n :precondition (at ?character old-house)\n :effect (kneel ?character)\n)",
        "evaluate": "(:action evaluate\n :parameters (?character - character)\n :precondition (tried ?character)\n :effect (voice-happy ?character)\n)"
    }
}