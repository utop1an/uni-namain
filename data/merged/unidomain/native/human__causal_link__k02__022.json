        "walk :parameters (?character - character ?location1 ?location2 - location) :precondition (and (at ?character ?location1) (not (hospitalised ?character))) :effect (and (at ?character ?location2) (not (at ?character ?location1))))": "(:action walk :parameters (?character - character ?location1 ?location2 - location) :precondition (and (at ?character ?location1) (not (hospitalised ?character))) :effect (and (at ?character ?location2) (not (at ?character ?location1))))",
        "move-location": "(:action move-location :parameters (?character - character ?destination - location ?origin - location) :precondition (and (connected ?destination ?origin) (not (asleep ?character)) (at ?character ?origin)) :effect (and (not (at ?character ?origin)) (at ?character ?destination)))",
        "assess :parameters (?doctor - doctor ?patient - patient ?symptom - symptom ?treatment - treatment ?location - medicalloc ?workload - level) :precondition (and (level-of-work ?doctor ?workload) (not (= ?workload three)) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (patient-room ?patient ?location) (has-symptom ?patient ?symptom) (treatment-for ?treatment ?symptom)) :effect (and (treatment-prescribed ?patient ?treatment)))": "(:action assess :parameters (?doctor - doctor ?patient - patient ?symptom - symptom ?treatment - treatment ?location - medicalloc ?workload - level) :precondition (and (level-of-work ?doctor ?workload) (not (= ?workload three)) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (patient-room ?patient ?location) (has-symptom ?patient ?symptom) (treatment-for ?treatment ?symptom)) :effect (and (treatment-prescribed ?patient ?treatment)))",
        "mistake-assess :parameters (?doctor - doctor ?patient - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?doctor ?w) (= ?w three) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (has-symptom ?patient ?s) (treatment-for ?t ?s) (not (receiving-treatment ?patient ?t))) :effect (and (wrong-treatment-prescribed ?patient ?t) (the-doctor-overworked) (the-doctor-mistake)))": "(:action mistake-assess :parameters (?doctor - doctor ?patient - patient ?s - symptom ?t - treatment ?location - medicalloc ?w - level) :precondition (and (level-of-work ?doctor ?w) (= ?w three) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (has-symptom ?patient ?s) (treatment-for ?t ?s) (not (receiving-treatment ?patient ?t))) :effect (and (wrong-treatment-prescribed ?patient ?t) (the-doctor-overworked) (the-doctor-mistake)))",
        "treat :parameters (?doctor - doctor ?patient - patient ?treatment - treatment ?location - medicalloc) :precondition (and (treatment-prescribed ?patient ?treatment) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (patient-room ?patient ?location) (not (receiving-treatment ?patient ?treatment))) :effect (and (not (treatment-prescribed ?patient ?treatment)) (receiving-treatment ?patient ?treatment)))": "(:action treat :parameters (?doctor - doctor ?patient - patient ?treatment - treatment ?location - medicalloc) :precondition (and (treatment-prescribed ?patient ?treatment) (alive ?patient) (the-doctor ?doctor) (the-doctor-treating ?patient) (at ?patient ?location) (at ?doctor ?location) (patient-room ?patient ?location) (not (receiving-treatment ?patient ?treatment))) :effect (and (not (treatment-prescribed ?patient ?treatment)) (receiving-treatment ?patient ?treatment)))",
        "recover :parameters (?character - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?character ?t) (alive ?character) (at ?character ?location) (patient-room ?character ?location) (has-symptom ?character ?s)) :effect (and (not (has-symptom ?character ?s))))": "(:action recover :parameters (?character - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?character ?t) (alive ?character) (at ?character ?location) (patient-room ?character ?location) (has-symptom ?character ?s)) :effect (and (not (has-symptom ?character ?s))))",
        "die :parameters (?character - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?character ?t) (alive ?character) (at ?character ?location) (patient-room ?character ?location)) :effect (and (not (alive ?character))))": "(:action die :parameters (?character - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?character ?t) (alive ?character) (at ?character ?location) (patient-room ?character ?location)) :effect (and (not (alive ?character))))",
        "lose-consciousness :parameters (?character - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?character ?t) (conscious ?character) (at ?character ?location)) :effect (and (unconscious ?character) (not (conscious ?character))))": "(:action lose-consciousness :parameters (?character - patient ?t - treatment ?s - symptom ?location - medicalloc) :precondition (and (receiving-treatment ?character ?t) (conscious ?character) (at ?character ?location)) :effect (and (unconscious ?character) (not (conscious ?character))))",
        "admit :parameters (?doctor - doctor ?patient - patient ?location - medicalloc ?from ?to - level) :precondition (and (alive ?doctor) (alive ?patient) (at ?patient ?location) (at ?doctor ?location) (not (occupied ?location)) (not (hospitalised ?patient)) (level-of-work ?doctor ?from) (connected ?from ?to) (the-doctor ?doctor)) :effect (and (the-doctor-treating ?patient) (hospitalised ?patient) (patient-room ?patient ?location) (occupied ?location) (not (level-of-work ?doctor ?from)) (level-of-work ?doctor ?to)))": "(:action admit :parameters (?doctor - doctor ?patient - patient ?location - medicalloc ?from ?to - level) :precondition (and (alive ?doctor) (alive ?patient) (at ?patient ?location) (at ?doctor ?location) (not (occupied ?location)) (not (hospitalised ?patient)) (level-of-work ?doctor ?from) (connected ?from ?to) (the-doctor ?doctor)) :effect (and (the-doctor-treating ?patient) (hospitalised ?patient) (patient-room ?patient ?location) (occupied ?location) (not (level-of-work ?doctor ?from)) (level-of-work ?doctor ?to)))"
