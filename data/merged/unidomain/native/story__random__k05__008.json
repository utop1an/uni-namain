    "operators": {
        "declare-war": "(:action declare-war\n :parameters (?nation1 - nation ?nation2 - nation)\n :precondition (not (= ?nation1 ?nation2))\n :effect (at-war ?nation1 ?nation2)\n)",
        "defeat-navy": "(:action defeat-navy\n :parameters (?nation1 - nation ?nation2 - nation)\n :precondition (and (not (= ?nation1 ?nation2)) (at-war ?nation1 ?nation2))\n :effect (navy-defeated ?nation1 ?nation2)\n)",
        "settle": "(:action settle\n :parameters (?nation - nation ?place - object)\n :precondition (and)\n :effect (settled ?nation ?place)\n)",
        "establish-trading": "(:action establish-trading\n :parameters (?nation - nation)\n :precondition (and)\n :effect (trading ?nation)\n)",
        "establish-plantation": "(:action establish-plantation\n :parameters (?nation - nation ?place - object)\n :precondition (and)\n :effect (plantation ?nation ?place)\n)",
        "establish-farm-estate": "(:action establish-farm-estate\n :parameters (?nation - nation ?place - object)\n :precondition (and)\n :effect (farm-estate ?nation ?place)\n)",
        "engage-slave-trade": "(:action engage-slave-trade\n :parameters (?nation - nation)\n :precondition (and)\n :effect (slave-trade ?nation)\n)",
        "take-toy :parameters (?taker - character ?victim - character ?object - object) :precondition (and (not (= ?taker ?victim)) (has ?victim ?object) (not (has ?taker ?object))) :effect (and (not (has ?victim ?object)) (has ?taker ?object) (sad ?victim)))": "(:action take-toy :parameters (?taker - character ?victim - character ?object - object) :precondition (and (not (= ?taker ?victim)) (has ?victim ?object) (not (has ?taker ?object))) :effect (and (not (has ?victim ?object)) (has ?taker ?object) (sad ?victim)))",
        "receive-gift :parameters (?receiver - character ?giver - character ?object - object) :precondition (and (not (= ?receiver ?giver)) (happy ?giver) (not (has ?receiver ?object)) (has ?giver ?object)) :effect (and (has ?receiver ?object) (happy ?receiver)))": "(:action receive-gift :parameters (?receiver - character ?giver - character ?object - object) :precondition (and (not (= ?receiver ?giver)) (happy ?giver) (not (has ?receiver ?object)) (has ?giver ?object)) :effect (and (has ?receiver ?object) (happy ?receiver)))",
        "play :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (not (sad ?character))) :effect (happy ?character))": "(:action play :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (not (sad ?character))) :effect (happy ?character))",
        "lose-toy :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (happy ?character)) :effect (and (not (has ?character ?object)) (sad ?character)))": "(:action lose-toy :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (happy ?character)) :effect (and (not (has ?character ?object)) (sad ?character)))",
        "become-ruler": "(:action become-ruler\n :parameters (?character - character ?nation - nation)\n :precondition (alive ?character)\n :effect (ruler ?character ?nation)\n)",
        "build": "(:action build\n :parameters (?character - character ?structure - object ?place - object)\n :precondition (alive ?character)\n :effect (built ?character ?structure ?place)\n)",
        "go-to-shop": "(:action go-to-shop\n :parameters (?character - character)\n :precondition (not (at-shop ?character))\n :effect (at-shop ?character)\n)",
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "stop-applauding": "(:action stop-applauding\n :parameters (?character - character)\n :precondition (applauding ?character)\n :effect (not (applauding ?character))\n)",
        "make-dreams-come-true": "(:action make-dreams-come-true\n :parameters (?character - character)\n :precondition (and (accepted-to-university ?character) (hardworking ?character))\n :effect (dreams-come-true ?character)\n)",
        "fix-pedal :parameters (?character - character ?item - object) :precondition (and (at-shop ?character) (has ?character ?item) (broken-pedal ?item)) :effect (and (not (broken-pedal ?item)) (fixed-pedal ?item)))": "(:action fix-pedal :parameters (?character - character ?item - object) :precondition (and (at-shop ?character) (has ?character ?item) (broken-pedal ?item)) :effect (and (not (broken-pedal ?item)) (fixed-pedal ?item)))",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "get-accepted": "(:action get-accepted\n :parameters (?character - character)\n :precondition (and (worried ?character) (hardworking ?character))\n :effect (and (accepted-to-university ?character) (not (worried ?character)) (happy ?character))\n)",
        "start-applauding": "(:action start-applauding\n :parameters (?character - character ?other - character)\n :precondition (and (not (applauding ?character)) (happy ?other))\n :effect (applauding ?character)\n)",
        "start-feeling": "(:action start-feeling\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (feeling ?character)))\n :effect (feeling ?character)\n)",
        "witness-end": "(:action witness-end\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (witness ?character)))\n :effect (witness ?character)\n)",
        "understand-end": "(:action understand-end\n :parameters (?character - character)\n :precondition (and (alive ?character) (witness ?character) (not (understand ?character)))\n :effect (understand ?character)\n)",
        "last-soul-fades": "(:action last-soul-fades\n :parameters (?character - character)\n :precondition (and (alive ?character) (last-soul ?character) (understand ?character))\n :effect (not (alive ?character))\n)",
        "humanity-ends": "(:action humanity-ends\n :parameters (?character - character)\n :precondition (and (alive ?character) (understand ?character) (not (end ?character)))\n :effect (end ?character)\n)"
    }
