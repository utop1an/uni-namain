        "turn-on-device :parameters (?character - character ?device - device) :precondition (and (awake ?character) (has ?character ?device) (not (device-on ?device))) :effect (device-on ?device))": "(:action turn-on-device :parameters (?character - character ?device - device) :precondition (and (awake ?character) (has ?character ?device) (not (device-on ?device))) :effect (device-on ?device))",
        "check-connectivity :parameters (?actor - character ?device - device) :precondition (and (awake ?actor) (device-on ?device) (has ?actor ?device)) :effect (when (device-connected ?device) (working ?device)))": "(:action check-connectivity :parameters (?actor - character ?device - device) :precondition (and (awake ?actor) (device-on ?device) (has ?actor ?device)) :effect (when (device-connected ?device) (working ?device)))",
        "smell-nice :parameters (?character - character ?item - (either item device dress)) :precondition (has ?character ?item) :effect (smells-nice ?character))": "(:action smell-nice :parameters (?character - character ?item - (either item device dress)) :precondition (has ?character ?item) :effect (smells-nice ?character))",
