{
    "predicates": {
        "(liberated ?character - character)": "Source predicate (liberated ?character - character).",
        "(defeated-illuminati)": "Source predicate (defeated-illuminati).",
        "(alien-exists ?character - character)": "Source predicate (alien-exists ?character - character).",
        "(alien-gone ?character - character)": "Source predicate (alien-gone ?character - character).",
        "(bachelor ?x - canmarry)": "Source predicate (bachelor ?x - canmarry).",
        "(bachelor-loves ?x - person)": "Source predicate (bachelor-loves ?x - person).",
        "(loves-bachelor ?x - person)": "Source predicate (loves-bachelor ?x - person).",
        "(magic-char ?x - character)": "Source predicate (magic-char ?x - character).",
        "(controls-magic ?x - person ?t - thing)": "Source predicate (controls-magic ?x - person ?t - thing).",
        "(magic-char-alive)": "Source predicate (magic-char-alive).",
        "(scary ?x0 - monster)": "Source predicate (scary ?x0 - monster).",
        "(single ?x0 - person)": "Source predicate (single ?x0 - person).",
        "(beautiful ?x0 - female)": "Source predicate (beautiful ?x0 - female).",
        "(magic ?t - thing)": "Source predicate (magic ?t - thing).",
        "(controls ?x0 - person ?x1 - ismagic ?t - thing)": "Source predicate (controls ?x0 - person ?x1 - ismagic ?t - thing).",
        "(married-to ?x0 - person ?x1 - person)": "Source predicate (married-to ?x0 - person ?x1 - person).",
        "(loves ?x0 - person ?x1 - person)": "Source predicate (loves ?x0 - person ?x1 - person).",
        "(loyal-to ?x0 - character ?x1 - character)": "Source predicate (loyal-to ?x0 - character ?x1 - character).",
        "(at ?x0 - character ?x1 - location)": "Source predicate (at ?x0 - character ?x1 - location).",
        "(in ?x0 - spirit ?x1 - thing)": "Source predicate (in ?x0 - spirit ?x1 - thing).",
        "(has ?x0 - character ?x1 - thing)": "Source predicate (has ?x0 - character ?x1 - thing).",
        "(confined ?x0 - spirit)": "Source predicate (confined ?x0 - spirit).",
        "(alive ?x0 - character)": "Source predicate (alive ?x0 - character).",
        "(intends-not-alive ?intender ?c - character)": "Source predicate (intends-not-alive ?intender ?c - character).",
        "(intends-has ?intender ?c - character ?t - thing)": "Source predicate (intends-has ?intender ?c - character ?t - thing).",
        "(intends-loves ?intender ?c1 ?c2 - character)": "Source predicate (intends-loves ?intender ?c1 ?c2 - character).",
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character)."
    },
    "operators": {
        "liberate": "(:action liberate\n :parameters (?alien - character ?human - character)\n :precondition (and (alien-exists ?alien) (not (liberated ?human)))\n :effect (liberated ?human)\n)",
        "defeat-illuminati": "(:action defeat-illuminati\n :parameters (?alien - character)\n :precondition (and (alien-exists ?alien) (not (defeated-illuminati)))\n :effect (defeated-illuminati)\n)",
        "disappear": "(:action disappear\n :parameters (?alien - character)\n :precondition (alien-exists ?alien)\n :effect (alien-gone ?alien)\n)",
        "reappear": "(:action reappear\n :parameters (?alien - character)\n :precondition (alien-gone ?alien)\n :effect (alien-exists ?alien)\n)",
        "travel": "(:action travel\n :parameters (?traveller - character ?from ?to - location)\n :precondition (and (at ?traveller ?from) (alive ?traveller) (not (= ?from ?to)))\n :effect (and (at ?traveller ?to) (not (at ?traveller ?from)))\n)",
        "slay": "(:action slay\n :parameters (?slayer - knight ?m - monster ?place - location)\n :precondition (and (at ?slayer ?place) (at ?m ?place) (alive ?slayer) (alive ?m) (not (= ?slayer ?m)) (intends-not-alive ?slayer ?m))\n :effect (and (not (alive ?m)))\n)",
        "slay-magic-char": "(:action slay-magic-char\n :parameters (?slayer - knight ?m - monster ?place - location)\n :precondition (and (at ?slayer ?place) (at ?m ?place) (alive ?slayer) (not (= ?slayer ?m)) (intends-not-alive ?slayer ?m) (magic-char ?m) (alive ?m) (magic-char-alive))\n :effect (and (not (alive ?m)) (magic-char ?m) (not (magic-char-alive)))\n)",
        "pillage": "(:action pillage\n :parameters (?pillager ?body - character ?t - thing ?place - location)\n :precondition (and (at ?pillager ?place) (at ?body ?place) (alive ?pillager) (not (alive ?body)) (has ?body ?t) (not (has ?pillager ?t)) (not (= ?pillager ?body)))\n :effect (and (has ?pillager ?t) (not (has ?body ?t)))\n)",
        "give": "(:action give\n :parameters (?giver ?givee - character ?t - thing ?place - location)\n :precondition (and (not (= ?giver ?givee)) (at ?giver ?place) (at ?givee ?place) (alive ?givee) (alive ?giver) (has ?giver ?t) (not (has ?givee ?t)) (intends-has ?giver ?givee ?t))\n :effect (and (has ?givee ?t) (not (has ?giver ?t)))\n)",
        "summon": "(:action summon\n :parameters (?char - person ?g - ismagic ?lamp - thing ?place - location)\n :precondition (and (confined ?g) (magic ?lamp) (at ?char ?place) (has ?char ?lamp) (in ?g ?lamp) (alive ?char) (not (= ?char ?g)) (magic-char ?g) (magic-char-alive))\n :effect (and (at ?g ?place) (controls ?char ?g ?lamp) (controls-magic ?char ?lamp) (not (in ?g ?lamp)) (not (confined ?g)))\n)",
        "love-spell": "(:action love-spell\n :parameters (?g - genie ?target - person ?lover - canmarry)\n :precondition (and (not (confined ?g)) (not (loves ?target ?lover)) (magic-char ?g) (magic-char-alive) (alive ?target) (alive ?lover) (not (= ?g ?target)) (not (= ?g ?lover)) (not (= ?target ?lover)) (intends-loves ?g ?target ?lover) (bachelor ?lover))\n :effect (and (loves ?target ?lover) (loves-bachelor ?target))\n)",
        "marry": "(:action marry\n :parameters (?groom - canmarry ?bride - person ?place - location)\n :precondition (and (alive ?groom) (alive ?bride) (at ?groom ?place) (at ?bride ?place) (loves ?groom ?bride) (loves ?bride ?groom) (single ?groom) (bachelor ?groom) (single ?bride) (not (= ?groom ?bride)))\n :effect (and (married-to ?groom ?bride) (married-to ?bride ?groom) (not (single ?groom)) (not (single ?bride)))\n)",
        "fall-in-love": "(:action fall-in-love\n :parameters (?m - canmarry ?f - female ?place - location)\n :precondition (and (bachelor ?m) (at ?m ?place) (at ?f ?place) (single ?m) (alive ?m) (alive ?f) (not (loves ?m ?f)) (beautiful ?f))\n :effect (and (loves ?m ?f) (bachelor-loves ?f))\n)",
        "order": "(:action order\n :parameters (?ki - king ?kn - knight ?place - location ?t - thing)\n :precondition (and (loyal-to ?kn ?ki) (alive ?kn) (alive ?ki) (at ?ki ?place) (at ?kn ?place))\n :effect (and (intends-has ?kn ?ki ?t))\n)",
        "appear-threatening": "(:action appear-threatening\n :parameters (?m - monster ?char - person ?place - location)\n :precondition (and (alive ?m) (alive ?char) (at ?m ?place) (at ?char ?place) (scary ?m) (not (= ?m ?char)))\n :effect (and (intends-not-alive ?char ?m))\n)",
        "command": "(:action command\n :parameters (?char - person ?g - genie ?love - person ?lamp - thing ?place - location)\n :precondition (and (magic ?lamp) (has ?char ?lamp) (controls ?char ?g ?lamp) (alive ?char) (magic-char ?g) (magic-char-alive) (alive ?love) (at ?char ?place) (at ?g ?place) (loves ?char ?love) (not (loves ?love ?char)) (not (= ?char ?g)) (not (= ?char ?love)))\n :effect (and (intends-loves ?g ?love ?char))\n)",
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)"
    }
}