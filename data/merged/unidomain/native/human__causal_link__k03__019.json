        "place-victim": "(:action place-victim :parameters (?acting-character - character ?target-entity - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?target-entity) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?target-entity)) (at ?target-entity ?destination-location) (captured ?target-entity)))"
    }
