        "unlock :parameters (?character - character ?entity - key ?room - room) :precondition (and (locked ?room) (unlocked-by ?room ?entity) (has ?character ?entity)) :effect (and (not (locked ?room))))": "(:action unlock :parameters (?character - character ?entity - key ?room - room) :precondition (and (locked ?room) (unlocked-by ?room ?entity) (has ?character ?entity)) :effect (and (not (locked ?room))))",
        "search-for :parameters (?character - character ?entity - (either character thing) ?location - room) :precondition (and (at ?character ?location) (in ?entity ?location)) :effect (and (has ?character ?entity) (not (in ?entity ?location))))": "(:action search-for :parameters (?character - character ?entity - (either character thing) ?location - room) :precondition (and (at ?character ?location) (in ?entity ?location)) :effect (and (has ?character ?entity) (not (in ?entity ?location))))",
