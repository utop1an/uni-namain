{
    "predicates": {
        "(kind ?character - character)": "Source predicate (kind ?character - character).",
        "(knows-wisdom ?character - character)": "Source predicate (knows-wisdom ?character - character).",
        "(dead ?character - character)": "Source predicate (dead ?character - character).",
        "(has-plan ?character - character)": "Source predicate (has-plan ?character - character).",
        "(has-time ?character - character)": "Source predicate (has-time ?character - character).",
        "(has-idea ?character - character)": "Source predicate (has-idea ?character - character).",
        "(has-tv-show-reference ?character - character)": "Source predicate (has-tv-show-reference ?character - character).",
        "(has-creative-plan ?character - character)": "Source predicate (has-creative-plan ?character - character).",
        "(has-better-plan ?character - character)": "Source predicate (has-better-plan ?character - character).",
        "(friends ?c1 - character ?c2 - character)": "Character ?c1 is friends with character ?c2.",
        "(missing ?character - character)": "The character is missing or lost; their whereabouts are unknown.",
        "(found ?searcher - character ?target - character)": "The searcher has found the target character.",
        "(alive ?character - character)": "The character is alive.",
        "(knows ?character1 - character ?character2 - character)": "Source predicate (knows ?character1 - character ?character2 - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(relationship ?character1 - character ?character2 - character)": "Source predicate (relationship ?character1 - character ?character2 - character).",
        "(searching ?searcher - character ?target - character)": "Source predicate (searching ?searcher - character ?target - character).",
        "(broken-pedal ?bike - object)": "Source predicate (broken-pedal ?bike - object).",
        "(fixed-pedal ?bike - object)": "Source predicate (fixed-pedal ?bike - object).",
        "(has ?character - character ?bike - object)": "Source predicate (has ?character - character ?bike - object).",
        "(at-shop ?character - character)": "Source predicate (at-shop ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(flying ?bike - object)": "Source predicate (flying ?bike - object).",
        "(hungry ?character - character)": "Source predicate (hungry ?character - character).",
        "(food-available)": "Source predicate (food-available).",
        "(friend ?character1 - character ?character2 - character)": "Character ?c1 is friends with character ?c2."
    },
    "operators": {
        "become-kind": "(:action become-kind\n :parameters (?character - character)\n :precondition (not (kind ?character))\n :effect (kind ?character)\n)",
        "learn-wisdom": "(:action learn-wisdom\n :parameters (?learner - character ?teacher - character)\n :precondition (and (not (knows-wisdom ?learner)) (knows-wisdom ?teacher))\n :effect (knows-wisdom ?learner)\n)",
        "help :parameters (?searcher - character ?target - character) :precondition (and (kind ?searcher) (lost ?target)) :effect (found ?searcher ?target))": "(:action help :parameters (?searcher - character ?target - character) :precondition (and (kind ?searcher) (lost ?target)) :effect (found ?searcher ?target))",
        "present-plan": "(:action present-plan\n :parameters (?character - character)\n :precondition (and (alive ?character) (has-plan ?character))\n :effect (and (has-idea ?character) (when (has-tv-show-reference ?character) (not (has-creative-plan ?character))))\n)",
        "decide-fate": "(:action decide-fate\n :parameters (?council - character ?character - character)\n :precondition (and (alive ?council) (alive ?character) (has-idea ?character))\n :effect (when (has-creative-plan ?character) (and (has-better-plan ?character) (has-time ?character)))\n)",
        "die": "(:action die\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-time ?character)))\n :effect (dead ?character)\n)",
        "stop-search": "(:action stop-search\n :parameters (?searcher - character ?target - character)\n :precondition (searching ?searcher ?target)\n :effect (not (searching ?searcher ?target))\n)",
        "start-relationship": "(:action start-relationship\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (not (relationship ?character1 ?character2)) (knows ?character1 ?character2))\n :effect (relationship ?character1 ?character2)\n)",
        "end-relationship": "(:action end-relationship\n :parameters (?character1 - character ?character2 - character)\n :precondition (relationship ?character1 ?character2)\n :effect (not (relationship ?character1 ?character2))\n)",
        "go-to-shop": "(:action go-to-shop\n :parameters (?character - character)\n :precondition (not (at-shop ?character))\n :effect (at-shop ?character)\n)",
        "fix-pedal": "(:action fix-pedal\n :parameters (?character - character ?bike - object)\n :precondition (and (at-shop ?character) (has ?character ?bike) (broken-pedal ?bike))\n :effect (and (not (broken-pedal ?bike)) (fixed-pedal ?bike))\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "start-search": "(:action start-search\n :parameters (?searcher - character ?target - character)\n :precondition (and (not (= ?searcher ?target)) (not (searching ?searcher ?target)) (missing ?target))\n :effect (searching ?searcher ?target)\n)",
        "find": "(:action find\n :parameters (?searcher - character ?target - character)\n :precondition (and (searching ?searcher ?target) (missing ?target))\n :effect (and (not (missing ?target)) (found ?searcher ?target))\n)",
        "search-for-food": "(:action search-for-food\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (food-available)\n)",
        "feed": "(:action feed\n :parameters (?feeder - character ?eater - character)\n :precondition (and (alive ?feeder) (alive ?eater) (hungry ?eater) (food-available))\n :effect (not (hungry ?eater))\n)",
        "eat": "(:action eat\n :parameters (?eater - character ?eaten - character)\n :precondition (and (alive ?eater) (hungry ?eater) (alive ?eaten))\n :effect (not (alive ?eaten))\n)",
        "become-friends": "(:action become-friends :parameters (?c1 - character ?c2 - character) :precondition (and (alive ?c1) (alive ?c2) (not (friends ?c1 ?c2)) (not (= ?c1 ?c2))) :effect (friends ?c1 ?c2))"
    }
}