    "operators": {
        "climb-tree": "(:action climb-tree\n :parameters (?character - character)\n :precondition (not (in-tree ?character))\n :effect (in-tree ?character)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and)\n :effect (helping ?helper ?helpee)\n)",
        "break-object": "(:action break-object\n :parameters (?character - character ?object - object ?helpee - character)\n :precondition (and (hard ?object) (helping ?character ?helpee))\n :effect (broken ?object)\n)",
        "interrogate-character :parameters (?player-character - character ?target-character - character ?current-location - location) :precondition (and (player ?player-character) (at ?player-character ?current-location) (at ?target-character ?current-location) (apprehended ?target-character)) :effect (knows ?player-character))": "(:action interrogate-character :parameters (?player-character - character ?target-character - character ?current-location - location) :precondition (and (player ?player-character) (at ?player-character ?current-location) (at ?target-character ?current-location) (apprehended ?target-character)) :effect (knows ?player-character))",
        "place-victim :parameters (?actor - character ?target - character ?origin - location ?destination - location) :precondition (and (henchman ?actor) (has ?actor ?target) (at ?actor ?origin) (connected ?destination ?origin)) :effect (and (not (has ?actor ?target)) (at ?target ?destination) (captured ?target)))": "(:action place-victim :parameters (?actor - character ?target - character ?origin - location ?destination - location) :precondition (and (henchman ?actor) (has ?actor ?target) (at ?actor ?origin) (connected ?destination ?origin)) :effect (and (not (has ?actor ?target)) (at ?target ?destination) (captured ?target)))",
        "save-character :parameters (?saving-character - character ?saved-character - character ?unsaved-character - character ?rescue-location - location) :precondition (and (player ?saving-character) (at ?saving-character ?rescue-location) (at ?saved-character ?rescue-location) (captured ?saved-character) (captured ?unsaved-character) (not (at ?unsaved-character ?rescue-location))) :effect (and (saved ?saved-character ?saving-character) (not (alive ?unsaved-character))))": "(:action save-character :parameters (?saving-character - character ?saved-character - character ?unsaved-character - character ?rescue-location - location) :precondition (and (player ?saving-character) (at ?saving-character ?rescue-location) (at ?saved-character ?rescue-location) (captured ?saved-character) (captured ?unsaved-character) (not (at ?unsaved-character ?rescue-location))) :effect (and (saved ?saved-character ?saving-character) (not (alive ?unsaved-character))))",
        "want-to-eat :parameters (?agent - character ?item - object) :precondition (and) :effect (wants-to-eat ?agent ?item))": "(:action want-to-eat :parameters (?agent - character ?item - object) :precondition (and) :effect (wants-to-eat ?agent ?item))",
        "try-to-eat :parameters (?actor - character ?item - object) :precondition (and (wants-to-eat ?actor ?item) (hard ?item)) :effect (not (eaten ?item)))": "(:action try-to-eat :parameters (?actor - character ?item - object) :precondition (and (wants-to-eat ?actor ?item) (hard ?item)) :effect (not (eaten ?item)))",
        "eat-together :parameters (?helper - character ?helpee - character ?item - object) :precondition (and (broken ?item) (helping ?helper ?helpee)) :effect (eaten ?item))": "(:action eat-together :parameters (?helper - character ?helpee - character ?item - object) :precondition (and (broken ?item) (helping ?helper ?helpee)) :effect (eaten ?item))",
        "rest": "(:action rest\n :parameters (?character - character)\n :precondition (tired ?character)\n :effect (not (tired ?character))\n)",
        "take-pill": "(:action take-pill\n :parameters (?character - character)\n :precondition (not (took-pill ?character))\n :effect (took-pill ?character)\n)",
        "ask-love-question": "(:action ask-love-question\n :parameters (?asker - character ?asked - character)\n :precondition (not (asked-question ?asker ?asked))\n :effect (asked-question ?asker ?asked)\n)",
        "confess-love": "(:action confess-love\n :parameters (?confessor - character ?confessed-to - character)\n :precondition (and (not (confessed ?confessor ?confessed-to)) (asked-question ?confessed-to ?confessor) (took-pill ?confessor))\n :effect (and (confessed ?confessor ?confessed-to) (loves ?confessor ?confessed-to))\n)",
        "move-location": "(:action move-location :parameters (?actor - character ?destination - location ?origin - location) :precondition (and (player ?actor) (connected ?destination ?origin) (at ?actor ?origin) (knows ?actor) (not (= ?origin ?destination))) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination)))",
        "play :parameters (?character1 - character ?character2 - character ?location - location) :precondition (and (not (= ?character1 ?character2)) (at ?character1 ?location) (at ?character2 ?location)) :effect (and (played-together ?character1 ?character2) (happy ?character1) (happy ?character2) (tired ?character1) (tired ?character2)))": "(:action play :parameters (?character1 - character ?character2 - character ?location - location) :precondition (and (not (= ?character1 ?character2)) (at ?character1 ?location) (at ?character2 ?location)) :effect (and (played-together ?character1 ?character2) (happy ?character1) (happy ?character2) (tired ?character1) (tired ?character2)))"
    }
