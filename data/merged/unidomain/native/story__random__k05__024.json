{
    "predicates": {
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(drunk ?character - character)": "Source predicate (drunk ?character - character).",
        "(night-show ?place - place)": "Source predicate (night-show ?place - place).",
        "(vomit-stain ?place - place)": "Source predicate (vomit-stain ?place - place).",
        "(liberated ?character - character)": "Source predicate (liberated ?character - character).",
        "(defeated-illuminati)": "Source predicate (defeated-illuminati).",
        "(alien-exists ?character - character)": "Source predicate (alien-exists ?character - character).",
        "(alien-gone ?character - character)": "Source predicate (alien-gone ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(wearing-clothes ?character - character)": "Source predicate (wearing-clothes ?character - character).",
        "(has-device ?character - character ?device - device)": "Source predicate (has-device ?character - character ?device - device).",
        "(device-on ?device - device)": "Source predicate (device-on ?device - device).",
        "(device-connected ?device - device)": "Source predicate (device-connected ?device - device).",
        "(electricity ?place - place)": "Source predicate (electricity ?place - place).",
        "(working ?device - device)": "Source predicate (working ?device - device).",
        "(school-canceled)": "Source predicate (school-canceled).",
        "(foggy ?place - place)": "Source predicate (foggy ?place - place).",
        "(found ?item - item)": "Source predicate (found ?item - item).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(sailor ?character - character)": "Source predicate (sailor ?character - character).",
        "(nice ?character - character)": "Source predicate (nice ?character - character).",
        "(sailing ?character - character)": "Source predicate (sailing ?character - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character)."
    },
    "operators": {
        "sober-up": "(:action sober-up\n :parameters (?character - character)\n :precondition (drunk ?character)\n :effect (not (drunk ?character))\n)",
        "disappear": "(:action disappear\n :parameters (?alien - character)\n :precondition (alien-exists ?alien)\n :effect (alien-gone ?alien)\n)",
        "reappear": "(:action reappear\n :parameters (?alien - character)\n :precondition (alien-gone ?alien)\n :effect (alien-exists ?alien)\n)",
        "vomit": "(:action vomit\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (drunk ?character) (at ?character ?place))\n :effect (vomit-stain ?place)\n)",
        "liberate": "(:action liberate\n :parameters (?alien - character ?human - character)\n :precondition (and (alien-exists ?alien) (not (liberated ?human)))\n :effect (liberated ?human)\n)",
        "defeat-illuminati": "(:action defeat-illuminati\n :parameters (?alien - character)\n :precondition (and (alien-exists ?alien) (not (defeated-illuminati)))\n :effect (defeated-illuminati)\n)",
        "drink": "(:action drink\n :parameters (?character - character ?drink - drink)\n :precondition (and (alive ?character) (has ?character ?drink))\n :effect (and (drunk ?character) (not (has ?character ?drink)))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "put-on-clothes": "(:action put-on-clothes\n :parameters (?character - character)\n :precondition (and (awake ?character) (not (wearing-clothes ?character)))\n :effect (wearing-clothes ?character)\n)",
        "cancel-school": "(:action cancel-school\n :parameters ()\n :precondition (not (school-canceled))\n :effect (school-canceled)\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (and)\n :effect (happy ?character)\n)",
        "clear-fog": "(:action clear-fog\n :parameters (?place - place)\n :precondition (foggy ?place)\n :effect (not (foggy ?place))\n)",
        "learn-to-sail": "(:action learn-to-sail\n :parameters (?character - character)\n :precondition (and)\n :effect (sailor ?character)\n)",
        "become-nice": "(:action become-nice\n :parameters (?character - character)\n :precondition (and)\n :effect (nice ?character)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (not (= ?helper ?helpee))\n :effect (helping ?helper ?helpee)\n)",
        "sail-together": "(:action sail-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sailor ?character1) (sailor ?character2))\n :effect (together ?character1 ?character2)\n)",
        "thank": "(:action thank\n :parameters (?thanker - character ?thankee - character)\n :precondition (not (= ?thanker ?thankee))\n :effect (nice ?thanker)\n)",
        "go-outside": "(:action go-outside\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (wearing-clothes ?character) (at ?character ?place))\n :effect (and (not (at ?character ?place)) (at ?character outside))\n)",
        "talk": "(:action talk\n :parameters (?speaker - character ?listener - character)\n :precondition (and (awake ?speaker) (awake ?listener) (at ?speaker outside) (at ?listener outside))\n :effect (and)\n)",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (alive ?character) (not (= ?from ?to)) (at ?character ?from) (not (at ?character ?to))) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "turn-on-device": "(:action turn-on-device\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (has-device ?character ?device) (not (device-on ?device)))\n :effect (device-on ?device)\n)",
        "check-connectivity": "(:action check-connectivity\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (device-on ?device) (has-device ?character ?device))\n :effect (when (device-connected ?device) (working ?device))\n)",
        "search": "(:action search\n :parameters (?character - character ?item - item ?place - place)\n :precondition (and (at ?character ?place) (not (found ?item)))\n :effect (when (not (foggy ?place)) (and (found ?item) (has ?character ?item)))\n)"
    }
}