        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "detect-stasis :parameters (?character - character ?item - (either dress mop item)) :precondition (and (alive ?character) (has ?character ?item) (ancient-technology ?item)) :effect (in-stasis ?item))": "(:action detect-stasis :parameters (?character - character ?item - (either dress mop item)) :precondition (and (alive ?character) (has ?character ?item) (ancient-technology ?item)) :effect (in-stasis ?item))",
