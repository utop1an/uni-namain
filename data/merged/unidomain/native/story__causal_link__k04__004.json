        "wear-item": "(:action wear-item :parameters (?character - character ?item - item) :precondition (and (alive ?character) (has ?character ?item) (fits ?item ?character) (not (wearing ?character ?item))) :effect (wearing ?character ?item))",
        "discover-technology :parameters (?character - character ?item - (either dress mop item) ?place - place) :precondition (and (alive ?character) (at ?character ?place)) :effect (and (has ?character ?item) (ancient-technology ?item)))": "(:action discover-technology :parameters (?character - character ?item - (either dress mop item) ?place - place) :precondition (and (alive ?character) (at ?character ?place)) :effect (and (has ?character ?item) (ancient-technology ?item)))",
        "transport-object :parameters (?character - character ?item - (either dress mop item) ?from - place ?to - place) :precondition (and (alive ?character) (at ?character ?from) (has ?character ?item) (requested-tow ?character ?to)) :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?item))))": "(:action transport-object :parameters (?character - character ?item - (either dress mop item) ?from - place ?to - place) :precondition (and (alive ?character) (at ?character ?from) (has ?character ?item) (requested-tow ?character ?to)) :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?item))))",
