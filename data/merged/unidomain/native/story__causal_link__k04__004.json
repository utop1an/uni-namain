        "receive-item :parameters (?character - character ?dog - character ?object - object ?place - place) :precondition (and (at ?character ?place) (at ?dog ?place) (has ?dog ?object)) :effect (and (not (has ?dog ?object)) (has ?character ?object)))": "(:action receive-item :parameters (?character - character ?dog - character ?object - object ?place - place) :precondition (and (at ?character ?place) (at ?dog ?place) (has ?dog ?object)) :effect (and (not (has ?dog ?object)) (has ?character ?object)))",
