{
    "predicates": {
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(party ?place - object)": "Source predicate (party ?place - object).",
        "(cake ?place - object)": "Source predicate (cake ?place - object).",
        "(at ?entity - (either item character) ?place - object)": "The item or character is at the specified location.",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(wearing-clothes ?character - character)": "Source predicate (wearing-clothes ?character - character).",
        "(has-device ?character - character ?device - device)": "Source predicate (has-device ?character - character ?device - device).",
        "(device-on ?device - device)": "Source predicate (device-on ?device - device).",
        "(device-connected ?device - device)": "Source predicate (device-connected ?device - device).",
        "(electricity ?place - place)": "Source predicate (electricity ?place - place).",
        "(working ?device - device)": "Source predicate (working ?device - device).",
        "(school-canceled)": "Source predicate (school-canceled).",
        "(at ?character - character ?place - place)": "The item or character is at the specified location."
    },
    "operators": {
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
        "start-party": "(:action start-party\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (party ?place)\n)",
        "enjoy-party": "(:action enjoy-party\n :parameters (?character - character ?place - object)\n :precondition (and (happy ?character) (party ?place))\n :effect (happy ?character)\n)",
        "put :parameters (?character - character ?entity - item ?place - object) :precondition (and (happy ?character) (has ?character ?entity)) :effect (at ?entity ?place))": "(:action put :parameters (?character - character ?entity - item ?place - object) :precondition (and (happy ?character) (has ?character ?entity)) :effect (at ?entity ?place))",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "put-on-clothes": "(:action put-on-clothes\n :parameters (?character - character)\n :precondition (and (awake ?character) (not (wearing-clothes ?character)))\n :effect (wearing-clothes ?character)\n)",
        "turn-on-device": "(:action turn-on-device\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (has-device ?character ?device) (not (device-on ?device)))\n :effect (device-on ?device)\n)",
        "check-connectivity": "(:action check-connectivity\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (device-on ?device) (has-device ?character ?device))\n :effect (when (device-connected ?device) (working ?device))\n)",
        "cancel-school": "(:action cancel-school\n :parameters ()\n :precondition (not (school-canceled))\n :effect (school-canceled)\n)",
        "go-outside :parameters (?entity - character ?location - object) :precondition (and (awake ?entity) (wearing-clothes ?entity) (at ?entity ?location)) :effect (and (not (at ?entity ?location)) (at ?entity outside)))": "(:action go-outside :parameters (?entity - character ?location - object) :precondition (and (awake ?entity) (wearing-clothes ?entity) (at ?entity ?location)) :effect (and (not (at ?entity ?location)) (at ?entity outside)))",
        "talk :parameters (?speaker_entity - character ?listener_entity - character) :precondition (and (awake ?speaker_entity) (awake ?listener_entity) (at ?speaker_entity outside) (at ?listener_entity outside)) :effect (and))": "(:action talk :parameters (?speaker_entity - character ?listener_entity - character) :precondition (and (awake ?speaker_entity) (awake ?listener_entity) (at ?speaker_entity outside) (at ?listener_entity outside)) :effect (and))"
    }
}