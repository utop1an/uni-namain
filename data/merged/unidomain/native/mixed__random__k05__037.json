        "activate-wingsuit :parameters (?c - character) :precondition (and (reached-altitude ?c) (reached-speed ?c) (not (wingsuit-active ?c))) :effect (wingsuit-active ?c))": "(:action activate-wingsuit :parameters (?c - character) :precondition (and (reached-altitude ?c) (reached-speed ?c) (not (wingsuit-active ?c))) :effect (wingsuit-active ?c))",
