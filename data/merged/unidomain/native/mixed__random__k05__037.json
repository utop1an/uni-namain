        "walk :parameters (?character - character ?place1 ?place2 - place) :precondition (and (at ?character ?place1) (not (hospitalised ?character))) :effect (and (at ?character ?place2) (not (at ?character ?place1))))": "(:action walk :parameters (?character - character ?place1 ?place2 - place) :precondition (and (at ?character ?place1) (not (hospitalised ?character))) :effect (and (at ?character ?place2) (not (at ?character ?place1))))",
        "move :parameters (?character - character ?from ?to - place) :precondition (and (at ?character ?from)) :effect (and (at ?character ?to) (not (at ?character ?from))))": "(:action move :parameters (?character - character ?from ?to - place) :precondition (and (at ?character ?from)) :effect (and (at ?character ?to) (not (at ?character ?from))))",
        "assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))": "(:action assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))",
        "mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - place ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))": "(:action mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - place ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))",
        "treat :parameters (?d - doctor ?p - patient ?t - treatment ?place - medicalloc) :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (not (receiving-treatment ?p ?t))) :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t)))": "(:action treat :parameters (?d - doctor ?p - patient ?t - treatment ?place - medicalloc) :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (not (receiving-treatment ?p ?t))) :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t)))",
        "recover :parameters (?p - patient ?t - treatment ?s - symptom ?place - place) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place) (has-symptom ?p ?s)) :effect (and (not (has-symptom ?p ?s))))": "(:action recover :parameters (?p - patient ?t - treatment ?s - symptom ?place - place) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place) (has-symptom ?p ?s)) :effect (and (not (has-symptom ?p ?s))))",
        "die :parameters (?p - patient ?t - treatment ?s - symptom ?place - place) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place)) :effect (and (not (alive ?p))))": "(:action die :parameters (?p - patient ?t - treatment ?s - symptom ?place - place) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place)) :effect (and (not (alive ?p))))",
        "lose-consciousness :parameters (?p - patient ?t - treatment ?s - symptom ?place - place) :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?place)) :effect (and (unconscious ?p) (not (conscious ?p))))": "(:action lose-consciousness :parameters (?p - patient ?t - treatment ?s - symptom ?place - place) :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?place)) :effect (and (unconscious ?p) (not (conscious ?p))))",
