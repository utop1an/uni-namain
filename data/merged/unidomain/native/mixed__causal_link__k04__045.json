    "operators": {
        "interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - object) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))": "(:action interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - object) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))",
        "place-victim :parameters (?placer - character ?entity - character ?source - (either location level) ?target - (either location level)) :precondition (and (henchman ?placer) (has ?placer ?entity) (at ?placer ?source) (connected ?target ?source)) :effect (and (not (has ?placer ?entity)) (at ?entity ?target) (captured ?entity)))": "(:action place-victim :parameters (?placer - character ?entity - character ?source - (either location level) ?target - (either location level)) :precondition (and (henchman ?placer) (has ?placer ?entity) (at ?placer ?source) (connected ?target ?source)) :effect (and (not (has ?placer ?entity)) (at ?entity ?target) (captured ?entity)))",
        "save-character :parameters (?saver - character ?saved - character ?p - character ?place - object) :precondition (and (player ?saver) (at ?saver ?place) (at ?saved ?place) (captured ?saved) (captured ?p) (not (at ?p ?place))) :effect (and (saved ?saved ?saver) (not (alive ?p))))": "(:action save-character :parameters (?saver - character ?saved - character ?p - character ?place - object) :precondition (and (player ?saver) (at ?saver ?place) (at ?saved ?place) (captured ?saved) (captured ?p) (not (at ?p ?place))) :effect (and (saved ?saved ?saver) (not (alive ?p))))",
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "sit-down": "(:action sit-down\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "become-magic": "(:action become-magic\n :parameters (?character - character)\n :precondition (not (magic ?character))\n :effect (magic ?character)\n)",
        "grant-wish": "(:action grant-wish\n :parameters (?granter - character ?wish - object)\n :precondition (magic ?granter)\n :effect (granted-wish ?wish)\n)",
        "move-location": "(:action move-location :parameters (?character - character ?to - (either location level) ?from - (either location level)) :precondition (and (player ?character) (connected ?to ?from) (at ?character ?from) (knows ?character) (not (hospitalised ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "move :parameters (?c - character ?place1 ?place2 - object) :precondition (and (at ?c ?place1)) :effect (and (at ?c ?place2) (not (at ?c ?place1))))": "(:action move :parameters (?c - character ?place1 ?place2 - object) :precondition (and (at ?c ?place1)) :effect (and (at ?c ?place2) (not (at ?c ?place1))))",
        "lose-consciousness :parameters (?p - patient ?t - treatment ?s - symptom ?place - object) :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?place)) :effect (and (unconscious ?p) (not (conscious ?p))))": "(:action lose-consciousness :parameters (?p - patient ?t - treatment ?s - symptom ?place - object) :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?place)) :effect (and (unconscious ?p) (not (conscious ?p))))",
        "go-to :parameters (?c - character ?place - object) :precondition (not (at ?c ?place)) :effect (at ?c ?place))": "(:action go-to :parameters (?c - character ?place - object) :precondition (not (at ?c ?place)) :effect (at ?c ?place))",
        "share-snack": "(:action share-snack\n :parameters (?sharer - character ?receiver - character ?snack - object)\n :precondition (and (has ?sharer ?snack) (not (has ?receiver ?snack)))\n :effect (has ?receiver ?snack)\n)",
        "treat :parameters (?d - doctor ?p - patient ?t - treatment ?place - medicalloc) :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (not (receiving-treatment ?p ?t))) :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t)))": "(:action treat :parameters (?d - doctor ?p - patient ?t - treatment ?place - medicalloc) :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (not (receiving-treatment ?p ?t))) :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t)))",
        "die :parameters (?p - patient ?t - treatment ?s - symptom ?place - medicalloc) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place)) :effect (and (not (alive ?p))))": "(:action die :parameters (?p - patient ?t - treatment ?s - symptom ?place - medicalloc) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place)) :effect (and (not (alive ?p))))",
        "assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))": "(:action assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - medicalloc ?w - level) :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (patient-room ?p ?place) (has-symptom ?p ?s) (treatment-for ?t ?s)) :effect (and (treatment-prescribed ?p ?t)))",
        "mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - object ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))": "(:action mistake-assess :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?place - object ?w - level) :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?place) (at ?d ?place) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t))) :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake)))",
        "recover :parameters (?p - patient ?t - treatment ?s - symptom ?place - medicalloc) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place) (has-symptom ?p ?s)) :effect (and (not (has-symptom ?p ?s))))": "(:action recover :parameters (?p - patient ?t - treatment ?s - symptom ?place - medicalloc) :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?place) (patient-room ?p ?place) (has-symptom ?p ?s)) :effect (and (not (has-symptom ?p ?s))))",
        "admit :parameters (?d - doctor ?p - patient ?place - medicalloc ?from ?to - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?place) (at ?d ?place) (not (occupied ?place)) (not (hospitalised ?p)) (level-of-work ?d ?from) (connected ?to ?from) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?place) (occupied ?place) (not (level-of-work ?d ?from)) (level-of-work ?d ?to)))": "(:action admit :parameters (?d - doctor ?p - patient ?place - medicalloc ?from ?to - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?place) (at ?d ?place) (not (occupied ?place)) (not (hospitalised ?p)) (level-of-work ?d ?from) (connected ?to ?from) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?place) (occupied ?place) (not (level-of-work ?d ?from)) (level-of-work ?d ?to)))"
    }
