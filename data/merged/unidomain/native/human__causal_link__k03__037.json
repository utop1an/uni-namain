        "move-location": "(:action move-location :parameters (?actor - character ?destination - location ?source - location) :precondition (and (player ?actor) (connected ?destination ?source) (at ?actor ?source) (knows ?actor) (not (asleep ?actor))) :effect (and (not (at ?actor ?source)) (at ?actor ?destination)))",
        "love-spell :parameters (?caster - genie ?subject - person ?beloved - canmarry) :precondition (and (not (confined ?caster)) (not (loves ?subject ?beloved)) (magic-char ?caster) (magic-char-alive) (alive ?subject) (alive ?beloved) (not (= ?caster ?subject)) (not (= ?caster ?beloved)) (not (= ?subject ?beloved)) (intends-loves ?caster ?subject ?beloved) (bachelor ?beloved)) :effect (and (loves ?subject ?beloved) (loves-bachelor ?subject)))": "(:action love-spell :parameters (?caster - genie ?subject - person ?beloved - canmarry) :precondition (and (not (confined ?caster)) (not (loves ?subject ?beloved)) (magic-char ?caster) (magic-char-alive) (alive ?subject) (alive ?beloved) (not (= ?caster ?subject)) (not (= ?caster ?beloved)) (not (= ?subject ?beloved)) (intends-loves ?caster ?subject ?beloved) (bachelor ?beloved)) :effect (and (loves ?subject ?beloved) (loves-bachelor ?subject)))",
