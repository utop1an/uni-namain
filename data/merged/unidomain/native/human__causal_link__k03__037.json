        "fall-in-love :parameters (?suitor - canmarry ?beloved - female ?place - location) :precondition (and (bachelor ?suitor) (at ?suitor ?place) (at ?beloved ?place) (single ?suitor) (alive ?suitor) (alive ?beloved) (not (loves ?suitor ?beloved)) (beautiful ?beloved)) :effect (and (loves ?suitor ?beloved) (bachelor-loves ?beloved)))": "(:action fall-in-love :parameters (?suitor - canmarry ?beloved - female ?place - location) :precondition (and (bachelor ?suitor) (at ?suitor ?place) (at ?beloved ?place) (single ?suitor) (alive ?suitor) (alive ?beloved) (not (loves ?suitor ?beloved)) (beautiful ?beloved)) :effect (and (loves ?suitor ?beloved) (bachelor-loves ?beloved)))",
        "appear-threatening :parameters (?threatening-monster - monster ?threatened-person - person ?location - location) :precondition (and (alive ?threatening-monster) (alive ?threatened-person) (at ?threatening-monster ?location) (at ?threatened-person ?location) (scary ?threatening-monster) (not (= ?threatening-monster ?threatened-person))) :effect (and (intends-not-alive ?threatened-person ?threatening-monster)))": "(:action appear-threatening :parameters (?threatening-monster - monster ?threatened-person - person ?location - location) :precondition (and (alive ?threatening-monster) (alive ?threatened-person) (at ?threatening-monster ?location) (at ?threatened-person ?location) (scary ?threatening-monster) (not (= ?threatening-monster ?threatened-person))) :effect (and (intends-not-alive ?threatened-person ?threatening-monster)))",
        "slay-magic-char :parameters (?acting-character - character ?target-character - character ?location - location) :precondition (and (at ?acting-character ?location) (at ?target-character ?location) (alive ?acting-character) (not (= ?acting-character ?target-character)) (intends-not-alive ?acting-character ?target-character) (magic-char ?target-character) (alive ?target-character) (magic-char-alive)) :effect (and (not (alive ?target-character)) (magic-char ?target-character) (not (magic-char-alive))))": "(:action slay-magic-char :parameters (?acting-character - character ?target-character - character ?location - location) :precondition (and (at ?acting-character ?location) (at ?target-character ?location) (alive ?acting-character) (not (= ?acting-character ?target-character)) (intends-not-alive ?acting-character ?target-character) (magic-char ?target-character) (alive ?target-character) (magic-char-alive)) :effect (and (not (alive ?target-character)) (magic-char ?target-character) (not (magic-char-alive))))",
