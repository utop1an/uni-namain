        "place-victim :parameters (?placer - character ?target - character ?place - place ?destination - place) :precondition (and (henchman ?placer) (has ?placer ?target) (at ?placer ?place) (connected ?destination ?place)) :effect (and (not (has ?placer ?target)) (at ?target ?destination) (captured ?target)))": "(:action place-victim :parameters (?placer - character ?target - character ?place - place ?destination - place) :precondition (and (henchman ?placer) (has ?placer ?target) (at ?placer ?place) (connected ?destination ?place)) :effect (and (not (has ?placer ?target)) (at ?target ?destination) (captured ?target)))",
        "clean-entity": "(:action clean-entity :parameters (?character - character ?entity - (either item character)) :precondition (and (alive ?character) (has ?character ?entity) (not (clean ?entity)) (worker ?character)) :effect (clean ?entity))"
