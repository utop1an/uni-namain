    "operators": {
        "enter-airlock": "(:action enter-airlock\n :parameters (?character - character)\n :precondition (not (in-airlock ?character))\n :effect (in-airlock ?character)\n)",
        "pressurize-suit": "(:action pressurize-suit\n :parameters (?character - character)\n :precondition (and (in-airlock ?character) (not (suit-pressurized ?character)))\n :effect (suit-pressurized ?character)\n)",
        "jump": "(:action jump\n :parameters (?character - character ?planet - planet)\n :precondition (and (suit-pressurized ?character) (not (on-planet ?character ?planet)))\n :effect (and (reached-altitude ?character) (reached-speed ?character))\n)",
        "land": "(:action land\n :parameters (?character - character ?planet - planet)\n :precondition (and (wingsuit-active ?character) (not (on-planet ?character ?planet)))\n :effect (on-planet ?character ?planet)\n)",
        "sleep": "(:action sleep\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (and (not (awake ?character)) (asleep ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (asleep ?character)\n :effect (and (not (asleep ?character)) (awake ?character))\n)",
        "rob": "(:action rob\n :parameters (?gang - character)\n :precondition (awake ?gang)\n :effect (robbed ?gang)\n)",
        "activate-wingsuit": "(:action activate-wingsuit\n :parameters (?character - character)\n :precondition (and (reached-altitude ?character) (reached-speed ?character) (not (wingsuit-active ?character)))\n :effect (wingsuit-active ?character)\n)",
        "install-soundproof-door": "(:action install-soundproof-door\n :parameters (?gang - character ?place - place)\n :precondition (and (awake ?gang) (at ?gang ?place) (not (soundproof-door ?place)))\n :effect (soundproof-door ?place)\n)",
        "attack": "(:action attack\n :parameters (?attacker - character ?victim - character)\n :precondition (and (awake ?attacker) (awake ?victim))\n :effect (attacked ?victim)\n)",
        "clear-passage": "(:action clear-passage\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (and (not (attacked ?character)) (has-hoard ?character))\n)",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - object)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "call-police": "(:action call-police\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (called-police ?character)\n)",
        "follow-officer": "(:action follow-officer\n :parameters (?character - character ?officer - character)\n :precondition (and (alive ?character) (alive ?officer))\n :effect (follows ?character ?officer)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "start-reading": "(:action start-reading\n :parameters (?character - character)\n :precondition (not (reading ?character))\n :effect (reading ?character)\n)",
        "stop-reading": "(:action stop-reading\n :parameters (?character - character)\n :precondition (reading ?character)\n :effect (not (reading ?character))\n)",
        "start-playing": "(:action start-playing\n :parameters (?character - character)\n :precondition (not (playing ?character))\n :effect (playing ?character)\n)",
        "stop-playing": "(:action stop-playing\n :parameters (?character - character)\n :precondition (playing ?character)\n :effect (not (playing ?character))\n)",
        "become-calm": "(:action become-calm\n :parameters (?character - character)\n :precondition (not (calm ?character))\n :effect (calm ?character)\n)",
        "become-uncalm": "(:action become-uncalm\n :parameters (?character - character)\n :precondition (calm ?character)\n :effect (not (calm ?character))\n)",
        "books-fall": "(:action books-fall\n :parameters ()\n :precondition (not (books-fall))\n :effect (books-fall)\n)",
        "avert-death": "(:action avert-death\n :parameters (?character - character)\n :precondition (and (alive ?character) (called-police ?character) (exists (?officer - character) (follows ?character ?officer)))\n :effect (death-averted ?character)\n)",
        "go-to-shop": "(:action go-to-shop\n :parameters (?character - character)\n :precondition (not (at-shop ?character))\n :effect (at-shop ?character)\n)",
        "fix-pedal :parameters (?character - character ?item - object) :precondition (and (at-shop ?character) (has ?character ?item) (broken-pedal ?item)) :effect (and (not (broken-pedal ?item)) (fixed-pedal ?item)))": "(:action fix-pedal :parameters (?character - character ?item - object) :precondition (and (at-shop ?character) (has ?character ?item) (broken-pedal ?item)) :effect (and (not (broken-pedal ?item)) (fixed-pedal ?item)))"
    }
