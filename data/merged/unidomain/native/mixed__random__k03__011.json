        "notice :parameters (?character - character ?entity - (either box actor) ?place - place) :precondition (and (at ?character ?place) (at ?entity ?place)) :effect (noticed ?character ?entity))": "(:action notice :parameters (?character - character ?entity - (either box actor) ?place - place) :precondition (and (at ?character ?place) (at ?entity ?place)) :effect (noticed ?character ?entity))",
