        "arrest :parameters (?officer - police ?entity - actor ?source ?destination - place ?offense - crime) :precondition (and (at ?officer ?source) (at ?entity ?source) (not (= ?source ?destination)) (is-arrest-place ?destination) (alive ?officer) (alive ?entity) (suspect ?entity ?offense) (arrester ?officer)) :effect (and (at ?entity ?destination) (not (at ?entity ?source)) (at ?officer ?destination) (not (at ?officer ?source)) (under-arrest ?entity)))": "(:action arrest :parameters (?officer - police ?entity - actor ?source ?destination - place ?offense - crime) :precondition (and (at ?officer ?source) (at ?entity ?source) (not (= ?source ?destination)) (is-arrest-place ?destination) (alive ?officer) (alive ?entity) (suspect ?entity ?offense) (arrester ?officer)) :effect (and (at ?entity ?destination) (not (at ?entity ?source)) (at ?officer ?destination) (not (at ?officer ?source)) (under-arrest ?entity)))",
        "play-basketball :parameters (?player1 ?player2 - actor ?location - place) :precondition (and (is-basketball-place ?location) (at ?player1 ?location) (alive ?player1) (at ?player2 ?location) (alive ?player2) (not (= ?player1 ?player2))) :effect (and (not (angry ?player1)) (not (angry ?player2))))": "(:action play-basketball :parameters (?player1 ?player2 - actor ?location - place) :precondition (and (is-basketball-place ?location) (at ?player1 ?location) (alive ?player1) (at ?player2 ?location) (alive ?player2) (not (= ?player1 ?player2))) :effect (and (not (angry ?player1)) (not (angry ?player2))))",
        "findclues :parameters (?entity - police ?c - crime ?i - item ?place - place) :precondition (and (at ?entity ?place) (alive ?entity) (clue ?c ?i ?place)) :effect (and (knows-clue ?entity ?c ?i)))": "(:action findclues :parameters (?entity - police ?c - crime ?i - item ?place - place) :precondition (and (at ?entity ?place) (alive ?entity) (clue ?c ?i ?place)) :effect (and (knows-clue ?entity ?c ?i)))",
        "shareclues :parameters (?entity1 ?entity2 - police ?crime - crime ?item - item ?place - place) :precondition (and (at ?entity1 ?place) (alive ?entity1) (at ?entity2 ?place) (alive ?entity2) (clue ?crime ?item ?place) (knows-clue ?entity1 ?crime ?item)) :effect (and (knows-clue ?entity2 ?crime ?item)))": "(:action shareclues :parameters (?entity1 ?entity2 - police ?crime - crime ?item - item ?place - place) :precondition (and (at ?entity1 ?place) (alive ?entity1) (at ?entity2 ?place) (alive ?entity2) (clue ?crime ?item ?place) (knows-clue ?entity1 ?crime ?item)) :effect (and (knows-clue ?entity2 ?crime ?item)))",
        "travel :parameters (?entity - actor ?c - car ?from ?to - place) :precondition (and (working ?c) (at ?entity ?from) (alive ?entity) (has-car ?entity ?c)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (and (arrester ?entity)) (and (arrester-at ?to) (not (arrester-at ?from))))))": "(:action travel :parameters (?entity - actor ?c - car ?from ?to - place) :precondition (and (working ?c) (at ?entity ?from) (alive ?entity) (has-car ?entity ?c)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (and (arrester ?entity)) (and (arrester-at ?to) (not (arrester-at ?from))))))",
        "steal :parameters (?thief ?owner - actor ?c - crime ?i - item ?place - place) :precondition (and (at ?thief ?place) (at ?owner ?place) (has ?owner ?i) (not (= ?thief ?owner)) (alive ?thief) (is-theft ?c)) :effect (and (has ?thief ?i) (not (has ?owner ?i)) (angry ?owner) (clue ?c ?i ?place)))": "(:action steal :parameters (?thief ?owner - actor ?c - crime ?i - item ?place - place) :precondition (and (at ?thief ?place) (at ?owner ?place) (has ?owner ?i) (not (= ?thief ?owner)) (alive ?thief) (is-theft ?c)) :effect (and (has ?thief ?i) (not (has ?owner ?i)) (angry ?owner) (clue ?c ?i ?place)))",
        "kill :parameters (?killer ?victim - actor ?crime - crime ?item - item ?location - place) :precondition (and (at ?killer ?location) (at ?victim ?location) (alive ?killer) (alive ?victim) (not (= ?killer ?victim)) (has ?killer ?item) (is-murder ?crime) (not (under-arrest ?killer))) :effect (and (not (alive ?victim)) (clue ?crime ?item ?location)))": "(:action kill :parameters (?killer ?victim - actor ?crime - crime ?item - item ?location - place) :precondition (and (at ?killer ?location) (at ?victim ?location) (alive ?killer) (alive ?victim) (not (= ?killer ?victim)) (has ?killer ?item) (is-murder ?crime) (not (under-arrest ?killer))) :effect (and (not (alive ?victim)) (clue ?crime ?item ?location)))",
        "suspect-of-crime :parameters (?officer - police ?citizen - citizen ?c - crime ?i - item ?place - place) :precondition (and (at ?officer ?place) (alive ?officer) (at ?citizen ?place) (alive ?citizen) (knows-clue ?officer ?c ?i) (has ?citizen ?i)) :effect (and (suspect ?citizen ?c)))": "(:action suspect-of-crime :parameters (?officer - police ?citizen - citizen ?c - crime ?i - item ?place - place) :precondition (and (at ?officer ?place) (alive ?officer) (at ?citizen ?place) (alive ?citizen) (knows-clue ?officer ?c ?i) (has ?citizen ?i)) :effect (and (suspect ?citizen ?c)))"
