{
    "predicates": {
        "(locked ?room - room)": "Source predicate (locked ?room - room).",
        "(unlocked-by ?room - room ?key - key)": "Source predicate (unlocked-by ?room - room ?key - key).",
        "(in ?thing - thing ?room - room)": "Source predicate (in ?thing - thing ?room - room).",
        "(hidden ?thing)": "Source predicate (hidden ?thing).",
        "(has ?character - character ?thing - thing)": "Source predicate (has ?character - character ?thing - thing).",
        "(at ?c - character ?l - location)": "Character ?c is at location ?l, which may be a room.",
        "(the-doctor ?c - character)": "Source predicate (the-doctor ?c - character).",
        "(the-doctor-treating ?c - character)": "Source predicate (the-doctor-treating ?c - character).",
        "(the-doctor-overworked)": "Source predicate (the-doctor-overworked).",
        "(the-doctor-mistake)": "Source predicate (the-doctor-mistake).",
        "(has-symptom ?p - patient ?s - symptom)": "Source predicate (has-symptom ?p - patient ?s - symptom).",
        "(conscious ?p)": "Source predicate (conscious ?p).",
        "(unconscious ?p)": "Source predicate (unconscious ?p).",
        "(alive ?p)": "Source predicate (alive ?p).",
        "(patient-room ?p - patient ?l - medicalloc)": "Source predicate (patient-room ?p - patient ?l - medicalloc).",
        "(occupied ?l - medicalloc)": "Source predicate (occupied ?l - medicalloc).",
        "(treatment-for ?t - treatment ?s - symptom)": "Source predicate (treatment-for ?t - treatment ?s - symptom).",
        "(male ?c - character)": "Source predicate (male ?c - character).",
        "(female ?c - character)": "Source predicate (female ?c - character).",
        "(hospitalised ?p - character)": "Source predicate (hospitalised ?p - character).",
        "(wrong-treatment-prescribed ?p - patient ?t - treatment)": "Source predicate (wrong-treatment-prescribed ?p - patient ?t - treatment).",
        "(treatment-prescribed ?p - patient ?t - treatment)": "Source predicate (treatment-prescribed ?p - patient ?t - treatment).",
        "(receiving-treatment ?p - patient ?t - treatment)": "Source predicate (receiving-treatment ?p - patient ?t - treatment).",
        "(level-of-work ?d - character ?l - level)": "Source predicate (level-of-work ?d - character ?l - level).",
        "(connected ?l1 ?l2 - level)": "Source predicate (connected ?l1 ?l2 - level)."
    },
    "operators": {
        "unlock": "(:action unlock\n :parameters (?character - character ?key - key ?room - room)\n :precondition (and (locked ?room) (unlocked-by ?room ?key) (has ?character ?key))\n :effect (and (not (locked ?room)))\n)",
        "enter :parameters (?c - character ?from - location ?to - room) :precondition (and (not (locked ?to)) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to)))": "(:action enter :parameters (?c - character ?from - location ?to - room) :precondition (and (not (locked ?to)) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to)))",
        "search-for :parameters (?c - character ?thing - thing ?l - room) :precondition (and (at ?c ?l) (in ?thing ?l)) :effect (and (has ?c ?thing) (not (in ?thing ?l))))": "(:action search-for :parameters (?c - character ?thing - thing ?l - room) :precondition (and (at ?c ?l) (in ?thing ?l)) :effect (and (has ?c ?thing) (not (in ?thing ?l))))",
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "admit": "(:action admit\n :parameters (?d - doctor ?p - patient ?l - medicalloc ?w1 ?w2 - level)\n :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?w1) (connected ?w1 ?w2) (the-doctor ?d))\n :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?w1)) (level-of-work ?d ?w2))\n)",
        "walk": "(:action walk\n :parameters (?c - character ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1) (not (hospitalised ?c)))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "move": "(:action move\n :parameters (?c - patient ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "lose-consciousness": "(:action lose-consciousness\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?l))\n :effect (and (unconscious ?p) (not (conscious ?p)))\n)"
    }
}