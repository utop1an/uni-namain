{
    "predicates": {
        "(dry ?place - place)": "Source predicate (dry ?place - place).",
        "(wet ?place - place)": "Source predicate (wet ?place - place).",
        "(sad ?character - character)": "Source predicate (sad ?character - character).",
        "(worried ?character - character)": "Source predicate (worried ?character - character).",
        "(accepted-to-university ?character - character)": "Source predicate (accepted-to-university ?character - character).",
        "(applauding ?character - character)": "Source predicate (applauding ?character - character).",
        "(hardworking ?character - character)": "Source predicate (hardworking ?character - character).",
        "(dreams-come-true ?character - character)": "Source predicate (dreams-come-true ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(friends ?character1 - character ?character2 - character)": "The first character is friends with the second character, including when the characters are dogs.",
        "(happy ?character - character)": "The character is happy.",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(wearing-clothes ?character - character)": "Source predicate (wearing-clothes ?character - character).",
        "(has-device ?character - character ?device - device)": "Source predicate (has-device ?character - character ?device - device).",
        "(device-on ?device - device)": "Source predicate (device-on ?device - device).",
        "(device-connected ?device - device)": "Source predicate (device-connected ?device - device).",
        "(electricity ?place - place)": "Source predicate (electricity ?place - place).",
        "(working ?device - device)": "Source predicate (working ?device - device).",
        "(school-canceled)": "Source predicate (school-canceled).",
        "(broken-pedal ?bike - object)": "Source predicate (broken-pedal ?bike - object).",
        "(fixed-pedal ?bike - object)": "Source predicate (fixed-pedal ?bike - object).",
        "(has ?character - character ?bike - object)": "Source predicate (has ?character - character ?bike - object).",
        "(at-shop ?character - character)": "Source predicate (at-shop ?character - character).",
        "(flying ?bike - object)": "Source predicate (flying ?bike - object).",
        "(practices ?dog1 - dog ?dog2 - dog)": "Source predicate (practices ?dog1 - dog ?dog2 - dog).",
        "(participates ?dog - dog)": "Source predicate (participates ?dog - dog).",
        "(wins ?dog - dog)": "Source predicate (wins ?dog - dog).",
        "(plays-with-toy-stack ?dog - dog)": "Source predicate (plays-with-toy-stack ?dog - dog).",
        "(friend ?dog1 - dog ?dog2 - dog)": "The first character is friends with the second character, including when the characters are dogs."
    },
    "operators": {
        "stop-applauding": "(:action stop-applauding\n :parameters (?character - character)\n :precondition (applauding ?character)\n :effect (not (applauding ?character))\n)",
        "make-dreams-come-true": "(:action make-dreams-come-true\n :parameters (?character - character)\n :precondition (and (accepted-to-university ?character) (hardworking ?character))\n :effect (dreams-come-true ?character)\n)",
        "move": "(:action move\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "dry-place": "(:action dry-place\n :parameters (?character - character ?place - place)\n :precondition (and (at ?character ?place) (wet ?place))\n :effect (and (not (wet ?place)) (dry ?place))\n)",
        "get-accepted": "(:action get-accepted\n :parameters (?character - character)\n :precondition (and (worried ?character) (hardworking ?character))\n :effect (and (accepted-to-university ?character) (not (worried ?character)) (happy ?character))\n)",
        "start-applauding": "(:action start-applauding\n :parameters (?character - character ?other - character)\n :precondition (and (not (applauding ?character)) (happy ?other))\n :effect (applauding ?character)\n)",
        "play": "(:action play\n :parameters (?character - character ?place - place)\n :precondition (and (at ?character ?place) (dry ?place))\n :effect (happy ?character)\n)",
        "make-friends": "(:action make-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (happy ?character1) (happy ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "put-on-clothes": "(:action put-on-clothes\n :parameters (?character - character)\n :precondition (and (awake ?character) (not (wearing-clothes ?character)))\n :effect (wearing-clothes ?character)\n)",
        "turn-on-device": "(:action turn-on-device\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (has-device ?character ?device) (not (device-on ?device)))\n :effect (device-on ?device)\n)",
        "check-connectivity": "(:action check-connectivity\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (device-on ?device) (has-device ?character ?device))\n :effect (when (device-connected ?device) (working ?device))\n)",
        "cancel-school": "(:action cancel-school\n :parameters ()\n :precondition (not (school-canceled))\n :effect (school-canceled)\n)",
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "play-with-toy-stack": "(:action play-with-toy-stack\n :parameters (?dog - dog)\n :precondition (not (plays-with-toy-stack ?dog))\n :effect (plays-with-toy-stack ?dog)\n)",
        "go-outside": "(:action go-outside\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (wearing-clothes ?character) (at ?character ?place))\n :effect (and (not (at ?character ?place)) (at ?character outside))\n)",
        "talk": "(:action talk\n :parameters (?speaker - character ?listener - character)\n :precondition (and (awake ?speaker) (awake ?listener) (at ?speaker outside) (at ?listener outside))\n :effect (and)\n)",
        "go-to-shop": "(:action go-to-shop\n :parameters (?character - character)\n :precondition (not (at-shop ?character))\n :effect (at-shop ?character)\n)",
        "fix-pedal": "(:action fix-pedal\n :parameters (?character - character ?bike - object)\n :precondition (and (at-shop ?character) (has ?character ?bike) (broken-pedal ?bike))\n :effect (and (not (broken-pedal ?bike)) (fixed-pedal ?bike))\n)",
        "participate-in-race": "(:action participate-in-race\n :parameters (?dog - dog)\n :precondition (not (participates ?dog))\n :effect (participates ?dog)\n)",
        "win-race": "(:action win-race\n :parameters (?dog - dog ?helper - dog)\n :precondition (and (participates ?dog) (practices ?dog ?helper))\n :effect (wins ?dog)\n)",
        "practice-running": "(:action practice-running\n :parameters (?coach - dog ?trainee - dog)\n :precondition (and (friends ?coach ?trainee) (not (practices ?coach ?trainee)))\n :effect (practices ?coach ?trainee)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)"
    }
}