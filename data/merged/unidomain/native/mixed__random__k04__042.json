        "clean-item :parameters (?entity - character ?item - item) :precondition (and (alive ?entity) (has ?entity ?item) (not (clean ?item))) :effect (clean ?item))": "(:action clean-item :parameters (?entity - character ?item - item) :precondition (and (alive ?entity) (has ?entity ?item) (not (clean ?item))) :effect (clean ?item))",
        "adjust-item :parameters (?entity - character ?item - item) :precondition (and (alive ?entity) (has ?entity ?item) (not (fits ?item ?entity))) :effect (fits ?item ?entity))": "(:action adjust-item :parameters (?entity - character ?item - item) :precondition (and (alive ?entity) (has ?entity ?item) (not (fits ?item ?entity))) :effect (fits ?item ?entity))",
        "wear-item :parameters (?entity - character ?item - item) :precondition (and (alive ?entity) (has ?entity ?item) (fits ?item ?entity) (not (wearing ?entity ?item))) :effect (wearing ?entity ?item))": "(:action wear-item :parameters (?entity - character ?item - item) :precondition (and (alive ?entity) (has ?entity ?item) (fits ?item ?entity) (not (wearing ?entity ?item))) :effect (wearing ?entity ?item))",
        "put :parameters (?actor - character ?item - item ?destination - object) :precondition (and (happy ?actor) (has ?actor ?item)) :effect (at ?item ?destination))": "(:action put :parameters (?actor - character ?item - item ?destination - object) :precondition (and (happy ?actor) (has ?actor ?item)) :effect (at ?item ?destination))",
        "lock-door :parameters (?actor - (either creature character) ?door - item) :precondition (and (alive ?actor) (not (locked ?door))) :effect (locked ?door))": "(:action lock-door :parameters (?actor - (either creature character) ?door - item) :precondition (and (alive ?actor) (not (locked ?door))) :effect (locked ?door))"
