        "make-friends :parameters (?entity1 - (either creature character) ?entity2 - (either creature character)) :precondition (and (awake ?entity1) (awake ?entity2) (not (friends ?entity1 ?entity2)) (not (= ?entity1 ?entity2))) :effect (friends ?entity1 ?entity2))": "(:action make-friends :parameters (?entity1 - (either creature character) ?entity2 - (either creature character)) :precondition (and (awake ?entity1) (awake ?entity2) (not (friends ?entity1 ?entity2)) (not (= ?entity1 ?entity2))) :effect (friends ?entity1 ?entity2))",
        "walk :parameters (?actor - (either creature character) ?from - landform ?to - landform) :precondition (and (not (= ?from ?to)) (alive ?actor) (not (stunned ?actor)) (at ?actor ?from) (habitable ?to) (safe ?to) (forall (?c - creature) (and (not (fighting ?actor ?c)) (not (fighting ?c ?actor))))) :effect (and (at ?actor ?to) (not (at ?actor ?from)) (when (not (safe ?actor)) (safe ?actor))))": "(:action walk :parameters (?actor - (either creature character) ?from - landform ?to - landform) :precondition (and (not (= ?from ?to)) (alive ?actor) (not (stunned ?actor)) (at ?actor ?from) (habitable ?to) (safe ?to) (forall (?c - creature) (and (not (fighting ?actor ?c)) (not (fighting ?c ?actor))))) :effect (and (at ?actor ?to) (not (at ?actor ?from)) (when (not (safe ?actor)) (safe ?actor))))",
        "teleport-from-ship :parameters (?traveler - (either creature character) ?from - ship ?to - place) :precondition (and (not (= ?from ?to)) (alive ?traveler) (not (stunned ?traveler)) (at ?traveler ?from) (habitable ?to) (safe ?to) (captain ?traveler ?from)) :effect (and (at ?traveler ?to) (not (at ?traveler ?from)) (when (not (safe ?traveler)) (safe ?traveler)) (forall (?c - creature) (and (not (fighting ?traveler ?c)) (not (fighting ?c ?traveler))))))": "(:action teleport-from-ship :parameters (?traveler - (either creature character) ?from - ship ?to - place) :precondition (and (not (= ?from ?to)) (alive ?traveler) (not (stunned ?traveler)) (at ?traveler ?from) (habitable ?to) (safe ?to) (captain ?traveler ?from)) :effect (and (at ?traveler ?to) (not (at ?traveler ?from)) (when (not (safe ?traveler)) (safe ?traveler)) (forall (?c - creature) (and (not (fighting ?traveler ?c)) (not (fighting ?c ?traveler))))))",
        "teleport-to-ship :parameters (?traveler - (either creature character) ?from - place ?to - ship) :precondition (and (not (= ?from ?to)) (alive ?traveler) (not (stunned ?traveler)) (at ?traveler ?from) (habitable ?to) (safe ?to) (captain ?traveler ?to)) :effect (and (at ?traveler ?to) (not (at ?traveler ?from)) (when (not (safe ?traveler)) (safe ?traveler)) (forall (?c - creature) (and (not (fighting ?traveler ?c)) (not (fighting ?c ?traveler))))))": "(:action teleport-to-ship :parameters (?traveler - (either creature character) ?from - place ?to - ship) :precondition (and (not (= ?from ?to)) (alive ?traveler) (not (stunned ?traveler)) (at ?traveler ?from) (habitable ?to) (safe ?to) (captain ?traveler ?to)) :effect (and (at ?traveler ?to) (not (at ?traveler ?from)) (when (not (safe ?traveler)) (safe ?traveler)) (forall (?c - creature) (and (not (fighting ?traveler ?c)) (not (fighting ?c ?traveler))))))",
        "attack :parameters (?attacker - creature ?victim - creature ?location - place) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (at ?attacker ?location) (alive ?victim) (not (stunned ?victim)) (at ?victim ?location)) :effect (and (fighting ?attacker ?victim)))": "(:action attack :parameters (?attacker - creature ?victim - creature ?location - place) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (at ?attacker ?location) (alive ?victim) (not (stunned ?victim)) (at ?victim ?location)) :effect (and (fighting ?attacker ?victim)))",
        "kill :parameters (?actor - creature ?victim - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?victim) (or (fighting ?actor ?victim) (fighting ?victim ?actor))) :effect (and (not (alive ?victim)) (when (fighting ?actor ?victim) (not (fighting ?actor ?victim))) (when (fighting ?victim ?actor) (not (fighting ?victim ?actor)))))": "(:action kill :parameters (?actor - creature ?victim - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?victim) (or (fighting ?actor ?victim) (fighting ?victim ?actor))) :effect (and (not (alive ?victim)) (when (fighting ?actor ?victim) (not (fighting ?actor ?victim))) (when (fighting ?victim ?actor) (not (fighting ?victim ?actor)))))",
        "stun :parameters (?stunner_entity - creature ?victim_entity - creature) :precondition (and (alive ?stunner_entity) (not (stunned ?stunner_entity)) (alive ?victim_entity) (not (stunned ?victim_entity)) (or (fighting ?stunner_entity ?victim_entity) (fighting ?victim_entity ?stunner_entity))) :effect (and (stunned ?victim_entity) (when (fighting ?stunner_entity ?victim_entity) (not (fighting ?stunner_entity ?victim_entity))) (when (fighting ?victim_entity ?stunner_entity) (not (fighting ?victim_entity ?stunner_entity)))))": "(:action stun :parameters (?stunner_entity - creature ?victim_entity - creature) :precondition (and (alive ?stunner_entity) (not (stunned ?stunner_entity)) (alive ?victim_entity) (not (stunned ?victim_entity)) (or (fighting ?stunner_entity ?victim_entity) (fighting ?victim_entity ?stunner_entity))) :effect (and (stunned ?victim_entity) (when (fighting ?stunner_entity ?victim_entity) (not (fighting ?stunner_entity ?victim_entity))) (when (fighting ?victim_entity ?stunner_entity) (not (fighting ?victim_entity ?stunner_entity)))))",
        "break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))": "(:action break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))",
        "erupt :parameters (?landform - landform) :precondition (erupting ?landform) :effect (and (not (habitable ?landform)) (not (erupting ?landform)) (forall (?occupant - (either creature character)) (when (at ?occupant ?landform) (not (alive ?occupant))))))": "(:action erupt :parameters (?landform - landform) :precondition (erupting ?landform) :effect (and (not (habitable ?landform)) (not (erupting ?landform)) (forall (?occupant - (either creature character)) (when (at ?occupant ?landform) (not (alive ?occupant))))))",
        "make-peace :parameters (?initiator - creature ?other - creature ?place - place) :precondition (and (alive ?initiator) (not (stunned ?initiator)) (at ?initiator ?place) (alive ?other) (at ?other ?place) (not (fighting ?initiator ?other)) (not (fighting ?other ?initiator))) :effect (and (friends ?initiator ?other) (friends ?other ?initiator)))": "(:action make-peace :parameters (?initiator - creature ?other - creature ?place - place) :precondition (and (alive ?initiator) (not (stunned ?initiator)) (at ?initiator ?place) (alive ?other) (at ?other ?place) (not (fighting ?initiator ?other)) (not (fighting ?other ?initiator))) :effect (and (friends ?initiator ?other) (friends ?other ?initiator)))",
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
