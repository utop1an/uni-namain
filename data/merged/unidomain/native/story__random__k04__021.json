{
    "predicates": {
        "(at ?object - object ?place - location)": "Source predicate (at ?object - object ?place - location).",
        "(can-fly ?animal - animal)": "Source predicate (can-fly ?animal - animal).",
        "(can-run ?character - character)": "Source predicate (can-run ?character - character).",
