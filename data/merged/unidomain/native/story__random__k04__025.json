{
    "predicates": {
        "(hungry ?character - character)": "Source predicate (hungry ?character - character).",
        "(friend ?character1 - character ?character2 - character)": "Source predicate (friend ?character1 - character ?character2 - character).",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(food-available)": "Source predicate (food-available).",
        "(in-tree ?character - character)": "Source predicate (in-tree ?character - character).",
        "(wants-to-eat ?character - character ?object - object)": "Source predicate (wants-to-eat ?character - character ?object - object).",
        "(hard ?object - object)": "Source predicate (hard ?object - object).",
        "(broken ?object - object)": "Source predicate (broken ?object - object).",
        "(eaten ?object - object)": "Source predicate (eaten ?object - object).",
        "(helping ?helper - character ?helpee - character)": "Character ?helper is helping character ?helpee.",
        "(sailor ?character - character)": "Source predicate (sailor ?character - character).",
        "(nice ?character - character)": "Source predicate (nice ?character - character).",
        "(sailing ?character - character)": "Source predicate (sailing ?character - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(feels-awful ?character - character)": "Source predicate (feels-awful ?character - character).",
        "(thinks-about-breakup ?character - character)": "Source predicate (thinks-about-breakup ?character - character).",
        "(heartbroken ?character - character)": "Source predicate (heartbroken ?character - character).",
        "(forgiven ?character - character)": "Source predicate (forgiven ?character - character).",
        "(learned ?character - character)": "Source predicate (learned ?character - character).",
        "(moved-on ?character - character)": "Source predicate (moved-on ?character - character)."
    },
    "operators": {
        "ask-to-be-friends": "(:action ask-to-be-friends\n :parameters (?asker - character ?askee - character)\n :precondition (and (alive ?asker) (alive ?askee) (not (friend ?asker ?askee)))\n :effect (friend ?asker ?askee)\n)",
        "search-for-food": "(:action search-for-food\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (food-available)\n)",
        "feed": "(:action feed\n :parameters (?feeder - character ?eater - character)\n :precondition (and (alive ?feeder) (alive ?eater) (hungry ?eater) (food-available))\n :effect (not (hungry ?eater))\n)",
        "eat": "(:action eat\n :parameters (?eater - character ?eaten - character)\n :precondition (and (alive ?eater) (hungry ?eater) (alive ?eaten))\n :effect (not (alive ?eaten))\n)",
        "climb-tree": "(:action climb-tree\n :parameters (?character - character)\n :precondition (not (in-tree ?character))\n :effect (in-tree ?character)\n)",
        "want-to-eat": "(:action want-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and)\n :effect (wants-to-eat ?character ?object)\n)",
        "try-to-eat": "(:action try-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and (wants-to-eat ?character ?object) (hard ?object))\n :effect (not (eaten ?object))\n)",
        "break-object": "(:action break-object\n :parameters (?character - character ?object - object ?helpee - character)\n :precondition (and (hard ?object) (helping ?character ?helpee))\n :effect (broken ?object)\n)",
        "eat-together": "(:action eat-together\n :parameters (?character1 - character ?character2 - character ?object - object)\n :precondition (and (broken ?object) (helping ?character1 ?character2))\n :effect (eaten ?object)\n)",
        "learn-to-sail": "(:action learn-to-sail\n :parameters (?character - character)\n :precondition (and)\n :effect (sailor ?character)\n)",
        "become-nice": "(:action become-nice\n :parameters (?character - character)\n :precondition (and)\n :effect (nice ?character)\n)",
        "sail-together": "(:action sail-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sailor ?character1) (sailor ?character2))\n :effect (together ?character1 ?character2)\n)",
        "thank": "(:action thank\n :parameters (?thanker - character ?thankee - character)\n :precondition (not (= ?thanker ?thankee))\n :effect (nice ?thanker)\n)",
        "forgive": "(:action forgive\n :parameters (?character - character)\n :precondition (and (feels-awful ?character) (not (forgiven ?character)))\n :effect (forgiven ?character)\n)",
        "learn": "(:action learn\n :parameters (?character - character)\n :precondition (and (heartbroken ?character) (not (learned ?character)))\n :effect (learned ?character)\n)",
        "move-on": "(:action move-on\n :parameters (?character - character)\n :precondition (and (thinks-about-breakup ?character) (forgiven ?character) (learned ?character) (not (moved-on ?character)))\n :effect (moved-on ?character)\n)",
        "help": "(:action help :parameters (?helper - character ?helpee - character) :precondition (not (= ?helper ?helpee)) :effect (helping ?helper ?helpee))"
    }
}