        "celebrate": "(:action celebrate\n :parameters (?celebrator - character ?celebratee - character)\n :precondition (and (celebrated ?celebrator) (not (= ?celebrator ?celebratee)))\n :effect (celebrated ?celebratee)\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?from ?to - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?from) (connected ?from ?to) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?from)) (level-of-work ?d ?to)))": "(:action admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?from ?to - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?from) (connected ?from ?to) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?from)) (level-of-work ?d ?to)))",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "wake-person :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (asleep ?c2) (not (asleep ?c1))) :effect (not (asleep ?c2)))": "(:action wake-person :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (asleep ?c2) (not (asleep ?c1))) :effect (not (asleep ?c2)))",
        "enter-success :parameters (?c - character ?from - room ?to - room) :precondition (and (not (believes-locked ?c ?to)) (believes-at ?c ?c ?from) (not (locked ?to)) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to) (forall (?char2 - character) (when (at ?char2 ?to) (and (believes-at ?c ?char2 ?to) (believes-at ?char2 ?c ?to)))) (forall (?thing - thing) (when (and (in ?thing ?to) (not (hidden ?thing))) (believes-in ?c ?thing ?to))) (not (believes-at ?c ?c ?from)) (believes-at ?c ?c ?to)))": "(:action enter-success :parameters (?c - character ?from - room ?to - room) :precondition (and (not (believes-locked ?c ?to)) (believes-at ?c ?c ?from) (not (locked ?to)) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to) (forall (?char2 - character) (when (at ?char2 ?to) (and (believes-at ?c ?char2 ?to) (believes-at ?char2 ?c ?to)))) (forall (?thing - thing) (when (and (in ?thing ?to) (not (hidden ?thing))) (believes-in ?c ?thing ?to))) (not (believes-at ?c ?c ?from)) (believes-at ?c ?c ?to)))",
        "enter-fail :parameters (?c - character ?l - room ?roomto - room) :precondition (and (not (believes-locked ?c ?roomto)) (believes-at ?c ?c ?l) (not (and (not (locked ?roomto)) (at ?c ?l)))) :effect (when (and (locked ?roomto) (at ?c ?l)) (believes-locked ?c ?roomto)))": "(:action enter-fail :parameters (?c - character ?l - room ?roomto - room) :precondition (and (not (believes-locked ?c ?roomto)) (believes-at ?c ?c ?l) (not (and (not (locked ?roomto)) (at ?c ?l)))) :effect (when (and (locked ?roomto) (at ?c ?l)) (believes-locked ?c ?roomto)))",
        "speak-to-success_in :parameters (?speaker - character ?thing - thing ?room - room ?listener - character ?l - room) :precondition (and (at ?speaker ?l) (at ?listener ?l) (believes-in ?speaker ?thing ?room) (believes-at ?speaker ?speaker ?l) (believes-at ?speaker ?listener ?l) (believes-at ?listener ?speaker ?l) (believes-at ?listener ?listener ?l)) :effect (when (and (at ?speaker ?l) (at ?listener ?l)) (believes-in ?listener ?thing ?room)))": "(:action speak-to-success_in :parameters (?speaker - character ?thing - thing ?room - room ?listener - character ?l - room) :precondition (and (at ?speaker ?l) (at ?listener ?l) (believes-in ?speaker ?thing ?room) (believes-at ?speaker ?speaker ?l) (believes-at ?speaker ?listener ?l) (believes-at ?listener ?speaker ?l) (believes-at ?listener ?listener ?l)) :effect (when (and (at ?speaker ?l) (at ?listener ?l)) (believes-in ?listener ?thing ?room)))",
        "speak-to-success_unlocked-by :parameters (?c1 - character ?unlocked-by_room - room ?unlocked-by_key - key ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (believes-unlocked-by ?c1 ?unlocked-by_room ?unlocked-by_key) (believes-at ?c1 ?c1 ?l) (believes-at ?c1 ?c2 ?l) (believes-at ?c2 ?c1 ?l) (believes-at ?c2 ?c2 ?l)) :effect (when (and (at ?c1 ?l) (at ?c2 ?l)) (believes-unlocked-by ?c2 ?unlocked-by_room ?unlocked-by_key)))": "(:action speak-to-success_unlocked-by :parameters (?c1 - character ?unlocked-by_room - room ?unlocked-by_key - key ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (believes-unlocked-by ?c1 ?unlocked-by_room ?unlocked-by_key) (believes-at ?c1 ?c1 ?l) (believes-at ?c1 ?c2 ?l) (believes-at ?c2 ?c1 ?l) (believes-at ?c2 ?c2 ?l)) :effect (when (and (at ?c1 ?l) (at ?c2 ?l)) (believes-unlocked-by ?c2 ?unlocked-by_room ?unlocked-by_key)))",
        "search-for-fail :parameters (?c - character ?thing - thing ?room - room ?l - location) :precondition (and (believes-at ?c ?c ?room) (believes-in ?c ?thing ?room) (not (and (at ?c ?l) (in ?thing ?room)))) :effect (when (and (not (in ?thing ?room)) (at ?c ?l)) (not (believes-in ?c ?thing ?room))))": "(:action search-for-fail :parameters (?c - character ?thing - thing ?room - room ?l - location) :precondition (and (believes-at ?c ?c ?room) (believes-in ?c ?thing ?room) (not (and (at ?c ?l) (in ?thing ?room)))) :effect (when (and (not (in ?thing ?room)) (at ?c ?l)) (not (believes-in ?c ?thing ?room))))",
        "travel :parameters (?c - character ?from ?to - (either level location)) :precondition (and (not (= ?from ?to)) (alive ?c) (connected ?from ?to) (not (asleep ?c)) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to)))": "(:action travel :parameters (?c - character ?from ?to - (either level location)) :precondition (and (not (= ?from ?to)) (alive ?c) (connected ?from ?to) (not (asleep ?c)) (at ?c ?from)) :effect (and (not (at ?c ?from)) (at ?c ?to)))",
        "unlock-success :parameters (?character - character ?object - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?object) (believes-has ?character ?character ?object) (locked ?room) (unlocked-by ?room ?object) (has ?character ?object)) :effect (and (not (locked ?room)) (not (believes-locked ?character ?room))))": "(:action unlock-success :parameters (?character - character ?object - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?object) (believes-has ?character ?character ?object) (locked ?room) (unlocked-by ?room ?object) (has ?character ?object)) :effect (and (not (locked ?room)) (not (believes-locked ?character ?room))))",
        "unlock-fail :parameters (?character - character ?object - object ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?object) (believes-has ?character ?character ?object) (not (and (locked ?room) (unlocked-by ?room ?object) (has ?character ?object)))) :effect (when (and (locked ?room) (has ?character ?object) (not (unlocked-by ?room ?object))) (not (believes-unlocked-by ?character ?room ?object))))": "(:action unlock-fail :parameters (?character - character ?object - object ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?object) (believes-has ?character ?character ?object) (not (and (locked ?room) (unlocked-by ?room ?object) (has ?character ?object)))) :effect (when (and (locked ?room) (has ?character ?object) (not (unlocked-by ?room ?object))) (not (believes-unlocked-by ?character ?room ?object))))",
        "disenchant-thing :parameters (?c - character ?thing - item ?object - object ?l - location) :precondition (and (at ?c ?l) (at ?thing ?l) (not (asleep ?c)) (has ?c ?object) (enchanted ?thing)) :effect (not (enchanted ?thing)))": "(:action disenchant-thing :parameters (?c - character ?thing - item ?object - object ?l - location) :precondition (and (at ?c ?l) (at ?thing ?l) (not (asleep ?c)) (has ?c ?object) (enchanted ?thing)) :effect (not (enchanted ?thing)))",
        "search-for-success :parameters (?c - character ?object - object ?l - room) :precondition (and (believes-at ?c ?c ?l) (believes-in ?c ?object ?l) (at ?c ?l) (in ?object ?l)) :effect (and (has ?c ?object) (not (in ?object ?l)) (believes-has ?c ?c ?object) (not (believes-in ?c ?object ?l))))": "(:action search-for-success :parameters (?c - character ?object - object ?l - room) :precondition (and (believes-at ?c ?c ?l) (believes-in ?c ?object ?l) (at ?c ?l) (in ?object ?l)) :effect (and (has ?c ?object) (not (in ?object ?l)) (believes-has ?c ?c ?object) (not (believes-in ?c ?object ?l))))",
        "deliver :parameters (?c - character ?object - object ?l - location) :precondition (and (alive ?c) (at ?c ?l) (has ?c ?object)) :effect (and (not (has ?c ?object)) (delivered ?object)))": "(:action deliver :parameters (?c - character ?object - object ?l - location) :precondition (and (alive ?c) (at ?c ?l) (has ?c ?object)) :effect (and (not (has ?c ?object)) (delivered ?object)))",
        "pick-up :parameters (?c - character ?object - object ?l - location) :precondition (and (alive ?c) (at ?c ?l) (at ?object ?l) (not (asleep ?c)) (not (enchanted ?object))) :effect (and (not (at ?object ?l)) (has ?c ?object)))": "(:action pick-up :parameters (?c - character ?object - object ?l - location) :precondition (and (alive ?c) (at ?c ?l) (at ?object ?l) (not (asleep ?c)) (not (enchanted ?object))) :effect (and (not (at ?object ?l)) (has ?c ?object)))"
