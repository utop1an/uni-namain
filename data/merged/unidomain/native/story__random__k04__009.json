{
    "predicates": {
        "(reading ?character - character)": "Source predicate (reading ?character - character).",
        "(calm ?character - character)": "Source predicate (calm ?character - character).",
        "(books-fall)": "Source predicate (books-fall).",
        "(playing ?character - character ?item - item)": "The character is playing with the specified item; a designated unspecified item can represent playing when no item was specified.",
        "(broken ?item - item)": "Source predicate (broken ?item - item).",
        "(apologized ?apologizer - character ?apologizee - character)": "Source predicate (apologized ?apologizer - character ?apologizee - character).",
        "(cleaned ?character - character)": "Source predicate (cleaned ?character - character).",
        "(forgiven ?forgiver - character ?forgivee - character)": "Source predicate (forgiven ?forgiver - character ?forgivee - character).",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(alive ?robot - robot)": "Source predicate (alive ?robot - robot).",
        "(has-weapon ?robot - robot ?weapon - weapon)": "Source predicate (has-weapon ?robot - robot ?weapon - weapon).",
        "(thrown ?weapon - weapon ?target - robot)": "Source predicate (thrown ?weapon - weapon ?target - robot).",
        "(damaged ?robot - robot)": "Source predicate (damaged ?robot - robot).",
        "(destroyed ?robot - robot)": "Source predicate (destroyed ?robot - robot).",
        "(revolution-started)": "Source predicate (revolution-started).",
        "(at ?entity - (either robot character) ?location - (either place room))": "The robot or character is at the specified place or room.",
        "(has-key ?character - character)": "Source predicate (has-key ?character - character).",
        "(in ?item - item ?room - room)": "Source predicate (in ?item - item ?room - room).",
        "(sick ?character - character)": "Source predicate (sick ?character - character).",
        "(called-911 ?caller - character ?sick-person - character)": "Source predicate (called-911 ?caller - character ?sick-person - character).",
        "(at ?character - character ?room - room)": "The robot or character is at the specified place or room."
    },
    "operators": {
        "start-reading": "(:action start-reading\n :parameters (?character - character)\n :precondition (not (reading ?character))\n :effect (reading ?character)\n)",
        "stop-reading": "(:action stop-reading\n :parameters (?character - character)\n :precondition (reading ?character)\n :effect (not (reading ?character))\n)",
        "become-calm": "(:action become-calm\n :parameters (?character - character)\n :precondition (not (calm ?character))\n :effect (calm ?character)\n)",
        "become-uncalm": "(:action become-uncalm\n :parameters (?character - character)\n :precondition (calm ?character)\n :effect (not (calm ?character))\n)",
        "books-fall": "(:action books-fall\n :parameters ()\n :precondition (not (books-fall))\n :effect (books-fall)\n)",
        "stop-playing :parameters (?character - character ?item - item) :precondition (playing ?character ?item) :effect (not (playing ?character ?item)))": "(:action stop-playing :parameters (?character - character ?item - item) :precondition (playing ?character ?item) :effect (not (playing ?character ?item)))",
        "apologize": "(:action apologize\n :parameters (?apologizer - character ?apologizee - character)\n :precondition (not (= ?apologizer ?apologizee))\n :effect (apologized ?apologizer ?apologizee)\n)",
        "clean": "(:action clean\n :parameters (?cleaner - character ?item - item)\n :precondition (broken ?item)\n :effect (cleaned ?cleaner)\n)",
        "forgive": "(:action forgive\n :parameters (?forgiver - character ?forgivee - character)\n :precondition (and (not (= ?forgiver ?forgivee)) (apologized ?forgivee ?forgiver))\n :effect (forgiven ?forgiver ?forgivee)\n)",
        "break-item": "(:action break-item\n :parameters (?breaker - character ?item - item)\n :precondition (and (not (broken ?item)) (playing ?breaker ?item))\n :effect (broken ?item)\n)",
        "start-playing :parameters (?character - character ?item - item) :precondition (and (not (playing ?character ?item)) (not (broken ?item)) (has ?character ?item)) :effect (playing ?character ?item))": "(:action start-playing :parameters (?character - character ?item - item) :precondition (and (not (playing ?character ?item)) (not (broken ?item)) (has ?character ?item)) :effect (playing ?character ?item))",
        "damage": "(:action damage\n :parameters (?damager - robot ?target - robot)\n :precondition (and (alive ?damager) (alive ?target) (exists (?weapon - weapon) (thrown ?weapon ?target)))\n :effect (and (not (alive ?target)) (damaged ?target))\n)",
        "destroy": "(:action destroy\n :parameters (?destroyer - robot ?target - robot)\n :precondition (and (alive ?destroyer) (damaged ?target))\n :effect (and (not (damaged ?target)) (destroyed ?target))\n)",
        "start-revolution": "(:action start-revolution\n :parameters (?robot - robot)\n :precondition (alive ?robot)\n :effect (revolution-started)\n)",
        "call-911": "(:action call-911\n :parameters (?caller - character ?sick-person - character)\n :precondition (and (sick ?sick-person) (not (called-911 ?caller ?sick-person)))\n :effect (called-911 ?caller ?sick-person)\n)",
        "move": "(:action move :parameters (?entity - robot ?from - (either place room) ?to - (either place room)) :precondition (and (not (= ?from ?to)) (alive ?entity) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))",
        "throw-weapon": "(:action throw-weapon\n :parameters (?thrower - robot ?weapon - weapon ?target - robot)\n :precondition (and (alive ?thrower) (has-weapon ?thrower ?weapon) (alive ?target))\n :effect (thrown ?weapon ?target)\n)",
        "take-item :parameters (?entity - character ?item - item ?location - room) :precondition (and (at ?entity ?location) (in ?item ?location)) :effect (and (not (in ?item ?location)) (has ?entity ?item)))": "(:action take-item :parameters (?entity - character ?item - item ?location - room) :precondition (and (at ?entity ?location) (in ?item ?location)) :effect (and (not (in ?item ?location)) (has ?entity ?item)))",
        "leave-item :parameters (?entity - character ?item - item ?location - room) :precondition (and (at ?entity ?location) (has ?entity ?item)) :effect (and (not (has ?entity ?item)) (in ?item ?location)))": "(:action leave-item :parameters (?entity - character ?item - item ?location - room) :precondition (and (at ?entity ?location) (has ?entity ?item)) :effect (and (not (has ?entity ?item)) (in ?item ?location)))"
    }
}