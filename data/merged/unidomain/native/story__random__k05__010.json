        "run-away :parameters (?character - character ?location - character) :precondition (and (at ?character ?location) (sad ?character)) :effect (and (not (at ?character ?location)) (not (trusts ?character ?location))))": "(:action run-away :parameters (?character - character ?location - character) :precondition (and (at ?character ?location) (sad ?character)) :effect (and (not (at ?character ?location)) (not (trusts ?character ?location))))",
