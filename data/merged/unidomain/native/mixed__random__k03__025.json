        "snakebite :parameters (?entity - person) :precondition (alive ?entity) :effect (and (sick ?entity snakebite)))": "(:action snakebite :parameters (?entity - person) :precondition (alive ?entity) :effect (and (sick ?entity snakebite)))",
        "die :parameters (?entity - person ?sickness - sickness) :precondition (and (alive ?entity) (sick ?entity ?sickness)) :effect (not (alive ?entity)))": "(:action die :parameters (?entity - person ?sickness - sickness) :precondition (and (alive ?entity) (sick ?entity ?sickness)) :effect (not (alive ?entity)))",
        "forcetravel :parameters (?entity - person ?captive - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from) (alive ?captive) (not (free ?captive)) (at ?captive ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (at ?captive ?to) (not (at ?captive ?from))))": "(:action forcetravel :parameters (?entity - person ?captive - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from) (alive ?captive) (not (free ?captive)) (at ?captive ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (at ?captive ?to) (not (at ?captive ?from))))",
        "tieup :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (at ?target ?place)) :effect (and (not (free ?target))))": "(:action tieup :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (at ?target ?place)) :effect (and (not (free ?target))))",
        "untie :parameters (?rescuer - person ?captive - person ?location - place) :precondition (and (alive ?rescuer) (free ?rescuer) (at ?rescuer ?location) (alive ?captive) (not (free ?captive)) (at ?captive ?location)) :effect (free ?captive))": "(:action untie :parameters (?rescuer - person ?captive - person ?location - place) :precondition (and (alive ?rescuer) (free ?rescuer) (at ?rescuer ?location) (alive ?captive) (not (free ?captive)) (at ?captive ?location)) :effect (free ?captive))",
        "help-bird :parameters (?entity - (either person character) ?bird - character) :precondition (and (alive ?entity) (alive ?bird) (not (in-nest ?bird))) :effect (in-nest ?bird))": "(:action help-bird :parameters (?entity - (either person character) ?bird - character) :precondition (and (alive ?entity) (alive ?bird) (not (in-nest ?bird))) :effect (in-nest ?bird))",
        "bird-falls :parameters (?entity - character) :precondition (and (alive ?entity) (in-nest ?entity)) :effect (not (in-nest ?entity)))": "(:action bird-falls :parameters (?entity - character) :precondition (and (alive ?entity) (in-nest ?entity)) :effect (not (in-nest ?entity)))",
        "travel": "(:action travel :parameters (?entity - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from) (not (at ?entity ?to))) :effect (and (at ?entity ?to) (not (at ?entity ?from))))",
        "give :parameters (?giving_holder - person ?receiving_holder - person ?item - item ?place - place) :precondition (and (alive ?giving_holder) (free ?giving_holder) (at ?giving_holder ?place) (has ?giving_holder ?item) (alive ?receiving_holder) (free ?receiving_holder) (at ?receiving_holder ?place)) :effect (and (has ?receiving_holder ?item) (not (has ?giving_holder ?item)) (when (belongsto ?item ?giving_holder) (belongsto ?item ?receiving_holder))))": "(:action give :parameters (?giving_holder - person ?receiving_holder - person ?item - item ?place - place) :precondition (and (alive ?giving_holder) (free ?giving_holder) (at ?giving_holder ?place) (has ?giving_holder ?item) (alive ?receiving_holder) (free ?receiving_holder) (at ?receiving_holder ?place)) :effect (and (has ?receiving_holder ?item) (not (has ?giving_holder ?item)) (when (belongsto ?item ?giving_holder) (belongsto ?item ?receiving_holder))))",
        "take :parameters (?taker_holder - person ?item - item ?victim_holder - person ?place - place) :precondition (and (not (= ?taker_holder ?victim_holder)) (alive ?taker_holder) (free ?taker_holder) (at ?taker_holder ?place) (alive ?victim_holder) (not (free ?victim_holder)) (at ?victim_holder ?place) (has ?victim_holder ?item)) :effect (and (has ?taker_holder ?item) (not (has ?victim_holder ?item))))": "(:action take :parameters (?taker_holder - person ?item - item ?victim_holder - person ?place - place) :precondition (and (not (= ?taker_holder ?victim_holder)) (alive ?taker_holder) (free ?taker_holder) (at ?taker_holder ?place) (alive ?victim_holder) (not (free ?victim_holder)) (at ?victim_holder ?place) (has ?victim_holder ?item)) :effect (and (has ?taker_holder ?item) (not (has ?victim_holder ?item))))",
        "heal :parameters (?holder - person ?treated_person - person ?sickness - sickness ?medicine - item ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?holder) (free ?holder) (at ?holder ?place) (has ?holder ?medicine) (alive ?treated_person) (at ?treated_person ?place) (sick ?treated_person ?sickness)) :effect (and (not (sick ?treated_person ?sickness)) (not (has ?holder ?medicine))))": "(:action heal :parameters (?holder - person ?treated_person - person ?sickness - sickness ?medicine - item ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?holder) (free ?holder) (at ?holder ?place) (has ?holder ?medicine) (alive ?treated_person) (at ?treated_person ?place) (sick ?treated_person ?sickness)) :effect (and (not (sick ?treated_person ?sickness)) (not (has ?holder ?medicine))))",
        "play :parameters (?holder - (either person character) ?item - item) :precondition (and (alive ?holder) (has ?holder ?item)) :effect (and))": "(:action play :parameters (?holder - (either person character) ?item - item) :precondition (and (alive ?holder) (has ?holder ?item)) :effect (and))",
        "pick-up :parameters (?holder - (either person character) ?item - item) :precondition (and (alive ?holder) (near ?holder ?item)) :effect (has ?holder ?item))": "(:action pick-up :parameters (?holder - (either person character) ?item - item) :precondition (and (alive ?holder) (near ?holder ?item)) :effect (has ?holder ?item))"
