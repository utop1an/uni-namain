    "operators": {
        "make-happy": "(:action make-happy\n :parameters (?character - character ?target - character)\n :precondition (and (not (= ?character ?target)) (not (happy ?target)))\n :effect (happy ?target)\n)",
        "go-to :parameters (?entity - (either character creature) ?place - place) :precondition (at ?entity ?place) :effect (at ?entity ?place))": "(:action go-to :parameters (?entity - (either character creature) ?place - place) :precondition (at ?entity ?place) :effect (at ?entity ?place))",
        "give :parameters (?giving-character - character ?object - object ?receiving-character - character ?location - place) :precondition (and (not (= ?giving-character ?receiving-character)) (at ?giving-character ?location) (has ?giving-character ?object) (at ?receiving-character ?location)) :effect (and (not (has ?giving-character ?object)) (has ?receiving-character ?object) (gave-gift ?giving-character ?receiving-character ?object)))": "(:action give :parameters (?giving-character - character ?object - object ?receiving-character - character ?location - place) :precondition (and (not (= ?giving-character ?receiving-character)) (at ?giving-character ?location) (has ?giving-character ?object) (at ?receiving-character ?location)) :effect (and (not (has ?giving-character ?object)) (has ?receiving-character ?object) (gave-gift ?giving-character ?receiving-character ?object)))",
        "play :parameters (?entity - character ?object - object ?place - place) :precondition (and (at ?entity ?place) (has ?entity ?object)) :effect (happy ?entity))": "(:action play :parameters (?entity - character ?object - object ?place - place) :precondition (and (at ?entity ?place) (has ?entity ?object)) :effect (happy ?entity))",
