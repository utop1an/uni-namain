        "unoccupy": "(:action unoccupy\n :parameters (?item - item)\n :precondition (occupied ?item)\n :effect (not (occupied ?item))\n)",
        "unshare": "(:action unshare\n :parameters (?sharer - character ?object - object ?receiver - character)\n :precondition (shares ?sharer ?receiver ?object)\n :effect (not (shares ?sharer ?receiver ?object))\n)",
        "walk :parameters (?entity - (either character creature) ?from - landform ?to - landform) :precondition (and (not (= ?from ?to)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?from) (habitable ?to) (safe ?to) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (not (safe ?entity)) (safe ?entity))))": "(:action walk :parameters (?entity - (either character creature) ?from - landform ?to - landform) :precondition (and (not (= ?from ?to)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?from) (habitable ?to) (safe ?to) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (not (safe ?entity)) (safe ?entity))))",
        "teleport-from-ship :parameters (?entity - (either character creature) ?from - ship ?to - place) :precondition (and (not (= ?from ?to)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?from) (habitable ?to) (safe ?to) (captain ?entity ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))": "(:action teleport-from-ship :parameters (?entity - (either character creature) ?from - ship ?to - place) :precondition (and (not (= ?from ?to)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?from) (habitable ?to) (safe ?to) (captain ?entity ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))",
        "teleport-to-ship :parameters (?entity - (either character creature) ?from - place ?to - ship) :precondition (and (not (= ?from ?to)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?from) (habitable ?to) (safe ?to) (captain ?entity ?to)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))": "(:action teleport-to-ship :parameters (?entity - (either character creature) ?from - place ?to - ship) :precondition (and (not (= ?from ?to)) (alive ?entity) (not (stunned ?entity)) (at ?entity ?from) (habitable ?to) (safe ?to) (captain ?entity ?to)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (when (not (safe ?entity)) (safe ?entity)) (forall (?c - creature) (and (not (fighting ?entity ?c)) (not (fighting ?c ?entity))))))",
        "attack :parameters (?initiator - creature ?target - creature ?location - place) :precondition (and (alive ?initiator) (not (stunned ?initiator)) (at ?initiator ?location) (alive ?target) (not (stunned ?target)) (at ?target ?location)) :effect (and (fighting ?initiator ?target)))": "(:action attack :parameters (?initiator - creature ?target - creature ?location - place) :precondition (and (alive ?initiator) (not (stunned ?initiator)) (at ?initiator ?location) (alive ?target) (not (stunned ?target)) (at ?target ?location)) :effect (and (fighting ?initiator ?target)))",
        "kill :parameters (?attacker - creature ?target - creature) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (alive ?target) (or (fighting ?attacker ?target) (fighting ?target ?attacker))) :effect (and (not (alive ?target)) (when (fighting ?attacker ?target) (not (fighting ?attacker ?target))) (when (fighting ?target ?attacker) (not (fighting ?target ?attacker)))))": "(:action kill :parameters (?attacker - creature ?target - creature) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (alive ?target) (or (fighting ?attacker ?target) (fighting ?target ?attacker))) :effect (and (not (alive ?target)) (when (fighting ?attacker ?target) (not (fighting ?attacker ?target))) (when (fighting ?target ?attacker) (not (fighting ?target ?attacker)))))",
        "stun :parameters (?acting_creature - creature ?target_creature - creature) :precondition (and (alive ?acting_creature) (not (stunned ?acting_creature)) (alive ?target_creature) (not (stunned ?target_creature)) (or (fighting ?acting_creature ?target_creature) (fighting ?target_creature ?acting_creature))) :effect (and (stunned ?target_creature) (when (fighting ?acting_creature ?target_creature) (not (fighting ?acting_creature ?target_creature))) (when (fighting ?target_creature ?acting_creature) (not (fighting ?target_creature ?acting_creature)))))": "(:action stun :parameters (?acting_creature - creature ?target_creature - creature) :precondition (and (alive ?acting_creature) (not (stunned ?acting_creature)) (alive ?target_creature) (not (stunned ?target_creature)) (or (fighting ?acting_creature ?target_creature) (fighting ?target_creature ?acting_creature))) :effect (and (stunned ?target_creature) (when (fighting ?acting_creature ?target_creature) (not (fighting ?acting_creature ?target_creature))) (when (fighting ?target_creature ?acting_creature) (not (fighting ?target_creature ?acting_creature)))))",
        "break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))": "(:action break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))",
        "make-peace :parameters (?mediator - creature ?entity - creature ?place - place) :precondition (and (alive ?mediator) (not (stunned ?mediator)) (at ?mediator ?place) (alive ?entity) (at ?entity ?place) (not (fighting ?mediator ?entity)) (not (fighting ?entity ?mediator))) :effect (and (friends ?mediator ?entity) (friends ?entity ?mediator)))": "(:action make-peace :parameters (?mediator - creature ?entity - creature ?place - place) :precondition (and (alive ?mediator) (not (stunned ?mediator)) (at ?mediator ?place) (alive ?entity) (at ?entity ?place) (not (fighting ?mediator ?entity)) (not (fighting ?entity ?mediator))) :effect (and (friends ?mediator ?entity) (friends ?entity ?mediator)))",
        "begin-erupt :parameters (?landform - landform) :precondition (and) :effect (and (erupting ?landform) (forall (?entity - (either character creature)) (when (at ?entity ?landform) (and (not (safe ?entity)))))))": "(:action begin-erupt :parameters (?landform - landform) :precondition (and) :effect (and (erupting ?landform) (forall (?entity - (either character creature)) (when (at ?entity ?landform) (and (not (safe ?entity)))))))",
        "erupt :parameters (?landform - landform) :precondition (erupting ?landform) :effect (and (not (habitable ?landform)) (not (erupting ?landform)) (forall (?entity - (either character creature)) (when (at ?entity ?landform) (not (alive ?entity))))))": "(:action erupt :parameters (?landform - landform) :precondition (erupting ?landform) :effect (and (not (habitable ?landform)) (not (erupting ?landform)) (forall (?entity - (either character creature)) (when (at ?entity ?landform) (not (alive ?entity))))))",
        "find": "(:action find :parameters (?entity - character ?object - object ?place - place) :precondition (and (at ?entity ?place) (not (has ?entity ?object))) :effect (has ?entity ?object))",
