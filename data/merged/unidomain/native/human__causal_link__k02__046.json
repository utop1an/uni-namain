        "marry :parameters (?partner1 - person ?partner2 - person ?location - place) :precondition (and (alive ?partner1) (at ?partner1 ?location) (hasproposed ?partner1 ?partner2) (single ?partner1) (alive ?partner2) (at ?partner2 ?location) (hasaccepted ?partner2 ?partner1) (single ?partner2)) :effect (and (marriedto ?partner1 ?partner2) (marriedto ?partner2 ?partner1) (not (single ?partner1)) (not (single ?partner2)) (forall (?possession - valuable) (when (has ?partner1 ?possession) (rich ?partner2))) (when (loves ?partner1 ?partner2) (happy ?partner1)) (when (loves ?partner2 ?partner1) (happy ?partner2))))": "(:action marry :parameters (?partner1 - person ?partner2 - person ?location - place) :precondition (and (alive ?partner1) (at ?partner1 ?location) (hasproposed ?partner1 ?partner2) (single ?partner1) (alive ?partner2) (at ?partner2 ?location) (hasaccepted ?partner2 ?partner1) (single ?partner2)) :effect (and (marriedto ?partner1 ?partner2) (marriedto ?partner2 ?partner1) (not (single ?partner1)) (not (single ?partner2)) (forall (?possession - valuable) (when (has ?partner1 ?possession) (rich ?partner2))) (when (loves ?partner1 ?partner2) (happy ?partner1)) (when (loves ?partner2 ?partner1) (happy ?partner2))))",
        "steal :parameters (?c - (either creature character) ?victim - creature ?t - item ?place - place) :precondition (and (not (= ?c ?victim)) (alive ?c) (at ?c ?place) (at ?t ?place) (belongsto ?t ?victim)) :effect (and (has ?c ?t) (when (forall (?v - valuable) (not (has ?victim ?v))) (not (rich ?victim)))))": "(:action steal :parameters (?c - (either creature character) ?victim - creature ?t - item ?place - place) :precondition (and (not (= ?c ?victim)) (alive ?c) (at ?c ?place) (at ?t ?place) (belongsto ?t ?victim)) :effect (and (has ?c ?t) (when (forall (?v - valuable) (not (has ?victim ?v))) (not (rich ?victim)))))",
        "walk :parameters (?object - object ?p1 ?p2 - place) :precondition (and (alive ?object) (at ?object ?p1) (not (eaten ?object))) :effect (and (not (at ?object ?p1)) (at ?object ?p2) (when (and (rescuer ?object)) (and (rescuer-at ?p2) (not (rescuer-at ?p1))))))": "(:action walk :parameters (?object - object ?p1 ?p2 - place) :precondition (and (alive ?object) (at ?object ?p1) (not (eaten ?object))) :effect (and (not (at ?object ?p1)) (at ?object ?p2) (when (and (rescuer ?object)) (and (rescuer-at ?p2) (not (rescuer-at ?p1))))))",
        "eat": "(:action eat :parameters (?eater - wolf ?prey - creature ?place - place) :precondition (and (alive ?eater) (at ?eater ?place) (hungry ?eater) (alive ?prey) (at ?prey ?place) (not (eaten ?prey)) (monster ?eater)) :effect (and (not (hungry ?eater)) (not (alive ?prey)) (not (rich ?prey)) (not (happy ?prey)) (eaten ?prey)))",
        "escape :parameters (?person - human ?entity - character ?place - place) :precondition (and (eaten ?person) (not (alive ?entity)) (at ?entity ?place)) :effect (and (not (eaten ?person)) (rescued ?person) (at ?person ?place)))": "(:action escape :parameters (?person - human ?entity - character ?place - place) :precondition (and (eaten ?person) (not (alive ?entity)) (at ?entity ?place)) :effect (and (not (eaten ?person)) (rescued ?person) (at ?person ?place)))",
        "kill :parameters (?holder - (either creature character) ?target - wolf ?tool - (either item thing) ?place - place) :precondition (and (alive ?holder) (alive ?target) (has ?holder ?tool) (at ?holder ?place) (at ?target ?place) (monster ?target) (monster-alive) (rescuer ?holder)) :effect (and (not (alive ?target)) (not (monster-alive))))": "(:action kill :parameters (?holder - (either creature character) ?target - wolf ?tool - (either item thing) ?place - place) :precondition (and (alive ?holder) (alive ?target) (has ?holder ?tool) (at ?holder ?place) (at ?target ?place) (monster ?target) (monster-alive) (rescuer ?holder)) :effect (and (not (alive ?target)) (not (monster-alive))))",
        "give :parameters (?donor ?receiver - character ?object - (either item thing) ?location - place) :precondition (and (not (eaten ?receiver)) (alive ?donor) (alive ?receiver) (has ?donor ?object) (at ?donor ?location) (at ?receiver ?location)) :effect (and (has ?receiver ?object) (not (has ?donor ?object))))": "(:action give :parameters (?donor ?receiver - character ?object - (either item thing) ?location - place) :precondition (and (not (eaten ?receiver)) (alive ?donor) (alive ?receiver) (has ?donor ?object) (at ?donor ?location) (at ?receiver ?location)) :effect (and (has ?receiver ?object) (not (has ?donor ?object))))"
