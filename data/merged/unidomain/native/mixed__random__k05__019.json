        "bird-falls :parameters (?entity - character) :precondition (and (alive ?entity) (in-nest ?entity)) :effect (not (in-nest ?entity)))": "(:action bird-falls :parameters (?entity - character) :precondition (and (alive ?entity) (in-nest ?entity)) :effect (not (in-nest ?entity)))",
