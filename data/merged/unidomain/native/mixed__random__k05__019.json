        "die :parameters (?entity - person ?sickness - sickness) :precondition (and (alive ?entity) (sick ?entity ?sickness)) :effect (not (alive ?entity)))": "(:action die :parameters (?entity - person ?sickness - sickness) :precondition (and (alive ?entity) (sick ?entity ?sickness)) :effect (not (alive ?entity)))",
        "move": "(:action move :parameters (?entity - (either character person) ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from) (not (at ?entity ?to))) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))",
        "forcetravel :parameters (?entity - person ?target - person ?source - object ?destination - object) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?source) (alive ?target) (not (free ?target)) (at ?target ?source)) :effect (and (at ?entity ?destination) (not (at ?entity ?source)) (at ?target ?destination) (not (at ?target ?source))))": "(:action forcetravel :parameters (?entity - person ?target - person ?source - object ?destination - object) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?source) (alive ?target) (not (free ?target)) (at ?target ?source)) :effect (and (at ?entity ?destination) (not (at ?entity ?source)) (at ?target ?destination) (not (at ?target ?source))))",
        "tieup :parameters (?actor - (either character person) ?target - (either character person) ?location - object) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?location) (alive ?target) (at ?target ?location)) :effect (and (not (free ?target))))": "(:action tieup :parameters (?actor - (either character person) ?target - (either character person) ?location - object) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?location) (alive ?target) (at ?target ?location)) :effect (and (not (free ?target))))",
        "untie :parameters (?actor - (either character person) ?target - (either character person) ?location - object) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?location) (alive ?target) (not (free ?target)) (at ?target ?location)) :effect (free ?target))": "(:action untie :parameters (?actor - (either character person) ?target - (either character person) ?location - object) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?location) (alive ?target) (not (free ?target)) (at ?target ?location)) :effect (free ?target))",
        "assemble :parameters (?holder - character ?robot - robot) :precondition (and (at ?holder garage) (not (assembled ?robot))) :effect (and (assembled ?robot) (has-robot ?holder ?robot)))": "(:action assemble :parameters (?holder - character ?robot - robot) :precondition (and (at ?holder garage) (not (assembled ?robot))) :effect (and (assembled ?robot) (has-robot ?holder ?robot)))",
        "give :parameters (?giver-holder - (either character person) ?receiver-holder - (either character person) ?item - item ?location - object) :precondition (and (alive ?giver-holder) (free ?giver-holder) (at ?giver-holder ?location) (has ?giver-holder ?item) (alive ?receiver-holder) (free ?receiver-holder) (at ?receiver-holder ?location)) :effect (and (has ?receiver-holder ?item) (not (has ?giver-holder ?item)) (when (belongsto ?item ?giver-holder) (belongsto ?item ?receiver-holder))))": "(:action give :parameters (?giver-holder - (either character person) ?receiver-holder - (either character person) ?item - item ?location - object) :precondition (and (alive ?giver-holder) (free ?giver-holder) (at ?giver-holder ?location) (has ?giver-holder ?item) (alive ?receiver-holder) (free ?receiver-holder) (at ?receiver-holder ?location)) :effect (and (has ?receiver-holder ?item) (not (has ?giver-holder ?item)) (when (belongsto ?item ?giver-holder) (belongsto ?item ?receiver-holder))))",
        "take :parameters (?taking-holder - (either character person) ?item - item ?holding-holder - (either character person) ?location - object) :precondition (and (not (= ?taking-holder ?holding-holder)) (alive ?taking-holder) (free ?taking-holder) (at ?taking-holder ?location) (alive ?holding-holder) (not (free ?holding-holder)) (at ?holding-holder ?location) (has ?holding-holder ?item)) :effect (and (has ?taking-holder ?item) (not (has ?holding-holder ?item))))": "(:action take :parameters (?taking-holder - (either character person) ?item - item ?holding-holder - (either character person) ?location - object) :precondition (and (not (= ?taking-holder ?holding-holder)) (alive ?taking-holder) (free ?taking-holder) (at ?taking-holder ?location) (alive ?holding-holder) (not (free ?holding-holder)) (at ?holding-holder ?location) (has ?holding-holder ?item)) :effect (and (has ?taking-holder ?item) (not (has ?holding-holder ?item))))",
        "heal :parameters (?holder - person ?patient_entity - person ?sickness - sickness ?medicine - item ?location - object) :precondition (and (cures ?medicine ?sickness) (alive ?holder) (free ?holder) (at ?holder ?location) (has ?holder ?medicine) (alive ?patient_entity) (at ?patient_entity ?location) (sick ?patient_entity ?sickness)) :effect (and (not (sick ?patient_entity ?sickness)) (not (has ?holder ?medicine))))": "(:action heal :parameters (?holder - person ?patient_entity - person ?sickness - sickness ?medicine - item ?location - object) :precondition (and (cures ?medicine ?sickness) (alive ?holder) (free ?holder) (at ?holder ?location) (has ?holder ?medicine) (alive ?patient_entity) (at ?patient_entity ?location) (sick ?patient_entity ?sickness)) :effect (and (not (sick ?patient_entity ?sickness)) (not (has ?holder ?medicine))))"
