        "win-race :parameters (?racer - dog ?partner - dog) :precondition (and (participates ?racer) (practices ?racer ?partner)) :effect (wins ?racer))": "(:action win-race :parameters (?racer - dog ?partner - dog) :precondition (and (participates ?racer) (practices ?racer ?partner)) :effect (wins ?racer))",
