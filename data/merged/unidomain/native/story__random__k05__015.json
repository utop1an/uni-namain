        "(at ?item - item ?place - object)": "The character or item is located at the specified place.",
        "(found ?character - character ?object - object)": "The character has found the object, which may be a toy.",
        "(at ?entity - (either character item) ?place - object)": "The character or item is located at the specified place.",
        "(happy ?character - character)": "The character is happy.",
        "(has ?character - character ?object - object)": "The character possesses the object.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(discovered ?place - place)": "Source predicate (discovered ?place - place).",
        "(knows-about ?character - character ?place - place)": "Source predicate (knows-about ?character - character ?place - place).",
        "(is-ceo ?character - character)": "Source predicate (is-ceo ?character - character).",
        "(is-alien ?character - character)": "Source predicate (is-alien ?character - character).",
        "(at-park ?character - character)": "Source predicate (at-park ?character - character).",
        "(on-swing ?character - character)": "Source predicate (on-swing ?character - character).",
        "(swinging ?character - character)": "Source predicate (swinging ?character - character).",
        "(sharing ?character1 - character ?character2 - character)": "Source predicate (sharing ?character1 - character ?character2 - character).",
        "(made-handprint ?character - character)": "Source predicate (made-handprint ?character - character).",
        "(celebrated ?character - character)": "Source predicate (celebrated ?character - character).",
        "(at ?character - character ?place - place)": "The character or item is located at the specified place."
    },
    "operators": {
        "hide :parameters (?entity - (either character item) ?toy - toy ?place - place) :precondition (at ?entity ?place) :effect (hidden ?toy ?place))": "(:action hide :parameters (?entity - (either character item) ?toy - toy ?place - place) :precondition (at ?entity ?place) :effect (hidden ?toy ?place))",
        "search :parameters (?entity - character ?location - place) :precondition (and (at ?entity ?location) (not (searched ?entity ?location))) :effect (searched ?entity ?location))": "(:action search :parameters (?entity - character ?location - place) :precondition (and (at ?entity ?location) (not (searched ?entity ?location))) :effect (searched ?entity ?location))",
        "move :parameters (?entity - (either character item) ?from - object ?to - object) :precondition (and (not (= ?from ?to)) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))": "(:action move :parameters (?entity - (either character item) ?from - object ?to - object) :precondition (and (not (= ?from ?to)) (at ?entity ?from)) :effect (and (not (at ?entity ?from)) (at ?entity ?to)))",
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
        "start-party": "(:action start-party\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (party ?place)\n)",
        "enjoy-party": "(:action enjoy-party\n :parameters (?character - character ?place - object)\n :precondition (and (happy ?character) (party ?place))\n :effect (happy ?character)\n)",
        "put :parameters (?character - character ?object - object ?place - object) :precondition (and (happy ?character) (has ?character ?object)) :effect (at ?object ?place))": "(:action put :parameters (?character - character ?object - object ?place - object) :precondition (and (happy ?character) (has ?character ?object)) :effect (at ?object ?place))",
        "learn": "(:action learn\n :parameters (?learner - character ?place - place)\n :precondition (and (alive ?learner) (discovered ?place))\n :effect (knows-about ?learner ?place)\n)",
        "hold-press-conference": "(:action hold-press-conference\n :parameters (?speaker - character ?place - place)\n :precondition (and (alive ?speaker) (is-ceo ?speaker) (knows-about ?speaker ?place))\n :effect (forall (?listener - character) (knows-about ?listener ?place))\n)",
        "reveal": "(:action reveal\n :parameters (?alien - character)\n :precondition (and (alive ?alien) (is-alien ?alien))\n :effect (forall (?listener - character) (knows-about ?listener ?alien))\n)",
        "start-swinging": "(:action start-swinging\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (not (swinging ?character)))\n :effect (swinging ?character)\n)",
        "share-swing": "(:action share-swing\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (swinging ?character1) (swinging ?character2))\n :effect (sharing ?character1 ?character2)\n)",
        "find": "(:action find :parameters (?character - character ?object - toy ?location - place) :precondition (and (at ?character ?location) (hidden ?object ?location) (searched ?character ?location) (not (found ?character ?object))) :effect (found ?character ?object))",
        "make-handprint": "(:action make-handprint\n :parameters (?character - character)\n :precondition (found ?character colors)\n :effect (made-handprint ?character)\n)",
        "discover :parameters (?entity - character ?location - place) :precondition (and (alive ?entity) (at ?entity ?location) (not (discovered ?location))) :effect (discovered ?location))": "(:action discover :parameters (?entity - character ?location - place) :precondition (and (alive ?entity) (at ?entity ?location) (not (discovered ?location))) :effect (discovered ?location))",
        "go-to-park :parameters (?entity - character) :precondition (not (at-park ?entity)) :effect (at-park ?entity))": "(:action go-to-park :parameters (?entity - character) :precondition (not (at-park ?entity)) :effect (at-park ?entity))",
        "get-on-swing :parameters (?actor - character) :precondition (and (at-park ?actor) (not (on-swing ?actor))) :effect (on-swing ?actor))": "(:action get-on-swing :parameters (?actor - character) :precondition (and (at-park ?actor) (not (on-swing ?actor))) :effect (on-swing ?actor))",
        "show-handprint :parameters (?actor - character ?observer - character) :precondition (and (made-handprint ?actor) (not (= ?actor ?observer))) :effect (celebrated ?observer))": "(:action show-handprint :parameters (?actor - character ?observer - character) :precondition (and (made-handprint ?actor) (not (= ?actor ?observer))) :effect (celebrated ?observer))",
        "celebrate :parameters (?source - character ?target - character) :precondition (and (celebrated ?source) (not (= ?source ?target))) :effect (celebrated ?target))": "(:action celebrate :parameters (?source - character ?target - character) :precondition (and (celebrated ?source) (not (= ?source ?target))) :effect (celebrated ?target))",
        "get-off-swing": "(:action get-off-swing\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (swinging ?character))\n :effect (and (not (on-swing ?character)) (not (swinging ?character)) (happy ?character))\n)",
        "thank": "(:action thank\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sharing ?character1 ?character2))\n :effect (happy ?character1)\n)"
    }
}