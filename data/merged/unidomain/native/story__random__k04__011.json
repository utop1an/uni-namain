{
    "predicates": {
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(interesting ?place - place)": "Source predicate (interesting ?place - place).",
        "(singing ?character - character)": "Source predicate (singing ?character - character).",
        "(at ?entity - (either character item) ?place - object)": "The character or item is located at the specified place.",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(party ?place - object)": "Source predicate (party ?place - object).",
        "(cake ?place - object)": "Source predicate (cake ?place - object).",
        "(at ?item - item ?place - object)": "The character or item is located at the specified place.",
        "(happy ?character - character)": "The character is happy.",
        "(in-tree ?character - character)": "Source predicate (in-tree ?character - character).",
        "(wants-to-eat ?character - character ?object - object)": "Source predicate (wants-to-eat ?character - character ?object - object).",
        "(hard ?object - object)": "Source predicate (hard ?object - object).",
        "(broken ?object - object)": "Source predicate (broken ?object - object).",
        "(eaten ?object - object)": "Source predicate (eaten ?object - object).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character).",
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character)."
    },
    "operators": {
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "sing": "(:action sing\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (singing ?character)\n)",
        "stop-singing": "(:action stop-singing\n :parameters (?character - character)\n :precondition (singing ?character)\n :effect (not (singing ?character))\n)",
        "make-friends": "(:action make-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (awake ?character1) (awake ?character2) (not (friends ?character1 ?character2)) (not (= ?character1 ?character2)))\n :effect (friends ?character1 ?character2)\n)",
        "move :parameters (?entity - character ?place - object) :precondition (and (awake ?entity) (not (at ?entity ?place))) :effect (at ?entity ?place))": "(:action move :parameters (?entity - character ?place - object) :precondition (and (awake ?entity) (not (at ?entity ?place))) :effect (at ?entity ?place))",
        "sleep :parameters (?entity - character ?location - place) :precondition (and (awake ?entity) (at ?entity ?location) (interesting ?location)) :effect (not (awake ?entity)))": "(:action sleep :parameters (?entity - character ?location - place) :precondition (and (awake ?entity) (at ?entity ?location) (interesting ?location)) :effect (not (awake ?entity)))",
        "make-cake": "(:action make-cake\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (cake ?place)\n)",
        "start-party": "(:action start-party\n :parameters (?character - character ?place - object)\n :precondition (happy ?character)\n :effect (party ?place)\n)",
        "enjoy-party": "(:action enjoy-party\n :parameters (?character - character ?place - object)\n :precondition (and (happy ?character) (party ?place))\n :effect (happy ?character)\n)",
        "put :parameters (?character - character ?entity - item ?place - object) :precondition (and (happy ?character) (has ?character ?entity)) :effect (at ?entity ?place))": "(:action put :parameters (?character - character ?entity - item ?place - object) :precondition (and (happy ?character) (has ?character ?entity)) :effect (at ?entity ?place))",
        "climb-tree": "(:action climb-tree\n :parameters (?character - character)\n :precondition (not (in-tree ?character))\n :effect (in-tree ?character)\n)",
        "want-to-eat": "(:action want-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and)\n :effect (wants-to-eat ?character ?object)\n)",
        "try-to-eat": "(:action try-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and (wants-to-eat ?character ?object) (hard ?object))\n :effect (not (eaten ?object))\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and)\n :effect (helping ?helper ?helpee)\n)",
        "break-object": "(:action break-object\n :parameters (?character - character ?object - object ?helpee - character)\n :precondition (and (hard ?object) (helping ?character ?helpee))\n :effect (broken ?object)\n)",
        "eat-together": "(:action eat-together\n :parameters (?character1 - character ?character2 - character ?object - object)\n :precondition (and (broken ?object) (helping ?character1 ?character2))\n :effect (eaten ?object)\n)",
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)"
    }
}