    "operators": {
        "arrest": "(:action arrest\n :parameters (?p - police ?a - actor ?p1 ?p2 - place ?c - crime)\n :precondition (and (at ?p ?p1) (at ?a ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?p) (alive ?a) (suspect ?a ?c) (arrester ?p))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (at ?p ?p2) (not (at ?p ?p1)) (under-arrest ?a))\n)",
        "play-basketball": "(:action play-basketball\n :parameters (?a ?b - citizen ?p - place)\n :precondition (and (is-basketball-place ?p) (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (not (= ?a ?b)))\n :effect (and (not (angry ?a)) (not (angry ?b)))\n)",
        "findclues": "(:action findclues\n :parameters (?a - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (clue ?c ?i ?p))\n :effect (and (knows-clue ?a ?c ?i))\n)",
        "shareclues": "(:action shareclues\n :parameters (?a ?b - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (clue ?c ?i ?p) (knows-clue ?a ?c ?i))\n :effect (and (knows-clue ?b ?c ?i))\n)",
        "travel": "(:action travel\n :parameters (?a - actor ?c - car ?p1 ?p2 - place)\n :precondition (and (working ?c) (at ?a ?p1) (alive ?a) (has-car ?a ?c))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (when (and (arrester ?a)) (and (arrester-at ?p2) (not (arrester-at ?p1)))))\n)",
        "steal": "(:action steal\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (has ?b ?i) (not (= ?a ?b)) (alive ?a) (is-theft ?c))\n :effect (and (has ?a ?i) (not (has ?b ?i)) (angry ?b) (clue ?c ?i ?p))\n)",
        "kill": "(:action kill\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (alive ?a) (alive ?b) (not (= ?a ?b)) (has ?a ?i) (is-murder ?c) (not (under-arrest ?a)))\n :effect (and (not (alive ?b)) (clue ?c ?i ?p))\n)",
        "suspect-of-crime": "(:action suspect-of-crime\n :parameters (?a - police ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (knows-clue ?a ?c ?i) (has ?b ?i))\n :effect (and (suspect ?b ?c))\n)",
        "enter-success :parameters (?c - actor ?pfrom - place ?pto - place) :precondition (and (not (believes-locked ?c ?pto)) (believes-at ?c ?c ?pfrom) (not (locked ?pto)) (at ?c ?pfrom)) :effect (and (not (at ?c ?pfrom)) (at ?c ?pto) (forall (?c2 - actor) (when (at ?c2 ?pto) (and (believes-at ?c ?c2 ?pto) (believes-at ?c2 ?c ?pto)))) (forall (?thing - thing) (when (and (in ?thing ?pto) (not (hidden ?thing))) (believes-in ?c ?thing ?pto))) (not (believes-at ?c ?c ?pfrom)) (believes-at ?c ?c ?pto)))": "(:action enter-success :parameters (?c - actor ?pfrom - place ?pto - place) :precondition (and (not (believes-locked ?c ?pto)) (believes-at ?c ?c ?pfrom) (not (locked ?pto)) (at ?c ?pfrom)) :effect (and (not (at ?c ?pfrom)) (at ?c ?pto) (forall (?c2 - actor) (when (at ?c2 ?pto) (and (believes-at ?c ?c2 ?pto) (believes-at ?c2 ?c ?pto)))) (forall (?thing - thing) (when (and (in ?thing ?pto) (not (hidden ?thing))) (believes-in ?c ?thing ?pto))) (not (believes-at ?c ?c ?pfrom)) (believes-at ?c ?c ?pto)))",
        "enter-fail :parameters (?c - actor ?pfrom - place ?roomto - room) :precondition (and (not (believes-locked ?c ?roomto)) (believes-at ?c ?c ?pfrom) (not (and (not (locked ?roomto)) (at ?c ?pfrom)))) :effect (when (and (locked ?roomto) (at ?c ?pfrom)) (believes-locked ?c ?roomto)))": "(:action enter-fail :parameters (?c - actor ?pfrom - place ?roomto - room) :precondition (and (not (believes-locked ?c ?roomto)) (believes-at ?c ?c ?pfrom) (not (and (not (locked ?roomto)) (at ?c ?pfrom)))) :effect (when (and (locked ?roomto) (at ?c ?pfrom)) (believes-locked ?c ?roomto)))",
        "speak-to-success_in :parameters (?informant - actor ?in_thing - thing ?in_room - room ?informed - actor ?place - place) :precondition (and (at ?informant ?place) (at ?informed ?place) (believes-in ?informant ?in_thing ?in_room) (believes-at ?informant ?informant ?place) (believes-at ?informant ?informed ?place) (believes-at ?informed ?informant ?place) (believes-at ?informed ?informed ?place)) :effect (when (and (at ?informant ?place) (at ?informed ?place)) (believes-in ?informed ?in_thing ?in_room)))": "(:action speak-to-success_in :parameters (?informant - actor ?in_thing - thing ?in_room - room ?informed - actor ?place - place) :precondition (and (at ?informant ?place) (at ?informed ?place) (believes-in ?informant ?in_thing ?in_room) (believes-at ?informant ?informant ?place) (believes-at ?informant ?informed ?place) (believes-at ?informed ?informant ?place) (believes-at ?informed ?informed ?place)) :effect (when (and (at ?informant ?place) (at ?informed ?place)) (believes-in ?informed ?in_thing ?in_room)))",
        "speak-to-success_unlocked-by :parameters (?informant - actor ?unlocked-by_room - room ?unlocked-by_key - key ?informed - actor ?place - place) :precondition (and (at ?informant ?place) (at ?informed ?place) (believes-unlocked-by ?informant ?unlocked-by_room ?unlocked-by_key) (believes-at ?informant ?informant ?place) (believes-at ?informant ?informed ?place) (believes-at ?informed ?informant ?place) (believes-at ?informed ?informed ?place)) :effect (when (and (at ?informant ?place) (at ?informed ?place)) (believes-unlocked-by ?informed ?unlocked-by_room ?unlocked-by_key)))": "(:action speak-to-success_unlocked-by :parameters (?informant - actor ?unlocked-by_room - room ?unlocked-by_key - key ?informed - actor ?place - place) :precondition (and (at ?informant ?place) (at ?informed ?place) (believes-unlocked-by ?informant ?unlocked-by_room ?unlocked-by_key) (believes-at ?informant ?informant ?place) (believes-at ?informant ?informed ?place) (believes-at ?informed ?informant ?place) (believes-at ?informed ?informed ?place)) :effect (when (and (at ?informant ?place) (at ?informed ?place)) (believes-unlocked-by ?informed ?unlocked-by_room ?unlocked-by_key)))",
        "search-for-fail :parameters (?c - actor ?thing - thing ?p - place) :precondition (and (believes-at ?c ?c ?p) (believes-in ?c ?thing ?p) (not (and (at ?c ?p) (in ?thing ?p)))) :effect (when (and (not (in ?thing ?p)) (at ?c ?p)) (not (believes-in ?c ?thing ?p))))": "(:action search-for-fail :parameters (?c - actor ?thing - thing ?p - place) :precondition (and (believes-at ?c ?c ?p) (believes-in ?c ?thing ?p) (not (and (at ?c ?p) (in ?thing ?p)))) :effect (when (and (not (in ?thing ?p)) (at ?c ?p)) (not (believes-in ?c ?thing ?p))))",
        "unlock-success :parameters (?c - actor ?t - item ?room - room) :precondition (and (believes-locked ?c ?room) (believes-unlocked-by ?c ?room ?t) (believes-has ?c ?c ?t) (locked ?room) (unlocked-by ?room ?t) (has ?c ?t)) :effect (and (not (locked ?room)) (not (believes-locked ?c ?room))))": "(:action unlock-success :parameters (?c - actor ?t - item ?room - room) :precondition (and (believes-locked ?c ?room) (believes-unlocked-by ?c ?room ?t) (believes-has ?c ?c ?t) (locked ?room) (unlocked-by ?room ?t) (has ?c ?t)) :effect (and (not (locked ?room)) (not (believes-locked ?c ?room))))",
        "unlock-fail :parameters (?c - actor ?t - item ?room - room) :precondition (and (believes-locked ?c ?room) (believes-unlocked-by ?c ?room ?t) (believes-has ?c ?c ?t) (not (and (locked ?room) (unlocked-by ?room ?t) (has ?c ?t)))) :effect (when (and (locked ?room) (has ?c ?t) (not (unlocked-by ?room ?t))) (not (believes-unlocked-by ?c ?room ?t))))": "(:action unlock-fail :parameters (?c - actor ?t - item ?room - room) :precondition (and (believes-locked ?c ?room) (believes-unlocked-by ?c ?room ?t) (believes-has ?c ?c ?t) (not (and (locked ?room) (unlocked-by ?room ?t) (has ?c ?t)))) :effect (when (and (locked ?room) (has ?c ?t) (not (unlocked-by ?room ?t))) (not (believes-unlocked-by ?c ?room ?t))))",
        "search-for-success :parameters (?c - actor ?t - item ?p - place) :precondition (and (believes-at ?c ?c ?p) (believes-in ?c ?t ?p) (at ?c ?p) (in ?t ?p)) :effect (and (has ?c ?t) (not (in ?t ?p)) (believes-has ?c ?c ?t) (not (believes-in ?c ?t ?p))))": "(:action search-for-success :parameters (?c - actor ?t - item ?p - place) :precondition (and (believes-at ?c ?c ?p) (believes-in ?c ?t ?p) (at ?c ?p) (in ?t ?p)) :effect (and (has ?c ?t) (not (in ?t ?p)) (believes-has ?c ?c ?t) (not (believes-in ?c ?t ?p))))"
