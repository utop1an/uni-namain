        "fall-in-love :parameters (?character1 - canmarry ?character2 - female ?place - location) :precondition (and (bachelor ?character1) (at ?character1 ?place) (at ?character2 ?place) (single ?character1) (alive ?character1) (alive ?character2) (not (loves ?character1 ?character2)) (beautiful ?character2)) :effect (and (loves ?character1 ?character2) (bachelor-loves ?character2)))": "(:action fall-in-love :parameters (?character1 - canmarry ?character2 - female ?place - location) :precondition (and (bachelor ?character1) (at ?character1 ?place) (at ?character2 ?place) (single ?character1) (alive ?character1) (alive ?character2) (not (loves ?character1 ?character2)) (beautiful ?character2)) :effect (and (loves ?character1 ?character2) (bachelor-loves ?character2)))",
        "appear-threatening :parameters (?monster - monster ?character - person ?location - location) :precondition (and (alive ?monster) (alive ?character) (at ?monster ?location) (at ?character ?location) (scary ?monster) (not (= ?monster ?character))) :effect (and (intends-not-alive ?character ?monster)))": "(:action appear-threatening :parameters (?monster - monster ?character - person ?location - location) :precondition (and (alive ?monster) (alive ?character) (at ?monster ?location) (at ?character ?location) (scary ?monster) (not (= ?monster ?character))) :effect (and (intends-not-alive ?character ?monster)))",
        "slay_monster_with_axe :parameters (?character - worker ?target - wolf ?entity - (either character thing) ?location - location) :precondition (and (alive ?character) (alive ?target) (has ?character ?entity) (at ?character ?location) (at ?target ?location) (monster ?target) (monster-alive) (rescuer ?character) (not (= ?character ?target)) (intends-not-alive ?character ?target)) :effect (and (not (alive ?target)) (not (monster-alive))))": "(:action slay_monster_with_axe :parameters (?character - worker ?target - wolf ?entity - (either character thing) ?location - location) :precondition (and (alive ?character) (alive ?target) (has ?character ?entity) (at ?character ?location) (at ?target ?location) (monster ?target) (monster-alive) (rescuer ?character) (not (= ?character ?target)) (intends-not-alive ?character ?target)) :effect (and (not (alive ?target)) (not (monster-alive))))",
        "pillage :parameters (?pillager ?corpse - character ?entity - (either character thing) ?location - location) :precondition (and (at ?pillager ?location) (at ?corpse ?location) (alive ?pillager) (not (alive ?corpse)) (has ?corpse ?entity) (not (has ?pillager ?entity)) (not (= ?pillager ?corpse))) :effect (and (has ?pillager ?entity) (not (has ?corpse ?entity))))": "(:action pillage :parameters (?pillager ?corpse - character ?entity - (either character thing) ?location - location) :precondition (and (at ?pillager ?location) (at ?corpse ?location) (alive ?pillager) (not (alive ?corpse)) (has ?corpse ?entity) (not (has ?pillager ?entity)) (not (= ?pillager ?corpse))) :effect (and (has ?pillager ?entity) (not (has ?corpse ?entity))))",
        "give :parameters (?giving-character ?receiving-character - human ?entity - (either character thing) ?location - location) :precondition (and (not (= ?giving-character ?receiving-character)) (not (eaten ?receiving-character)) (alive ?giving-character) (alive ?receiving-character) (has ?giving-character ?entity) (not (has ?receiving-character ?entity)) (at ?giving-character ?location) (at ?receiving-character ?location) (intends-has ?giving-character ?receiving-character ?entity)) :effect (and (has ?receiving-character ?entity) (not (has ?giving-character ?entity))))": "(:action give :parameters (?giving-character ?receiving-character - human ?entity - (either character thing) ?location - location) :precondition (and (not (= ?giving-character ?receiving-character)) (not (eaten ?receiving-character)) (alive ?giving-character) (alive ?receiving-character) (has ?giving-character ?entity) (not (has ?receiving-character ?entity)) (at ?giving-character ?location) (at ?receiving-character ?location) (intends-has ?giving-character ?receiving-character ?entity)) :effect (and (has ?receiving-character ?entity) (not (has ?giving-character ?entity))))",
        "summon :parameters (?character - person ?summoned - ismagic ?entity - thing ?location - location) :precondition (and (confined ?summoned) (magic ?entity) (at ?character ?location) (has ?character ?entity) (in ?summoned ?entity) (alive ?character) (not (= ?character ?summoned)) (magic-char ?summoned) (magic-char-alive)) :effect (and (at ?summoned ?location) (controls ?character ?summoned ?entity) (controls-magic ?character ?entity) (not (in ?summoned ?entity)) (not (confined ?summoned))))": "(:action summon :parameters (?character - person ?summoned - ismagic ?entity - thing ?location - location) :precondition (and (confined ?summoned) (magic ?entity) (at ?character ?location) (has ?character ?entity) (in ?summoned ?entity) (alive ?character) (not (= ?character ?summoned)) (magic-char ?summoned) (magic-char-alive)) :effect (and (at ?summoned ?location) (controls ?character ?summoned ?entity) (controls-magic ?character ?entity) (not (in ?summoned ?entity)) (not (confined ?summoned))))",
        "order :parameters (?king - king ?knight - knight ?location - location ?target - (either character thing)) :precondition (and (loyal-to ?knight ?king) (alive ?knight) (alive ?king) (at ?king ?location) (at ?knight ?location)) :effect (and (intends-has ?knight ?king ?target)))": "(:action order :parameters (?king - king ?knight - knight ?location - location ?target - (either character thing)) :precondition (and (loyal-to ?knight ?king) (alive ?knight) (alive ?king) (at ?king ?location) (at ?knight ?location)) :effect (and (intends-has ?knight ?king ?target)))",
        "command :parameters (?owner-character - person ?genie - genie ?beloved-character - person ?entity - thing ?location - location) :precondition (and (magic ?entity) (has ?owner-character ?entity) (controls ?owner-character ?genie ?entity) (alive ?owner-character) (magic-char ?genie) (magic-char-alive) (alive ?beloved-character) (at ?owner-character ?location) (at ?genie ?location) (loves ?owner-character ?beloved-character) (not (loves ?beloved-character ?owner-character)) (not (= ?owner-character ?genie)) (not (= ?owner-character ?beloved-character))) :effect (and (intends-loves ?genie ?beloved-character ?owner-character)))": "(:action command :parameters (?owner-character - person ?genie - genie ?beloved-character - person ?entity - thing ?location - location) :precondition (and (magic ?entity) (has ?owner-character ?entity) (controls ?owner-character ?genie ?entity) (alive ?owner-character) (magic-char ?genie) (magic-char-alive) (alive ?beloved-character) (at ?owner-character ?location) (at ?genie ?location) (loves ?owner-character ?beloved-character) (not (loves ?beloved-character ?owner-character)) (not (= ?owner-character ?genie)) (not (= ?owner-character ?beloved-character))) :effect (and (intends-loves ?genie ?beloved-character ?owner-character)))"
