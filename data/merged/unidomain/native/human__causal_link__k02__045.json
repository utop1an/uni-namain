        "steal :parameters (?stealer - actor ?owner - actor ?c - crime ?i - item ?location - place) :precondition (and (at ?stealer ?location) (at ?owner ?location) (has ?owner ?i) (not (= ?stealer ?owner)) (alive ?stealer) (is-theft ?c)) :effect (and (has ?stealer ?i) (not (has ?owner ?i)) (angry ?owner) (clue ?c ?i ?location)))": "(:action steal :parameters (?stealer - actor ?owner - actor ?c - crime ?i - item ?location - place) :precondition (and (at ?stealer ?location) (at ?owner ?location) (has ?owner ?i) (not (= ?stealer ?owner)) (alive ?stealer) (is-theft ?c)) :effect (and (has ?stealer ?i) (not (has ?owner ?i)) (angry ?owner) (clue ?c ?i ?location)))",
