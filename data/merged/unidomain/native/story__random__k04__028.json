{
    "predicates": {
        "(has-skin ?character - character)": "Source predicate (has-skin ?character - character).",
        "(kneel ?character - character)": "Source predicate (kneel ?character - character).",
        "(rewarded ?character - character)": "Source predicate (rewarded ?character - character).",
        "(tried ?character - character)": "Source predicate (tried ?character - character).",
        "(voice-happy ?character - character)": "Source predicate (voice-happy ?character - character).",
        "(wearing ?character - character ?dress - dress)": "Source predicate (wearing ?character - character ?dress - dress).",
        "(has ?character - character ?dress - dress)": "Source predicate (has ?character - character ?dress - dress).",
        "(damaged ?dress - dress)": "Source predicate (damaged ?dress - dress).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(happy ?character - character)": "The character is happy.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(amazed ?character - character)": "Source predicate (amazed ?character - character).",
        "(supports ?character - character ?project - project)": "Source predicate (supports ?character - character ?project - project).",
        "(persistent ?character - character)": "Source predicate (persistent ?character - character).",
        "(completed ?project - project)": "Source predicate (completed ?project - project).",
        "(famous ?character - character)": "Source predicate (famous ?character - character).",
        "(wears-earmuffs ?character - character)": "Source predicate (wears-earmuffs ?character - character).",
        "(filled-with-ice ?character - character)": "Source predicate (filled-with-ice ?character - character).",
        "(candidate ?character - character)": "Source predicate (candidate ?character - character).",
        "(president ?character - character)": "Source predicate (president ?character - character).",
        "(endured-pain ?character - character)": "Source predicate (endured-pain ?character - character)."
    },
    "operators": {
        "try": "(:action try\n :parameters (?character - character)\n :precondition (kneel ?character)\n :effect (tried ?character)\n)",
        "put-on-dress": "(:action put-on-dress\n :parameters (?character - character ?dress - dress)\n :precondition (and (has ?character ?dress) (not (wearing ?character ?dress)))\n :effect (wearing ?character ?dress)\n)",
        "slip": "(:action slip\n :parameters (?character - character ?dress - dress)\n :precondition (and (wearing ?character ?dress) (not (damaged ?dress)))\n :effect (damaged ?dress)\n)",
        "get-new-dress": "(:action get-new-dress\n :parameters (?character - character ?old-dress - dress ?new-dress - dress)\n :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-dress)))\n :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-dress))\n)",
        "kneel": "(:action kneel\n :parameters (?character - character)\n :precondition (at ?character old-house)\n :effect (kneel ?character)\n)",
        "reward": "(:action reward\n :parameters (?character - character)\n :precondition (voice-happy ?character)\n :effect (rewarded ?character)\n)",
        "take-skin": "(:action take-skin\n :parameters (?character - character)\n :precondition (and (not (voice-happy ?character)) (has-skin ?character))\n :effect (not (has-skin ?character))\n)",
        "comfort": "(:action comfort\n :parameters (?parent - character ?child - character)\n :precondition (and (not (happy ?child)) (not (= ?parent ?child)))\n :effect (happy ?child)\n)",
        "evaluate": "(:action evaluate\n :parameters (?character - character)\n :precondition (tried ?character)\n :effect (voice-happy ?character)\n)",
        "become-amazed": "(:action become-amazed\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (amazed ?character)\n)",
        "support-project": "(:action support-project\n :parameters (?character - character ?project - project)\n :precondition (alive ?character)\n :effect (supports ?character ?project)\n)",
        "become-persistent": "(:action become-persistent\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (persistent ?character)\n)",
        "complete-project": "(:action complete-project\n :parameters (?character - character ?project - project)\n :precondition (and (alive ?character) (supports ?character ?project) (persistent ?character))\n :effect (completed ?project)\n)",
        "become-famous": "(:action become-famous\n :parameters (?character - character)\n :precondition (not (famous ?character))\n :effect (famous ?character)\n)",
        "wear-earmuffs": "(:action wear-earmuffs\n :parameters (?character - character)\n :precondition (and (famous ?character) (not (wears-earmuffs ?character)))\n :effect (wears-earmuffs ?character)\n)",
        "fill-earmuffs-with-ice": "(:action fill-earmuffs-with-ice\n :parameters (?character - character)\n :precondition (and (famous ?character) (wears-earmuffs ?character) (not (filled-with-ice ?character)))\n :effect (filled-with-ice ?character)\n)",
        "endure-pain": "(:action endure-pain\n :parameters (?character - character)\n :precondition (and (famous ?character) (filled-with-ice ?character) (not (endured-pain ?character)))\n :effect (endured-pain ?character)\n)",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "become-candidate": "(:action become-candidate\n :parameters (?character - character)\n :precondition (and (famous ?character) (not (candidate ?character)))\n :effect (candidate ?character)\n)",
        "become-president": "(:action become-president\n :parameters (?character - character)\n :precondition (and (candidate ?character) (not (president ?character)))\n :effect (president ?character)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (happy ?character)\n)"
    }
}