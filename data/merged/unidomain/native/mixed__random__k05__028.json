    "operators": {
        "fly-high": "(:action fly-high\n :parameters (?character - character)\n :precondition (and (played-with ?character rocket))\n :effect (happy ?character)\n)",
        "show :parameters (?shower - character ?object - object ?receiver - character ?place - place) :precondition (and (not (= ?shower ?receiver)) (at ?shower ?place) (has ?shower ?object) (at ?receiver ?place)) :effect (happy ?receiver))": "(:action show :parameters (?shower - character ?object - object ?receiver - character ?place - place) :precondition (and (not (= ?shower ?receiver)) (at ?shower ?place) (has ?shower ?object) (at ?receiver ?place)) :effect (happy ?receiver))",
        "play": "(:action play\n :parameters (?character1 - character ?character2 - character ?object - item ?place - place)\n :precondition (and (not (= ?character1 ?character2)) (at ?character1 ?place) (has ?character1 ?object) (at ?character2 ?place))\n :effect (played-with ?character1 ?object)\n)",
        "travel": "(:action travel\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "confront": "(:action confront\n :parameters (?confronter - character ?confronted - character ?place - place)\n :precondition (and (not (= ?confronter ?confronted)) (alive ?confronter) (at ?confronter ?place) (alive ?confronted) (at ?confronted ?place))\n :effect (and)\n)",
        "defeat": "(:action defeat\n :parameters (?defeater - character ?defeated - character ?place - place)\n :precondition (and (not (= ?defeater ?defeated)) (alive ?defeater) (at ?defeater ?place) (alive ?defeated) (at ?defeated ?place))\n :effect (not (alive ?defeated))\n)",
        "show-mercy": "(:action show-mercy\n :parameters (?merciful - character ?recipient - character ?place - place)\n :precondition (and (not (= ?merciful ?recipient)) (alive ?merciful) (at ?merciful ?place) (not (alive ?recipient)) (at ?recipient ?place))\n :effect (alive ?recipient)\n)",
        "lose :parameters (?character - character ?item - cap) :precondition (has ?character ?item) :effect (and (lost ?character ?item) (not (has ?character ?item))))": "(:action lose :parameters (?character - character ?item - cap) :precondition (has ?character ?item) :effect (and (lost ?character ?item) (not (has ?character ?item))))",
        "find": "(:action find :parameters (?character - character ?item - (either item cap) ?place - place) :precondition (and (at ?character ?place) (not (found ?character ?item)) (lost ?character ?item) (forall (?searched-place - place) (searched ?character ?searched-place))) :effect (and (found ?character ?item) (has ?character ?item) (happy ?character) (not (lost ?character ?item))))",
        "replace :parameters (?character - character ?found-object - (either item cap) ?item - object) :precondition (and (found ?character ?found-object) (not (has ?character ?found-object)) (has ?character ?item)) :effect (and (not (found ?character ?found-object)) (has ?character ?found-object) (not (has ?character ?item))))": "(:action replace :parameters (?character - character ?found-object - (either item cap) ?item - object) :precondition (and (found ?character ?found-object) (not (has ?character ?found-object)) (has ?character ?item)) :effect (and (not (found ?character ?found-object)) (has ?character ?found-object) (not (has ?character ?item))))",
        "move-location :parameters (?actor - character ?to - location ?from - location) :precondition (and (player ?actor) (connected ?to ?from) (at ?actor ?from) (knows ?actor)) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))": "(:action move-location :parameters (?actor - character ?to - location ?from - location) :precondition (and (player ?actor) (connected ?to ?from) (at ?actor ?from) (knows ?actor)) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))",
        "interrogate-character :parameters (?actor - character ?target - character ?place - location) :precondition (and (player ?actor) (at ?actor ?place) (at ?target ?place) (apprehended ?target)) :effect (knows ?actor))": "(:action interrogate-character :parameters (?actor - character ?target - character ?place - location) :precondition (and (player ?actor) (at ?actor ?place) (at ?target ?place) (apprehended ?target)) :effect (knows ?actor))",
        "search :parameters (?character - character ?cap - cap ?location - location) :precondition (and (at ?character ?location) (lost ?character ?cap)) :effect (searched ?character ?location))": "(:action search :parameters (?character - character ?cap - cap ?location - location) :precondition (and (at ?character ?location) (lost ?character ?cap)) :effect (searched ?character ?location))",
        "place-victim :parameters (?acting-character - character ?item - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?item) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?item)) (at ?item ?destination-location) (captured ?item)))": "(:action place-victim :parameters (?acting-character - character ?item - character ?source-location - location ?destination-location - location) :precondition (and (henchman ?acting-character) (has ?acting-character ?item) (at ?acting-character ?source-location) (connected ?destination-location ?source-location)) :effect (and (not (has ?acting-character ?item)) (at ?item ?destination-location) (captured ?item)))",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - object)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "call-police": "(:action call-police\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (called-police ?character)\n)",
        "follow-officer": "(:action follow-officer\n :parameters (?character - character ?officer - character)\n :precondition (and (alive ?character) (alive ?officer))\n :effect (follows ?character ?officer)\n)",
        "avert-death": "(:action avert-death\n :parameters (?character - character)\n :precondition (and (alive ?character) (called-police ?character) (exists (?officer - character) (follows ?character ?officer)))\n :effect (death-averted ?character)\n)",
        "save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?other - character ?place - location) :precondition (and (player ?rescuer) (at ?rescuer ?place) (at ?rescued ?place) (captured ?rescued) (captured ?other) (not (at ?other ?place))) :effect (and (saved ?rescued ?rescuer) (not (alive ?other))))"
    }
