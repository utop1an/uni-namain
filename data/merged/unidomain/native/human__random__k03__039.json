        "save-character :parameters (?saving-character - character ?saved-character - character ?unsaved-character - character ?loc - location) :precondition (and (player ?saving-character) (at ?saving-character ?loc) (at ?saved-character ?loc) (captured ?saved-character) (captured ?unsaved-character) (not (at ?unsaved-character ?loc))) :effect (and (saved ?saved-character ?saving-character) (not (alive ?unsaved-character))))": "(:action save-character :parameters (?saving-character - character ?saved-character - character ?unsaved-character - character ?loc - location) :precondition (and (player ?saving-character) (at ?saving-character ?loc) (at ?saved-character ?loc) (captured ?saved-character) (captured ?unsaved-character) (not (at ?unsaved-character ?loc))) :effect (and (saved ?saved-character ?saving-character) (not (alive ?unsaved-character))))",
        "enter": "(:action enter :parameters (?character - character ?from - location ?to - room) :precondition (and (not (locked ?to)) (connected ?to ?from) (not (asleep ?character)) (at ?character ?from) (player ?character) (knows ?character)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "take-thing": "(:action take-thing :parameters (?taker - character ?target - thing ?location - room) :precondition (and (at ?taker ?location) (in ?target ?location) (at ?target ?location) (not (asleep ?taker)) (not (enchanted ?target))) :effect (and (has ?taker ?target) (not (in ?target ?location)) (not (at ?target ?location))))",
        "disenchant-thing :parameters (?caster - character ?thing - item ?held-target - (either thing character) ?location - location) :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?held-target) (enchanted ?thing)) :effect (not (enchanted ?thing)))": "(:action disenchant-thing :parameters (?caster - character ?thing - item ?held-target - (either thing character) ?location - location) :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?held-target) (enchanted ?thing)) :effect (not (enchanted ?thing)))",
