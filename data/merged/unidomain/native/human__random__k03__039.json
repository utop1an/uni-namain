    "operators": {
        "unlock :parameters (?character - character ?target - key ?room - room) :precondition (and (locked ?room) (unlocked-by ?room ?target) (has ?character ?target)) :effect (and (not (locked ?room))))": "(:action unlock :parameters (?character - character ?target - key ?room - room) :precondition (and (locked ?room) (unlocked-by ?room ?target) (has ?character ?target)) :effect (and (not (locked ?room))))",
        "wake-person": "(:action wake-person\n :parameters (?waker - character ?woken - character ?location - location)\n :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker)))\n :effect (not (asleep ?woken))\n)",
