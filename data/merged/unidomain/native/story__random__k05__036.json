{
    "predicates": {
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(amazed ?character - character)": "Source predicate (amazed ?character - character).",
        "(supports ?character - character ?project - project)": "Source predicate (supports ?character - character ?project - project).",
        "(persistent ?character - character)": "Source predicate (persistent ?character - character).",
        "(completed ?project - project)": "Source predicate (completed ?project - project).",
        "(on-planet ?character - character ?planet - planet)": "Source predicate (on-planet ?character - character ?planet - planet).",
        "(in-formation ?character - character)": "Source predicate (in-formation ?character - character).",
        "(in-airlock ?character - character)": "Source predicate (in-airlock ?character - character).",
        "(wingsuit-active ?character - character)": "Source predicate (wingsuit-active ?character - character).",
        "(suit-pressurized ?character - character)": "Source predicate (suit-pressurized ?character - character).",
        "(reached-altitude ?character - character)": "Source predicate (reached-altitude ?character - character).",
        "(reached-speed ?character - character)": "Source predicate (reached-speed ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(wearing-pajamas ?animal - animal)": "Source predicate (wearing-pajamas ?animal - animal).",
        "(on-floor ?character - character)": "Source predicate (on-floor ?character - character).",
        "(dressed ?character - character)": "Source predicate (dressed ?character - character).",
        "(holding ?character - character ?object - object)": "Source predicate (holding ?character - character ?object - object).",
        "(walking ?character - character ?direction - direction)": "Source predicate (walking ?character - character ?direction - direction).",
        "(petting ?character - character ?animal - animal)": "Source predicate (petting ?character - character ?animal - animal).",
        "(bites ?animal - animal)": "Source predicate (bites ?animal - animal).",
        "(owns ?character - character ?animal - animal)": "Source predicate (owns ?character - character ?animal - animal).",
        "(life-is-a-joke ?character - character)": "Source predicate (life-is-a-joke ?character - character).",
        "(on-top ?toy - toy ?place - place)": "Source predicate (on-top ?toy - toy ?place - place).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(scared ?character - character)": "Source predicate (scared ?character - character).",
        "(has ?character - character ?object - object)": "The character possesses the object, which may be a toy.",
        "(impatient ?character - character)": "Source predicate (impatient ?character - character).",
        "(on-table ?object - object)": "Source predicate (on-table ?object - object).",
        "(smells-nice ?character - character)": "Source predicate (smells-nice ?character - character).",
        "(playing-with-ball ?character - character)": "Source predicate (playing-with-ball ?character - character)."
    },
    "operators": {
        "become-amazed": "(:action become-amazed\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (amazed ?character)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (happy ?character)\n)",
        "support-project": "(:action support-project\n :parameters (?character - character ?project - project)\n :precondition (alive ?character)\n :effect (supports ?character ?project)\n)",
        "become-persistent": "(:action become-persistent\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (persistent ?character)\n)",
        "complete-project": "(:action complete-project\n :parameters (?character - character ?project - project)\n :precondition (and (alive ?character) (supports ?character ?project) (persistent ?character))\n :effect (completed ?project)\n)",
        "enter-airlock": "(:action enter-airlock\n :parameters (?character - character)\n :precondition (not (in-airlock ?character))\n :effect (in-airlock ?character)\n)",
        "pressurize-suit": "(:action pressurize-suit\n :parameters (?character - character)\n :precondition (and (in-airlock ?character) (not (suit-pressurized ?character)))\n :effect (suit-pressurized ?character)\n)",
        "jump": "(:action jump\n :parameters (?character - character ?planet - planet)\n :precondition (and (suit-pressurized ?character) (not (on-planet ?character ?planet)))\n :effect (and (reached-altitude ?character) (reached-speed ?character))\n)",
        "land": "(:action land\n :parameters (?character - character ?planet - planet)\n :precondition (and (wingsuit-active ?character) (not (on-planet ?character ?planet)))\n :effect (on-planet ?character ?planet)\n)",
        "activate-wingsuit": "(:action activate-wingsuit\n :parameters (?character - character)\n :precondition (and (reached-altitude ?character) (reached-speed ?character) (not (wingsuit-active ?character)))\n :effect (wingsuit-active ?character)\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "dress": "(:action dress\n :parameters (?character - character)\n :precondition (and (awake ?character) (on-floor ?character) (not (dressed ?character)))\n :effect (dressed ?character)\n)",
        "pet": "(:action pet\n :parameters (?character - character ?animal - animal)\n :precondition (and (awake ?character) (dressed ?character) (not (bites ?animal)))\n :effect (petting ?character ?animal)\n)",
        "realize-life-is-a-joke": "(:action realize-life-is-a-joke\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (life-is-a-joke ?character)\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "overcome-fear": "(:action overcome-fear\n :parameters (?character - character)\n :precondition (scared ?character)\n :effect (not (scared ?character))\n)",
        "smell-nice": "(:action smell-nice\n :parameters (?character - character)\n :precondition (has ?character perfume)\n :effect (smells-nice ?character)\n)",
        "play-with-ball": "(:action play-with-ball\n :parameters (?character - character)\n :precondition (has ?character ball)\n :effect (playing-with-ball ?character)\n)",
        "move": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "retrieve-toy": "(:action retrieve-toy\n :parameters (?character - character ?object - toy ?place - place)\n :precondition (and (at ?character ?place) (on-top ?object ?place))\n :effect (and (not (on-top ?object ?place)) (has ?character ?object))\n)",
        "try-get": "(:action try-get\n :parameters (?character - character ?object - object)\n :precondition (and (impatient ?character) (on-table ?object))\n :effect (and (not (on-table ?object)) (has ?character ?object))\n)"
    }
}