{
    "predicates": {
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character).",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(anchored ?light - lightbox)": "Source predicate (anchored ?light - lightbox).",
        "(charged ?light - lightbox)": "Source predicate (charged ?light - lightbox).",
        "(created ?character - character ?light - lightbox)": "Source predicate (created ?character - character ?light - lightbox).",
        "(used ?character - character ?light - lightbox)": "Source predicate (used ?character - character ?light - lightbox).",
        "(happy ?character - character)": "The character is happy.",
        "(alive ?character - character)": "The character is alive.",
        "(fan ?character - character ?idol - character)": "Source predicate (fan ?character - character ?idol - character).",
        "(read ?character - character ?story - object)": "Source predicate (read ?character - character ?story - object).",
        "(vote ?character - character ?story - object)": "Source predicate (vote ?character - character ?story - object).",
        "(win ?story - object)": "Source predicate (win ?story - object).",
        "(in-tree ?character - character)": "Source predicate (in-tree ?character - character).",
        "(wants-to-eat ?character - character ?object - object)": "Source predicate (wants-to-eat ?character - character ?object - object).",
        "(hard ?object - object)": "Source predicate (hard ?object - object).",
        "(broken ?object - object)": "Source predicate (broken ?object - object).",
        "(eaten ?object - object)": "Source predicate (eaten ?object - object).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character).",
        "(has-swing ?character - character)": "Source predicate (has-swing ?character - character).",
        "(playing-together ?character1 - character ?character2 - character)": "Source predicate (playing-together ?character1 - character ?character2 - character)."
    },
    "operators": {
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)",
        "create-lightbox": "(:action create-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (alive ?character)\n :effect (and (created ?character ?lightbox) (has ?character ?lightbox))\n)",
        "anchor-light": "(:action anchor-light\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (created ?character ?lightbox) (has ?character ?lightbox))\n :effect (anchored ?lightbox)\n)",
        "charge-lightbox": "(:action charge-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (anchored ?lightbox) (created ?character ?lightbox))\n :effect (charged ?lightbox)\n)",
        "use-lightbox": "(:action use-lightbox\n :parameters (?character - character ?lightbox - lightbox)\n :precondition (and (alive ?character) (charged ?lightbox) (created ?character ?lightbox) (has ?character ?lightbox))\n :effect (and (used ?character ?lightbox) (not (charged ?lightbox)))\n)",
        "story-wins": "(:action story-wins\n :parameters (?story - object)\n :precondition (exists (?voter - character) (vote ?voter ?story))\n :effect (win ?story)\n)",
        "climb-tree": "(:action climb-tree\n :parameters (?character - character)\n :precondition (not (in-tree ?character))\n :effect (in-tree ?character)\n)",
        "want-to-eat": "(:action want-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and)\n :effect (wants-to-eat ?character ?object)\n)",
        "try-to-eat": "(:action try-to-eat\n :parameters (?character - character ?object - object)\n :precondition (and (wants-to-eat ?character ?object) (hard ?object))\n :effect (not (eaten ?object))\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and)\n :effect (helping ?helper ?helpee)\n)",
        "break-object": "(:action break-object\n :parameters (?character - character ?object - object ?helpee - character)\n :precondition (and (hard ?object) (helping ?character ?helpee))\n :effect (broken ?object)\n)",
        "eat-together": "(:action eat-together\n :parameters (?character1 - character ?character2 - character ?object - object)\n :precondition (and (broken ?object) (helping ?character1 ?character2))\n :effect (eaten ?object)\n)",
        "invite": "(:action invite\n :parameters (?inviter - character ?invitee - character)\n :precondition (and (not (= ?inviter ?invitee)) (has-swing ?inviter))\n :effect (playing-together ?inviter ?invitee)\n)",
        "play-on-swing": "(:action play-on-swing\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (playing-together ?character1 ?character2))\n :effect (and (happy ?character1) (happy ?character2))\n)",
        "read-story": "(:action read-story\n :parameters (?reader - character ?story - object)\n :precondition (alive ?reader)\n :effect (read ?reader ?story)\n)",
        "vote-for-story": "(:action vote-for-story\n :parameters (?voter - character ?story - object)\n :precondition (and (alive ?voter) (read ?voter ?story))\n :effect (vote ?voter ?story)\n)",
        "become-fan": "(:action become-fan\n :parameters (?fan - character ?idol - character)\n :precondition (and (alive ?fan) (alive ?idol) (not (= ?fan ?idol)))\n :effect (fan ?fan ?idol)\n)"
    }
}