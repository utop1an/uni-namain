        "appear-threatening :parameters (?m - monster ?c - character ?l - location) :precondition (and (alive ?m) (alive ?c) (at ?m ?l) (at ?c ?l) (scary ?m) (not (= ?m ?c))) :effect (and (intends-not-alive ?c ?m)))": "(:action appear-threatening :parameters (?m - monster ?c - character ?l - location) :precondition (and (alive ?m) (alive ?c) (at ?m ?l) (at ?c ?l) (scary ?m) (not (= ?m ?c))) :effect (and (intends-not-alive ?c ?m)))",
        "pillage :parameters (?p ?corpse - character ?t - thing ?l - location) :precondition (and (at ?p ?l) (at ?corpse ?l) (alive ?p) (not (alive ?corpse)) (has ?corpse ?t) (not (has ?p ?t)) (not (= ?p ?corpse))) :effect (and (has ?p ?t) (not (has ?corpse ?t))))": "(:action pillage :parameters (?p ?corpse - character ?t - thing ?l - location) :precondition (and (at ?p ?l) (at ?corpse ?l) (alive ?p) (not (alive ?corpse)) (has ?corpse ?t) (not (has ?p ?t)) (not (= ?p ?corpse))) :effect (and (has ?p ?t) (not (has ?corpse ?t))))",
        "give :parameters (?giver ?recipient - character ?item - thing ?place - location) :precondition (and (not (= ?giver ?recipient)) (not (eaten ?recipient)) (alive ?giver) (alive ?recipient) (has ?giver ?item) (not (has ?recipient ?item)) (at ?giver ?place) (at ?recipient ?place) (intends-has ?giver ?recipient ?item)) :effect (and (has ?recipient ?item) (not (has ?giver ?item))))": "(:action give :parameters (?giver ?recipient - character ?item - thing ?place - location) :precondition (and (not (= ?giver ?recipient)) (not (eaten ?recipient)) (alive ?giver) (alive ?recipient) (has ?giver ?item) (not (has ?recipient ?item)) (at ?giver ?place) (at ?recipient ?place) (intends-has ?giver ?recipient ?item)) :effect (and (has ?recipient ?item) (not (has ?giver ?item))))",
