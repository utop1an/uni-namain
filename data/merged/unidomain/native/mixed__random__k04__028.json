{
    "predicates": {
        "(free ?person - person)": "Source predicate (free ?person - person).",
        "(sheriff ?person - person)": "Source predicate (sheriff ?person - person).",
        "(belongsto ?item - item ?person - person)": "Source predicate (belongsto ?item - item ?person - person).",
        "(has ?person - person ?item - item)": "Source predicate (has ?person - person ?item - item).",
        "(sick ?person - person ?sickness - sickness)": "Source predicate (sick ?person - person ?sickness - sickness).",
        "(cures ?item - item ?sickness - sickness)": "Source predicate (cures ?item - item ?sickness - sickness).",
        "(loves ?lover - person ?love - person)": "Source predicate (loves ?lover - person ?love - person).",
        "(at ?object - object ?place - place)": "The object, which may be a character, is at the specified place.",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(interesting ?place - place)": "Source predicate (interesting ?place - place).",
        "(singing ?character - character)": "Source predicate (singing ?character - character).",
        "(at ?character - character ?place - place)": "The object, which may be a character, is at the specified place.",
        "(alive ?entity - (either person character))": "The specified person or character is alive.",
        "(friends ?character1 - character ?character2 - character)": "Character1 is friends with character2.",
        "(in-drawer ?toy - toy)": "Source predicate (in-drawer ?toy - toy).",
        "(friends ?character - character ?toy - toy)": "Source predicate (friends ?character - character ?toy - toy).",
        "(wants-to-take ?character - character ?toy - toy)": "Source predicate (wants-to-take ?character - character ?toy - toy).",
        "(brave ?character - character)": "Source predicate (brave ?character - character).",
        "(has-emotion ?character - character ?emotion - emotion)": "Source predicate (has-emotion ?character - character ?emotion - emotion).",
        "(knows-change ?character - character)": "Source predicate (knows-change ?character - character).",
        "(memorize ?character - character)": "Source predicate (memorize ?character - character).",
        "(alive ?character - character)": "The specified person or character is alive."
    },
    "operators": {
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "sing": "(:action sing\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (singing ?character)\n)",
        "stop-singing": "(:action stop-singing\n :parameters (?character - character)\n :precondition (singing ?character)\n :effect (not (singing ?character))\n)",
        "move :parameters (?character - character ?object - object ?place - place) :precondition (and (awake ?character) (not (at ?object ?place))) :effect (at ?object ?place))": "(:action move :parameters (?character - character ?object - object ?place - place) :precondition (and (awake ?character) (not (at ?object ?place))) :effect (at ?object ?place))",
        "sleep :parameters (?sleeper - character ?location - place) :precondition (and (awake ?sleeper) (at ?sleeper ?location) (interesting ?location)) :effect (not (awake ?sleeper)))": "(:action sleep :parameters (?sleeper - character ?location - place) :precondition (and (awake ?sleeper) (at ?sleeper ?location) (interesting ?location)) :effect (not (awake ?sleeper)))",
        "snakebite :parameters (?entity - person) :precondition (alive ?entity) :effect (and (sick ?entity snakebite)))": "(:action snakebite :parameters (?entity - person) :precondition (alive ?entity) :effect (and (sick ?entity snakebite)))",
        "die :parameters (?entity - person ?sickness - sickness) :precondition (and (alive ?entity) (sick ?entity ?sickness)) :effect (not (alive ?entity)))": "(:action die :parameters (?entity - person ?sickness - sickness) :precondition (and (alive ?entity) (sick ?entity ?sickness)) :effect (not (alive ?entity)))",
        "travel :parameters (?entity - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from))))": "(:action travel :parameters (?entity - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from))))",
        "forcetravel :parameters (?entity - person ?target - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from) (alive ?target) (not (free ?target)) (at ?target ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (at ?target ?to) (not (at ?target ?from))))": "(:action forcetravel :parameters (?entity - person ?target - person ?from - place ?to - place) :precondition (and (alive ?entity) (free ?entity) (at ?entity ?from) (alive ?target) (not (free ?target)) (at ?target ?from)) :effect (and (at ?entity ?to) (not (at ?entity ?from)) (at ?target ?to) (not (at ?target ?from))))",
        "give :parameters (?giving_person - person ?receiving_person - person ?item - item ?place - place) :precondition (and (alive ?giving_person) (free ?giving_person) (at ?giving_person ?place) (has ?giving_person ?item) (alive ?receiving_person) (free ?receiving_person) (at ?receiving_person ?place)) :effect (and (has ?receiving_person ?item) (not (has ?giving_person ?item)) (when (belongsto ?item ?giving_person) (belongsto ?item ?receiving_person))))": "(:action give :parameters (?giving_person - person ?receiving_person - person ?item - item ?place - place) :precondition (and (alive ?giving_person) (free ?giving_person) (at ?giving_person ?place) (has ?giving_person ?item) (alive ?receiving_person) (free ?receiving_person) (at ?receiving_person ?place)) :effect (and (has ?receiving_person ?item) (not (has ?giving_person ?item)) (when (belongsto ?item ?giving_person) (belongsto ?item ?receiving_person))))",
        "tieup :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (at ?target ?place)) :effect (and (not (free ?target))))": "(:action tieup :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (at ?target ?place)) :effect (and (not (free ?target))))",
        "untie :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (not (free ?target)) (at ?target ?place)) :effect (free ?target))": "(:action untie :parameters (?actor - person ?target - person ?place - place) :precondition (and (alive ?actor) (free ?actor) (at ?actor ?place) (alive ?target) (not (free ?target)) (at ?target ?place)) :effect (free ?target))",
        "take :parameters (?taking_entity - person ?item - item ?holding_entity - person ?place - place) :precondition (and (not (= ?taking_entity ?holding_entity)) (alive ?taking_entity) (free ?taking_entity) (at ?taking_entity ?place) (alive ?holding_entity) (not (free ?holding_entity)) (at ?holding_entity ?place) (has ?holding_entity ?item)) :effect (and (has ?taking_entity ?item) (not (has ?holding_entity ?item))))": "(:action take :parameters (?taking_entity - person ?item - item ?holding_entity - person ?place - place) :precondition (and (not (= ?taking_entity ?holding_entity)) (alive ?taking_entity) (free ?taking_entity) (at ?taking_entity ?place) (alive ?holding_entity) (not (free ?holding_entity)) (at ?holding_entity ?place) (has ?holding_entity ?item)) :effect (and (has ?taking_entity ?item) (not (has ?holding_entity ?item))))",
        "heal :parameters (?healer_entity - person ?patient_entity - person ?sickness - sickness ?medicine - item ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?healer_entity) (free ?healer_entity) (at ?healer_entity ?place) (has ?healer_entity ?medicine) (alive ?patient_entity) (at ?patient_entity ?place) (sick ?patient_entity ?sickness)) :effect (and (not (sick ?patient_entity ?sickness)) (not (has ?healer_entity ?medicine))))": "(:action heal :parameters (?healer_entity - person ?patient_entity - person ?sickness - sickness ?medicine - item ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?healer_entity) (free ?healer_entity) (at ?healer_entity ?place) (has ?healer_entity ?medicine) (alive ?patient_entity) (at ?patient_entity ?place) (sick ?patient_entity ?sickness)) :effect (and (not (sick ?patient_entity ?sickness)) (not (has ?healer_entity ?medicine))))",
        "make-friends": "(:action make-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (awake ?character1) (awake ?character2) (not (friends ?character1 ?character2)) (not (= ?character1 ?character2)))\n :effect (friends ?character1 ?character2)\n)",
        "experience-emotion": "(:action experience-emotion\n :parameters (?entity - character ?emotion - emotion)\n :precondition (alive ?entity)\n :effect (has-emotion ?entity ?emotion)\n)",
        "notice-change :parameters (?entity - (either person character)) :precondition (alive ?entity) :effect (knows-change ?entity))": "(:action notice-change :parameters (?entity - (either person character)) :precondition (alive ?entity) :effect (knows-change ?entity))",
        "memorize-appearance :parameters (?entity - character) :precondition (and (alive ?entity) (knows-change ?entity)) :effect (memorize ?entity))": "(:action memorize-appearance :parameters (?entity - character) :precondition (and (alive ?entity) (knows-change ?entity)) :effect (memorize ?entity))",
        "find-toy": "(:action find-toy\n :parameters (?character - character ?toy - toy)\n :precondition (in-drawer ?toy)\n :effect (and (not (in-drawer ?toy)) (friends ?character ?toy))\n)",
        "want-to-take": "(:action want-to-take\n :parameters (?taker - character ?toy - toy ?owner - character)\n :precondition (and (not (= ?taker ?owner)) (friends ?owner ?toy))\n :effect (wants-to-take ?taker ?toy)\n)",
        "stand-up": "(:action stand-up\n :parameters (?defender - character ?taker - character ?toy - toy)\n :precondition (and (not (= ?defender ?taker)) (wants-to-take ?taker ?toy) (friends ?defender ?toy))\n :effect (and (not (wants-to-take ?taker ?toy)) (brave ?defender))\n)"
    }
}