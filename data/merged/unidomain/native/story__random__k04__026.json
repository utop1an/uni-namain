{
    "predicates": {
        "(hungry ?character - character)": "Source predicate (hungry ?character - character).",
        "(food-available)": "Source predicate (food-available).",
        "(friend ?character1 - character ?character2 - character)": "Character1 is friends with character2.",
        "(worker ?character - character)": "Source predicate (worker ?character - character).",
        "(clean ?place - object)": "Source predicate (clean ?place - object).",
        "(makes-toys ?character - character)": "Source predicate (makes-toys ?character - character).",
        "(nervous ?character - character)": "Source predicate (nervous ?character - character).",
        "(friends-with ?character1 - character ?character2 - character)": "Character1 is friends with character2.",
        "(alive ?character - character)": "The character is alive.",
        "(happy ?character - character)": "The character is happy.",
        "(amazed ?character - character)": "Source predicate (amazed ?character - character).",
        "(supports ?character - character ?project - project)": "Source predicate (supports ?character - character ?project - project).",
        "(persistent ?character - character)": "Source predicate (persistent ?character - character).",
        "(completed ?project - project)": "Source predicate (completed ?project - project).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(ready ?character - character)": "Source predicate (ready ?character - character).",
        "(has-lover ?character - character)": "Source predicate (has-lover ?character - character).",
        "(has-child ?character - character ?child - character)": "Source predicate (has-child ?character - character ?child - character).",
        "(is-grandmother ?character - character)": "Source predicate (is-grandmother ?character - character).",
        "(is-ill ?character - character)": "Source predicate (is-ill ?character - character)."
    },
    "operators": {
        "start-working": "(:action start-working\n :parameters (?character - character)\n :precondition (and)\n :effect (worker ?character)\n)",
        "clean-factory": "(:action clean-factory\n :parameters (?character - character)\n :precondition (worker ?character)\n :effect (clean factory)\n)",
        "make-toys": "(:action make-toys\n :parameters (?character - character)\n :precondition (worker ?character)\n :effect (makes-toys ?character)\n)",
        "become-less-nervous": "(:action become-less-nervous\n :parameters (?character - character)\n :precondition (and (worker ?character) (nervous ?character))\n :effect (not (nervous ?character))\n)",
        "search-for-food": "(:action search-for-food\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (food-available)\n)",
        "feed": "(:action feed\n :parameters (?feeder - character ?eater - character)\n :precondition (and (alive ?feeder) (alive ?eater) (hungry ?eater) (food-available))\n :effect (not (hungry ?eater))\n)",
        "eat": "(:action eat\n :parameters (?eater - character ?eaten - character)\n :precondition (and (alive ?eater) (hungry ?eater) (alive ?eaten))\n :effect (not (alive ?eaten))\n)",
        "become-friends :parameters (?character1 - character ?character2 - character) :precondition (and (alive ?character1) (alive ?character2) (worker ?character1) (worker ?character2) (not (= ?character1 ?character2)) (not (friend ?character1 ?character2))) :effect (and (friend ?character1 ?character2) (friends-with ?character1 ?character2)))": "(:action become-friends :parameters (?character1 - character ?character2 - character) :precondition (and (alive ?character1) (alive ?character2) (worker ?character1) (worker ?character2) (not (= ?character1 ?character2)) (not (friend ?character1 ?character2))) :effect (and (friend ?character1 ?character2) (friends-with ?character1 ?character2)))",
        "get-ready": "(:action get-ready\n :parameters (?character - character)\n :precondition (not (ready ?character))\n :effect (ready ?character)\n)",
        "become-grandmother": "(:action become-grandmother\n :parameters (?character - character)\n :precondition (and (not (is-grandmother ?character)) (exists (?child - character) (has-child ?character ?child)))\n :effect (is-grandmother ?character)\n)",
        "become-ill": "(:action become-ill\n :parameters (?character - character)\n :precondition (not (is-ill ?character))\n :effect (is-ill ?character)\n)",
        "recover": "(:action recover\n :parameters (?character - character)\n :precondition (is-ill ?character)\n :effect (not (is-ill ?character))\n)",
        "become-amazed": "(:action become-amazed\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (amazed ?character)\n)",
        "support-project": "(:action support-project\n :parameters (?character - character ?project - project)\n :precondition (alive ?character)\n :effect (supports ?character ?project)\n)",
        "become-persistent": "(:action become-persistent\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (persistent ?character)\n)",
        "complete-project": "(:action complete-project\n :parameters (?character - character ?project - project)\n :precondition (and (alive ?character) (supports ?character ?project) (persistent ?character))\n :effect (completed ?project)\n)",
        "move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from) (ready ?character)) :effect (and (not (at ?character ?from)) (at ?character ?to)))": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from) (ready ?character)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "become-happy": "(:action become-happy :parameters (?character - character) :precondition (and (worker ?character) (alive ?character)) :effect (happy ?character))"
    }
}