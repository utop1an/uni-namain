{
    "predicates": {
        "(birthday ?character - character)": "Source predicate (birthday ?character - character).",
        "(box-closed)": "Source predicate (box-closed).",
        "(box-open)": "Source predicate (box-open).",
        "(cake-spoiled)": "Source predicate (cake-spoiled).",
        "(cake-good)": "Source predicate (cake-good).",
        "(listened-to-mom ?character - character)": "Source predicate (listened-to-mom ?character - character).",
        "(waited-for-birthday ?character - character)": "Source predicate (waited-for-birthday ?character - character).",
        "(at-party ?character - character)": "Source predicate (at-party ?character - character).",
        "(fast ?character - character)": "Source predicate (fast ?character - character).",
        "(cake-transformed)": "Source predicate (cake-transformed).",
        "(has ?character - character ?object - object)": "The character has the object.",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(in-stasis ?character - character)": "Source predicate (in-stasis ?character - character).",
        "(ancient-technology ?object - object)": "Source predicate (ancient-technology ?object - object).",
        "(propellant-device ?object - object)": "Source predicate (propellant-device ?object - object).",
        "(shielded ?object - object)": "Source predicate (shielded ?object - object).",
        "(requested-tow ?character - character ?place - place)": "Source predicate (requested-tow ?character - character ?place - place).",
        "(hurting ?character - character)": "Source predicate (hurting ?character - character).",
        "(struggling ?character - character)": "Source predicate (struggling ?character - character).",
        "(loved ?character1 - character ?character2 - character)": "Source predicate (loved ?character1 - character ?character2 - character).",
        "(letting-go ?character1 - character ?character2 - character)": "Source predicate (letting-go ?character1 - character ?character2 - character).",
        "(ready ?character - character)": "Source predicate (ready ?character - character).",
        "(better-times ?character - character)": "Source predicate (better-times ?character - character)."
    },
    "operators": {
        "wait-for-birthday": "(:action wait-for-birthday\n :parameters (?character - character)\n :precondition (and (not (birthday ?character)) (not (waited-for-birthday ?character)))\n :effect (waited-for-birthday ?character)\n)",
        "listen-to-mom": "(:action listen-to-mom\n :parameters (?character - character)\n :precondition (and (not (listened-to-mom ?character)) (waited-for-birthday ?character))\n :effect (listened-to-mom ?character)\n)",
        "open-box": "(:action open-box\n :parameters (?character - character)\n :precondition (and (box-closed) (birthday ?character))\n :effect (and (not (box-closed)) (box-open))\n)",
        "spoil-cake": "(:action spoil-cake\n :parameters ()\n :precondition (and (box-open) (not (listened-to-mom tim)) (cake-good))\n :effect (and (not (cake-good)) (cake-spoiled))\n)",
        "keep-cake-good": "(:action keep-cake-good\n :parameters ()\n :precondition (and (box-open) (listened-to-mom tim) (cake-good))\n :effect (cake-good)\n)",
        "go-to-party": "(:action go-to-party\n :parameters (?character - character)\n :precondition (not (at-party ?character))\n :effect (at-party ?character)\n)",
        "magic-trick": "(:action magic-trick\n :parameters (?magician - character)\n :precondition (and (at-party ?magician) (not (cake-transformed)))\n :effect (cake-transformed)\n)",
        "eat-cake": "(:action eat-cake\n :parameters (?character - character)\n :precondition (and (at-party ?character) (cake-transformed))\n :effect (fast ?character)\n)",
        "play": "(:action play\n :parameters (?character - character)\n :precondition (and (at-party ?character) (fast ?character))\n :effect (and)\n)",
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "acknowledge-pain": "(:action acknowledge-pain\n :parameters (?character - character)\n :precondition (and (hurting ?character) (struggling ?character))\n :effect (not (struggling ?character))\n)",
        "let-go": "(:action let-go\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (loved ?character1 ?character2) (not (ready ?character2)))\n :effect (letting-go ?character1 ?character2)\n)",
        "believe-in-better-times": "(:action believe-in-better-times\n :parameters (?character - character)\n :precondition (hurting ?character)\n :effect (better-times ?character)\n)",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)"
    }
}