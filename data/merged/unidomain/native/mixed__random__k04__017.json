        "(eaten ?c - character)": "Source predicate (eaten ?c - character).",
        "(rescued ?c - human)": "Source predicate (rescued ?c - human).",
        "(watches-tv ?character - character)": "Source predicate (watches-tv ?character - character).",
        "(rude ?character - character)": "Source predicate (rude ?character - character).",
        "(nice ?character - character)": "Source predicate (nice ?character - character).",
        "(wants-to-watch-tv ?character - character)": "Source predicate (wants-to-watch-tv ?character - character).",
        "(alive ?c - character)": "Character ?c is alive.",
        "(has ?c - character ?t - thing)": "Character ?c possesses thing ?t, including objects typed as item.",
        "(at ?character - character ?place - place)": "The character is at the specified place, including a house; house must be a subtype of place.",
        "(happy ?character - character)": "The character is happy.",
        "(sad ?character - character)": "Source predicate (sad ?character - character).",
        "(offered-snack ?giver - character ?receiver - character)": "Source predicate (offered-snack ?giver - character ?receiver - character).",
        "(snack-is-lie ?giver - character ?receiver - character)": "Source predicate (snack-is-lie ?giver - character ?receiver - character).",
        "(trusts ?character1 - character ?character2 - character)": "Source predicate (trusts ?character1 - character ?character2 - character).",
        "(compassionate ?character - character)": "Source predicate (compassionate ?character - character).",
        "(at ?character - character ?place - object)": "The character is at the specified place or object.",
        "(knows-survival-skills ?character - character)": "Source predicate (knows-survival-skills ?character - character).",
        "(computers-working)": "Source predicate (computers-working).",
        "(caused-apocalypse ?character - character)": "Source predicate (caused-apocalypse ?character - character).",
        "(alive ?character - character)": "Character ?c is alive.",
        "(has ?character - character ?item - item)": "Character ?c possesses thing ?t, including objects typed as item."
    },
    "operators": {
        "become-nice": "(:action become-nice\n :parameters (?character - character)\n :precondition (rude ?character)\n :effect (and (not (rude ?character)) (nice ?character))\n)",
        "become-rude": "(:action become-rude\n :parameters (?character - character)\n :precondition (nice ?character)\n :effect (and (not (nice ?character)) (rude ?character))\n)",
        "start-watching-tv :parameters (?character - character) :precondition (wants-to-watch-tv ?character) :effect (watches-tv ?character))": "(:action start-watching-tv :parameters (?character - character) :precondition (wants-to-watch-tv ?character) :effect (watches-tv ?character))",
        "stop-watching-tv :parameters (?c - character) :precondition (watches-tv ?c) :effect (not (watches-tv ?c)))": "(:action stop-watching-tv :parameters (?c - character) :precondition (watches-tv ?c) :effect (not (watches-tv ?c)))",
        "walk :parameters (?character - character ?source ?destination - house) :precondition (and (alive ?character) (at ?character ?source) (not (eaten ?character))) :effect (and (not (at ?character ?source)) (at ?character ?destination) (when (and (rescuer ?character)) (and (rescuer-at ?destination) (not (rescuer-at ?source))))))": "(:action walk :parameters (?character - character ?source ?destination - house) :precondition (and (alive ?character) (at ?character ?source) (not (eaten ?character))) :effect (and (not (at ?character ?source)) (at ?character ?destination) (when (and (rescuer ?character)) (and (rescuer-at ?destination) (not (rescuer-at ?source))))))",
        "eat :parameters (?m - wolf ?c - human ?p - place) :precondition (and (alive ?m) (alive ?c) (not (eaten ?c)) (at ?m ?p) (at ?c ?p) (monster ?m)) :effect (and (eaten ?c)))": "(:action eat :parameters (?m - wolf ?c - human ?p - place) :precondition (and (alive ?m) (alive ?c) (not (eaten ?c)) (at ?m ?p) (at ?c ?p) (monster ?m)) :effect (and (eaten ?c)))",
        "escape :parameters (?c - human ?m - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?m)) (at ?m ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))": "(:action escape :parameters (?c - human ?m - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?m)) (at ?m ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))",
        "give :parameters (?c1 ?c2 - human ?t - thing ?p - place) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?t) (at ?c1 ?p) (at ?c2 ?p)) :effect (and (has ?c2 ?t) (not (has ?c1 ?t))))": "(:action give :parameters (?c1 ?c2 - human ?t - thing ?p - place) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?t) (at ?c1 ?p) (at ?c2 ?p)) :effect (and (has ?c2 ?t) (not (has ?c1 ?t))))",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (and)\n :effect (happy ?character)\n)",
        "become-unhappy": "(:action become-unhappy\n :parameters (?character - character)\n :precondition (happy ?character)\n :effect (not (happy ?character))\n)",
        "learn-survival-skills :parameters (?l - character ?t - character) :precondition (and (alive ?l) (alive ?t) (knows-survival-skills ?t) (not (knows-survival-skills ?l))) :effect (knows-survival-skills ?l))": "(:action learn-survival-skills :parameters (?l - character ?t - character) :precondition (and (alive ?l) (alive ?t) (knows-survival-skills ?t) (not (knows-survival-skills ?l))) :effect (knows-survival-skills ?l))",
        "cause-apocalypse :parameters (?c - character) :precondition (and (alive ?c) (computers-working)) :effect (and (not (computers-working)) (caused-apocalypse ?c)))": "(:action cause-apocalypse :parameters (?c - character) :precondition (and (alive ?c) (computers-working)) :effect (and (not (computers-working)) (caused-apocalypse ?c)))",
        "kill": "(:action kill :parameters (?c - worker ?m - wolf ?a - axe ?p - place) :precondition (and (alive ?c) (alive ?m) (has ?c ?a) (at ?c ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?c) (not (= ?c ?m))) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "offer-snack": "(:action offer-snack\n :parameters (?giver - character ?receiver - character)\n :precondition (and (at ?receiver ?giver) (compassionate ?giver))\n :effect (offered-snack ?giver ?receiver)\n)",
        "run-away": "(:action run-away\n :parameters (?runner - character ?from - character)\n :precondition (and (at ?runner ?from) (sad ?runner))\n :effect (and (not (at ?runner ?from)) (not (trusts ?runner ?from)))\n)",
        "learn-lesson": "(:action learn-lesson\n :parameters (?character - character)\n :precondition (and (sad ?character) (not (trusts ?character ?character)))\n :effect (and (not (sad ?character)) (happy ?character))\n)",
        "go-to-place": "(:action go-to-place\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (at ?character1 ?character2)) (happy ?character1))\n :effect (and (at ?character1 ?character2) (not (happy ?character1)))\n)",
        "reveal-lie": "(:action reveal-lie\n :parameters (?giver - character ?receiver - character)\n :precondition (and (offered-snack ?giver ?receiver) (not (compassionate ?giver)))\n :effect (and (snack-is-lie ?giver ?receiver) (not (happy ?receiver)) (sad ?receiver))\n)"
    }
}