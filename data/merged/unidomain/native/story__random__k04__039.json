{
    "predicates": {
        "(digging ?character - character)": "Source predicate (digging ?character - character).",
        "(found ?character - character ?item - item)": "Source predicate (found ?character - character ?item - item).",
        "(opened ?character - character ?item - item)": "Source predicate (opened ?character - character ?item - item).",
        "(playing ?character - character)": "Source predicate (playing ?character - character).",
        "(has ?character - character ?object - object)": "The character possesses the object.",
        "(at-party ?character - character)": "Source predicate (at-party ?character - character).",
        "(fast ?character - character)": "Source predicate (fast ?character - character).",
        "(cake-transformed)": "Source predicate (cake-transformed).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(amazed ?character - character)": "Source predicate (amazed ?character - character).",
        "(supports ?character - character ?project - project)": "Source predicate (supports ?character - character ?project - project).",
        "(persistent ?character - character)": "Source predicate (persistent ?character - character).",
        "(completed ?project - project)": "Source predicate (completed ?project - project).",
        "(happy ?character - character)": "The character is happy.",
        "(worried ?character - character)": "Source predicate (worried ?character - character).",
        "(accepted-to-university ?character - character)": "Source predicate (accepted-to-university ?character - character).",
        "(applauding ?character - character)": "Source predicate (applauding ?character - character).",
        "(hardworking ?character - character)": "Source predicate (hardworking ?character - character).",
        "(dreams-come-true ?character - character)": "Source predicate (dreams-come-true ?character - character)."
    },
    "operators": {
        "open": "(:action open\n :parameters (?character - character ?item - item)\n :precondition (and (found ?character ?item) (not (opened ?character ?item)))\n :effect (opened ?character ?item)\n)",
        "dig :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (not (digging ?character))) :effect (digging ?character))": "(:action dig :parameters (?character - character ?object - object) :precondition (and (has ?character ?object) (not (digging ?character))) :effect (digging ?character))",
        "find :parameters (?character - character ?object - object) :precondition (and (digging ?character) (not (found ?character ?object))) :effect (and (found ?character ?object) (has ?character ?object)))": "(:action find :parameters (?character - character ?object - object) :precondition (and (digging ?character) (not (found ?character ?object))) :effect (and (found ?character ?object) (has ?character ?object)))",
        "go-to :parameters (?character - character ?place - place ?object - object) :precondition (and (not (at ?character ?place)) (has ?character ?object)) :effect (at ?character ?place))": "(:action go-to :parameters (?character - character ?place - place ?object - object) :precondition (and (not (at ?character ?place)) (has ?character ?object)) :effect (at ?character ?place))",
        "go-to-party": "(:action go-to-party\n :parameters (?character - character)\n :precondition (not (at-party ?character))\n :effect (at-party ?character)\n)",
        "magic-trick": "(:action magic-trick\n :parameters (?magician - character)\n :precondition (and (at-party ?magician) (not (cake-transformed)))\n :effect (cake-transformed)\n)",
        "eat-cake": "(:action eat-cake\n :parameters (?character - character)\n :precondition (and (at-party ?character) (cake-transformed))\n :effect (fast ?character)\n)",
        "play :parameters (?character - character) :precondition (and (opened ?character small-box) (at-party ?character) (fast ?character)) :effect (playing ?character))": "(:action play :parameters (?character - character) :precondition (and (opened ?character small-box) (at-party ?character) (fast ?character)) :effect (playing ?character))",
        "become-amazed": "(:action become-amazed\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (amazed ?character)\n)",
        "support-project": "(:action support-project\n :parameters (?character - character ?project - project)\n :precondition (alive ?character)\n :effect (supports ?character ?project)\n)",
        "become-persistent": "(:action become-persistent\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (persistent ?character)\n)",
        "complete-project": "(:action complete-project\n :parameters (?character - character ?project - project)\n :precondition (and (alive ?character) (supports ?character ?project) (persistent ?character))\n :effect (completed ?project)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (happy ?character)\n)",
        "stop-applauding": "(:action stop-applauding\n :parameters (?character - character)\n :precondition (applauding ?character)\n :effect (not (applauding ?character))\n)",
        "make-dreams-come-true": "(:action make-dreams-come-true\n :parameters (?character - character)\n :precondition (and (accepted-to-university ?character) (hardworking ?character))\n :effect (dreams-come-true ?character)\n)",
        "get-accepted": "(:action get-accepted\n :parameters (?character - character)\n :precondition (and (worried ?character) (hardworking ?character))\n :effect (and (accepted-to-university ?character) (not (worried ?character)) (happy ?character))\n)",
        "start-applauding": "(:action start-applauding\n :parameters (?character - character ?other - character)\n :precondition (and (not (applauding ?character)) (happy ?other))\n :effect (applauding ?character)\n)",
        "move": "(:action move\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)"
    }
}