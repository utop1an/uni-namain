        "start-wind": "(:action start-wind\n :parameters ()\n :precondition (and)\n :effect (wind-blows)\n)",
        "stop-wind": "(:action stop-wind\n :parameters ()\n :precondition (wind-blows)\n :effect (not (wind-blows))\n)",
