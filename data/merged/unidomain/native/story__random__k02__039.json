{
    "predicates": {
        "(at ?society - society ?planet - planet)": "Source predicate (at ?society - society ?planet - planet).",
        "(has-technology ?society - society ?technology - technology)": "Source predicate (has-technology ?society - society ?technology - technology).",
        "(in-habitable-zone ?planet - planet)": "Source predicate (in-habitable-zone ?planet - planet).",
        "(in-high-wind-zone ?planet - planet)": "Source predicate (in-high-wind-zone ?planet - planet).",
        "(in-low-wind-zone ?planet - planet)": "Source predicate (in-low-wind-zone ?planet - planet).",
        "(explored ?society - society ?planet - planet)": "Source predicate (explored ?society - society ?planet - planet).",
        "(feels-awful ?character - character)": "Source predicate (feels-awful ?character - character).",
        "(thinks-about-breakup ?character - character)": "Source predicate (thinks-about-breakup ?character - character).",
        "(heartbroken ?character - character)": "Source predicate (heartbroken ?character - character).",
        "(forgiven ?character - character)": "Source predicate (forgiven ?character - character).",
        "(learned ?character - character)": "Source predicate (learned ?character - character).",
        "(moved-on ?character - character)": "Source predicate (moved-on ?character - character)."
    },
    "operators": {
        "develop-technology": "(:action develop-technology\n :parameters (?society - society ?technology - technology)\n :precondition (and)\n :effect (has-technology ?society ?technology)\n)",
        "explore": "(:action explore\n :parameters (?society - society ?planet - planet ?technology - technology)\n :precondition (and (at ?society ?planet) (has-technology ?society ?technology) (or (in-habitable-zone ?planet) (in-high-wind-zone ?planet) (in-low-wind-zone ?planet)))\n :effect (explored ?society ?planet)\n)",
        "move": "(:action move\n :parameters (?society - society ?from - planet ?to - planet ?technology - technology)\n :precondition (and (at ?society ?from) (has-technology ?society ?technology) (or (in-habitable-zone ?to) (in-high-wind-zone ?to) (in-low-wind-zone ?to)))\n :effect (and (not (at ?society ?from)) (at ?society ?to))\n)",
        "forgive": "(:action forgive\n :parameters (?character - character)\n :precondition (and (feels-awful ?character) (not (forgiven ?character)))\n :effect (forgiven ?character)\n)",
        "learn": "(:action learn\n :parameters (?character - character)\n :precondition (and (heartbroken ?character) (not (learned ?character)))\n :effect (learned ?character)\n)",
        "move-on": "(:action move-on\n :parameters (?character - character)\n :precondition (and (thinks-about-breakup ?character) (forgiven ?character) (learned ?character) (not (moved-on ?character)))\n :effect (moved-on ?character)\n)"
    }
}