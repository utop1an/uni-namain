{
    "predicates": {
        "(in ?item - item ?room - room)": "Source predicate (in ?item - item ?room - room).",
        "(occupied ?item - item)": "Source predicate (occupied ?item - item).",
        "(plugged-in ?item - item)": "Source predicate (plugged-in ?item - item).",
        "(connected ?item1 - item ?item2 - item)": "Source predicate (connected ?item1 - item ?item2 - item).",
        "(well-lit ?room - room)": "Source predicate (well-lit ?room - room).",
        "(morning)": "Source predicate (morning).",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(discovered ?place - place)": "Source predicate (discovered ?place - place).",
        "(knows-about ?character - character ?place - place)": "Source predicate (knows-about ?character - character ?place - place).",
        "(is-ceo ?character - character)": "Source predicate (is-ceo ?character - character).",
        "(is-alien ?character - character)": "Source predicate (is-alien ?character - character).",
        "(president ?character - character)": "Source predicate (president ?character - character).",
        "(speaker ?character - character)": "Source predicate (speaker ?character - character).",
        "(vice-president ?character - character)": "Source predicate (vice-president ?character - character).",
        "(belongs-to ?character - character ?organization - organization)": "Source predicate (belongs-to ?character - character ?organization - organization).",
        "(economy-collapsed)": "Source predicate (economy-collapsed).",
        "(real-estate-monopoly)": "Source predicate (real-estate-monopoly).",
        "(planned-parenthood-defunded)": "Source predicate (planned-parenthood-defunded).",
        "(planned-parenthood-shutdown)": "Source predicate (planned-parenthood-shutdown).",
        "(planned-parenthood-criminalized)": "Source predicate (planned-parenthood-criminalized).",
        "(prison-population-increased)": "Source predicate (prison-population-increased).",
        "(political-prisoner ?character - character)": "Source predicate (political-prisoner ?character - character).",
        "(sailor ?character - character)": "Source predicate (sailor ?character - character).",
        "(nice ?character - character)": "Source predicate (nice ?character - character).",
        "(sailing ?character - character)": "Source predicate (sailing ?character - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character).",
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character)."
    },
    "operators": {
        "move-item": "(:action move-item\n :parameters (?item - item ?from - room ?to - room)\n :precondition (and (not (= ?from ?to)) (in ?item ?from))\n :effect (and (not (in ?item ?from)) (in ?item ?to))\n)",
        "plug-in": "(:action plug-in\n :parameters (?item - item)\n :precondition (not (plugged-in ?item))\n :effect (plugged-in ?item)\n)",
        "connect": "(:action connect\n :parameters (?item1 - item ?item2 - item)\n :precondition (and (not (connected ?item1 ?item2)) (not (= ?item1 ?item2)))\n :effect (connected ?item1 ?item2)\n)",
        "morning-comes": "(:action morning-comes\n :parameters (?room - room)\n :precondition (and (not (well-lit ?room)) (morning))\n :effect (well-lit ?room)\n)",
        "night-falls": "(:action night-falls\n :parameters (?room - room)\n :precondition (and (well-lit ?room) (not (morning)))\n :effect (not (well-lit ?room))\n)",
        "occupy": "(:action occupy\n :parameters (?item - item)\n :precondition (not (occupied ?item))\n :effect (occupied ?item)\n)",
        "unoccupy": "(:action unoccupy\n :parameters (?item - item)\n :precondition (occupied ?item)\n :effect (not (occupied ?item))\n)",
        "discover": "(:action discover\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place) (not (discovered ?place)))\n :effect (discovered ?place)\n)",
        "learn": "(:action learn\n :parameters (?learner - character ?place - place)\n :precondition (and (alive ?learner) (discovered ?place))\n :effect (knows-about ?learner ?place)\n)",
        "hold-press-conference": "(:action hold-press-conference\n :parameters (?speaker - character ?place - place)\n :precondition (and (alive ?speaker) (is-ceo ?speaker) (knows-about ?speaker ?place))\n :effect (forall (?listener - character) (knows-about ?listener ?place))\n)",
        "reveal": "(:action reveal\n :parameters (?alien - character)\n :precondition (and (alive ?alien) (is-alien ?alien))\n :effect (forall (?listener - character) (knows-about ?listener ?alien))\n)",
        "announce-state-of-the-union": "(:action announce-state-of-the-union\n :parameters (?president - character)\n :precondition (president ?president)\n :effect (and)\n)",
        "introduce-president": "(:action introduce-president\n :parameters (?speaker - character ?president - character)\n :precondition (and (speaker ?speaker) (president ?president))\n :effect (and)\n)",
        "attend-state-of-the-union": "(:action attend-state-of-the-union\n :parameters (?vice-president - character)\n :precondition (vice-president ?vice-president)\n :effect (and)\n)",
        "learn-to-sail": "(:action learn-to-sail\n :parameters (?character - character)\n :precondition (and)\n :effect (sailor ?character)\n)",
        "become-nice": "(:action become-nice\n :parameters (?character - character)\n :precondition (and)\n :effect (nice ?character)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (not (= ?helper ?helpee))\n :effect (helping ?helper ?helpee)\n)",
        "sail-together": "(:action sail-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sailor ?character1) (sailor ?character2))\n :effect (together ?character1 ?character2)\n)",
        "thank": "(:action thank\n :parameters (?thanker - character ?thankee - character)\n :precondition (not (= ?thanker ?thankee))\n :effect (nice ?thanker)\n)",
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)"
    }
}