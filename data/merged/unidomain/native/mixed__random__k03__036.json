    "operators": {
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "put-on-clothes": "(:action put-on-clothes\n :parameters (?character - character)\n :precondition (and (awake ?character) (not (wearing-clothes ?character)))\n :effect (wearing-clothes ?character)\n)",
        "turn-on-device": "(:action turn-on-device\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (has-device ?character ?device) (not (device-on ?device)))\n :effect (device-on ?device)\n)",
        "check-connectivity": "(:action check-connectivity\n :parameters (?character - character ?device - device)\n :precondition (and (awake ?character) (device-on ?device) (has-device ?character ?device))\n :effect (when (device-connected ?device) (working ?device))\n)",
        "cancel-school": "(:action cancel-school\n :parameters ()\n :precondition (not (school-canceled))\n :effect (school-canceled)\n)",
        "go-outside": "(:action go-outside\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (wearing-clothes ?character) (at ?character ?place))\n :effect (and (not (at ?character ?place)) (at ?character outside))\n)",
        "talk": "(:action talk\n :parameters (?speaker - character ?listener - character)\n :precondition (and (awake ?speaker) (awake ?listener) (at ?speaker outside) (at ?listener outside))\n :effect (and)\n)",
        "play-chess": "(:action play-chess\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (sick ?character1)) (not (sick ?character2)) (not (= ?character1 ?character2)) (sit-together ?character1 ?character2))\n :effect (and (play-chess ?character1 ?character2) (happy ?character1) (happy ?character2))\n)",
        "get-sick": "(:action get-sick\n :parameters (?character - character)\n :precondition (and)\n :effect (sick ?character)\n)",
        "feel-better": "(:action feel-better\n :parameters (?character - character)\n :precondition (sick ?character)\n :effect (not (sick ?character))\n)",
        "sit-together": "(:action sit-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (sit-together ?character1 ?character2)\n)",
        "move-location :parameters (?character - character ?to-place - place ?from-place - place) :precondition (and (player ?character) (connected ?to-place ?from-place) (at ?character ?from-place) (knows ?character)) :effect (and (not (at ?character ?from-place)) (at ?character ?to-place)))": "(:action move-location :parameters (?character - character ?to-place - place ?from-place - place) :precondition (and (player ?character) (connected ?to-place ?from-place) (at ?character ?from-place) (knows ?character)) :effect (and (not (at ?character ?from-place)) (at ?character ?to-place)))",
        "interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - place) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))": "(:action interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - place) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))",
        "place-victim :parameters (?placer - character ?victim - character ?place - place ?destination - place) :precondition (and (henchman ?placer) (has ?placer ?victim) (at ?placer ?place) (connected ?destination ?place)) :effect (and (not (has ?placer ?victim)) (at ?victim ?destination) (captured ?victim)))": "(:action place-victim :parameters (?placer - character ?victim - character ?place - place ?destination - place) :precondition (and (henchman ?placer) (has ?placer ?victim) (at ?placer ?place) (connected ?destination ?place)) :effect (and (not (has ?placer ?victim)) (at ?victim ?destination) (captured ?victim)))",
        "save-character :parameters (?saver - character ?saved - character ?notsaved - character ?place - place) :precondition (and (player ?saver) (at ?saver ?place) (at ?saved ?place) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?place))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))": "(:action save-character :parameters (?saver - character ?saved - character ?notsaved - character ?place - place) :precondition (and (player ?saver) (at ?saver ?place) (at ?saved ?place) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?place))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))"
    }
}