        "move": "(:action move\n :parameters (?c - patient ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "lose-consciousness": "(:action lose-consciousness\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?l))\n :effect (and (unconscious ?p) (not (conscious ?p)))\n)",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?a ?b - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?a) (connected ?a ?b) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?a)) (level-of-work ?d ?b)))": "(:action admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?a ?b - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?a) (connected ?a ?b) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?a)) (level-of-work ?d ?b)))",
        "interrogate-character :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (player ?c1) (at ?c1 ?l) (at ?c2 ?l) (apprehended ?c2)) :effect (knows ?c1))": "(:action interrogate-character :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (player ?c1) (at ?c1 ?l) (at ?c2 ?l) (apprehended ?c2)) :effect (knows ?c1))",
        "walk :parameters (?c - character ?l1 ?l2 - location) :precondition (and (alive ?c) (at ?c ?l1) (not (eaten ?c))) :effect (and (not (at ?c ?l1)) (at ?c ?l2) (when (and (rescuer ?c)) (and (rescuer-at ?l2) (not (rescuer-at ?l1))))))": "(:action walk :parameters (?c - character ?l1 ?l2 - location) :precondition (and (alive ?c) (at ?c ?l1) (not (eaten ?c))) :effect (and (not (at ?c ?l1)) (at ?c ?l2) (when (and (rescuer ?c)) (and (rescuer-at ?l2) (not (rescuer-at ?l1))))))",
        "eat :parameters (?m - wolf ?p - human ?l - location) :precondition (and (alive ?m) (alive ?p) (not (eaten ?p)) (at ?m ?l) (at ?p ?l) (monster ?m)) :effect (and (eaten ?p)))": "(:action eat :parameters (?m - wolf ?p - human ?l - location) :precondition (and (alive ?m) (alive ?p) (not (eaten ?p)) (at ?m ?l) (at ?p ?l) (monster ?m)) :effect (and (eaten ?p)))",
        "escape :parameters (?c - human ?p - character ?l - location) :precondition (and (eaten ?c) (not (alive ?p)) (at ?p ?l)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?l)))": "(:action escape :parameters (?c - human ?p - character ?l - location) :precondition (and (eaten ?c) (not (alive ?p)) (at ?p ?l)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?l)))",
        "kill :parameters (?p - worker ?m - wolf ?t - (either thing character) ?l - location) :precondition (and (alive ?p) (alive ?m) (has ?p ?t) (at ?p ?l) (at ?m ?l) (monster ?m) (monster-alive) (rescuer ?p)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?p - worker ?m - wolf ?t - (either thing character) ?l - location) :precondition (and (alive ?p) (alive ?m) (has ?p ?t) (at ?p ?l) (at ?m ?l) (monster ?m) (monster-alive) (rescuer ?p)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "give :parameters (?p1 ?p2 - human ?o - (either thing character) ?l - location) :precondition (and (not (eaten ?p2)) (alive ?p1) (alive ?p2) (has ?p1 ?o) (at ?p1 ?l) (at ?p2 ?l)) :effect (and (has ?p2 ?o) (not (has ?p1 ?o))))": "(:action give :parameters (?p1 ?p2 - human ?o - (either thing character) ?l - location) :precondition (and (not (eaten ?p2)) (alive ?p1) (alive ?p2) (has ?p1 ?o) (at ?p1 ?l) (at ?p2 ?l)) :effect (and (has ?p2 ?o) (not (has ?p1 ?o))))",
        "save-character :parameters (?rescuer - character ?rescued - character ?p - character ?l - location) :precondition (and (player ?rescuer) (at ?rescuer ?l) (at ?rescued ?l) (captured ?rescued) (captured ?p) (not (at ?p ?l))) :effect (and (saved ?rescued ?rescuer) (not (alive ?p))))": "(:action save-character :parameters (?rescuer - character ?rescued - character ?p - character ?l - location) :precondition (and (player ?rescuer) (at ?rescuer ?l) (at ?rescued ?l) (captured ?rescued) (captured ?p) (not (at ?p ?l))) :effect (and (saved ?rescued ?rescuer) (not (alive ?p))))",
        "move-location :parameters (?c - character ?a ?b - (either level location)) :precondition (and (player ?c) (connected ?a ?b) (at ?c ?b) (knows ?c)) :effect (and (not (at ?c ?b)) (at ?c ?a)))": "(:action move-location :parameters (?c - character ?a ?b - (either level location)) :precondition (and (player ?c) (connected ?a ?b) (at ?c ?b) (knows ?c)) :effect (and (not (at ?c ?b)) (at ?c ?a)))",
        "place-victim :parameters (?agent - character ?target - character ?b - (either level location) ?a - (either level location)) :precondition (and (henchman ?agent) (has ?agent ?target) (at ?agent ?b) (connected ?a ?b)) :effect (and (not (has ?agent ?target)) (at ?target ?a) (captured ?target)))": "(:action place-victim :parameters (?agent - character ?target - character ?b - (either level location) ?a - (either level location)) :precondition (and (henchman ?agent) (has ?agent ?target) (at ?agent ?b) (connected ?a ?b)) :effect (and (not (has ?agent ?target)) (at ?target ?a) (captured ?target)))"
    }
