        "steal-cash :parameters (?offender ?target - person ?place - place) :precondition (and (at ?offender ?place) (at ?target ?place) (has-cash ?target) (thecriminal ?offender)) :effect (and (has-cash ?offender) (not (has-cash ?target)) (done-crime ?offender) (crime-done)))": "(:action steal-cash :parameters (?offender ?target - person ?place - place) :precondition (and (at ?offender ?place) (at ?target ?place) (has-cash ?target) (thecriminal ?offender)) :effect (and (has-cash ?offender) (not (has-cash ?target)) (done-crime ?offender) (crime-done)))",
        "steal-medicine :parameters (?person - person ?place - place) :precondition (and (at ?person ?place) (theinvalid ?person) (invalid-unwell) (not (has-cash ?person))) :effect (and (has-medicine ?person)))": "(:action steal-medicine :parameters (?person - person ?place - place) :precondition (and (at ?person ?place) (theinvalid ?person) (invalid-unwell) (not (has-cash ?person))) :effect (and (has-medicine ?person)))",
        "get-medicine :parameters (?buyer ?seller - person ?place - place) :precondition (and (has-cash ?buyer) (not (has-medicine ?buyer)) (has-medicine ?seller) (at ?buyer ?place) (at ?seller ?place)) :effect (and (has-medicine ?buyer) (not (has-cash ?buyer)) (has-cash ?seller) (not (has-medicine ?seller))))": "(:action get-medicine :parameters (?buyer ?seller - person ?place - place) :precondition (and (has-cash ?buyer) (not (has-medicine ?buyer)) (has-medicine ?seller) (at ?buyer ?place) (at ?seller ?place)) :effect (and (has-medicine ?buyer) (not (has-cash ?buyer)) (has-cash ?seller) (not (has-medicine ?seller))))",
        "take-thing :parameters (?taker - (either person character) ?item - item ?place - place) :precondition (and (at ?taker ?place) (at ?item ?place) (not (asleep ?taker)) (not (enchanted ?item))) :effect (and (not (at ?item ?place)) (has ?taker ?item)))": "(:action take-thing :parameters (?taker - (either person character) ?item - item ?place - place) :precondition (and (at ?taker ?place) (at ?item ?place) (not (asleep ?taker)) (not (enchanted ?item))) :effect (and (not (at ?item ?place)) (has ?taker ?item)))",
