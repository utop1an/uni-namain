        "sell-land :parameters (?vendor - rancher ?purchaser - person ?parcel - place) :precondition (and (owns ?vendor ?parcel) (wants ?purchaser ?parcel) (has-cash ?purchaser) (decided-move-city)) :effect (and (has-cash ?vendor) (not (has-cash ?purchaser)) (owns ?purchaser ?parcel) (not (owns ?vendor ?parcel))))": "(:action sell-land :parameters (?vendor - rancher ?purchaser - person ?parcel - place) :precondition (and (owns ?vendor ?parcel) (wants ?purchaser ?parcel) (has-cash ?purchaser) (decided-move-city)) :effect (and (has-cash ?vendor) (not (has-cash ?purchaser)) (owns ?purchaser ?parcel) (not (owns ?vendor ?parcel))))",
        "buy-ticket :parameters (?purchaser ?payee - person ?location - place) :precondition (and (has-cash ?purchaser) (= ?payee railwaydeveloper)) :effect (and (has-ticket ?purchaser) (not (has-cash ?purchaser)) (has-cash ?payee)))": "(:action buy-ticket :parameters (?purchaser ?payee - person ?location - place) :precondition (and (has-cash ?purchaser) (= ?payee railwaydeveloper)) :effect (and (has-ticket ?purchaser) (not (has-cash ?purchaser)) (has-cash ?payee)))",
        "steal-item :parameters (?thief ?holder - (either person character) ?item - item) :precondition (and (has ?holder ?item)) :effect (and (not (has ?holder ?item))))": "(:action steal-item :parameters (?thief ?holder - (either person character) ?item - item) :precondition (and (has ?holder ?item)) :effect (and (not (has ?holder ?item))))",
        "chop-wood :parameters (?actor - (either person character)) :precondition (and (not (has-firewood ?actor))) :effect (and (has-firewood ?actor)))": "(:action chop-wood :parameters (?actor - (either person character)) :precondition (and (not (has-firewood ?actor))) :effect (and (has-firewood ?actor)))",
        "heal": "(:action heal :parameters (?holder - person ?patient - person ?sickness - sickness ?medicine - item ?place - place) :precondition (and (cures ?medicine ?sickness) (alive ?holder) (free ?holder) (at ?holder ?place) (has ?holder ?medicine) (alive ?patient) (at ?patient ?place) (sick ?patient ?sickness) (has-medicine ?patient) (not (healthy ?patient)) (theinvalid ?patient) (invalid-unwell)) :effect (and (not (sick ?patient ?sickness)) (not (has ?holder ?medicine)) (healthy ?patient) (not (has-medicine ?patient)) (recovered ?patient) (not (invalid-unwell)) (invalid-recovered)))",
        "prepare-for-winter :parameters (?person - person) :precondition (and (autumn) (alive ?person) (winter-proofed-house) (has-firewood ?person)) :effect (and (prepared-for-winter)))": "(:action prepare-for-winter :parameters (?person - person) :precondition (and (autumn) (alive ?person) (winter-proofed-house) (has-firewood ?person)) :effect (and (prepared-for-winter)))",
