        "untie": "(:action untie\n :parameters (?person - person ?victim - person ?place - place)\n :precondition (and (alive ?person) (free ?person) (at ?person ?place) (alive ?victim) (not (free ?victim)) (at ?victim ?place))\n :effect (free ?victim)\n)",
        "take :parameters (?holder - person ?item - item ?source - person ?place - place) :precondition (and (not (= ?holder ?source)) (alive ?holder) (free ?holder) (at ?holder ?place) (alive ?source) (not (free ?source)) (at ?source ?place) (has ?source ?item)) :effect (and (has ?holder ?item) (not (has ?source ?item))))": "(:action take :parameters (?holder - person ?item - item ?source - person ?place - place) :precondition (and (not (= ?holder ?source)) (alive ?holder) (free ?holder) (at ?holder ?place) (alive ?source) (not (free ?source)) (at ?source ?place) (has ?source ?item)) :effect (and (has ?holder ?item) (not (has ?source ?item))))",
        "give :parameters (?giving_holder - (either person character) ?receiving_holder - (either person character) ?item - item ?place - place) :precondition (and (alive ?giving_holder) (free ?giving_holder) (at ?giving_holder ?place) (has ?giving_holder ?item) (alive ?receiving_holder) (free ?receiving_holder) (at ?receiving_holder ?place)) :effect (and (has ?receiving_holder ?item) (not (has ?giving_holder ?item)) (when (belongsto ?item ?giving_holder) (belongsto ?item ?receiving_holder))))": "(:action give :parameters (?giving_holder - (either person character) ?receiving_holder - (either person character) ?item - item ?place - place) :precondition (and (alive ?giving_holder) (free ?giving_holder) (at ?giving_holder ?place) (has ?giving_holder ?item) (alive ?receiving_holder) (free ?receiving_holder) (at ?receiving_holder ?place)) :effect (and (has ?receiving_holder ?item) (not (has ?giving_holder ?item)) (when (belongsto ?item ?giving_holder) (belongsto ?item ?receiving_holder))))",
