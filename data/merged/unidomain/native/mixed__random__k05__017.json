{
    "predicates": {
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character).",
        "(scared ?character - character)": "Source predicate (scared ?character - character).",
        "(spider-on-wall)": "Source predicate (spider-on-wall).",
        "(cake-made)": "Source predicate (cake-made).",
        "(sad ?character - character)": "Source predicate (sad ?character - character).",
        "(happy ?character - character)": "The character is happy.",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(at ?character - character ?location - location)": "The character is at the specified location.",
        "(president ?character - character)": "Source predicate (president ?character - character).",
        "(speaker ?character - character)": "Source predicate (speaker ?character - character).",
        "(vice-president ?character - character)": "Source predicate (vice-president ?character - character).",
        "(belongs-to ?character - character ?organization - organization)": "Source predicate (belongs-to ?character - character ?organization - organization).",
        "(economy-collapsed)": "Source predicate (economy-collapsed).",
        "(real-estate-monopoly)": "Source predicate (real-estate-monopoly).",
        "(planned-parenthood-defunded)": "Source predicate (planned-parenthood-defunded).",
        "(planned-parenthood-shutdown)": "Source predicate (planned-parenthood-shutdown).",
        "(planned-parenthood-criminalized)": "Source predicate (planned-parenthood-criminalized).",
        "(prison-population-increased)": "Source predicate (prison-population-increased).",
        "(political-prisoner ?character - character)": "Source predicate (political-prisoner ?character - character).",
        "(player ?character - character)": "Source predicate (player ?character - character).",
        "(at ?thing - item ?location - location)": "Source predicate (at ?thing - item ?location - location).",
        "(asleep ?character - character)": "Source predicate (asleep ?character - character).",
        "(connected ?location - location ?oldlocation - location)": "Source predicate (connected ?location - location ?oldlocation - location).",
        "(enchanted ?item - item)": "Source predicate (enchanted ?item - item).",
        "(is ?item - item ?thing - thing)": "Source predicate (is ?item - item ?thing - thing).",
        "(play-chess ?character1 - character ?character2 - character)": "Source predicate (play-chess ?character1 - character ?character2 - character).",
        "(feel-better ?character - character)": "Source predicate (feel-better ?character - character).",
        "(sit-together ?character1 - character ?character2 - character)": "Source predicate (sit-together ?character1 - character ?character2 - character).",
        "(sick ?character - character)": "Source predicate (sick ?character - character)."
    },
    "operators": {
        "see-spider": "(:action see-spider\n :parameters (?character - character)\n :precondition (and (not (scared ?character)) (not (spider-on-wall)))\n :effect (and (scared ?character) (spider-on-wall))\n)",
        "remove-spider": "(:action remove-spider\n :parameters (?character - character ?helpee - character)\n :precondition (and (spider-on-wall) (helping ?character ?helpee))\n :effect (not (spider-on-wall))\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (and (not (= ?helper ?helpee)) (scared ?helpee))\n :effect (and (not (scared ?helpee)) (happy ?helpee) (helping ?helper ?helpee))\n)",
        "make-cake": "(:action make-cake\n :parameters (?character - character)\n :precondition (and (not (cake-made)) (happy ?character))\n :effect (cake-made)\n)",
        "take-toy": "(:action take-toy\n :parameters (?taker - character ?victim - character ?item - item)\n :precondition (and (not (= ?taker ?victim)) (has ?victim ?item) (not (has ?taker ?item)))\n :effect (and (not (has ?victim ?item)) (has ?taker ?item) (sad ?victim))\n)",
        "receive-gift": "(:action receive-gift\n :parameters (?receiver - character ?giver - character ?item - item)\n :precondition (and (not (= ?receiver ?giver)) (happy ?giver) (not (has ?receiver ?item)) (has ?giver ?item))\n :effect (and (has ?receiver ?item) (happy ?receiver))\n)",
        "play": "(:action play\n :parameters (?character - character ?item - item)\n :precondition (and (has ?character ?item) (not (sad ?character)))\n :effect (happy ?character)\n)",
        "lose-toy": "(:action lose-toy\n :parameters (?character - character ?item - item)\n :precondition (and (has ?character ?item) (happy ?character))\n :effect (and (not (has ?character ?item)) (sad ?character))\n)",
        "introduce-president": "(:action introduce-president\n :parameters (?speaker - character ?president - character)\n :precondition (and (speaker ?speaker) (president ?president))\n :effect (and)\n)",
        "get-sick": "(:action get-sick\n :parameters (?character - character)\n :precondition (and)\n :effect (sick ?character)\n)",
        "feel-better": "(:action feel-better\n :parameters (?character - character)\n :precondition (sick ?character)\n :effect (not (sick ?character))\n)",
        "sit-together": "(:action sit-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (sit-together ?character1 ?character2)\n)",
        "play-chess": "(:action play-chess\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (sick ?character1)) (not (sick ?character2)) (not (= ?character1 ?character2)) (sit-together ?character1 ?character2))\n :effect (and (play-chess ?character1 ?character2) (happy ?character1) (happy ?character2))\n)",
        "announce-state-of-the-union": "(:action announce-state-of-the-union\n :parameters (?president - character)\n :precondition (president ?president)\n :effect (and)\n)",
        "attend-state-of-the-union": "(:action attend-state-of-the-union\n :parameters (?vice-president - character)\n :precondition (vice-president ?vice-president)\n :effect (and)\n)",
        "move-location": "(:action move-location\n :parameters (?character - character ?to - location ?from - location)\n :precondition (and (connected ?to ?from) (not (asleep ?character)) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "wake-person": "(:action wake-person\n :parameters (?waker - character ?woken - character ?location - location)\n :precondition (and (at ?waker ?location) (at ?woken ?location) (asleep ?woken) (not (asleep ?waker)))\n :effect (not (asleep ?woken))\n)",
        "take-thing": "(:action take-thing\n :parameters (?taker - character ?thing - item ?location - location)\n :precondition (and (at ?taker ?location) (at ?thing ?location) (not (asleep ?taker)) (not (enchanted ?thing)))\n :effect (and (not (at ?thing ?location)) (has ?taker ?thing))\n)",
        "disenchant-thing": "(:action disenchant-thing\n :parameters (?caster - character ?thing - item ?book - book ?location - location)\n :precondition (and (at ?caster ?location) (at ?thing ?location) (not (asleep ?caster)) (has ?caster ?book) (enchanted ?thing))\n :effect (not (enchanted ?thing))\n)"
    }
}