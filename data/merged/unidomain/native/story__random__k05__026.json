{
    "predicates": {
        "(fierce ?character - character)": "Source predicate (fierce ?character - character).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(sneezed ?character - character)": "Source predicate (sneezed ?character - character).",
        "(playing ?character1 - character ?character2 - character)": "Character1 is playing with character2; the reserved character constant no-partner indicates playing without a specified second character.",
        "(tired ?character - character)": "Source predicate (tired ?character - character).",
        "(sleeping ?character - character)": "Source predicate (sleeping ?character - character).",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(has-energy ?character - character)": "Source predicate (has-energy ?character - character).",
        "(playing ?character - character)": "Character1 is playing with character2; the reserved character constant no-partner indicates playing without a specified second character.",
        "(scared ?character - character)": "The character is scared, without specifying whom they fear.",
        "(human ?character - character)": "Source predicate (human ?character - character).",
        "(crow ?character - character)": "Source predicate (crow ?character - character).",
        "(sunlight-available)": "Source predicate (sunlight-available).",
        "(transformed ?character - character)": "Source predicate (transformed ?character - character).",
        "(in-pain ?character - character)": "The character is hurt or experiencing pain.",
        "(alive ?character - character)": "Source predicate (alive ?character - character).",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(near ?item1 - item ?item2 - item)": "Source predicate (near ?item1 - item ?item2 - item).",
        "(in-nest ?bird - character)": "Source predicate (in-nest ?bird - character).",
        "(at ?character - character ?location - object)": "The character is at the specified location, which may be a place or another object.",
        "(touching ?character - character ?object - object)": "Source predicate (touching ?character - character ?object - object).",
        "(hugging ?character1 - character ?character2 - character)": "Source predicate (hugging ?character1 - character ?character2 - character).",
        "(hurt ?character - character)": "The character is hurt or experiencing pain."
    },
    "operators": {
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (not (friends ?character1 ?character2)))\n :effect (friends ?character1 ?character2)\n)",
        "sneeze": "(:action sneeze\n :parameters (?character - character)\n :precondition (and)\n :effect (sneezed ?character)\n)",
        "sleep": "(:action sleep\n :parameters (?character - character)\n :precondition (and (tired ?character) (not (sleeping ?character)))\n :effect (and (not (awake ?character)) (sleeping ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (sleeping ?character)\n :effect (and (awake ?character) (not (sleeping ?character)) (not (tired ?character)) (has-energy ?character))\n)",
        "start-playing": "(:action start-playing :parameters (?character - character ?partner - character) :precondition (and (not (= ?character ?partner)) (friends ?character ?partner) (awake ?character) (not (playing ?character ?partner)) (has-energy ?character)) :effect (playing ?character ?partner))",
        "stop-playing :parameters (?character1 - character ?character2 - character) :precondition (playing ?character1 ?character2) :effect (and (not (playing ?character1 ?character2)) (tired ?character1)))": "(:action stop-playing :parameters (?character1 - character ?character2 - character) :precondition (playing ?character1 ?character2) :effect (and (not (playing ?character1 ?character2)) (tired ?character1)))",
        "transform-back-into-human": "(:action transform-back-into-human\n :parameters (?character - character)\n :precondition (crow ?character)\n :effect (and (not (crow ?character)) (human ?character))\n)",
        "transform-into-crow": "(:action transform-into-crow\n :parameters (?character - character)\n :precondition (and (human ?character) (in-pain ?character) (sunlight-available))\n :effect (and (not (human ?character)) (crow ?character) (transformed ?character))\n)",
        "play": "(:action play\n :parameters (?character - character ?item - item)\n :precondition (and (alive ?character) (has ?character ?item))\n :effect (and)\n)",
        "pick-up": "(:action pick-up\n :parameters (?character - character ?item - item)\n :precondition (and (alive ?character) (near ?character ?item))\n :effect (has ?character ?item)\n)",
        "help-bird": "(:action help-bird\n :parameters (?character - character ?bird - character)\n :precondition (and (alive ?character) (alive ?bird) (not (in-nest ?bird)))\n :effect (in-nest ?bird)\n)",
        "bird-falls": "(:action bird-falls\n :parameters (?bird - character)\n :precondition (and (alive ?bird) (in-nest ?bird))\n :effect (not (in-nest ?bird))\n)",
        "stop-touching": "(:action stop-touching\n :parameters (?character - character ?object - object)\n :precondition (touching ?character ?object)\n :effect (not (touching ?character ?object))\n)",
        "hug": "(:action hug\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (hugging ?character1 ?character2)) (not (hugging ?character2 ?character1)))\n :effect (hugging ?character1 ?character2)\n)",
        "stop-hug": "(:action stop-hug\n :parameters (?character1 - character ?character2 - character)\n :precondition (hugging ?character1 ?character2)\n :effect (not (hugging ?character1 ?character2))\n)",
        "touch": "(:action touch\n :parameters (?character - character ?object - object ?location - object)\n :precondition (and (not (touching ?character ?object)) (at ?character ?location))\n :effect (touching ?character ?object)\n)",
        "get-hurt": "(:action get-hurt :parameters (?character - character) :precondition (and (human ?character) (not (hurt ?character))) :effect (and (in-pain ?character) (hurt ?character)))",
        "become-scared": "(:action become-scared :parameters (?character - character ?source - character) :precondition (and (not (= ?character ?source)) (fierce ?source) (not (scared ?character))) :effect (scared ?character))",
        "stop-being-scared": "(:action stop-being-scared :parameters (?character - character) :precondition (scared ?character) :effect (not (scared ?character)))",
        "move :parameters (?character - character ?from_location - object ?to_location - object) :precondition (and (alive ?character) (at ?character ?from_location) (not (at ?character ?to_location)) (not (scared ?character))) :effect (and (not (at ?character ?from_location)) (at ?character ?to_location)))": "(:action move :parameters (?character - character ?from_location - object ?to_location - object) :precondition (and (alive ?character) (at ?character ?from_location) (not (at ?character ?to_location)) (not (scared ?character))) :effect (and (not (at ?character ?from_location)) (at ?character ?to_location)))"
    }
}