    "operators": {
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)",
        "acknowledge-pain": "(:action acknowledge-pain\n :parameters (?character - character)\n :precondition (and (hurting ?character) (struggling ?character))\n :effect (not (struggling ?character))\n)",
        "let-go": "(:action let-go\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (loved ?character1 ?character2) (not (ready ?character2)))\n :effect (letting-go ?character1 ?character2)\n)",
        "believe-in-better-times": "(:action believe-in-better-times\n :parameters (?character - character)\n :precondition (hurting ?character)\n :effect (better-times ?character)\n)",
        "deliver :parameters (?character - character ?object - item ?destination - place) :precondition (and (alive ?character) (at ?character ?destination) (has ?character ?object)) :effect (and (not (has ?character ?object)) (delivered ?object)))": "(:action deliver :parameters (?character - character ?object - item ?destination - place) :precondition (and (alive ?character) (at ?character ?destination) (has ?character ?object)) :effect (and (not (has ?character ?object)) (delivered ?object)))",
        "pick-up :parameters (?character - character ?object - (either item thing) ?place - place) :precondition (and (alive ?character) (at ?character ?place)) :effect (has ?character ?object))": "(:action pick-up :parameters (?character - character ?object - (either item thing) ?place - place) :precondition (and (alive ?character) (at ?character ?place)) :effect (has ?character ?object))",
        "hide": "(:action hide\n :parameters (?character - character ?toy - toy ?place - place)\n :precondition (at ?character ?place)\n :effect (hidden ?toy ?place)\n)",
        "search": "(:action search\n :parameters (?character - character ?place - place)\n :precondition (and (at ?character ?place) (not (searched ?character ?place)))\n :effect (searched ?character ?place)\n)",
        "find": "(:action find\n :parameters (?character - character ?toy - toy ?place - place)\n :precondition (and (at ?character ?place) (hidden ?toy ?place) (searched ?character ?place))\n :effect (found ?toy)\n)",
        "travel": "(:action travel :parameters (?character - character ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from)) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "walk :parameters (?actor - character ?origin ?destination - house) :precondition (and (alive ?actor) (at ?actor ?origin) (not (eaten ?actor))) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination) (when (and (rescuer ?actor)) (and (rescuer-at ?destination) (not (rescuer-at ?origin))))))": "(:action walk :parameters (?actor - character ?origin ?destination - house) :precondition (and (alive ?actor) (at ?actor ?origin) (not (eaten ?actor))) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination) (when (and (rescuer ?actor)) (and (rescuer-at ?destination) (not (rescuer-at ?origin))))))",
        "eat :parameters (?m - wolf ?character - character ?p - place) :precondition (and (alive ?m) (alive ?character) (not (eaten ?character)) (at ?m ?p) (at ?character ?p) (monster ?m)) :effect (and (eaten ?character)))": "(:action eat :parameters (?m - wolf ?character - character ?p - place) :precondition (and (alive ?m) (alive ?character) (not (eaten ?character)) (at ?m ?p) (at ?character ?p) (monster ?m)) :effect (and (eaten ?character)))",
        "escape :parameters (?c - human ?character - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?character)) (at ?character ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))": "(:action escape :parameters (?c - human ?character - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?character)) (at ?character ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))",
        "kill :parameters (?actor - worker ?target - wolf ?object - (either item thing) ?p - place) :precondition (and (alive ?actor) (alive ?target) (has ?actor ?object) (at ?actor ?p) (at ?target ?p) (monster ?target) (monster-alive) (rescuer ?actor)) :effect (and (not (alive ?target)) (not (monster-alive))))": "(:action kill :parameters (?actor - worker ?target - wolf ?object - (either item thing) ?p - place) :precondition (and (alive ?actor) (alive ?target) (has ?actor ?object) (at ?actor ?p) (at ?target ?p) (monster ?target) (monster-alive) (rescuer ?actor)) :effect (and (not (alive ?target)) (not (monster-alive))))",
        "give :parameters (?character1 ?character2 - human ?o - (either item thing) ?p - place) :precondition (and (not (eaten ?character2)) (alive ?character1) (alive ?character2) (has ?character1 ?o) (at ?character1 ?p) (at ?character2 ?p)) :effect (and (has ?character2 ?o) (not (has ?character1 ?o))))": "(:action give :parameters (?character1 ?character2 - human ?o - (either item thing) ?p - place) :precondition (and (not (eaten ?character2)) (alive ?character1) (alive ?character2) (has ?character1 ?o) (at ?character1 ?p) (at ?character2 ?p)) :effect (and (has ?character2 ?o) (not (has ?character1 ?o))))"
    }
