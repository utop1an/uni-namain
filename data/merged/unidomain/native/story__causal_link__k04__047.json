        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)",
        "call-911": "(:action call-911\n :parameters (?caller - character ?sick-person - character)\n :precondition (and (sick ?sick-person) (not (called-911 ?caller ?sick-person)))\n :effect (called-911 ?caller ?sick-person)\n)",
        "move :parameters (?character - character ?from-place - place ?to-place - place) :precondition (and (not (= ?from-place ?to-place)) (at ?character ?from-place)) :effect (and (not (at ?character ?from-place)) (at ?character ?to-place)))": "(:action move :parameters (?character - character ?from-place - place ?to-place - place) :precondition (and (not (= ?from-place ?to-place)) (at ?character ?from-place)) :effect (and (not (at ?character ?from-place)) (at ?character ?to-place)))",
        "take-item :parameters (?character - character ?object - object ?place - room) :precondition (and (at ?character ?place) (in ?object ?place)) :effect (and (not (in ?object ?place)) (has ?character ?object)))": "(:action take-item :parameters (?character - character ?object - object ?place - room) :precondition (and (at ?character ?place) (in ?object ?place)) :effect (and (not (in ?object ?place)) (has ?character ?object)))",
        "leave-item :parameters (?character - character ?object - object ?place - place) :precondition (and (at ?character ?place) (has ?character ?object)) :effect (and (not (has ?character ?object)) (in ?object ?place)))": "(:action leave-item :parameters (?character - character ?object - object ?place - place) :precondition (and (at ?character ?place) (has ?character ?object)) :effect (and (not (has ?character ?object)) (in ?object ?place)))",
        "travel": "(:action travel\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "deliver :parameters (?character - character ?object - object ?destination - place) :precondition (and (alive ?character) (at ?character ?destination) (has ?character ?object)) :effect (and (not (has ?character ?object)) (delivered ?object)))": "(:action deliver :parameters (?character - character ?object - object ?destination - place) :precondition (and (alive ?character) (at ?character ?destination) (has ?character ?object)) :effect (and (not (has ?character ?object)) (delivered ?object)))",
