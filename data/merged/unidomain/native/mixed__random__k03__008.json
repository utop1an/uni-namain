        "suspect-of-crime :parameters (?officer - police ?person - citizen ?c - crime ?i - item ?p - place) :precondition (and (at ?officer ?p) (alive ?officer) (at ?person ?p) (alive ?person) (knows-clue ?officer ?c ?i) (has ?person ?i)) :effect (and (suspect ?person ?c)))": "(:action suspect-of-crime :parameters (?officer - police ?person - citizen ?c - crime ?i - item ?p - place) :precondition (and (at ?officer ?p) (alive ?officer) (at ?person ?p) (alive ?person) (knows-clue ?officer ?c ?i) (has ?person ?i)) :effect (and (suspect ?person ?c)))"
