        "arrest": "(:action arrest\n :parameters (?p - police ?entity - actor ?p1 ?p2 - place ?c - crime)\n :precondition (and (at ?p ?p1) (at ?entity ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?p) (alive ?entity) (suspect ?entity ?c) (arrester ?p))\n :effect (and (at ?entity ?p2) (not (at ?entity ?p1)) (at ?p ?p2) (not (at ?p ?p1)) (under-arrest ?entity))\n)",
        "play-basketball :parameters (?entity1 ?entity2 - (either character actor) ?p - place) :precondition (and (is-basketball-place ?p) (at ?entity1 ?p) (alive ?entity1) (at ?entity2 ?p) (alive ?entity2) (not (= ?entity1 ?entity2))) :effect (and (not (angry ?entity1)) (not (angry ?entity2))))": "(:action play-basketball :parameters (?entity1 ?entity2 - (either character actor) ?p - place) :precondition (and (is-basketball-place ?p) (at ?entity1 ?p) (alive ?entity1) (at ?entity2 ?p) (alive ?entity2) (not (= ?entity1 ?entity2))) :effect (and (not (angry ?entity1)) (not (angry ?entity2))))",
        "findclues :parameters (?entity - police ?c - crime ?i - item ?p - place) :precondition (and (at ?entity ?p) (alive ?entity) (clue ?c ?i ?p)) :effect (and (knows-clue ?entity ?c ?i)))": "(:action findclues :parameters (?entity - police ?c - crime ?i - item ?p - place) :precondition (and (at ?entity ?p) (alive ?entity) (clue ?c ?i ?p)) :effect (and (knows-clue ?entity ?c ?i)))",
