    "operators": {
        "help-bird :parameters (?entity - (either character actor) ?bird - character) :precondition (and (alive ?entity) (alive ?bird) (not (in-nest ?bird))) :effect (in-nest ?bird))": "(:action help-bird :parameters (?entity - (either character actor) ?bird - character) :precondition (and (alive ?entity) (alive ?bird) (not (in-nest ?bird))) :effect (in-nest ?bird))",
