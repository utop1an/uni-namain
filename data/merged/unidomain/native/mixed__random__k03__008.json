        "search :parameters (?c - actor ?t - item ?p - place) :precondition (and (at ?c ?p) (not (found ?t))) :effect (when (not (foggy ?p)) (and (found ?t) (has ?c ?t))))": "(:action search :parameters (?c - actor ?t - item ?p - place) :precondition (and (at ?c ?p) (not (found ?t))) :effect (when (not (foggy ?p)) (and (found ?t) (has ?c ?t))))",
        "travel :parameters (?entity - (either character actor) ?c - car ?p1 ?p2 - place) :precondition (and (working ?c) (at ?entity ?p1) (alive ?entity) (has-car ?entity ?c)) :effect (and (at ?entity ?p2) (not (at ?entity ?p1)) (when (and (arrester ?entity)) (and (arrester-at ?p2) (not (arrester-at ?p1))))))": "(:action travel :parameters (?entity - (either character actor) ?c - car ?p1 ?p2 - place) :precondition (and (working ?c) (at ?entity ?p1) (alive ?entity) (has-car ?entity ?c)) :effect (and (at ?entity ?p2) (not (at ?entity ?p1)) (when (and (arrester ?entity)) (and (arrester-at ?p2) (not (arrester-at ?p1))))))",
