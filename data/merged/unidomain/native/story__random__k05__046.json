    "operators": {
        "remind-ancient-oath": "(:action remind-ancient-oath\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (ancient-oath ?dog))\n :effect (needs-walk ?master)\n)",
        "bring-to-herenow": "(:action bring-to-herenow\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (not (in-herenow ?master)))\n :effect (in-herenow ?master)\n)",
        "walk": "(:action walk\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (needs-walk ?master))\n :effect (and (not (needs-walk ?master)) (in-herenow ?master))\n)",
        "time-of-passing": "(:action time-of-passing\n :parameters ()\n :precondition (not (time-of-passing))\n :effect (time-of-passing)\n)",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - object)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "call-police": "(:action call-police\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (called-police ?character)\n)",
        "follow-officer": "(:action follow-officer\n :parameters (?character - character ?officer - character)\n :precondition (and (alive ?character) (alive ?officer))\n :effect (follows ?character ?officer)\n)",
        "avert-death": "(:action avert-death\n :parameters (?character - character)\n :precondition (and (alive ?character) (called-police ?character) (exists (?officer - character) (follows ?character ?officer)))\n :effect (death-averted ?character)\n)",
        "apologize": "(:action apologize\n :parameters (?apologizer - character ?apologized - character)\n :precondition (and (not (= ?apologizer ?apologized)) (not (friends ?apologizer ?apologized)))\n :effect (friends ?apologizer ?apologized)\n)",
        "start-feeling": "(:action start-feeling\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (feeling ?character)))\n :effect (feeling ?character)\n)",
        "witness-end": "(:action witness-end\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (witness ?character)))\n :effect (witness ?character)\n)",
        "understand-end": "(:action understand-end\n :parameters (?character - character)\n :precondition (and (alive ?character) (witness ?character) (not (understand ?character)))\n :effect (understand ?character)\n)",
        "last-soul-fades": "(:action last-soul-fades\n :parameters (?character - character)\n :precondition (and (alive ?character) (last-soul ?character) (understand ?character))\n :effect (not (alive ?character))\n)",
        "humanity-ends": "(:action humanity-ends\n :parameters (?character - character)\n :precondition (and (alive ?character) (understand ?character) (not (end ?character)))\n :effect (end ?character)\n)",
        "become-weak": "(:action become-weak\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (weak ?character)\n)",
        "drive-away-love": "(:action drive-away-love\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (love-driven-away ?character)\n)",
        "end-up-in-asylum": "(:action end-up-in-asylum\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (in-asylum ?character)\n)",
        "ask-spirits-to-leave": "(:action ask-spirits-to-leave\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-present ?character))\n :effect (and (spirits-gone ?character) (not (spirits-present ?character)))\n)",
        "regret-asking-spirits-to-leave": "(:action regret-asking-spirits-to-leave\n :parameters (?character - character)\n :precondition (and (alive ?character) (spirits-gone ?character))\n :effect (spirits-present ?character)\n)",
        "try-steal :parameters (?stealer - character ?object - object ?owner - character) :precondition (and (not (= ?stealer ?owner)) (has ?owner ?object) (steal-intention ?stealer ?object)) :effect (and (not (steal-intention ?stealer ?object)) (not (friends ?stealer ?owner)) (has ?stealer ?object) (not (has ?owner ?object))))": "(:action try-steal :parameters (?stealer - character ?object - object ?owner - character) :precondition (and (not (= ?stealer ?owner)) (has ?owner ?object) (steal-intention ?stealer ?object)) :effect (and (not (steal-intention ?stealer ?object)) (not (friends ?stealer ?owner)) (has ?stealer ?object) (not (has ?owner ?object))))",
        "clean-item :parameters (?character - character ?object - item) :precondition (and (not (clean ?object)) (has ?character ?object)) :effect (clean ?object))": "(:action clean-item :parameters (?character - character ?object - item) :precondition (and (not (clean ?object)) (has ?character ?object)) :effect (clean ?object))",
        "drop-in-puddle :parameters (?dropper - character ?object - object) :precondition (and (has ?dropper ?object) (clean ?object)) :effect (not (clean ?object)))": "(:action drop-in-puddle :parameters (?dropper - character ?object - object) :precondition (and (has ?dropper ?object) (clean ?object)) :effect (not (clean ?object)))"
