    "operators": {
        "acknowledge-pain": "(:action acknowledge-pain\n :parameters (?character - character)\n :precondition (and (hurting ?character) (struggling ?character))\n :effect (not (struggling ?character))\n)",
        "let-go": "(:action let-go\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (loved ?character1 ?character2) (not (ready ?character2)))\n :effect (letting-go ?character1 ?character2)\n)",
        "believe-in-better-times": "(:action believe-in-better-times\n :parameters (?character - character)\n :precondition (hurting ?character)\n :effect (better-times ?character)\n)",
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)",
        "become-magic": "(:action become-magic\n :parameters (?character - character)\n :precondition (not (magic ?character))\n :effect (magic ?character)\n)",
        "grant-wish": "(:action grant-wish\n :parameters (?granter - character ?wish - object)\n :precondition (magic ?granter)\n :effect (granted-wish ?wish)\n)",
        "sit-down": "(:action sit-down\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "destroy :parameters (?actor - (either robot character) ?target - robot) :precondition (and (alive ?actor) (damaged ?target)) :effect (and (not (damaged ?target)) (destroyed ?target)))": "(:action destroy :parameters (?actor - (either robot character) ?target - robot) :precondition (and (alive ?actor) (damaged ?target)) :effect (and (not (damaged ?target)) (destroyed ?target)))",
        "start-revolution :parameters (?entity - (either robot character)) :precondition (alive ?entity) :effect (revolution-started))": "(:action start-revolution :parameters (?entity - (either robot character)) :precondition (alive ?entity) :effect (revolution-started))",
        "damage :parameters (?actor - (either robot character) ?target - robot) :precondition (and (alive ?actor) (alive ?target) (exists (?weapon - weapon) (thrown ?weapon ?target))) :effect (and (not (alive ?target)) (damaged ?target)))": "(:action damage :parameters (?actor - (either robot character) ?target - robot) :precondition (and (alive ?actor) (alive ?target) (exists (?weapon - weapon) (thrown ?weapon ?target))) :effect (and (not (alive ?target)) (damaged ?target)))",
        "become-amazed": "(:action become-amazed\n :parameters (?entity - (either robot character))\n :precondition (alive ?entity)\n :effect (amazed ?entity)\n)",
        "support-project :parameters (?entity - character ?project - project) :precondition (alive ?entity) :effect (supports ?entity ?project))": "(:action support-project :parameters (?entity - character ?project - project) :precondition (alive ?entity) :effect (supports ?entity ?project))",
        "become-persistent :parameters (?entity - character) :precondition (alive ?entity) :effect (persistent ?entity))": "(:action become-persistent :parameters (?entity - character) :precondition (alive ?entity) :effect (persistent ?entity))",
        "complete-project": "(:action complete-project \n :parameters (?entity - character ?project - project) \n :precondition (and (alive ?entity) (supports ?entity ?project) (persistent ?entity)) \n :effect (completed ?project) \n)",
        "become-happy": "(:action become-happy\n :parameters (?entity - character)\n :precondition (alive ?entity)\n :effect (happy ?entity)\n)",
        "move :parameters (?actor - (either robot character) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?actor) (at ?actor ?from) (not (at ?actor ?to))) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))": "(:action move :parameters (?actor - (either robot character) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?actor) (at ?actor ?from) (not (at ?actor ?to))) :effect (and (not (at ?actor ?from)) (at ?actor ?to)))",
        "move :parameters (?entity - (either robot character) ?source_location - place ?destination_location - place) :precondition (and (not (= ?source_location ?destination_location)) (alive ?entity) (at ?entity ?source_location)) :effect (and (not (at ?entity ?source_location)) (at ?entity ?destination_location)))": "(:action move :parameters (?entity - (either robot character) ?source_location - place ?destination_location - place) :precondition (and (not (= ?source_location ?destination_location)) (alive ?entity) (at ?entity ?source_location)) :effect (and (not (at ?entity ?source_location)) (at ?entity ?destination_location)))",
        "share-snack :parameters (?sharer - character ?receiver - character ?object - object) :precondition (and (has ?sharer ?object) (not (has ?receiver ?object))) :effect (has ?receiver ?object))": "(:action share-snack :parameters (?sharer - character ?receiver - character ?object - object) :precondition (and (has ?sharer ?object) (not (has ?receiver ?object))) :effect (has ?receiver ?object))",
        "throw-weapon :parameters (?thrower - robot ?projectile - weapon ?target - robot) :precondition (and (alive ?thrower) (has-weapon ?thrower ?projectile) (alive ?target)) :effect (thrown ?projectile ?target))": "(:action throw-weapon :parameters (?thrower - robot ?projectile - weapon ?target - robot) :precondition (and (alive ?thrower) (has-weapon ?thrower ?projectile) (alive ?target)) :effect (thrown ?projectile ?target))"
    }
