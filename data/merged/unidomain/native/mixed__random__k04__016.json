    "operators": {
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "walk :parameters (?character - character ?from ?to - place) :precondition (and (alive ?character) (at ?character ?from) (not (eaten ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to) (when (and (rescuer ?character)) (and (rescuer-at ?to) (not (rescuer-at ?from))))))": "(:action walk :parameters (?character - character ?from ?to - place) :precondition (and (alive ?character) (at ?character ?from) (not (eaten ?character))) :effect (and (not (at ?character ?from)) (at ?character ?to) (when (and (rescuer ?character)) (and (rescuer-at ?to) (not (rescuer-at ?from))))))",
        "eat :parameters (?m - wolf ?c - human ?p - place) :precondition (and (alive ?m) (alive ?c) (not (eaten ?c)) (at ?m ?p) (at ?c ?p) (monster ?m)) :effect (and (eaten ?c)))": "(:action eat :parameters (?m - wolf ?c - human ?p - place) :precondition (and (alive ?m) (alive ?c) (not (eaten ?c)) (at ?m ?p) (at ?c ?p) (monster ?m)) :effect (and (eaten ?c)))",
        "escape :parameters (?c - human ?m - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?m)) (at ?m ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))": "(:action escape :parameters (?c - human ?m - wolf ?p - place) :precondition (and (eaten ?c) (not (alive ?m)) (at ?m ?p)) :effect (and (not (eaten ?c)) (rescued ?c) (at ?c ?p)))",
        "go-to-shop :parameters (?c - character) :precondition (not (at-shop ?c)) :effect (at-shop ?c))": "(:action go-to-shop :parameters (?c - character) :precondition (not (at-shop ?c)) :effect (at-shop ?c))",
        "kill :parameters (?c - worker ?m - wolf ?o - object ?p - place) :precondition (and (alive ?c) (alive ?m) (has ?c ?o) (at ?c ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?c)) :effect (and (not (alive ?m)) (not (monster-alive))))": "(:action kill :parameters (?c - worker ?m - wolf ?o - object ?p - place) :precondition (and (alive ?c) (alive ?m) (has ?c ?o) (at ?c ?p) (at ?m ?p) (monster ?m) (monster-alive) (rescuer ?c)) :effect (and (not (alive ?m)) (not (monster-alive))))",
        "give :parameters (?c1 ?c2 - human ?o - object ?p - place) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?o) (at ?c1 ?p) (at ?c2 ?p)) :effect (and (has ?c2 ?o) (not (has ?c1 ?o))))": "(:action give :parameters (?c1 ?c2 - human ?o - object ?p - place) :precondition (and (not (eaten ?c2)) (alive ?c1) (alive ?c2) (has ?c1 ?o) (at ?c1 ?p) (at ?c2 ?p)) :effect (and (has ?c2 ?o) (not (has ?c1 ?o))))",
        "fix-pedal :parameters (?character - character ?bike - object) :precondition (and (at-shop ?character) (has ?character ?bike) (broken-pedal ?bike)) :effect (and (not (broken-pedal ?bike)) (fixed-pedal ?bike)))": "(:action fix-pedal :parameters (?character - character ?bike - object) :precondition (and (at-shop ?character) (has ?character ?bike) (broken-pedal ?bike)) :effect (and (not (broken-pedal ?bike)) (fixed-pedal ?bike)))",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "bring-to-herenow": "(:action bring-to-herenow\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (not (in-herenow ?master)))\n :effect (in-herenow ?master)\n)",
        "walk": "(:action walk\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (needs-walk ?master))\n :effect (and (not (needs-walk ?master)) (in-herenow ?master))\n)",
        "time-of-passing": "(:action time-of-passing\n :parameters ()\n :precondition (not (time-of-passing))\n :effect (time-of-passing)\n)",
        "remind-ancient-oath": "(:action remind-ancient-oath\n :parameters (?dog - character ?master - character)\n :precondition (and (guardian ?dog) (master ?master) (ancient-oath ?dog))\n :effect (needs-walk ?master)\n)",
        "find :parameters (?c - character ?t - object) :precondition (and (not (has ?c ?t)) (reads ?c)) :effect (has ?c ?t))": "(:action find :parameters (?c - character ?t - object) :precondition (and (not (has ?c ?t)) (reads ?c)) :effect (has ?c ?t))",
        "put-on-shelf :parameters (?c - character ?t - object ?place - place) :precondition (and (has ?c ?t) (at ?c ?place)) :effect (and (not (has ?c ?t)) (on-shelf ?t) (organized ?place)))": "(:action put-on-shelf :parameters (?c - character ?t - object ?place - place) :precondition (and (has ?c ?t) (at ?c ?place)) :effect (and (not (has ?c ?t)) (on-shelf ?t) (organized ?place)))",
        "read": "(:action read\n :parameters (?character - character)\n :precondition (reads ?character)\n :effect (happy ?character)\n)",
        "smell-soap": "(:action smell-soap\n :parameters (?character - character ?soap - item)\n :precondition (and (on-shelf ?soap) (reads ?character))\n :effect (happy ?character)\n)"
    }
