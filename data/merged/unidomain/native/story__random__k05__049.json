{
    "predicates": {
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(wolves-attack ?place - place)": "Source predicate (wolves-attack ?place - place).",
        "(wolves-killed ?character - character)": "Source predicate (wolves-killed ?character - character).",
        "(alive ?character - character)": "The character is alive.",
        "(imprisoned ?character - character)": "Source predicate (imprisoned ?character - character).",
        "(served-sentence ?character - character)": "Source predicate (served-sentence ?character - character).",
        "(has-serum ?character - character)": "Source predicate (has-serum ?character - character).",
        "(religious ?character - character)": "Source predicate (religious ?character - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(performing ?character - character)": "Source predicate (performing ?character - character).",
        "(applause)": "Source predicate (applause).",
        "(satisfied ?character - character)": "Source predicate (satisfied ?character - character).",
        "(disappeared ?character - character)": "Source predicate (disappeared ?character - character).",
        "(trick-performed)": "Source predicate (trick-performed).",
        "(worried ?character - character)": "Source predicate (worried ?character - character).",
        "(accepted-to-university ?character - character)": "Source predicate (accepted-to-university ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(applauding ?character - character)": "Source predicate (applauding ?character - character).",
        "(hardworking ?character - character)": "Source predicate (hardworking ?character - character).",
        "(dreams-come-true ?character - character)": "Source predicate (dreams-come-true ?character - character).",
        "(asleep ?character - character)": "Source predicate (asleep ?character - character).",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(has-hoard ?character - character)": "Source predicate (has-hoard ?character - character).",
        "(robbed ?gang - gang)": "Source predicate (robbed ?gang - gang).",
        "(soundproof-door ?place - place)": "Source predicate (soundproof-door ?place - place).",
        "(attacked ?character - character)": "Source predicate (attacked ?character - character)."
    },
    "operators": {
        "die": "(:action die\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (not (alive ?character))\n)",
        "take-serum": "(:action take-serum\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-serum ?character)))\n :effect (has-serum ?character)\n)",
        "serve-sentence": "(:action serve-sentence\n :parameters (?character - character)\n :precondition (and (alive ?character) (imprisoned ?character) (not (served-sentence ?character)))\n :effect (served-sentence ?character)\n)",
        "release": "(:action release\n :parameters (?character - character)\n :precondition (and (alive ?character) (imprisoned ?character) (served-sentence ?character))\n :effect (not (imprisoned ?character))\n)",
        "convert": "(:action convert\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (religious ?character)))\n :effect (religious ?character)\n)",
        "abandon-religion": "(:action abandon-religion\n :parameters (?character - character)\n :precondition (and (alive ?character) (religious ?character))\n :effect (not (religious ?character))\n)",
        "move": "(:action move\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "kill-wolves": "(:action kill-wolves\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place) (wolves-attack ?place))\n :effect (wolves-killed ?character)\n)",
        "perform-show": "(:action perform-show\n :parameters (?magician - character)\n :precondition (not (performing ?magician))\n :effect (and (performing ?magician) (applause))\n)",
        "perform-final-trick": "(:action perform-final-trick\n :parameters (?magician - character)\n :precondition (and (performing ?magician) (not (trick-performed)))\n :effect (and (trick-performed) (disappeared ?magician))\n)",
        "stop-applause": "(:action stop-applause\n :parameters ()\n :precondition (applause)\n :effect (not (applause))\n)",
        "get-accepted": "(:action get-accepted\n :parameters (?character - character)\n :precondition (and (worried ?character) (hardworking ?character))\n :effect (and (accepted-to-university ?character) (not (worried ?character)) (happy ?character))\n)",
        "start-applauding": "(:action start-applauding\n :parameters (?character - character ?other - character)\n :precondition (and (not (applauding ?character)) (happy ?other))\n :effect (applauding ?character)\n)",
        "stop-applauding": "(:action stop-applauding\n :parameters (?character - character)\n :precondition (applauding ?character)\n :effect (not (applauding ?character))\n)",
        "make-dreams-come-true": "(:action make-dreams-come-true\n :parameters (?character - character)\n :precondition (and (accepted-to-university ?character) (hardworking ?character))\n :effect (dreams-come-true ?character)\n)",
        "sleep": "(:action sleep\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (and (not (awake ?character)) (asleep ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (asleep ?character)\n :effect (and (not (asleep ?character)) (awake ?character))\n)",
        "rob": "(:action rob\n :parameters (?gang - character)\n :precondition (awake ?gang)\n :effect (robbed ?gang)\n)",
        "become-satisfied": "(:action become-satisfied\n :parameters (?character - character)\n :precondition (and (performing ?character) (trick-performed) (applause) (not (satisfied ?character)))\n :effect (satisfied ?character)\n)",
        "install-soundproof-door": "(:action install-soundproof-door\n :parameters (?gang - character ?place - place)\n :precondition (and (awake ?gang) (at ?gang ?place) (not (soundproof-door ?place)))\n :effect (soundproof-door ?place)\n)",
        "attack": "(:action attack\n :parameters (?attacker - character ?victim - character)\n :precondition (and (awake ?attacker) (awake ?victim))\n :effect (attacked ?victim)\n)",
        "clear-passage": "(:action clear-passage\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (and (not (attacked ?character)) (has-hoard ?character))\n)"
    }
}