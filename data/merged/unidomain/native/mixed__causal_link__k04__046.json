{
    "predicates": {
        "(player ?character - character)": "The character is a player.",
        "(connected ?to - location ?from - location)": "Location ?from is connected to location ?to.",
        "(apprehended ?character - character)": "The character has been apprehended.",
        "(alive ?character - character)": "The character is alive.",
        "(saved ?saved - character ?saver - character)": "Character ?saved was saved by character ?saver.",
        "(knows ?character - character)": "The character satisfies the knows condition, preserving the meaning of both source predicates.",
        "(captured ?character - character)": "The character is captured.",
        "(henchman ?henchman - character)": "The character is a henchman.",
        "(at ?character - character ?place - object)": "Character ?character is at the location represented by ?place.",
        "(has ?character - character ?item - object)": "Character ?character has entity ?item, which may be a character or another object.",
        "(hidden ?toy - toy ?place - place)": "Source predicate (hidden ?toy - toy ?place - place).",
        "(found ?toy - toy)": "Source predicate (found ?toy - toy).",
        "(searched ?character - character ?place - place)": "Source predicate (searched ?character - character ?place - place).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(magic ?character - character)": "Source predicate (magic ?character - character).",
        "(granted-wish ?wish - object)": "Source predicate (granted-wish ?wish - object)."
    },
    "operators": {
        "interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - object) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))": "(:action interrogate-character :parameters (?interrogator - character ?interrogated - character ?place - object) :precondition (and (player ?interrogator) (at ?interrogator ?place) (at ?interrogated ?place) (apprehended ?interrogated)) :effect (knows ?interrogator))",
        "save-character :parameters (?saver - character ?saved - character ?notsaved - character ?place - object) :precondition (and (player ?saver) (at ?saver ?place) (at ?saved ?place) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?place))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))": "(:action save-character :parameters (?saver - character ?saved - character ?notsaved - character ?place - object) :precondition (and (player ?saver) (at ?saver ?place) (at ?saved ?place) (captured ?saved) (captured ?notsaved) (not (at ?notsaved ?place))) :effect (and (saved ?saved ?saver) (not (alive ?notsaved))))",
        "place-victim :parameters (?placer - character ?item - character ?place - location ?destination - location) :precondition (and (henchman ?placer) (has ?placer ?item) (at ?placer ?place) (connected ?destination ?place)) :effect (and (not (has ?placer ?item)) (at ?item ?destination) (captured ?item)))": "(:action place-victim :parameters (?placer - character ?item - character ?place - location ?destination - location) :precondition (and (henchman ?placer) (has ?placer ?item) (at ?placer ?place) (connected ?destination ?place)) :effect (and (not (has ?placer ?item)) (at ?item ?destination) (captured ?item)))",
        "sit-down": "(:action sit-down\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "become-magic": "(:action become-magic\n :parameters (?character - character)\n :precondition (not (magic ?character))\n :effect (magic ?character)\n)",
        "grant-wish": "(:action grant-wish\n :parameters (?granter - character ?wish - object)\n :precondition (magic ?granter)\n :effect (granted-wish ?wish)\n)",
        "hide :parameters (?character - character ?toy - toy ?location - place) :precondition (at ?character ?location) :effect (hidden ?toy ?location))": "(:action hide :parameters (?character - character ?toy - toy ?location - place) :precondition (at ?character ?location) :effect (hidden ?toy ?location))",
        "search": "(:action search\n :parameters (?character - character ?object - object)\n :precondition (and (at ?character ?object) (not (searched ?character ?object)))\n :effect (searched ?character ?object)\n)",
        "find :parameters (?character - character ?toy - toy ?location - place) :precondition (and (at ?character ?location) (hidden ?toy ?location) (searched ?character ?location)) :effect (found ?toy))": "(:action find :parameters (?character - character ?toy - toy ?location - place) :precondition (and (at ?character ?location) (hidden ?toy ?location) (searched ?character ?location)) :effect (found ?toy))",
        "move-location": "(:action move-location :parameters (?character - character ?destination - location ?source - location) :precondition (and (player ?character) (connected ?destination ?source) (at ?character ?source) (knows ?character) (not (= ?source ?destination))) :effect (and (not (at ?character ?source)) (at ?character ?destination)))",
        "go-to": "(:action go-to\n :parameters (?character - character ?place - object)\n :precondition (not (at ?character ?place))\n :effect (at ?character ?place)\n)",
        "share-snack": "(:action share-snack\n :parameters (?sharer - character ?receiver - character ?snack - object)\n :precondition (and (has ?sharer ?snack) (not (has ?receiver ?snack)))\n :effect (has ?receiver ?snack)\n)"
    }
}