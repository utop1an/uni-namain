    "operators": {
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "give-toy :parameters (?sender - actor ?item - item ?recipient - actor) :precondition (and (not (= ?sender ?recipient)) (has ?sender ?item)) :effect (and (not (has ?sender ?item)) (has ?recipient ?item)))": "(:action give-toy :parameters (?sender - actor ?item - item ?recipient - actor) :precondition (and (not (= ?sender ?recipient)) (has ?sender ?item)) :effect (and (not (has ?sender ?item)) (has ?recipient ?item)))",
        "play-together :parameters (?c - actor ?character2 - character ?t - item) :precondition (and (not (= ?c ?character2)) (has ?c ?t) (friends ?c ?character2)) :effect (and (played-together ?c ?character2) (happy ?c) (happy ?character2)))": "(:action play-together :parameters (?c - actor ?character2 - character ?t - item) :precondition (and (not (= ?c ?character2)) (has ?c ?t) (friends ?c ?character2)) :effect (and (played-together ?c ?character2) (happy ?c) (happy ?character2)))",
        "arrest": "(:action arrest\n :parameters (?p - police ?a - actor ?p1 ?p2 - place ?c - crime)\n :precondition (and (at ?p ?p1) (at ?a ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?p) (alive ?a) (suspect ?a ?c) (arrester ?p))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (at ?p ?p2) (not (at ?p ?p1)) (under-arrest ?a))\n)",
        "play-basketball": "(:action play-basketball\n :parameters (?a ?b - citizen ?p - place)\n :precondition (and (is-basketball-place ?p) (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (not (= ?a ?b)))\n :effect (and (not (angry ?a)) (not (angry ?b)))\n)",
        "findclues": "(:action findclues\n :parameters (?a - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (clue ?c ?i ?p))\n :effect (and (knows-clue ?a ?c ?i))\n)",
        "shareclues": "(:action shareclues\n :parameters (?a ?b - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (clue ?c ?i ?p) (knows-clue ?a ?c ?i))\n :effect (and (knows-clue ?b ?c ?i))\n)",
        "travel": "(:action travel\n :parameters (?a - actor ?c - car ?p1 ?p2 - place)\n :precondition (and (working ?c) (at ?a ?p1) (alive ?a) (has-car ?a ?c))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (when (and (arrester ?a)) (and (arrester-at ?p2) (not (arrester-at ?p1)))))\n)",
        "steal": "(:action steal\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (has ?b ?i) (not (= ?a ?b)) (alive ?a) (is-theft ?c))\n :effect (and (has ?a ?i) (not (has ?b ?i)) (angry ?b) (clue ?c ?i ?p))\n)",
        "kill": "(:action kill\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (alive ?a) (alive ?b) (not (= ?a ?b)) (has ?a ?i) (is-murder ?c) (not (under-arrest ?a)))\n :effect (and (not (alive ?b)) (clue ?c ?i ?p))\n)",
        "suspect-of-crime": "(:action suspect-of-crime\n :parameters (?a - police ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (knows-clue ?a ?c ?i) (has ?b ?i))\n :effect (and (suspect ?b ?c))\n)",
        "start-playing": "(:action start-playing\n :parameters (?character - character)\n :precondition (and (awake ?character) (not (playing ?character)) (has-energy ?character))\n :effect (playing ?character)\n)",
        "stop-playing": "(:action stop-playing\n :parameters (?character - character)\n :precondition (playing ?character)\n :effect (and (not (playing ?character)) (tired ?character))\n)",
        "sleep": "(:action sleep\n :parameters (?character - character)\n :precondition (and (tired ?character) (not (sleeping ?character)))\n :effect (and (not (awake ?character)) (sleeping ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (sleeping ?character)\n :effect (and (awake ?character) (not (sleeping ?character)) (not (tired ?character)) (has-energy ?character))\n)",
        "fight :parameters (?actor1 - actor ?actor2 - actor) :precondition (and (not (= ?actor1 ?actor2)) (alive ?actor1) (has-weapon ?actor1) (alive ?actor2) (has-weapon ?actor2)) :effect (and))": "(:action fight :parameters (?actor1 - actor ?actor2 - actor) :precondition (and (not (= ?actor1 ?actor2)) (alive ?actor1) (has-weapon ?actor1) (alive ?actor2) (has-weapon ?actor2)) :effect (and))",
        "die :parameters (?a - actor) :precondition (alive ?a) :effect (not (alive ?a)))": "(:action die :parameters (?a - actor) :precondition (alive ?a) :effect (not (alive ?a)))",
        "acquire-electronics :parameters (?a - actor) :precondition (and (alive ?a) (not (has-electronics ?a))) :effect (has-electronics ?a))": "(:action acquire-electronics :parameters (?a - actor) :precondition (and (alive ?a) (not (has-electronics ?a))) :effect (has-electronics ?a))",
        "stop-believing :parameters (?a - actor) :precondition (and (alive ?a) (believes-in-fairies ?a)) :effect (not (believes-in-fairies ?a)))": "(:action stop-believing :parameters (?a - actor) :precondition (and (alive ?a) (believes-in-fairies ?a)) :effect (not (believes-in-fairies ?a)))",
        "travel :parameters (?a - actor ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?a) (at ?a ?from)) :effect (and (not (at ?a ?from)) (at ?a ?to)))": "(:action travel :parameters (?a - actor ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?a) (at ?a ?from)) :effect (and (not (at ?a ?from)) (at ?a ?to)))"
    }
