{
    "predicates": {
        "(at-peace ?nation - nation)": "Source predicate (at-peace ?nation - nation).",
        "(sharing-technology ?nation1 - nation ?nation2 - nation)": "Source predicate (sharing-technology ?nation1 - nation ?nation2 - nation).",
        "(advanced-technology ?nation - nation)": "Source predicate (advanced-technology ?nation - nation).",
        "(facing-destruction)": "Source predicate (facing-destruction).",
        "(read ?reader - reader ?poem - poem)": "Source predicate (read ?reader - reader ?poem - poem).",
        "(alive ?poem - poem)": "Source predicate (alive ?poem - poem).",
        "(dead ?poem - poem)": "Source predicate (dead ?poem - poem).",
        "(echo ?reader - reader ?poem - poem)": "Source predicate (echo ?reader - reader ?poem - poem).",
        "(loves ?lover - character ?loved - character)": "Source predicate (loves ?lover - character ?loved - character).",
        "(confessed ?confessor - character ?confessed-to - character)": "Source predicate (confessed ?confessor - character ?confessed-to - character).",
        "(asked-question ?asker - character ?asked - character)": "Source predicate (asked-question ?asker - character ?asked - character).",
        "(took-pill ?character - character)": "Source predicate (took-pill ?character - character).",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(interesting ?place - place)": "Source predicate (interesting ?place - place).",
        "(singing ?character - character)": "Source predicate (singing ?character - character).",
        "(worried ?character - character)": "Source predicate (worried ?character - character).",
        "(accepted-to-university ?character - character)": "Source predicate (accepted-to-university ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(applauding ?character - character)": "Source predicate (applauding ?character - character).",
        "(hardworking ?character - character)": "Source predicate (hardworking ?character - character).",
        "(dreams-come-true ?character - character)": "Source predicate (dreams-come-true ?character - character)."
    },
    "operators": {
        "unite": "(:action unite\n :parameters (?nation1 - nation ?nation2 - nation)\n :precondition (and (not (= ?nation1 ?nation2)) (facing-destruction))\n :effect (and (at-peace ?nation1) (at-peace ?nation2) (sharing-technology ?nation1 ?nation2))\n)",
        "develop-technology": "(:action develop-technology\n :parameters (?nation1 - nation ?nation2 - nation)\n :precondition (and (not (= ?nation1 ?nation2)) (sharing-technology ?nation1 ?nation2))\n :effect (and (advanced-technology ?nation1) (advanced-technology ?nation2))\n)",
        "avoid-destruction": "(:action avoid-destruction\n :parameters ()\n :precondition (and (advanced-technology nation1) (advanced-technology nation2) (advanced-technology nation3))\n :effect (not (facing-destruction))\n)",
        "maintain-peace": "(:action maintain-peace\n :parameters (?nation1 - nation ?nation2 - nation)\n :precondition (and (not (= ?nation1 ?nation2)) (at-peace ?nation1) (at-peace ?nation2) (sharing-technology ?nation1 ?nation2))\n :effect (and (at-peace ?nation1) (at-peace ?nation2) (sharing-technology ?nation1 ?nation2))\n)",
        "read-poem": "(:action read-poem\n :parameters (?reader - reader ?poem - poem)\n :precondition (and (not (read ?reader ?poem)) (alive ?poem))\n :effect (and (read ?reader ?poem) (echo ?reader ?poem))\n)",
        "poem-dies": "(:action poem-dies\n :parameters (?poem - poem)\n :precondition (alive ?poem)\n :effect (and (not (alive ?poem)) (dead ?poem))\n)",
        "echo-poem": "(:action echo-poem\n :parameters (?reader - reader ?poem - poem)\n :precondition (and (read ?reader ?poem) (not (echo ?reader ?poem)))\n :effect (echo ?reader ?poem)\n)",
        "take-pill": "(:action take-pill\n :parameters (?character - character)\n :precondition (not (took-pill ?character))\n :effect (took-pill ?character)\n)",
        "ask-love-question": "(:action ask-love-question\n :parameters (?asker - character ?asked - character)\n :precondition (not (asked-question ?asker ?asked))\n :effect (asked-question ?asker ?asked)\n)",
        "confess-love": "(:action confess-love\n :parameters (?confessor - character ?confessed-to - character)\n :precondition (and (not (confessed ?confessor ?confessed-to)) (asked-question ?confessed-to ?confessor) (took-pill ?confessor))\n :effect (and (confessed ?confessor ?confessed-to) (loves ?confessor ?confessed-to))\n)",
        "move": "(:action move\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (not (at ?character ?place)))\n :effect (at ?character ?place)\n)",
        "sleep": "(:action sleep\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (at ?character ?place) (interesting ?place))\n :effect (not (awake ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "sing": "(:action sing\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (singing ?character)\n)",
        "stop-singing": "(:action stop-singing\n :parameters (?character - character)\n :precondition (singing ?character)\n :effect (not (singing ?character))\n)",
        "make-friends": "(:action make-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (awake ?character1) (awake ?character2) (not (friends ?character1 ?character2)) (not (= ?character1 ?character2)))\n :effect (friends ?character1 ?character2)\n)",
        "get-accepted": "(:action get-accepted\n :parameters (?character - character)\n :precondition (and (worried ?character) (hardworking ?character))\n :effect (and (accepted-to-university ?character) (not (worried ?character)) (happy ?character))\n)",
        "start-applauding": "(:action start-applauding\n :parameters (?character - character ?other - character)\n :precondition (and (not (applauding ?character)) (happy ?other))\n :effect (applauding ?character)\n)",
        "stop-applauding": "(:action stop-applauding\n :parameters (?character - character)\n :precondition (applauding ?character)\n :effect (not (applauding ?character))\n)",
        "make-dreams-come-true": "(:action make-dreams-come-true\n :parameters (?character - character)\n :precondition (and (accepted-to-university ?character) (hardworking ?character))\n :effect (dreams-come-true ?character)\n)"
    }
}