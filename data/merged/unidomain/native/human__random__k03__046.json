        "unlock": "(:action unlock\n :parameters (?character - character ?key - key ?room - room)\n :precondition (and (locked ?room) (unlocked-by ?room ?key) (has ?character ?key))\n :effect (and (not (locked ?room)))\n)",
        "enter :parameters (?entity - (either creature item) ?positionfrom - (either place location) ?destination - room) :precondition (and (not (locked ?destination)) (at ?entity ?positionfrom)) :effect (and (not (at ?entity ?positionfrom)) (at ?entity ?destination)))": "(:action enter :parameters (?entity - (either creature item) ?positionfrom - (either place location) ?destination - room) :precondition (and (not (locked ?destination)) (at ?entity ?positionfrom)) :effect (and (not (at ?entity ?positionfrom)) (at ?entity ?destination)))",
        "move-location :parameters (?entity - (either creature item) ?destination - (either place location) ?origin - (either place location)) :precondition (and (connected ?destination ?origin) (not (asleep ?entity)) (at ?entity ?origin)) :effect (and (not (at ?entity ?origin)) (at ?entity ?destination)))": "(:action move-location :parameters (?entity - (either creature item) ?destination - (either place location) ?origin - (either place location)) :precondition (and (connected ?destination ?origin) (not (asleep ?entity)) (at ?entity ?origin)) :effect (and (not (at ?entity ?origin)) (at ?entity ?destination)))",
        "wake-person :parameters (?awakener - character ?sleeper - character ?position - (either place location)) :precondition (and (at ?awakener ?position) (at ?sleeper ?position) (asleep ?sleeper) (not (asleep ?awakener))) :effect (not (asleep ?sleeper)))": "(:action wake-person :parameters (?awakener - character ?sleeper - character ?position - (either place location)) :precondition (and (at ?awakener ?position) (at ?sleeper ?position) (asleep ?sleeper) (not (asleep ?awakener))) :effect (not (asleep ?sleeper)))",
        "take-thing :parameters (?character - character ?entity - (either creature item) ?position - (either place location)) :precondition (and (at ?character ?position) (in ?entity ?position) (at ?entity ?position) (not (asleep ?character)) (not (enchanted ?entity))) :effect (and (has ?character ?entity) (not (in ?entity ?position)) (not (at ?entity ?position))))": "(:action take-thing :parameters (?character - character ?entity - (either creature item) ?position - (either place location)) :precondition (and (at ?character ?position) (in ?entity ?position) (at ?entity ?position) (not (asleep ?character)) (not (enchanted ?entity))) :effect (and (has ?character ?entity) (not (in ?entity ?position)) (not (at ?entity ?position))))",
        "disenchant-thing :parameters (?caster - character ?entity - (either creature item) ?held-thing - thing ?position - (either place location)) :precondition (and (at ?caster ?position) (at ?entity ?position) (not (asleep ?caster)) (has ?caster ?held-thing) (enchanted ?entity)) :effect (not (enchanted ?entity)))": "(:action disenchant-thing :parameters (?caster - character ?entity - (either creature item) ?held-thing - thing ?position - (either place location)) :precondition (and (at ?caster ?position) (at ?entity ?position) (not (asleep ?caster)) (has ?caster ?held-thing) (enchanted ?entity)) :effect (not (enchanted ?entity)))"
