        "unlock-fail :parameters (?person - person ?item - item ?room - room) :precondition (and (believes-locked ?person ?room) (believes-unlocked-by ?person ?room ?item) (believes-has ?person ?person ?item) (not (and (locked ?room) (unlocked-by ?room ?item) (has ?person ?item)))) :effect (when (and (locked ?room) (has ?person ?item) (not (unlocked-by ?room ?item))) (not (believes-unlocked-by ?person ?room ?item))))": "(:action unlock-fail :parameters (?person - person ?item - item ?room - room) :precondition (and (believes-locked ?person ?room) (believes-unlocked-by ?person ?room ?item) (believes-has ?person ?person ?item) (not (and (locked ?room) (unlocked-by ?room ?item) (has ?person ?item)))) :effect (when (and (locked ?room) (has ?person ?item) (not (unlocked-by ?room ?item))) (not (believes-unlocked-by ?person ?room ?item))))",
        "search-for-success :parameters (?person - person ?item - item ?place - room) :precondition (and (believes-at ?person ?person ?place) (believes-in ?person ?item ?place) (at ?person ?place) (in ?item ?place)) :effect (and (has ?person ?item) (not (in ?item ?place)) (believes-has ?person ?person ?item) (not (believes-in ?person ?item ?place))))": "(:action search-for-success :parameters (?person - person ?item - item ?place - room) :precondition (and (believes-at ?person ?person ?place) (believes-in ?person ?item ?place) (at ?person ?place) (in ?item ?place)) :effect (and (has ?person ?item) (not (in ?item ?place)) (believes-has ?person ?person ?item) (not (believes-in ?person ?item ?place))))"
