        "propose :parameters (?initiator - person ?recipient - person ?location - place) :precondition (and (alive ?initiator) (at ?initiator ?location) (alive ?recipient) (at ?recipient ?location) (loves ?initiator ?recipient)) :effect (hasproposed ?initiator ?recipient))": "(:action propose :parameters (?initiator - person ?recipient - person ?location - place) :precondition (and (alive ?initiator) (at ?initiator ?location) (alive ?recipient) (at ?recipient ?location) (loves ?initiator ?recipient)) :effect (hasproposed ?initiator ?recipient))",
        "accept :parameters (?proposee - person ?initiator - person ?location - place) :precondition (and (alive ?proposee) (at ?proposee ?location) (alive ?initiator) (at ?initiator ?location) (hasproposed ?initiator ?proposee)) :effect (hasaccepted ?proposee ?initiator))": "(:action accept :parameters (?proposee - person ?initiator - person ?location - place) :precondition (and (alive ?proposee) (at ?proposee ?location) (alive ?initiator) (at ?initiator ?location) (hasproposed ?initiator ?proposee)) :effect (hasaccepted ?proposee ?initiator))",
        "marry :parameters (?holder - person ?bride - person ?place - place) :precondition (and (alive ?holder) (at ?holder ?place) (hasproposed ?holder ?bride) (single ?holder) (alive ?bride) (at ?bride ?place) (hasaccepted ?bride ?holder) (single ?bride)) :effect (and (marriedto ?holder ?bride) (marriedto ?bride ?holder) (not (single ?holder)) (not (single ?bride)) (forall (?v - valuable) (when (has ?holder ?v) (rich ?bride))) (when (loves ?holder ?bride) (happy ?holder)) (when (loves ?bride ?holder) (happy ?bride))))": "(:action marry :parameters (?holder - person ?bride - person ?place - place) :precondition (and (alive ?holder) (at ?holder ?place) (hasproposed ?holder ?bride) (single ?holder) (alive ?bride) (at ?bride ?place) (hasaccepted ?bride ?holder) (single ?bride)) :effect (and (marriedto ?holder ?bride) (marriedto ?bride ?holder) (not (single ?holder)) (not (single ?bride)) (forall (?v - valuable) (when (has ?holder ?v) (rich ?bride))) (when (loves ?holder ?bride) (happy ?holder)) (when (loves ?bride ?holder) (happy ?bride))))",
        "steal :parameters (?holder - creature ?owner - creature ?item - item ?place - place) :precondition (and (not (= ?holder ?owner)) (alive ?holder) (at ?holder ?place) (at ?item ?place) (belongsto ?item ?owner)) :effect (and (has ?holder ?item) (when (forall (?v - valuable) (not (has ?owner ?v))) (not (rich ?owner)))))": "(:action steal :parameters (?holder - creature ?owner - creature ?item - item ?place - place) :precondition (and (not (= ?holder ?owner)) (alive ?holder) (at ?holder ?place) (at ?item ?place) (belongsto ?item ?owner)) :effect (and (has ?holder ?item) (when (forall (?v - valuable) (not (has ?owner ?v))) (not (rich ?owner)))))",
        "move-location :parameters (?object - object ?destination - place ?source - place) :precondition (and (connected ?destination ?source) (not (asleep ?object)) (at ?object ?source)) :effect (and (not (at ?object ?source)) (at ?object ?destination)))": "(:action move-location :parameters (?object - object ?destination - place ?source - place) :precondition (and (connected ?destination ?source) (not (asleep ?object)) (at ?object ?source)) :effect (and (not (at ?object ?source)) (at ?object ?destination)))",
        "wake-person :parameters (?awakener - character ?sleeper - character ?place - place) :precondition (and (at ?awakener ?place) (at ?sleeper ?place) (asleep ?sleeper) (not (asleep ?awakener))) :effect (not (asleep ?sleeper)))": "(:action wake-person :parameters (?awakener - character ?sleeper - character ?place - place) :precondition (and (at ?awakener ?place) (at ?sleeper ?place) (asleep ?sleeper) (not (asleep ?awakener))) :effect (not (asleep ?sleeper)))",
        "take-thing :parameters (?holder - (either creature character) ?object - object ?place - place) :precondition (and (at ?holder ?place) (at ?object ?place) (not (asleep ?holder)) (not (enchanted ?object))) :effect (and (not (at ?object ?place)) (has ?holder ?object)))": "(:action take-thing :parameters (?holder - (either creature character) ?object - object ?place - place) :precondition (and (at ?holder ?place) (at ?object ?place) (not (asleep ?holder)) (not (enchanted ?object))) :effect (and (not (at ?object ?place)) (has ?holder ?object)))",
        "disenchant-thing :parameters (?holder - (either creature character) ?object - object ?book - book ?place - place) :precondition (and (at ?holder ?place) (at ?object ?place) (not (asleep ?holder)) (has ?holder ?book) (enchanted ?object)) :effect (not (enchanted ?object)))": "(:action disenchant-thing :parameters (?holder - (either creature character) ?object - object ?book - book ?place - place) :precondition (and (at ?holder ?place) (at ?object ?place) (not (asleep ?holder)) (has ?holder ?book) (enchanted ?object)) :effect (not (enchanted ?object)))"
