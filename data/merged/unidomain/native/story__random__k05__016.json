        "get-on-swing :parameters (?character - character ?place - object) :precondition (and (at ?character ?place) (not (on-swing ?character))) :effect (on-swing ?character))": "(:action get-on-swing :parameters (?character - character ?place - object) :precondition (and (at ?character ?place) (not (on-swing ?character))) :effect (on-swing ?character))",
        "move :parameters (?character - character ?from-object - object ?to-object - object) :precondition (and (not (= ?from-object ?to-object)) (at ?character ?from-object)) :effect (and (not (at ?character ?from-object)) (at ?character ?to-object)))": "(:action move :parameters (?character - character ?from-object - object ?to-object - object) :precondition (and (not (= ?from-object ?to-object)) (at ?character ?from-object)) :effect (and (not (at ?character ?from-object)) (at ?character ?to-object)))",
        "get-off-swing": "(:action get-off-swing\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (swinging ?character))\n :effect (and (not (on-swing ?character)) (not (swinging ?character)) (happy ?character))\n)",
