        "(echo ?reader - reader ?poem - poem)": "Source predicate (echo ?reader - reader ?poem - poem).",
        "(alive ?entity - (either poem character))": "The poem or character is alive.",
        "(feeling ?character - character)": "Source predicate (feeling ?character - character).",
        "(last-soul ?character - character)": "Source predicate (last-soul ?character - character).",
        "(understand ?character - character)": "Source predicate (understand ?character - character).",
        "(witness ?character - character)": "Source predicate (witness ?character - character).",
        "(end ?character - character)": "Source predicate (end ?character - character).",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(interesting ?place - place)": "Source predicate (interesting ?place - place).",
        "(singing ?character - character)": "Source predicate (singing ?character - character).",
        "(friends ?character1 - character ?character2 - character)": "Character1 is friends with character2.",
        "(wearing-hat ?character - character)": "Source predicate (wearing-hat ?character - character).",
        "(is-dog ?character - character)": "Source predicate (is-dog ?character - character).",
        "(is-fairy ?character - character)": "Source predicate (is-fairy ?character - character).",
        "(has-magic-flower ?character - character)": "Source predicate (has-magic-flower ?character - character).",
        "(playing-together ?character1 - character ?character2 - character)": "Source predicate (playing-together ?character1 - character ?character2 - character).",
        "(alive ?character - character)": "The poem or character is alive."
    },
    "operators": {
        "play-chess": "(:action play-chess\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (sick ?character1)) (not (sick ?character2)) (not (= ?character1 ?character2)) (sit-together ?character1 ?character2))\n :effect (and (play-chess ?character1 ?character2) (happy ?character1) (happy ?character2))\n)",
        "get-sick": "(:action get-sick\n :parameters (?character - character)\n :precondition (and)\n :effect (sick ?character)\n)",
        "feel-better": "(:action feel-better\n :parameters (?character - character)\n :precondition (sick ?character)\n :effect (not (sick ?character))\n)",
        "sit-together": "(:action sit-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (sit-together ?character1 ?character2)\n)",
        "echo-poem": "(:action echo-poem\n :parameters (?reader - reader ?poem - poem)\n :precondition (and (read ?reader ?poem) (not (echo ?reader ?poem)))\n :effect (echo ?reader ?poem)\n)",
        "read-poem :parameters (?reader - reader ?entity - poem) :precondition (and (not (read ?reader ?entity)) (alive ?entity)) :effect (and (read ?reader ?entity) (echo ?reader ?entity)))": "(:action read-poem :parameters (?reader - reader ?entity - poem) :precondition (and (not (read ?reader ?entity)) (alive ?entity)) :effect (and (read ?reader ?entity) (echo ?reader ?entity)))",
        "poem-dies :parameters (?entity - poem) :precondition (alive ?entity) :effect (and (not (alive ?entity)) (dead ?entity)))": "(:action poem-dies :parameters (?entity - poem) :precondition (alive ?entity) :effect (and (not (alive ?entity)) (dead ?entity)))",
        "move": "(:action move\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (not (at ?character ?place)))\n :effect (at ?character ?place)\n)",
        "sleep": "(:action sleep\n :parameters (?character - character ?place - place)\n :precondition (and (awake ?character) (at ?character ?place) (interesting ?place))\n :effect (not (awake ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (not (awake ?character))\n :effect (awake ?character)\n)",
        "sing": "(:action sing\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (singing ?character)\n)",
        "stop-singing": "(:action stop-singing\n :parameters (?character - character)\n :precondition (singing ?character)\n :effect (not (singing ?character))\n)",
        "remove-hat": "(:action remove-hat\n :parameters (?remover - character ?wearer - character)\n :precondition (and (not (= ?remover ?wearer)) (wearing-hat ?wearer))\n :effect (not (wearing-hat ?wearer))\n)",
        "transform": "(:action transform\n :parameters (?character - character)\n :precondition (is-dog ?character)\n :effect (and (not (is-dog ?character)) (is-fairy ?character))\n)",
        "give-magic-flower": "(:action give-magic-flower\n :parameters (?giver - character ?receiver - character)\n :precondition (and (not (= ?giver ?receiver)) (is-fairy ?giver))\n :effect (has-magic-flower ?receiver)\n)",
        "make-friends": "(:action make-friends :parameters (?character1 - character ?character2 - character) :precondition (and (awake ?character1) (awake ?character2) (not (friends ?character1 ?character2)) (not (= ?character1 ?character2))) :effect (friends ?character1 ?character2))",
        "play-together": "(:action play-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (friends ?character1 ?character2))\n :effect (playing-together ?character1 ?character2)\n)",
        "start-feeling :parameters (?entity - character) :precondition (and (alive ?entity) (not (feeling ?entity))) :effect (feeling ?entity))": "(:action start-feeling :parameters (?entity - character) :precondition (and (alive ?entity) (not (feeling ?entity))) :effect (feeling ?entity))",
        "witness-end :parameters (?entity - character) :precondition (and (alive ?entity) (not (witness ?entity))) :effect (witness ?entity))": "(:action witness-end :parameters (?entity - character) :precondition (and (alive ?entity) (not (witness ?entity))) :effect (witness ?entity))",
        "understand-end :parameters (?entity - character) :precondition (and (alive ?entity) (witness ?entity) (not (understand ?entity))) :effect (understand ?entity))": "(:action understand-end :parameters (?entity - character) :precondition (and (alive ?entity) (witness ?entity) (not (understand ?entity))) :effect (understand ?entity))",
        "last-soul-fades :parameters (?entity - character) :precondition (and (alive ?entity) (last-soul ?entity) (understand ?entity)) :effect (not (alive ?entity)))": "(:action last-soul-fades :parameters (?entity - character) :precondition (and (alive ?entity) (last-soul ?entity) (understand ?entity)) :effect (not (alive ?entity)))",
        "humanity-ends :parameters (?entity - character) :precondition (and (alive ?entity) (understand ?entity) (not (end ?entity))) :effect (end ?entity))": "(:action humanity-ends :parameters (?entity - character) :precondition (and (alive ?entity) (understand ?entity) (not (end ?entity))) :effect (end ?entity))"
    }
}