{
    "predicates": {
        "(play-chess ?character1 - character ?character2 - character)": "Source predicate (play-chess ?character1 - character ?character2 - character).",
        "(feel-better ?character - character)": "Source predicate (feel-better ?character - character).",
        "(sit-together ?character1 - character ?character2 - character)": "Source predicate (sit-together ?character1 - character ?character2 - character).",
