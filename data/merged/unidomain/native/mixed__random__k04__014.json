        "keep-cake-good": "(:action keep-cake-good\n :parameters ()\n :precondition (and (box-open) (listened-to-mom tim) (cake-good))\n :effect (cake-good)\n)",
        "arrest :parameters (?officer - police ?suspect - actor ?p1 ?p2 - place ?c - crime) :precondition (and (at ?officer ?p1) (at ?suspect ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?officer) (alive ?suspect) (suspect ?suspect ?c) (arrester ?officer)) :effect (and (at ?suspect ?p2) (not (at ?suspect ?p1)) (at ?officer ?p2) (not (at ?officer ?p1)) (under-arrest ?suspect)))": "(:action arrest :parameters (?officer - police ?suspect - actor ?p1 ?p2 - place ?c - crime) :precondition (and (at ?officer ?p1) (at ?suspect ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?officer) (alive ?suspect) (suspect ?suspect ?c) (arrester ?officer)) :effect (and (at ?suspect ?p2) (not (at ?suspect ?p1)) (at ?officer ?p2) (not (at ?officer ?p1)) (under-arrest ?suspect)))",
        "play-basketball :parameters (?player1 ?player2 - (either actor character) ?p - place) :precondition (and (is-basketball-place ?p) (at ?player1 ?p) (alive ?player1) (at ?player2 ?p) (alive ?player2) (not (= ?player1 ?player2))) :effect (and (not (angry ?player1)) (not (angry ?player2))))": "(:action play-basketball :parameters (?player1 ?player2 - (either actor character) ?p - place) :precondition (and (is-basketball-place ?p) (at ?player1 ?p) (alive ?player1) (at ?player2 ?p) (alive ?player2) (not (= ?player1 ?player2))) :effect (and (not (angry ?player1)) (not (angry ?player2))))",
        "findclues :parameters (?officer - police ?case - crime ?evidence - item ?location - place) :precondition (and (at ?officer ?location) (alive ?officer) (clue ?case ?evidence ?location)) :effect (and (knows-clue ?officer ?case ?evidence)))": "(:action findclues :parameters (?officer - police ?case - crime ?evidence - item ?location - place) :precondition (and (at ?officer ?location) (alive ?officer) (clue ?case ?evidence ?location)) :effect (and (knows-clue ?officer ?case ?evidence)))",
        "shareclues :parameters (?sender ?receiver - police ?c - crime ?i - item ?p - place) :precondition (and (at ?sender ?p) (alive ?sender) (at ?receiver ?p) (alive ?receiver) (clue ?c ?i ?p) (knows-clue ?sender ?c ?i)) :effect (and (knows-clue ?receiver ?c ?i)))": "(:action shareclues :parameters (?sender ?receiver - police ?c - crime ?i - item ?p - place) :precondition (and (at ?sender ?p) (alive ?sender) (at ?receiver ?p) (alive ?receiver) (clue ?c ?i ?p) (knows-clue ?sender ?c ?i)) :effect (and (knows-clue ?receiver ?c ?i)))",
        "travel :parameters (?traveler - (either actor character) ?c - car ?p1 ?p2 - place) :precondition (and (working ?c) (at ?traveler ?p1) (alive ?traveler) (has-car ?traveler ?c)) :effect (and (at ?traveler ?p2) (not (at ?traveler ?p1)) (when (and (arrester ?traveler)) (and (arrester-at ?p2) (not (arrester-at ?p1))))))": "(:action travel :parameters (?traveler - (either actor character) ?c - car ?p1 ?p2 - place) :precondition (and (working ?c) (at ?traveler ?p1) (alive ?traveler) (has-car ?traveler ?c)) :effect (and (at ?traveler ?p2) (not (at ?traveler ?p1)) (when (and (arrester ?traveler)) (and (arrester-at ?p2) (not (arrester-at ?p1))))))",
        "steal :parameters (?thief - (either actor character) ?b - citizen ?c - crime ?i - item ?p - place) :precondition (and (at ?thief ?p) (at ?b ?p) (has ?b ?i) (not (= ?thief ?b)) (alive ?thief) (is-theft ?c)) :effect (and (has ?thief ?i) (not (has ?b ?i)) (angry ?b) (clue ?c ?i ?p)))": "(:action steal :parameters (?thief - (either actor character) ?b - citizen ?c - crime ?i - item ?p - place) :precondition (and (at ?thief ?p) (at ?b ?p) (has ?b ?i) (not (= ?thief ?b)) (alive ?thief) (is-theft ?c)) :effect (and (has ?thief ?i) (not (has ?b ?i)) (angry ?b) (clue ?c ?i ?p)))",
        "kill :parameters (?killer ?victim - actor ?crime - crime ?weapon - item ?location - place) :precondition (and (at ?killer ?location) (at ?victim ?location) (alive ?killer) (alive ?victim) (not (= ?killer ?victim)) (has ?killer ?weapon) (is-murder ?crime) (not (under-arrest ?killer))) :effect (and (not (alive ?victim)) (clue ?crime ?weapon ?location)))": "(:action kill :parameters (?killer ?victim - actor ?crime - crime ?weapon - item ?location - place) :precondition (and (at ?killer ?location) (at ?victim ?location) (alive ?killer) (alive ?victim) (not (= ?killer ?victim)) (has ?killer ?weapon) (is-murder ?crime) (not (under-arrest ?killer))) :effect (and (not (alive ?victim)) (clue ?crime ?weapon ?location)))",
        "suspect-of-crime :parameters (?officer - police ?citizen - citizen ?crime - crime ?item - item ?location - place) :precondition (and (at ?officer ?location) (alive ?officer) (at ?citizen ?location) (alive ?citizen) (knows-clue ?officer ?crime ?item) (has ?citizen ?item)) :effect (and (suspect ?citizen ?crime)))": "(:action suspect-of-crime :parameters (?officer - police ?citizen - citizen ?crime - crime ?item - item ?location - place) :precondition (and (at ?officer ?location) (alive ?officer) (at ?citizen ?location) (alive ?citizen) (knows-clue ?officer ?crime ?item) (has ?citizen ?item)) :effect (and (suspect ?citizen ?crime)))",
        "sober-up": "(:action sober-up\n :parameters (?character - character)\n :precondition (drunk ?character)\n :effect (not (drunk ?character))\n)",
        "move :parameters (?a - (either actor character) ?p - place) :precondition (and (alive ?a) (not (at ?a ?p))) :effect (at ?a ?p))": "(:action move :parameters (?a - (either actor character) ?p - place) :precondition (and (alive ?a) (not (at ?a ?p))) :effect (at ?a ?p))",
        "vomit :parameters (?a - (either actor character) ?p - place) :precondition (and (alive ?a) (drunk ?a) (at ?a ?p)) :effect (vomit-stain ?p))": "(:action vomit :parameters (?a - (either actor character) ?p - place) :precondition (and (alive ?a) (drunk ?a) (at ?a ?p)) :effect (vomit-stain ?p))",
        "travel :parameters (?a - (either actor character) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?a) (at ?a ?from)) :effect (and (not (at ?a ?from)) (at ?a ?to)))": "(:action travel :parameters (?a - (either actor character) ?from - place ?to - place) :precondition (and (not (= ?from ?to)) (alive ?a) (at ?a ?from)) :effect (and (not (at ?a ?from)) (at ?a ?to)))",
        "drink :parameters (?a - (either actor character) ?t - item) :precondition (and (alive ?a) (has ?a ?t)) :effect (and (drunk ?a) (not (has ?a ?t))))": "(:action drink :parameters (?a - (either actor character) ?t - item) :precondition (and (alive ?a) (has ?a ?t)) :effect (and (drunk ?a) (not (has ?a ?t))))",
        "deliver :parameters (?a - (either actor character) ?t - item ?p - place) :precondition (and (alive ?a) (at ?a ?p) (has ?a ?t)) :effect (and (not (has ?a ?t)) (delivered ?t)))": "(:action deliver :parameters (?a - (either actor character) ?t - item ?p - place) :precondition (and (alive ?a) (at ?a ?p) (has ?a ?t)) :effect (and (not (has ?a ?t)) (delivered ?t)))",
        "pick-up :parameters (?a - (either actor character) ?t - item ?p - place) :precondition (and (alive ?a) (at ?a ?p)) :effect (has ?a ?t))": "(:action pick-up :parameters (?a - (either actor character) ?t - item ?p - place) :precondition (and (alive ?a) (at ?a ?p)) :effect (has ?a ?t))"
