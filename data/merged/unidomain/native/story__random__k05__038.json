{
    "predicates": {
        "(sailor ?character - character)": "Source predicate (sailor ?character - character).",
        "(nice ?character - character)": "Source predicate (nice ?character - character).",
        "(sailing ?character - character)": "Source predicate (sailing ?character - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(helping ?helper - character ?helpee - character)": "Source predicate (helping ?helper - character ?helpee - character).",
        "(knows-survival-skills ?character - character)": "Source predicate (knows-survival-skills ?character - character).",
        "(computers-working)": "Source predicate (computers-working).",
        "(caused-apocalypse ?character - character)": "Source predicate (caused-apocalypse ?character - character).",
        "(alive ?character - character)": "The character is alive.",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(has ?character - character ?item - item)": "The character possesses the item, which may be a toy.",
        "(has-emotion ?character - character ?emotion - emotion)": "Source predicate (has-emotion ?character - character ?emotion - emotion).",
        "(knows-change ?character - character)": "Source predicate (knows-change ?character - character).",
        "(memorize ?character - character)": "Source predicate (memorize ?character - character).",
        "(on-top ?toy - toy ?place - place)": "Source predicate (on-top ?toy - toy ?place - place).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(scared ?character - character)": "Source predicate (scared ?character - character).",
        "(playing ?character - character)": "Source predicate (playing ?character - character).",
        "(tired ?character - character)": "Source predicate (tired ?character - character).",
        "(sleeping ?character - character)": "Source predicate (sleeping ?character - character).",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(has-energy ?character - character)": "Source predicate (has-energy ?character - character).",
        "(has ?character - character ?toy - toy)": "The character possesses the item, which may be a toy."
    },
    "operators": {
        "learn-to-sail": "(:action learn-to-sail\n :parameters (?character - character)\n :precondition (and)\n :effect (sailor ?character)\n)",
        "become-nice": "(:action become-nice\n :parameters (?character - character)\n :precondition (and)\n :effect (nice ?character)\n)",
        "help": "(:action help\n :parameters (?helper - character ?helpee - character)\n :precondition (not (= ?helper ?helpee))\n :effect (helping ?helper ?helpee)\n)",
        "sail-together": "(:action sail-together\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sailor ?character1) (sailor ?character2))\n :effect (together ?character1 ?character2)\n)",
        "thank": "(:action thank\n :parameters (?thanker - character ?thankee - character)\n :precondition (not (= ?thanker ?thankee))\n :effect (nice ?thanker)\n)",
        "learn-survival-skills": "(:action learn-survival-skills\n :parameters (?learner - character ?teacher - character)\n :precondition (and (alive ?learner) (alive ?teacher) (knows-survival-skills ?teacher) (not (knows-survival-skills ?learner)))\n :effect (knows-survival-skills ?learner)\n)",
        "cause-apocalypse": "(:action cause-apocalypse\n :parameters (?character - character)\n :precondition (and (alive ?character) (computers-working))\n :effect (and (not (computers-working)) (caused-apocalypse ?character))\n)",
        "kill": "(:action kill\n :parameters (?killer - character ?victim - character)\n :precondition (and (alive ?killer) (alive ?victim) (not (= ?killer ?victim)))\n :effect (not (alive ?victim))\n)",
        "become-friends": "(:action become-friends\n :parameters (?character1 - character ?character2 - character)\n :precondition (not (= ?character1 ?character2))\n :effect (friends ?character1 ?character2)\n)",
        "overcome-fear": "(:action overcome-fear\n :parameters (?character - character)\n :precondition (scared ?character)\n :effect (not (scared ?character))\n)",
        "stop-playing": "(:action stop-playing\n :parameters (?character - character)\n :precondition (playing ?character)\n :effect (and (not (playing ?character)) (tired ?character))\n)",
        "sleep": "(:action sleep\n :parameters (?character - character)\n :precondition (and (tired ?character) (not (sleeping ?character)))\n :effect (and (not (awake ?character)) (sleeping ?character))\n)",
        "notice-change": "(:action notice-change\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (knows-change ?character)\n)",
        "memorize-appearance": "(:action memorize-appearance\n :parameters (?character - character)\n :precondition (and (alive ?character) (knows-change ?character))\n :effect (memorize ?character)\n)",
        "move": "(:action move\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "start-playing :parameters (?character - character) :precondition (and (awake ?character) (not (playing ?character)) (has-energy ?character)) :effect (playing ?character))": "(:action start-playing :parameters (?character - character) :precondition (and (awake ?character) (not (playing ?character)) (has-energy ?character)) :effect (playing ?character))",
        "wake-up :parameters (?character - character) :precondition (sleeping ?character) :effect (and (awake ?character) (not (sleeping ?character)) (not (tired ?character)) (has-energy ?character)))": "(:action wake-up :parameters (?character - character) :precondition (sleeping ?character) :effect (and (awake ?character) (not (sleeping ?character)) (not (tired ?character)) (has-energy ?character)))",
        "experience-emotion :parameters (?character - character ?emotion - emotion) :precondition (alive ?character) :effect (has-emotion ?character ?emotion))": "(:action experience-emotion :parameters (?character - character ?emotion - emotion) :precondition (alive ?character) :effect (has-emotion ?character ?emotion))",
        "retrieve-toy :parameters (?character - character ?item - item ?place - place) :precondition (and (at ?character ?place) (on-top ?item ?place)) :effect (and (not (on-top ?item ?place)) (has ?character ?item)))": "(:action retrieve-toy :parameters (?character - character ?item - item ?place - place) :precondition (and (at ?character ?place) (on-top ?item ?place)) :effect (and (not (on-top ?item ?place)) (has ?character ?item)))"
    }
}