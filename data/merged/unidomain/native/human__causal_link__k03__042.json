        "lose-consciousness": "(:action lose-consciousness\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?l))\n :effect (and (unconscious ?p) (not (conscious ?p)))\n)",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?a ?b - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?a) (connected ?a ?b) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?a)) (level-of-work ?d ?b)))": "(:action admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?a ?b - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?a) (connected ?a ?b) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?a)) (level-of-work ?d ?b)))",
        "unlock-success :parameters (?character - character ?entity - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?entity) (believes-has ?character ?character ?entity) (locked ?room) (unlocked-by ?room ?entity) (has ?character ?entity)) :effect (and (not (locked ?room)) (not (believes-locked ?character ?room))))": "(:action unlock-success :parameters (?character - character ?entity - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?entity) (believes-has ?character ?character ?entity) (locked ?room) (unlocked-by ?room ?entity) (has ?character ?entity)) :effect (and (not (locked ?room)) (not (believes-locked ?character ?room))))",
        "unlock-fail :parameters (?character - character ?entity - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?entity) (believes-has ?character ?character ?entity) (not (and (locked ?room) (unlocked-by ?room ?entity) (has ?character ?entity)))) :effect (when (and (locked ?room) (has ?character ?entity) (not (unlocked-by ?room ?entity))) (not (believes-unlocked-by ?character ?room ?entity))))": "(:action unlock-fail :parameters (?character - character ?entity - key ?room - room) :precondition (and (believes-locked ?character ?room) (believes-unlocked-by ?character ?room ?entity) (believes-has ?character ?character ?entity) (not (and (locked ?room) (unlocked-by ?room ?entity) (has ?character ?entity)))) :effect (when (and (locked ?room) (has ?character ?entity) (not (unlocked-by ?room ?entity))) (not (believes-unlocked-by ?character ?room ?entity))))",
        "interrogate-character :parameters (?c - character ?t - character ?l - location) :precondition (and (player ?c) (at ?c ?l) (at ?t ?l) (apprehended ?t)) :effect (knows ?c))": "(:action interrogate-character :parameters (?c - character ?t - character ?l - location) :precondition (and (player ?c) (at ?c ?l) (at ?t ?l) (apprehended ?t)) :effect (knows ?c))",
        "enter-success :parameters (?c - character ?lfrom - room ?lto - room) :precondition (and (not (believes-locked ?c ?lto)) (believes-at ?c ?c ?lfrom) (not (locked ?lto)) (at ?c ?lfrom)) :effect (and (not (at ?c ?lfrom)) (at ?c ?lto) (forall (?char2 - character) (when (at ?char2 ?lto) (and (believes-at ?c ?char2 ?lto) (believes-at ?char2 ?c ?lto)))) (forall (?thing - thing) (when (and (in ?thing ?lto) (not (hidden ?thing))) (believes-in ?c ?thing ?lto))) (not (believes-at ?c ?c ?lfrom)) (believes-at ?c ?c ?lto)))": "(:action enter-success :parameters (?c - character ?lfrom - room ?lto - room) :precondition (and (not (believes-locked ?c ?lto)) (believes-at ?c ?c ?lfrom) (not (locked ?lto)) (at ?c ?lfrom)) :effect (and (not (at ?c ?lfrom)) (at ?c ?lto) (forall (?char2 - character) (when (at ?char2 ?lto) (and (believes-at ?c ?char2 ?lto) (believes-at ?char2 ?c ?lto)))) (forall (?thing - thing) (when (and (in ?thing ?lto) (not (hidden ?thing))) (believes-in ?c ?thing ?lto))) (not (believes-at ?c ?c ?lfrom)) (believes-at ?c ?c ?lto)))",
        "enter-fail :parameters (?c - character ?l - room ?roomto - room) :precondition (and (not (believes-locked ?c ?roomto)) (believes-at ?c ?c ?l) (not (and (not (locked ?roomto)) (at ?c ?l)))) :effect (when (and (locked ?roomto) (at ?c ?l)) (believes-locked ?c ?roomto)))": "(:action enter-fail :parameters (?c - character ?l - room ?roomto - room) :precondition (and (not (believes-locked ?c ?roomto)) (believes-at ?c ?c ?l) (not (and (not (locked ?roomto)) (at ?c ?l)))) :effect (when (and (locked ?roomto) (at ?c ?l)) (believes-locked ?c ?roomto)))",
        "speak-to-success_in :parameters (?c - character ?in_thing - thing ?in_room - room ?recipient - character ?l - room) :precondition (and (at ?c ?l) (at ?recipient ?l) (believes-in ?c ?in_thing ?in_room) (believes-at ?c ?c ?l) (believes-at ?c ?recipient ?l) (believes-at ?recipient ?c ?l) (believes-at ?recipient ?recipient ?l)) :effect (when (and (at ?c ?l) (at ?recipient ?l)) (believes-in ?recipient ?in_thing ?in_room)))": "(:action speak-to-success_in :parameters (?c - character ?in_thing - thing ?in_room - room ?recipient - character ?l - room) :precondition (and (at ?c ?l) (at ?recipient ?l) (believes-in ?c ?in_thing ?in_room) (believes-at ?c ?c ?l) (believes-at ?c ?recipient ?l) (believes-at ?recipient ?c ?l) (believes-at ?recipient ?recipient ?l)) :effect (when (and (at ?c ?l) (at ?recipient ?l)) (believes-in ?recipient ?in_thing ?in_room)))",
        "speak-to-success_unlocked-by :parameters (?speaker - character ?unlocked-by_room - room ?unlocked-by_key - key ?listener - character ?l - location) :precondition (and (at ?speaker ?l) (at ?listener ?l) (believes-unlocked-by ?speaker ?unlocked-by_room ?unlocked-by_key) (believes-at ?speaker ?speaker ?l) (believes-at ?speaker ?listener ?l) (believes-at ?listener ?speaker ?l) (believes-at ?listener ?listener ?l)) :effect (when (and (at ?speaker ?l) (at ?listener ?l)) (believes-unlocked-by ?listener ?unlocked-by_room ?unlocked-by_key)))": "(:action speak-to-success_unlocked-by :parameters (?speaker - character ?unlocked-by_room - room ?unlocked-by_key - key ?listener - character ?l - location) :precondition (and (at ?speaker ?l) (at ?listener ?l) (believes-unlocked-by ?speaker ?unlocked-by_room ?unlocked-by_key) (believes-at ?speaker ?speaker ?l) (believes-at ?speaker ?listener ?l) (believes-at ?listener ?speaker ?l) (believes-at ?listener ?listener ?l)) :effect (when (and (at ?speaker ?l) (at ?listener ?l)) (believes-unlocked-by ?listener ?unlocked-by_room ?unlocked-by_key)))",
        "search-for-fail :parameters (?c - character ?thing - thing ?room - room ?l - location) :precondition (and (believes-at ?c ?c ?room) (believes-in ?c ?thing ?room) (not (and (at ?c ?l) (in ?thing ?room)))) :effect (when (and (not (in ?thing ?room)) (at ?c ?l)) (not (believes-in ?c ?thing ?room))))": "(:action search-for-fail :parameters (?c - character ?thing - thing ?room - room ?l - location) :precondition (and (believes-at ?c ?c ?room) (believes-in ?c ?thing ?room) (not (and (at ?c ?l) (in ?thing ?room)))) :effect (when (and (not (in ?thing ?room)) (at ?c ?l)) (not (believes-in ?c ?thing ?room))))",
        "search-for-success :parameters (?c - character ?entity - thing ?l - room) :precondition (and (believes-at ?c ?c ?l) (believes-in ?c ?entity ?l) (at ?c ?l) (in ?entity ?l)) :effect (and (has ?c ?entity) (not (in ?entity ?l)) (believes-has ?c ?c ?entity) (not (believes-in ?c ?entity ?l))))": "(:action search-for-success :parameters (?c - character ?entity - thing ?l - room) :precondition (and (believes-at ?c ?c ?l) (believes-in ?c ?entity ?l) (at ?c ?l) (in ?entity ?l)) :effect (and (has ?c ?entity) (not (in ?entity ?l)) (believes-has ?c ?c ?entity) (not (believes-in ?c ?entity ?l))))",
        "save-character :parameters (?c1 - character ?c2 - character ?c3 - character ?l - location) :precondition (and (player ?c1) (at ?c1 ?l) (at ?c2 ?l) (captured ?c2) (captured ?c3) (not (at ?c3 ?l))) :effect (and (saved ?c2 ?c1) (not (alive ?c3))))": "(:action save-character :parameters (?c1 - character ?c2 - character ?c3 - character ?l - location) :precondition (and (player ?c1) (at ?c1 ?l) (at ?c2 ?l) (captured ?c2) (captured ?c3) (not (at ?c3 ?l))) :effect (and (saved ?c2 ?c1) (not (alive ?c3))))",
        "move-location :parameters (?c - character ?a ?b - (either level location)) :precondition (and (player ?c) (connected ?a ?b) (at ?c ?b) (knows ?c)) :effect (and (not (at ?c ?b)) (at ?c ?a)))": "(:action move-location :parameters (?c - character ?a ?b - (either level location)) :precondition (and (player ?c) (connected ?a ?b) (at ?c ?b) (knows ?c)) :effect (and (not (at ?c ?b)) (at ?c ?a)))",
        "place-victim :parameters (?c - character ?victim - character ?from - location ?to - location) :precondition (and (henchman ?c) (has ?c ?victim) (at ?c ?from) (connected ?to ?from)) :effect (and (not (has ?c ?victim)) (at ?victim ?to) (captured ?victim)))": "(:action place-victim :parameters (?c - character ?victim - character ?from - location ?to - location) :precondition (and (henchman ?c) (has ?c ?victim) (at ?c ?from) (connected ?to ?from)) :effect (and (not (has ?c ?victim)) (at ?victim ?to) (captured ?victim)))"
