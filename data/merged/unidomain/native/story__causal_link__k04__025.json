        "give :parameters (?giver - character ?object - object ?receiver - character ?location - object) :precondition (and (not (= ?giver ?receiver)) (at ?giver ?location) (has ?giver ?object) (at ?receiver ?location)) :effect (and (not (has ?giver ?object)) (has ?receiver ?object) (gave-gift ?giver ?receiver ?object)))": "(:action give :parameters (?giver - character ?object - object ?receiver - character ?location - object) :precondition (and (not (= ?giver ?receiver)) (at ?giver ?location) (has ?giver ?object) (at ?receiver ?location)) :effect (and (not (has ?giver ?object)) (has ?receiver ?object) (gave-gift ?giver ?receiver ?object)))",
        "put :parameters (?character - character ?object - object ?place - object) :precondition (and (happy ?character) (has ?character ?object)) :effect (at ?object ?place))": "(:action put :parameters (?character - character ?object - object ?place - object) :precondition (and (happy ?character) (has ?character ?object)) :effect (at ?object ?place))",
        "play :parameters (?entity - character ?object - object ?place - object) :precondition (and (at ?entity ?place) (has ?entity ?object)) :effect (happy ?entity))": "(:action play :parameters (?entity - character ?object - object ?place - object) :precondition (and (at ?entity ?place) (has ?entity ?object)) :effect (happy ?entity))",
        "slip": "(:action slip\n :parameters (?character - character ?dress - dress)\n :precondition (and (wearing ?character ?dress) (not (damaged ?dress)))\n :effect (damaged ?dress)\n)",
        "make-happy": "(:action make-happy :parameters (?character - character ?target - character) :precondition (and (not (= ?character ?target)) (not (happy ?target))) :effect (happy ?target))",
        "request-tow :parameters (?entity - character ?location - place) :precondition (and (alive ?entity) (at ?entity ?location)) :effect (requested-tow ?entity ?location))": "(:action request-tow :parameters (?entity - character ?location - place) :precondition (and (alive ?entity) (at ?entity ?location)) :effect (requested-tow ?entity ?location))",
        "put-on-dress :parameters (?character - character ?object - dress) :precondition (and (has ?character ?object) (not (wearing ?character ?object))) :effect (wearing ?character ?object))": "(:action put-on-dress :parameters (?character - character ?object - dress) :precondition (and (has ?character ?object) (not (wearing ?character ?object))) :effect (wearing ?character ?object))",
        "get-new-dress :parameters (?character - character ?old-dress - dress ?new-object - object) :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-object))) :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-object)))": "(:action get-new-dress :parameters (?character - character ?old-dress - dress ?new-object - object) :precondition (and (damaged ?old-dress) (wearing ?character ?old-dress) (not (has ?character ?new-object))) :effect (and (not (wearing ?character ?old-dress)) (has ?character ?new-object)))",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "discover-technology :parameters (?character - character ?object - object ?location - object) :precondition (and (alive ?character) (at ?character ?location)) :effect (and (has ?character ?object) (ancient-technology ?object)))": "(:action discover-technology :parameters (?character - character ?object - object ?location - object) :precondition (and (alive ?character) (at ?character ?location)) :effect (and (has ?character ?object) (ancient-technology ?object)))",
        "transport-object :parameters (?actor - character ?cargo - object ?origin - object ?destination - place) :precondition (and (alive ?actor) (at ?actor ?origin) (has ?actor ?cargo) (requested-tow ?actor ?destination)) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination) (not (has ?actor ?cargo))))": "(:action transport-object :parameters (?actor - character ?cargo - object ?origin - object ?destination - place) :precondition (and (alive ?actor) (at ?actor ?origin) (has ?actor ?cargo) (requested-tow ?actor ?destination)) :effect (and (not (at ?actor ?origin)) (at ?actor ?destination) (not (has ?actor ?cargo))))"
