    "operators": {
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - item)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "request-tow": "(:action request-tow\n :parameters (?character - character ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (requested-tow ?character ?place)\n)",
        "detect-stasis": "(:action detect-stasis\n :parameters (?character - character ?object - object)\n :precondition (and (alive ?character) (has ?character ?object) (ancient-technology ?object))\n :effect (in-stasis ?object)\n)",
        "clean-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (clean ?object))) :effect (clean ?object))": "(:action clean-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (clean ?object))) :effect (clean ?object))",
        "adjust-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (fits ?object ?character))) :effect (fits ?object ?character))": "(:action adjust-item :parameters (?character - character ?object - item) :precondition (and (alive ?character) (has ?character ?object) (not (fits ?object ?character))) :effect (fits ?object ?character))",
        "discover-technology": "(:action discover-technology\n :parameters (?character - character ?object - object ?place - place)\n :precondition (and (alive ?character) (at ?character ?place))\n :effect (and (has ?character ?object) (ancient-technology ?object))\n)",
        "transport-object": "(:action transport-object\n :parameters (?character - character ?object - object ?from - place ?to - place)\n :precondition (and (alive ?character) (at ?character ?from) (has ?character ?object) (requested-tow ?character ?to))\n :effect (and (not (at ?character ?from)) (at ?character ?to) (not (has ?character ?object)))\n)",
        "call-911": "(:action call-911\n :parameters (?caller - character ?sick-person - character)\n :precondition (and (sick ?sick-person) (not (called-911 ?caller ?sick-person)))\n :effect (called-911 ?caller ?sick-person)\n)",
        "comfort": "(:action comfort\n :parameters (?parent - character ?child - character)\n :precondition (and (not (happy ?child)) (not (= ?parent ?child)))\n :effect (happy ?child)\n)",
        "fly-high": "(:action fly-high\n :parameters (?character - character)\n :precondition (and (played-with ?character rocket))\n :effect (happy ?character)\n)",
        "move :parameters (?character - character ?from_place - place ?to_place - place) :precondition (and (not (= ?from_place ?to_place)) (at ?character ?from_place)) :effect (and (not (at ?character ?from_place)) (at ?character ?to_place)))": "(:action move :parameters (?character - character ?from_place - place ?to_place - place) :precondition (and (not (= ?from_place ?to_place)) (at ?character ?from_place)) :effect (and (not (at ?character ?from_place)) (at ?character ?to_place)))",
        "take-item :parameters (?character - character ?object - object ?place - room) :precondition (and (at ?character ?place) (in ?object ?place)) :effect (and (not (in ?object ?place)) (has ?character ?object)))": "(:action take-item :parameters (?character - character ?object - object ?place - room) :precondition (and (at ?character ?place) (in ?object ?place)) :effect (and (not (in ?object ?place)) (has ?character ?object)))",
        "leave-item :parameters (?character - character ?object - object ?place - room) :precondition (and (at ?character ?place) (has ?character ?object)) :effect (and (not (has ?character ?object)) (in ?object ?place)))": "(:action leave-item :parameters (?character - character ?object - object ?place - room) :precondition (and (at ?character ?place) (has ?character ?object)) :effect (and (not (has ?character ?object)) (in ?object ?place)))",
        "play :parameters (?character1 - character ?character2 - character ?object - object ?place - place) :precondition (and (not (= ?character1 ?character2)) (at ?character1 ?place) (has ?character1 ?object) (at ?character2 ?place)) :effect (played-with ?character1 ?object))": "(:action play :parameters (?character1 - character ?character2 - character ?object - object ?place - place) :precondition (and (not (= ?character1 ?character2)) (at ?character1 ?place) (has ?character1 ?object) (at ?character2 ?place)) :effect (played-with ?character1 ?object))",
        "find :parameters (?character - character ?object - object ?place - place) :precondition (and (at ?character ?place) (not (found ?character ?object))) :effect (and (found ?character ?object) (has ?character ?object) (happy ?character)))": "(:action find :parameters (?character - character ?object - object ?place - place) :precondition (and (at ?character ?place) (not (found ?character ?object))) :effect (and (found ?character ?object) (has ?character ?object) (happy ?character)))",
        "show :parameters (?shower - character ?object - object ?receiver - character ?place - place) :precondition (and (not (= ?shower ?receiver)) (at ?shower ?place) (has ?shower ?object) (at ?receiver ?place)) :effect (happy ?receiver))": "(:action show :parameters (?shower - character ?object - object ?receiver - character ?place - place) :precondition (and (not (= ?shower ?receiver)) (at ?shower ?place) (has ?shower ?object) (at ?receiver ?place)) :effect (happy ?receiver))",
        "slip :parameters (?character - character ?item - item) :precondition (and (wearing ?character ?item) (not (damaged ?item))) :effect (damaged ?item))": "(:action slip :parameters (?character - character ?item - item) :precondition (and (wearing ?character ?item) (not (damaged ?item))) :effect (damaged ?item))",
        "wear-item": "(:action wear-item :parameters (?character - character ?item - item) :precondition (and (alive ?character) (has ?character ?item) (fits ?item ?character) (not (wearing ?character ?item))) :effect (wearing ?character ?item))",
        "get-new-dress :parameters (?character - character ?old-item - dress ?new-item - item) :precondition (and (damaged ?old-item) (wearing ?character ?old-item) (not (has ?character ?new-item))) :effect (and (not (wearing ?character ?old-item)) (has ?character ?new-item)))": "(:action get-new-dress :parameters (?character - character ?old-item - dress ?new-item - item) :precondition (and (damaged ?old-item) (wearing ?character ?old-item) (not (has ?character ?new-item))) :effect (and (not (wearing ?character ?old-item)) (has ?character ?new-item)))"
    }
