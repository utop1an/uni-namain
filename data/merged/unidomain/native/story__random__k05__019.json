{
    "predicates": {
        "(in ?pin - pin ?box - box)": "Source predicate (in ?pin - pin ?box - box).",
        "(tidy ?box - box)": "Source predicate (tidy ?box - box).",
        "(on-floor ?pin - pin)": "Source predicate (on-floor ?pin - pin).",
        "(scared ?pin - pin)": "Source predicate (scared ?pin - pin).",
        "(fairy ?character - character)": "Source predicate (fairy ?character - character).",
        "(has-swing ?character - character)": "Source predicate (has-swing ?character - character).",
        "(playing-together ?character1 - character ?character2 - character)": "Source predicate (playing-together ?character1 - character ?character2 - character).",
        "(alive ?entity - (either pin character))": "The pin or character is alive.",
        "(at ?character - character ?place - object)": "The character is at the specified place, which may be a box or another object.",
        "(happy ?character - character)": "The character is happy.",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(anchored ?light - lightbox)": "Source predicate (anchored ?light - lightbox).",
        "(charged ?light - lightbox)": "Source predicate (charged ?light - lightbox).",
        "(created ?character - character ?light - lightbox)": "Source predicate (created ?character - character ?light - lightbox).",
        "(used ?character - character ?light - lightbox)": "Source predicate (used ?character - character ?light - lightbox).",
        "(friend ?dog1 - dog ?dog2 - dog)": "Source predicate (friend ?dog1 - dog ?dog2 - dog).",
        "(practices ?dog1 - dog ?dog2 - dog)": "Source predicate (practices ?dog1 - dog ?dog2 - dog).",
        "(participates ?dog - dog)": "Source predicate (participates ?dog - dog).",
        "(wins ?dog - dog)": "Source predicate (wins ?dog - dog).",
        "(plays-with-toy-stack ?dog - dog)": "Source predicate (plays-with-toy-stack ?dog - dog).",
        "(sad ?character - character)": "Source predicate (sad ?character - character).",
        "(offered-snack ?giver - character ?receiver - character)": "Source predicate (offered-snack ?giver - character ?receiver - character).",
        "(snack-is-lie ?giver - character ?receiver - character)": "Source predicate (snack-is-lie ?giver - character ?receiver - character).",
        "(trusts ?character1 - character ?character2 - character)": "Source predicate (trusts ?character1 - character ?character2 - character).",
        "(compassionate ?character - character)": "Source predicate (compassionate ?character - character).",
        "(alive ?character - character)": "The pin or character is alive."
    },
    "operators": {
        "invite": "(:action invite\n :parameters (?inviter - character ?invitee - character)\n :precondition (and (not (= ?inviter ?invitee)) (has-swing ?inviter))\n :effect (playing-together ?inviter ?invitee)\n)",
        "bring-to-life :parameters (?fairy - character ?entity - pin ?box - box) :precondition (and (fairy ?fairy) (in ?entity ?box)) :effect (alive ?entity))": "(:action bring-to-life :parameters (?fairy - character ?entity - pin ?box - box) :precondition (and (fairy ?fairy) (in ?entity ?box)) :effect (alive ?entity))",
        "become-friends :parameters (?fairy - character ?entity - (either pin character) ?box - box) :precondition (and (fairy ?fairy) (alive ?entity)) :effect (and))": "(:action become-friends :parameters (?fairy - character ?entity - (either pin character) ?box - box) :precondition (and (fairy ?fairy) (alive ?entity)) :effect (and))",
        "pick-up-pin :parameters (?character - character ?pin - pin ?box - box ?place - object) :precondition (and (at ?character ?place) (on-floor ?pin) (tidy ?box)) :effect (and (not (on-floor ?pin)) (in ?pin ?box) (not (scared ?pin))))": "(:action pick-up-pin :parameters (?character - character ?pin - pin ?box - box ?place - object) :precondition (and (at ?character ?place) (on-floor ?pin) (tidy ?box)) :effect (and (not (on-floor ?pin)) (in ?pin ?box) (not (scared ?pin))))",
        "open-box :parameters (?character - character ?place - box) :precondition (and (at ?character ?place) (tidy ?place)) :effect (forall (?pin - pin) (and (not (in ?pin ?place)) (on-floor ?pin) (scared ?pin))))": "(:action open-box :parameters (?character - character ?place - box) :precondition (and (at ?character ?place) (tidy ?place)) :effect (forall (?pin - pin) (and (not (in ?pin ?place)) (on-floor ?pin) (scared ?pin))))",
        "play-on-swing": "(:action play-on-swing\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (playing-together ?character1 ?character2))\n :effect (and (happy ?character1) (happy ?character2))\n)",
        "practice-running": "(:action practice-running\n :parameters (?helper - dog ?runner - dog)\n :precondition (and (friend ?helper ?runner) (not (practices ?helper ?runner)))\n :effect (practices ?helper ?runner)\n)",
        "play-with-toy-stack": "(:action play-with-toy-stack\n :parameters (?dog - dog)\n :precondition (not (plays-with-toy-stack ?dog))\n :effect (plays-with-toy-stack ?dog)\n)",
        "participate-in-race": "(:action participate-in-race\n :parameters (?dog - dog)\n :precondition (not (participates ?dog))\n :effect (participates ?dog)\n)",
        "win-race": "(:action win-race\n :parameters (?dog - dog ?helper - dog)\n :precondition (and (participates ?dog) (practices ?dog ?helper))\n :effect (wins ?dog)\n)",
        "offer-snack": "(:action offer-snack\n :parameters (?giver - character ?receiver - character)\n :precondition (and (at ?receiver ?giver) (compassionate ?giver))\n :effect (offered-snack ?giver ?receiver)\n)",
        "run-away": "(:action run-away\n :parameters (?runner - character ?from - character)\n :precondition (and (at ?runner ?from) (sad ?runner))\n :effect (and (not (at ?runner ?from)) (not (trusts ?runner ?from)))\n)",
        "create-lightbox :parameters (?entity - (either pin character) ?lightbox - lightbox) :precondition (alive ?entity) :effect (and (created ?entity ?lightbox) (has ?entity ?lightbox)))": "(:action create-lightbox :parameters (?entity - (either pin character) ?lightbox - lightbox) :precondition (alive ?entity) :effect (and (created ?entity ?lightbox) (has ?entity ?lightbox)))",
        "anchor-light": "(:action anchor-light\n :parameters (?entity - (either pin character) ?lightbox - lightbox)\n :precondition (and (alive ?entity) (created ?entity ?lightbox) (has ?entity ?lightbox))\n :effect (anchored ?lightbox)\n)",
        "charge-lightbox": "(:action charge-lightbox\n :parameters (?entity - (either pin character) ?lightbox - lightbox)\n :precondition (and (alive ?entity) (anchored ?lightbox) (created ?entity ?lightbox))\n :effect (charged ?lightbox)\n)",
        "use-lightbox :parameters (?entity - character ?lightbox - lightbox) :precondition (and (alive ?entity) (charged ?lightbox) (created ?entity ?lightbox) (has ?entity ?lightbox)) :effect (and (used ?entity ?lightbox) (not (charged ?lightbox))))": "(:action use-lightbox :parameters (?entity - character ?lightbox - lightbox) :precondition (and (alive ?entity) (charged ?lightbox) (created ?entity ?lightbox) (has ?entity ?lightbox)) :effect (and (used ?entity ?lightbox) (not (charged ?lightbox))))",
        "learn-lesson": "(:action learn-lesson\n :parameters (?character - character)\n :precondition (and (sad ?character) (not (trusts ?character ?character)))\n :effect (and (not (sad ?character)) (happy ?character))\n)",
        "go-to-place": "(:action go-to-place\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (at ?character1 ?character2)) (happy ?character1))\n :effect (and (at ?character1 ?character2) (not (happy ?character1)))\n)",
        "reveal-lie": "(:action reveal-lie\n :parameters (?giver - character ?receiver - character)\n :precondition (and (offered-snack ?giver ?receiver) (not (compassionate ?giver)))\n :effect (and (snack-is-lie ?giver ?receiver) (not (happy ?receiver)) (sad ?receiver))\n)"
    }
}