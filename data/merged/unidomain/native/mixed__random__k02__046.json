        "attack :parameters (?attacker - creature ?victim - creature ?location - place) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (at ?attacker ?location) (alive ?victim) (not (stunned ?victim)) (at ?victim ?location)) :effect (and (fighting ?attacker ?victim)))": "(:action attack :parameters (?attacker - creature ?victim - creature ?location - place) :precondition (and (alive ?attacker) (not (stunned ?attacker)) (at ?attacker ?location) (alive ?victim) (not (stunned ?victim)) (at ?victim ?location)) :effect (and (fighting ?attacker ?victim)))",
        "kill :parameters (?aggressor - creature ?victim - creature) :precondition (and (alive ?aggressor) (not (stunned ?aggressor)) (alive ?victim) (or (fighting ?aggressor ?victim) (fighting ?victim ?aggressor))) :effect (and (not (alive ?victim)) (when (fighting ?aggressor ?victim) (not (fighting ?aggressor ?victim))) (when (fighting ?victim ?aggressor) (not (fighting ?victim ?aggressor)))))": "(:action kill :parameters (?aggressor - creature ?victim - creature) :precondition (and (alive ?aggressor) (not (stunned ?aggressor)) (alive ?victim) (or (fighting ?aggressor ?victim) (fighting ?victim ?aggressor))) :effect (and (not (alive ?victim)) (when (fighting ?aggressor ?victim) (not (fighting ?aggressor ?victim))) (when (fighting ?victim ?aggressor) (not (fighting ?victim ?aggressor)))))",
        "stun :parameters (?actor - creature ?target - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?target) (not (stunned ?target)) (or (fighting ?actor ?target) (fighting ?target ?actor))) :effect (and (stunned ?target) (when (fighting ?actor ?target) (not (fighting ?actor ?target))) (when (fighting ?target ?actor) (not (fighting ?target ?actor)))))": "(:action stun :parameters (?actor - creature ?target - creature) :precondition (and (alive ?actor) (not (stunned ?actor)) (alive ?target) (not (stunned ?target)) (or (fighting ?actor ?target) (fighting ?target ?actor))) :effect (and (stunned ?target) (when (fighting ?actor ?target) (not (fighting ?actor ?target))) (when (fighting ?target ?actor) (not (fighting ?target ?actor)))))",
        "break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))": "(:action break-free :parameters (?creature - creature) :precondition (and (alive ?creature) (stunned ?creature)) :effect (not (stunned ?creature)))",
        "make-peace :parameters (?peacemaker - creature ?counterpart - creature ?place - place) :precondition (and (alive ?peacemaker) (not (stunned ?peacemaker)) (at ?peacemaker ?place) (alive ?counterpart) (at ?counterpart ?place) (not (fighting ?peacemaker ?counterpart)) (not (fighting ?counterpart ?peacemaker))) :effect (and (friends ?peacemaker ?counterpart) (friends ?counterpart ?peacemaker)))": "(:action make-peace :parameters (?peacemaker - creature ?counterpart - creature ?place - place) :precondition (and (alive ?peacemaker) (not (stunned ?peacemaker)) (at ?peacemaker ?place) (alive ?counterpart) (at ?counterpart ?place) (not (fighting ?peacemaker ?counterpart)) (not (fighting ?counterpart ?peacemaker))) :effect (and (friends ?peacemaker ?counterpart) (friends ?counterpart ?peacemaker)))",
        "erupt :parameters (?site - landform) :precondition (erupting ?site) :effect (and (not (habitable ?site)) (not (erupting ?site)) (forall (?occupant - (either creature character)) (when (at ?occupant ?site) (not (alive ?occupant))))))": "(:action erupt :parameters (?site - landform) :precondition (erupting ?site) :effect (and (not (habitable ?site)) (not (erupting ?site)) (forall (?occupant - (either creature character)) (when (at ?occupant ?site) (not (alive ?occupant))))))",
