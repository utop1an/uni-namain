{
    "predicates": {
        "(at-park ?character - character)": "Source predicate (at-park ?character - character).",
        "(on-swing ?character - character)": "Source predicate (on-swing ?character - character).",
        "(swinging ?character - character)": "Source predicate (swinging ?character - character).",
        "(sharing ?character1 - character ?character2 - character)": "Source predicate (sharing ?character1 - character ?character2 - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(friends ?character1 - character ?character2 - character)": "Source predicate (friends ?character1 - character ?character2 - character).",
        "(clean ?item - item)": "Source predicate (clean ?item - item).",
        "(steal-intention ?character - character ?item - item)": "Source predicate (steal-intention ?character - character ?item - item).",
        "(has ?character - character ?item - item)": "The character has the item.",
        "(riding ?character - character ?vehicle - vehicle)": "Source predicate (riding ?character - character ?vehicle - vehicle).",
        "(relaxed ?character - character)": "Source predicate (relaxed ?character - character).",
        "(flying ?character - character)": "Source predicate (flying ?character - character).",
        "(in-vehicle ?character - character ?vehicle - vehicle)": "Source predicate (in-vehicle ?character - character ?vehicle - vehicle).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(alive ?character - character)": "The character is alive.",
        "(imprisoned ?character - character)": "Source predicate (imprisoned ?character - character).",
        "(served-sentence ?character - character)": "Source predicate (served-sentence ?character - character).",
        "(has-serum ?character - character)": "Source predicate (has-serum ?character - character).",
        "(religious ?character - character)": "Source predicate (religious ?character - character)."
    },
    "operators": {
        "go-to-park": "(:action go-to-park\n :parameters (?character - character)\n :precondition (not (at-park ?character))\n :effect (at-park ?character)\n)",
        "get-on-swing": "(:action get-on-swing\n :parameters (?character - character)\n :precondition (and (at-park ?character) (not (on-swing ?character)))\n :effect (on-swing ?character)\n)",
        "start-swinging": "(:action start-swinging\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (not (swinging ?character)))\n :effect (swinging ?character)\n)",
        "share-swing": "(:action share-swing\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (swinging ?character1) (swinging ?character2))\n :effect (sharing ?character1 ?character2)\n)",
        "get-off-swing": "(:action get-off-swing\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (swinging ?character))\n :effect (and (not (on-swing ?character)) (not (swinging ?character)) (happy ?character))\n)",
        "thank": "(:action thank\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sharing ?character1 ?character2))\n :effect (happy ?character1)\n)",
        "apologize": "(:action apologize\n :parameters (?apologizer - character ?apologized - character)\n :precondition (and (not (= ?apologizer ?apologized)) (not (friends ?apologizer ?apologized)))\n :effect (friends ?apologizer ?apologized)\n)",
        "try-steal": "(:action try-steal\n :parameters (?stealer - character ?item - item ?owner - character)\n :precondition (and (not (= ?stealer ?owner)) (has ?owner ?item) (steal-intention ?stealer ?item))\n :effect (and (not (steal-intention ?stealer ?item)) (not (friends ?stealer ?owner)) (has ?stealer ?item) (not (has ?owner ?item)))\n)",
        "clean-item": "(:action clean-item\n :parameters (?cleaner - character ?item - item)\n :precondition (and (not (clean ?item)) (has ?cleaner ?item))\n :effect (clean ?item)\n)",
        "drop-in-puddle": "(:action drop-in-puddle\n :parameters (?dropper - character ?item - item)\n :precondition (and (has ?dropper ?item) (clean ?item))\n :effect (not (clean ?item))\n)",
        "stop-riding": "(:action stop-riding\n :parameters (?character - character ?vehicle - vehicle)\n :precondition (and (alive ?character) (riding ?character ?vehicle))\n :effect (not (riding ?character ?vehicle))\n)",
        "start-flying": "(:action start-flying\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (flying ?character)))\n :effect (flying ?character)\n)",
        "stop-flying": "(:action stop-flying\n :parameters (?character - character)\n :precondition (and (alive ?character) (flying ?character))\n :effect (not (flying ?character))\n)",
        "try-relax": "(:action try-relax\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (relaxed ?character)))\n :effect (relaxed ?character)\n)",
        "stop-relax": "(:action stop-relax\n :parameters (?character - character)\n :precondition (and (alive ?character) (relaxed ?character))\n :effect (not (relaxed ?character))\n)",
        "travel": "(:action travel\n :parameters (?character - character ?from - place ?to - place)\n :precondition (and (not (= ?from ?to)) (alive ?character) (at ?character ?from))\n :effect (and (not (at ?character ?from)) (at ?character ?to))\n)",
        "serve-sentence": "(:action serve-sentence\n :parameters (?character - character)\n :precondition (and (alive ?character) (imprisoned ?character) (not (served-sentence ?character)))\n :effect (served-sentence ?character)\n)",
        "release": "(:action release\n :parameters (?character - character)\n :precondition (and (alive ?character) (imprisoned ?character) (served-sentence ?character))\n :effect (not (imprisoned ?character))\n)",
        "convert": "(:action convert\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (religious ?character)))\n :effect (religious ?character)\n)",
        "abandon-religion": "(:action abandon-religion\n :parameters (?character - character)\n :precondition (and (alive ?character) (religious ?character))\n :effect (not (religious ?character))\n)",
        "start-riding": "(:action start-riding\n :parameters (?character - character ?vehicle - vehicle)\n :precondition (and (alive ?character) (has ?character ?vehicle) (not (riding ?character ?vehicle)))\n :effect (riding ?character ?vehicle)\n)",
        "take-serum": "(:action take-serum\n :parameters (?character - character)\n :precondition (and (alive ?character) (not (has-serum ?character)))\n :effect (has-serum ?character)\n)"
    }
}