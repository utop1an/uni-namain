{
    "predicates": {
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character).",
        "(human ?character - character)": "Source predicate (human ?character - character).",
        "(crow ?character - character)": "Source predicate (crow ?character - character).",
        "(in-pain ?character - character)": "Source predicate (in-pain ?character - character).",
        "(sunlight-available)": "Source predicate (sunlight-available).",
        "(transformed ?character - character)": "Source predicate (transformed ?character - character).",
        "(locked ?door - object)": "Source predicate (locked ?door - object).",
        "(called-police ?character - character)": "Source predicate (called-police ?character - character).",
        "(death-averted ?character - character)": "Source predicate (death-averted ?character - character).",
        "(follows ?character - character ?officer - character)": "Source predicate (follows ?character - character ?officer - character).",
        "(at ?character - character ?place - place)": "The character is at the specified place.",
        "(alive ?character - character)": "The character is alive.",
        "(has ?character - character ?item - object)": "The character has the specified object.",
        "(near ?item1 - item ?item2 - item)": "Source predicate (near ?item1 - item ?item2 - item).",
        "(in-nest ?bird - character)": "Source predicate (in-nest ?bird - character).",
        "(sitting ?character - character ?seat - seat)": "Source predicate (sitting ?character - character ?seat - seat).",
        "(broken ?seat - seat)": "Source predicate (broken ?seat - seat).",
        "(big ?seat - seat)": "Source predicate (big ?seat - seat).",
        "(small ?seat - seat)": "Source predicate (small ?seat - seat).",
        "(important ?character - character)": "Source predicate (important ?character - character).",
        "(has ?character - character ?item - item)": "The character has the specified object."
    },
    "operators": {
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)",
        "experience-pain": "(:action experience-pain\n :parameters (?character - character)\n :precondition (human ?character)\n :effect (in-pain ?character)\n)",
        "transform-into-crow": "(:action transform-into-crow\n :parameters (?character - character)\n :precondition (and (human ?character) (in-pain ?character) (sunlight-available))\n :effect (and (not (human ?character)) (crow ?character) (transformed ?character))\n)",
        "transform-back-into-human": "(:action transform-back-into-human\n :parameters (?character - character)\n :precondition (crow ?character)\n :effect (and (not (crow ?character)) (human ?character))\n)",
        "lock-door": "(:action lock-door\n :parameters (?character - character ?door - object)\n :precondition (and (alive ?character) (not (locked ?door)))\n :effect (locked ?door)\n)",
        "call-police": "(:action call-police\n :parameters (?character - character)\n :precondition (alive ?character)\n :effect (called-police ?character)\n)",
        "follow-officer": "(:action follow-officer\n :parameters (?character - character ?officer - character)\n :precondition (and (alive ?character) (alive ?officer))\n :effect (follows ?character ?officer)\n)",
        "avert-death": "(:action avert-death\n :parameters (?character - character)\n :precondition (and (alive ?character) (called-police ?character) (exists (?officer - character) (follows ?character ?officer)))\n :effect (death-averted ?character)\n)",
        "become-important": "(:action become-important\n :parameters (?character - character)\n :precondition (not (important ?character))\n :effect (important ?character)\n)",
        "become-unimportant": "(:action become-unimportant\n :parameters (?character - character)\n :precondition (important ?character)\n :effect (not (important ?character))\n)",
        "sit": "(:action sit\n :parameters (?character - character ?seat - seat)\n :precondition (and (not (sitting ?character ?seat)) (not (broken ?seat)))\n :effect (sitting ?character ?seat)\n)",
        "leave": "(:action leave\n :parameters (?character - character ?seat - seat)\n :precondition (sitting ?character ?seat)\n :effect (not (sitting ?character ?seat))\n)",
        "break-seat": "(:action break-seat\n :parameters (?seat - seat)\n :precondition (not (broken ?seat))\n :effect (broken ?seat)\n)",
        "help-bird": "(:action help-bird\n :parameters (?character - character ?bird - character)\n :precondition (and (alive ?character) (alive ?bird) (not (in-nest ?bird)))\n :effect (in-nest ?bird)\n)",
        "bird-falls": "(:action bird-falls\n :parameters (?bird - character)\n :precondition (and (alive ?bird) (in-nest ?bird))\n :effect (not (in-nest ?bird))\n)",
        "move :parameters (?character - character ?from - place ?to - place) :precondition (and (alive ?character) (at ?character ?from) (not (at ?character ?to))) :effect (and (not (at ?character ?from)) (at ?character ?to)))": "(:action move :parameters (?character - character ?from - place ?to - place) :precondition (and (alive ?character) (at ?character ?from) (not (at ?character ?to))) :effect (and (not (at ?character ?from)) (at ?character ?to)))",
        "play :parameters (?character - character ?object - object) :precondition (and (alive ?character) (has ?character ?object)) :effect (and))": "(:action play :parameters (?character - character ?object - object) :precondition (and (alive ?character) (has ?character ?object)) :effect (and))",
        "pick-up :parameters (?character - character ?object - object) :precondition (and (alive ?character) (near ?character ?object)) :effect (has ?character ?object))": "(:action pick-up :parameters (?character - character ?object - object) :precondition (and (alive ?character) (near ?character ?object)) :effect (has ?character ?object))"
    }
}