{
    "predicates": {
        "(knows ?character1 - character ?character2 - character)": "Source predicate (knows ?character1 - character ?character2 - character).",
        "(together ?character1 - character ?character2 - character)": "Source predicate (together ?character1 - character ?character2 - character).",
        "(missing ?character - character)": "Source predicate (missing ?character - character).",
        "(relationship ?character1 - character ?character2 - character)": "Source predicate (relationship ?character1 - character ?character2 - character).",
        "(searching ?searcher - character ?target - character)": "Source predicate (searching ?searcher - character ?target - character).",
        "(found ?searcher - character ?target - (either character item))": "The searcher has found the target, which may be a character or an item.",
        "(arrester ?p - actor)": "Source predicate (arrester ?p - actor).",
        "(arrester-at ?p - place)": "Source predicate (arrester-at ?p - place).",
        "(alive ?a - actor)": "Source predicate (alive ?a - actor).",
        "(under-arrest ?a - actor)": "Source predicate (under-arrest ?a - actor).",
        "(angry ?a - actor)": "Source predicate (angry ?a - actor).",
        "(knows-clue ?p - police ?c - crime ?i - item)": "Source predicate (knows-clue ?p - police ?c - crime ?i - item).",
        "(suspect ?a - actor ?c - crime)": "Source predicate (suspect ?a - actor ?c - crime).",
        "(murder-clue ?i - item)": "Source predicate (murder-clue ?i - item).",
        "(clue ?c - crime ?i - item ?p - place)": "Source predicate (clue ?c - crime ?i - item ?p - place).",
        "(is-basketball-place ?p - place)": "Source predicate (is-basketball-place ?p - place).",
        "(is-theft ?c - crime)": "Source predicate (is-theft ?c - crime).",
        "(is-arrest-place ?p - place)": "Source predicate (is-arrest-place ?p - place).",
        "(is-murder ?c - crime)": "Source predicate (is-murder ?c - crime).",
        "(has-car ?a - actor ?c - vehicle)": "Source predicate (has-car ?a - actor ?c - vehicle).",
        "(working ?c - vehicle)": "Source predicate (working ?c - vehicle).",
        "(at ?c - actor ?p - place)": "Actor or character ?c is at place ?p.",
        "(has ?c - actor ?t - item)": "Actor c possesses item t.",
        "(played-with ?character - character ?item - item)": "Source predicate (played-with ?character - character ?item - item).",
        "(happy ?character - character)": "Source predicate (happy ?character - character).",
        "(at ?character - character ?place - place)": "Actor or character ?c is at place ?p.",
        "(has ?character - character ?item - item)": "Actor c possesses item t.",
        "(found ?character - character ?item - item)": "The searcher has found the target, which may be a character or an item."
    },
    "operators": {
        "start-search": "(:action start-search\n :parameters (?searcher - character ?target - character)\n :precondition (and (not (= ?searcher ?target)) (not (searching ?searcher ?target)) (missing ?target))\n :effect (searching ?searcher ?target)\n)",
        "stop-search": "(:action stop-search\n :parameters (?searcher - character ?target - character)\n :precondition (searching ?searcher ?target)\n :effect (not (searching ?searcher ?target))\n)",
        "start-relationship": "(:action start-relationship\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (not (relationship ?character1 ?character2)) (knows ?character1 ?character2))\n :effect (relationship ?character1 ?character2)\n)",
        "end-relationship": "(:action end-relationship\n :parameters (?character1 - character ?character2 - character)\n :precondition (relationship ?character1 ?character2)\n :effect (not (relationship ?character1 ?character2))\n)",
        "arrest": "(:action arrest\n :parameters (?p - police ?a - actor ?p1 ?p2 - place ?c - crime)\n :precondition (and (at ?p ?p1) (at ?a ?p1) (not (= ?p1 ?p2)) (is-arrest-place ?p2) (alive ?p) (alive ?a) (suspect ?a ?c) (arrester ?p))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (at ?p ?p2) (not (at ?p ?p1)) (under-arrest ?a))\n)",
        "play-basketball": "(:action play-basketball\n :parameters (?a ?b - citizen ?p - place)\n :precondition (and (is-basketball-place ?p) (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (not (= ?a ?b)))\n :effect (and (not (angry ?a)) (not (angry ?b)))\n)",
        "findclues": "(:action findclues\n :parameters (?a - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (clue ?c ?i ?p))\n :effect (and (knows-clue ?a ?c ?i))\n)",
        "shareclues": "(:action shareclues\n :parameters (?a ?b - police ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (clue ?c ?i ?p) (knows-clue ?a ?c ?i))\n :effect (and (knows-clue ?b ?c ?i))\n)",
        "travel": "(:action travel\n :parameters (?a - actor ?c - car ?p1 ?p2 - place)\n :precondition (and (working ?c) (at ?a ?p1) (alive ?a) (has-car ?a ?c))\n :effect (and (at ?a ?p2) (not (at ?a ?p1)) (when (and (arrester ?a)) (and (arrester-at ?p2) (not (arrester-at ?p1)))))\n)",
        "steal": "(:action steal\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (has ?b ?i) (not (= ?a ?b)) (alive ?a) (is-theft ?c))\n :effect (and (has ?a ?i) (not (has ?b ?i)) (angry ?b) (clue ?c ?i ?p))\n)",
        "kill": "(:action kill\n :parameters (?a ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (at ?b ?p) (alive ?a) (alive ?b) (not (= ?a ?b)) (has ?a ?i) (is-murder ?c) (not (under-arrest ?a)))\n :effect (and (not (alive ?b)) (clue ?c ?i ?p))\n)",
        "suspect-of-crime": "(:action suspect-of-crime\n :parameters (?a - police ?b - citizen ?c - crime ?i - item ?p - place)\n :precondition (and (at ?a ?p) (alive ?a) (at ?b ?p) (alive ?b) (knows-clue ?a ?c ?i) (has ?b ?i))\n :effect (and (suspect ?b ?c))\n)",
        "fly-high": "(:action fly-high\n :parameters (?character - character)\n :precondition (and (played-with ?character rocket))\n :effect (happy ?character)\n)",
        "show :parameters (?c - actor ?t - item ?r - actor ?loc - place) :precondition (and (not (= ?c ?r)) (at ?c ?loc) (has ?c ?t) (at ?r ?loc)) :effect (happy ?r))": "(:action show :parameters (?c - actor ?t - item ?r - actor ?loc - place) :precondition (and (not (= ?c ?r)) (at ?c ?loc) (has ?c ?t) (at ?r ?loc)) :effect (happy ?r))",
        "play :parameters (?c - actor ?other - actor ?t - item ?p - place) :precondition (and (not (= ?c ?other)) (at ?c ?p) (has ?c ?t) (at ?other ?p)) :effect (played-with ?c ?t))": "(:action play :parameters (?c - actor ?other - actor ?t - item ?p - place) :precondition (and (not (= ?c ?other)) (at ?c ?p) (has ?c ?t) (at ?other ?p)) :effect (played-with ?c ?t))",
        "find": "(:action find :parameters (?searcher - character ?target - (either character item) ?p - place) :precondition (and (searching ?searcher ?target) (missing ?target) (at ?searcher ?p) (not (found ?searcher ?target))) :effect (and (not (missing ?target)) (found ?searcher ?target) (has ?searcher ?target) (happy ?searcher)))"
    }
}