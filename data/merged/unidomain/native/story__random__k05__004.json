{
    "predicates": {
        "(bored ?character - character)": "Source predicate (bored ?character - character).",
        "(dizzy ?character - character)": "Source predicate (dizzy ?character - character).",
        "(rolling ?character - character)": "Source predicate (rolling ?character - character).",
        "(lying-down ?character - character)": "Source predicate (lying-down ?character - character).",
        "(asleep ?character - character)": "Source predicate (asleep ?character - character).",
        "(awake ?character - character)": "Source predicate (awake ?character - character).",
        "(at ?character - character ?place - place)": "Source predicate (at ?character - character ?place - place).",
        "(has-hoard ?character - character)": "Source predicate (has-hoard ?character - character).",
        "(robbed ?gang - gang)": "Source predicate (robbed ?gang - gang).",
        "(soundproof-door ?place - place)": "Source predicate (soundproof-door ?place - place).",
        "(attacked ?character - character)": "Source predicate (attacked ?character - character).",
        "(happy ?character - character)": "The character is happy.",
        "(wearing ?character - character ?clothing - object)": "Source predicate (wearing ?character - character ?clothing - object).",
        "(united ?subreddit1 - subreddit ?subreddit2 - subreddit)": "Source predicate (united ?subreddit1 - subreddit ?subreddit2 - subreddit).",
        "(truce ?subreddit1 - subreddit ?subreddit2 - subreddit)": "Source predicate (truce ?subreddit1 - subreddit ?subreddit2 - subreddit).",
        "(exists ?subreddit - subreddit)": "Source predicate (exists ?subreddit - subreddit).",
        "(wall-built)": "Source predicate (wall-built).",
        "(filled-with-water)": "Source predicate (filled-with-water).",
        "(broken-pedal ?bike - object)": "Source predicate (broken-pedal ?bike - object).",
        "(fixed-pedal ?bike - object)": "Source predicate (fixed-pedal ?bike - object).",
        "(has ?character - character ?bike - object)": "Source predicate (has ?character - character ?bike - object).",
        "(at-shop ?character - character)": "Source predicate (at-shop ?character - character).",
        "(flying ?bike - object)": "Source predicate (flying ?bike - object).",
        "(at-park ?character - character)": "Source predicate (at-park ?character - character).",
        "(on-swing ?character - character)": "Source predicate (on-swing ?character - character).",
        "(swinging ?character - character)": "Source predicate (swinging ?character - character).",
        "(sharing ?character1 - character ?character2 - character)": "Source predicate (sharing ?character1 - character ?character2 - character)."
    },
    "operators": {
        "start-rolling": "(:action start-rolling\n :parameters (?character - character)\n :precondition (and (bored ?character) (not (rolling ?character)))\n :effect (and (not (bored ?character)) (rolling ?character))\n)",
        "stop-rolling": "(:action stop-rolling\n :parameters (?character - character)\n :precondition (rolling ?character)\n :effect (and (not (rolling ?character)) (dizzy ?character))\n)",
        "lie-down": "(:action lie-down\n :parameters (?character - character)\n :precondition (and (dizzy ?character) (not (lying-down ?character)))\n :effect (and (not (dizzy ?character)) (lying-down ?character))\n)",
        "sleep": "(:action sleep\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (and (not (awake ?character)) (asleep ?character))\n)",
        "wake-up": "(:action wake-up\n :parameters (?character - character)\n :precondition (asleep ?character)\n :effect (and (not (asleep ?character)) (awake ?character))\n)",
        "install-soundproof-door": "(:action install-soundproof-door\n :parameters (?gang - character ?place - place)\n :precondition (and (awake ?gang) (at ?gang ?place) (not (soundproof-door ?place)))\n :effect (soundproof-door ?place)\n)",
        "rob": "(:action rob\n :parameters (?gang - character)\n :precondition (awake ?gang)\n :effect (robbed ?gang)\n)",
        "attack": "(:action attack\n :parameters (?attacker - character ?victim - character)\n :precondition (and (awake ?attacker) (awake ?victim))\n :effect (attacked ?victim)\n)",
        "clear-passage": "(:action clear-passage\n :parameters (?character - character)\n :precondition (awake ?character)\n :effect (and (not (attacked ?character)) (has-hoard ?character))\n)",
        "get-up": "(:action get-up\n :parameters (?character - character)\n :precondition (lying-down ?character)\n :effect (and (not (lying-down ?character)) (happy ?character))\n)",
        "wear": "(:action wear\n :parameters (?character - character ?clothing - object)\n :precondition (and)\n :effect (wearing ?character ?clothing)\n)",
        "unite": "(:action unite\n :parameters (?subreddit1 - subreddit ?subreddit2 - subreddit)\n :precondition (not (united ?subreddit1 ?subreddit2))\n :effect (united ?subreddit1 ?subreddit2)\n)",
        "establish-truce": "(:action establish-truce\n :parameters (?subreddit1 - subreddit ?subreddit2 - subreddit)\n :precondition (not (truce ?subreddit1 ?subreddit2))\n :effect (truce ?subreddit1 ?subreddit2)\n)",
        "create-subreddit": "(:action create-subreddit\n :parameters (?subreddit - subreddit)\n :precondition (and)\n :effect (exists ?subreddit)\n)",
        "build-wall": "(:action build-wall\n :parameters ()\n :precondition (and)\n :effect (wall-built)\n)",
        "fill-wall-with-water": "(:action fill-wall-with-water\n :parameters ()\n :precondition (wall-built)\n :effect (filled-with-water)\n)",
        "go-to-shop": "(:action go-to-shop\n :parameters (?character - character)\n :precondition (not (at-shop ?character))\n :effect (at-shop ?character)\n)",
        "fix-pedal": "(:action fix-pedal\n :parameters (?character - character ?bike - object)\n :precondition (and (at-shop ?character) (has ?character ?bike) (broken-pedal ?bike))\n :effect (and (not (broken-pedal ?bike)) (fixed-pedal ?bike))\n)",
        "start-flying": "(:action start-flying\n :parameters (?bike - object)\n :precondition (and (fixed-pedal ?bike) (not (flying ?bike)))\n :effect (flying ?bike)\n)",
        "go-to-park": "(:action go-to-park\n :parameters (?character - character)\n :precondition (not (at-park ?character))\n :effect (at-park ?character)\n)",
        "get-on-swing": "(:action get-on-swing\n :parameters (?character - character)\n :precondition (and (at-park ?character) (not (on-swing ?character)))\n :effect (on-swing ?character)\n)",
        "start-swinging": "(:action start-swinging\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (not (swinging ?character)))\n :effect (swinging ?character)\n)",
        "share-swing": "(:action share-swing\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (swinging ?character1) (swinging ?character2))\n :effect (sharing ?character1 ?character2)\n)",
        "become-happy": "(:action become-happy\n :parameters (?character - character)\n :precondition (not (happy ?character))\n :effect (happy ?character)\n)",
        "get-off-swing": "(:action get-off-swing\n :parameters (?character - character)\n :precondition (and (on-swing ?character) (swinging ?character))\n :effect (and (not (on-swing ?character)) (not (swinging ?character)) (happy ?character))\n)",
        "thank": "(:action thank\n :parameters (?character1 - character ?character2 - character)\n :precondition (and (not (= ?character1 ?character2)) (sharing ?character1 ?character2))\n :effect (happy ?character1)\n)"
    }
}