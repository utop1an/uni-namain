    "operators": {
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "walk": "(:action walk\n :parameters (?c - character ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1) (not (hospitalised ?c)))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "move": "(:action move\n :parameters (?c - patient ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "lose-consciousness": "(:action lose-consciousness\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?l))\n :effect (and (unconscious ?p) (not (conscious ?p)))\n)",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?from-level ?to-level - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?from-level) (connected ?from-level ?to-level) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?from-level)) (level-of-work ?d ?to-level)))": "(:action admit :parameters (?d - doctor ?p - patient ?l - medicalloc ?from-level ?to-level - level) :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?from-level) (connected ?from-level ?to-level) (the-doctor ?d)) :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?from-level)) (level-of-work ?d ?to-level)))",
        "interrogate-character :parameters (?c - character ?d - character ?l - location) :precondition (and (player ?c) (at ?c ?l) (at ?d ?l) (apprehended ?d)) :effect (knows ?c))": "(:action interrogate-character :parameters (?c - character ?d - character ?l - location) :precondition (and (player ?c) (at ?c ?l) (at ?d ?l) (apprehended ?d)) :effect (knows ?c))",
        "wake-person :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (asleep ?c2) (not (asleep ?c1))) :effect (not (asleep ?c2)))": "(:action wake-person :parameters (?c1 - character ?c2 - character ?l - location) :precondition (and (at ?c1 ?l) (at ?c2 ?l) (asleep ?c2) (not (asleep ?c1))) :effect (not (asleep ?c2)))",
        "take-thing :parameters (?c - character ?target - (either character item) ?l - location) :precondition (and (at ?c ?l) (at ?target ?l) (not (asleep ?c)) (not (enchanted ?target))) :effect (and (not (at ?target ?l)) (has ?c ?target)))": "(:action take-thing :parameters (?c - character ?target - (either character item) ?l - location) :precondition (and (at ?c ?l) (at ?target ?l) (not (asleep ?c)) (not (enchanted ?target))) :effect (and (not (at ?target ?l)) (has ?c ?target)))",
        "disenchant-thing :parameters (?c - character ?thing - item ?target - (either character item) ?l - location) :precondition (and (at ?c ?l) (at ?thing ?l) (not (asleep ?c)) (has ?c ?target) (enchanted ?thing)) :effect (not (enchanted ?thing)))": "(:action disenchant-thing :parameters (?c - character ?thing - item ?target - (either character item) ?l - location) :precondition (and (at ?c ?l) (at ?thing ?l) (not (asleep ?c)) (has ?c ?target) (enchanted ?thing)) :effect (not (enchanted ?thing)))",
        "save-character :parameters (?c1 - character ?c2 - character ?c3 - character ?l - location) :precondition (and (player ?c1) (at ?c1 ?l) (at ?c2 ?l) (captured ?c2) (captured ?c3) (not (at ?c3 ?l))) :effect (and (saved ?c2 ?c1) (not (alive ?c3))))": "(:action save-character :parameters (?c1 - character ?c2 - character ?c3 - character ?l - location) :precondition (and (player ?c1) (at ?c1 ?l) (at ?c2 ?l) (captured ?c2) (captured ?c3) (not (at ?c3 ?l))) :effect (and (saved ?c2 ?c1) (not (alive ?c3))))",
        "place-victim :parameters (?actor - character ?victim - character ?l2 - (either level location) ?l1 - (either level location)) :precondition (and (henchman ?actor) (has ?actor ?victim) (at ?actor ?l2) (connected ?l1 ?l2)) :effect (and (not (has ?actor ?victim)) (at ?victim ?l1) (captured ?victim)))": "(:action place-victim :parameters (?actor - character ?victim - character ?l2 - (either level location) ?l1 - (either level location)) :precondition (and (henchman ?actor) (has ?actor ?victim) (at ?actor ?l2) (connected ?l1 ?l2)) :effect (and (not (has ?actor ?victim)) (at ?victim ?l1) (captured ?victim)))",
        "move-location :parameters (?c - character ?l1 ?l2 - (either level location)) :precondition (and (player ?c) (connected ?l1 ?l2) (at ?c ?l2) (knows ?c) (not (asleep ?c))) :effect (and (not (at ?c ?l2)) (at ?c ?l1)))": "(:action move-location :parameters (?c - character ?l1 ?l2 - (either level location)) :precondition (and (player ?c) (connected ?l1 ?l2) (at ?c ?l2) (knows ?c) (not (asleep ?c))) :effect (and (not (at ?c ?l2)) (at ?c ?l1)))"
    }
