{
    "predicates": {
        "(the-doctor ?c - character)": "Source predicate (the-doctor ?c - character).",
        "(the-doctor-treating ?c - character)": "Source predicate (the-doctor-treating ?c - character).",
        "(the-doctor-overworked)": "Source predicate (the-doctor-overworked).",
        "(the-doctor-mistake)": "Source predicate (the-doctor-mistake).",
        "(has-symptom ?p - patient ?s - symptom)": "Source predicate (has-symptom ?p - patient ?s - symptom).",
        "(conscious ?p)": "Source predicate (conscious ?p).",
        "(unconscious ?p)": "Source predicate (unconscious ?p).",
        "(patient-room ?p - patient ?l - medicalloc)": "Source predicate (patient-room ?p - patient ?l - medicalloc).",
        "(occupied ?l - medicalloc)": "Source predicate (occupied ?l - medicalloc).",
        "(treatment-for ?t - treatment ?s - symptom)": "Source predicate (treatment-for ?t - treatment ?s - symptom).",
        "(male ?c - character)": "Source predicate (male ?c - character).",
        "(female ?c - character)": "Source predicate (female ?c - character).",
        "(hospitalised ?p - character)": "Source predicate (hospitalised ?p - character).",
        "(wrong-treatment-prescribed ?p - patient ?t - treatment)": "Source predicate (wrong-treatment-prescribed ?p - patient ?t - treatment).",
        "(treatment-prescribed ?p - patient ?t - treatment)": "Source predicate (treatment-prescribed ?p - patient ?t - treatment).",
        "(receiving-treatment ?p - patient ?t - treatment)": "Source predicate (receiving-treatment ?p - patient ?t - treatment).",
        "(level-of-work ?d - character ?l - level)": "Source predicate (level-of-work ?d - character ?l - level).",
        "(connected ?l1 ?l2 - level)": "Source predicate (connected ?l1 ?l2 - level).",
        "(has ?character - character ?item - item)": "Source predicate (has ?character - character ?item - item).",
        "(near ?item1 - item ?item2 - item)": "Source predicate (near ?item1 - item ?item2 - item).",
        "(in-nest ?bird - character)": "Source predicate (in-nest ?bird - character).",
        "(alive ?character - character)": "Entity ?p is alive.",
        "(at ?character - character ?place - place)": "Character ?c is at location ?l, with place unified as location.",
        "(alive ?p)": "Entity ?p is alive.",
        "(at ?c - character ?l - location)": "Character ?c is at location ?l, with place unified as location.",
        "(birthday ?character - character)": "Source predicate (birthday ?character - character).",
        "(box-closed)": "Source predicate (box-closed).",
        "(box-open)": "Source predicate (box-open).",
        "(cake-spoiled)": "Source predicate (cake-spoiled).",
        "(cake-good)": "Source predicate (cake-good).",
        "(listened-to-mom ?character - character)": "Source predicate (listened-to-mom ?character - character).",
        "(waited-for-birthday ?character - character)": "Source predicate (waited-for-birthday ?character - character).",
        "(in-love ?character1 - character ?character2 - character)": "Source predicate (in-love ?character1 - character ?character2 - character).",
        "(accepts-past ?character1 - character ?character2 - character)": "Source predicate (accepts-past ?character1 - character ?character2 - character).",
        "(knows-self ?character - character)": "Source predicate (knows-self ?character - character).",
        "(sings ?character - character)": "Source predicate (sings ?character - character)."
    },
    "operators": {
        "get-work-help": "(:action get-work-help\n :parameters (?d - doctor ?l - level)\n :precondition (and (level-of-work ?d ?l) (not (= ?l zero)))\n :effect (and (not (level-of-work ?d ?l)) (level-of-work ?d zero) (not (the-doctor-overworked)))\n)",
        "play :parameters (?p - character ?item - item) :precondition (and (alive ?p) (has ?p ?item)) :effect (and))": "(:action play :parameters (?p - character ?item - item) :precondition (and (alive ?p) (has ?p ?item)) :effect (and))",
        "pick-up :parameters (?p - character ?item - item) :precondition (and (alive ?p) (near ?p ?item)) :effect (has ?p ?item))": "(:action pick-up :parameters (?p - character ?item - item) :precondition (and (alive ?p) (near ?p ?item)) :effect (has ?p ?item))",
        "help-bird :parameters (?p - object ?bird - character) :precondition (and (alive ?p) (alive ?bird) (not (in-nest ?bird))) :effect (in-nest ?bird))": "(:action help-bird :parameters (?p - object ?bird - character) :precondition (and (alive ?p) (alive ?bird) (not (in-nest ?bird))) :effect (in-nest ?bird))",
        "bird-falls :parameters (?p - character) :precondition (and (alive ?p) (in-nest ?p)) :effect (not (in-nest ?p)))": "(:action bird-falls :parameters (?p - character) :precondition (and (alive ?p) (in-nest ?p)) :effect (not (in-nest ?p)))",
        "walk": "(:action walk\n :parameters (?c - character ?l1 ?l2 - location)\n :precondition (and (at ?c ?l1) (not (hospitalised ?c)))\n :effect (and (at ?c ?l2) (not (at ?c ?l1)))\n)",
        "lose-consciousness": "(:action lose-consciousness\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (conscious ?p) (at ?p ?l))\n :effect (and (unconscious ?p) (not (conscious ?p)))\n)",
        "admit": "(:action admit\n :parameters (?d - doctor ?p - patient ?l - medicalloc ?w1 ?w2 - level)\n :precondition (and (alive ?d) (alive ?p) (at ?p ?l) (at ?d ?l) (not (occupied ?l)) (not (hospitalised ?p)) (level-of-work ?d ?w1) (connected ?w1 ?w2) (the-doctor ?d))\n :effect (and (the-doctor-treating ?p) (hospitalised ?p) (patient-room ?p ?l) (occupied ?l) (not (level-of-work ?d ?w1)) (level-of-work ?d ?w2))\n)",
        "assess": "(:action assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (not (= ?w three)) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (has-symptom ?p ?s) (treatment-for ?t ?s))\n :effect (and (treatment-prescribed ?p ?t))\n)",
        "mistake-assess": "(:action mistake-assess\n :parameters (?d - doctor ?p - patient ?s - symptom ?t - treatment ?l - medicalloc ?w - level)\n :precondition (and (level-of-work ?d ?w) (= ?w three) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (has-symptom ?p ?s) (treatment-for ?t ?s) (not (receiving-treatment ?p ?t)))\n :effect (and (wrong-treatment-prescribed ?p ?t) (the-doctor-overworked) (the-doctor-mistake))\n)",
        "treat": "(:action treat\n :parameters (?d - doctor ?p - patient ?t - treatment ?l - medicalloc)\n :precondition (and (treatment-prescribed ?p ?t) (alive ?p) (the-doctor ?d) (the-doctor-treating ?p) (at ?p ?l) (at ?d ?l) (patient-room ?p ?l) (not (receiving-treatment ?p ?t)))\n :effect (and (not (treatment-prescribed ?p ?t)) (receiving-treatment ?p ?t))\n)",
        "recover": "(:action recover\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l) (has-symptom ?p ?s))\n :effect (and (not (has-symptom ?p ?s)))\n)",
        "die": "(:action die\n :parameters (?p - patient ?t - treatment ?s - symptom ?l - medicalloc)\n :precondition (and (receiving-treatment ?p ?t) (alive ?p) (at ?p ?l) (patient-room ?p ?l))\n :effect (and (not (alive ?p)))\n)",
        "wait-for-birthday": "(:action wait-for-birthday\n :parameters (?character - character)\n :precondition (and (not (birthday ?character)) (not (waited-for-birthday ?character)))\n :effect (waited-for-birthday ?character)\n)",
        "listen-to-mom": "(:action listen-to-mom\n :parameters (?character - character)\n :precondition (and (not (listened-to-mom ?character)) (waited-for-birthday ?character))\n :effect (listened-to-mom ?character)\n)",
        "open-box": "(:action open-box\n :parameters (?character - character)\n :precondition (and (box-closed) (birthday ?character))\n :effect (and (not (box-closed)) (box-open))\n)",
        "spoil-cake": "(:action spoil-cake\n :parameters ()\n :precondition (and (box-open) (not (listened-to-mom tim)) (cake-good))\n :effect (and (not (cake-good)) (cake-spoiled))\n)",
        "keep-cake-good": "(:action keep-cake-good\n :parameters ()\n :precondition (and (box-open) (listened-to-mom tim) (cake-good))\n :effect (cake-good)\n)",
        "sing :parameters (?p) :precondition (alive ?p) :effect (sings ?p))": "(:action sing :parameters (?p) :precondition (alive ?p) :effect (sings ?p))",
        "fall-in-love :parameters (?p1 ?p2) :precondition (and (not (= ?p1 ?p2)) (alive ?p1) (alive ?p2)) :effect (in-love ?p1 ?p2))": "(:action fall-in-love :parameters (?p1 ?p2) :precondition (and (not (= ?p1 ?p2)) (alive ?p1) (alive ?p2)) :effect (in-love ?p1 ?p2))",
        "accept-past :parameters (?p1 - character ?p2 - character) :precondition (and (not (= ?p1 ?p2)) (alive ?p1) (alive ?p2)) :effect (accepts-past ?p1 ?p2))": "(:action accept-past :parameters (?p1 - character ?p2 - character) :precondition (and (not (= ?p1 ?p2)) (alive ?p1) (alive ?p2)) :effect (accepts-past ?p1 ?p2))",
        "know-self :parameters (?p - character) :precondition (alive ?p) :effect (knows-self ?p))": "(:action know-self :parameters (?p - character) :precondition (alive ?p) :effect (knows-self ?p))",
        "move": "(:action move :parameters (?c - patient ?from ?to - location) :precondition (and (alive ?c) (at ?c ?from) (not (at ?c ?to)) (not (= ?from ?to))) :effect (and (not (at ?c ?from)) (at ?c ?to)))"
    }
}