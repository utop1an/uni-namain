    :precondition (and (case_role_cutter ?j) (case_role_axe ?a) (case_role_workshop ?w) (d002__p_alive ?j) (scene_at ?j ?w) (scene_axe_racked ?a ?w))
    :effect (and (d001__p_has ?j ?a) (not (scene_axe_racked ?a ?w)))
  )

  (:action scene__take_comb_back
    :parameters (?r - object ?s - object ?c - object ?h - object)
    :precondition (and (case_role_rescuer ?r) (case_role_witch ?s) (case_role_comb ?c) (case_role_hut ?h) (d002__p_alive ?r) (d002__p_alive ?s) (scene_at ?r ?h) (scene_at ?s ?h) (shared__p_possession ?s ?c) (d002__p_poisoned ?c))
    :effect (and (not (shared__p_possession ?s ?c)) (shared__p_possession ?r ?c))
  )
)
