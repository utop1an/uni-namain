(define (domain formula_a) (:requirements :adl :typing :equality)
    (:types person vacant - object) (:constants a - person)
    (:predicates (p ?x - person) (r ?x ?y - person) (e ?x - vacant) (done)) (:action negated_all :parameters (?x - person) :precondition (not (forall (?y - person) (p ?y))) :effect (done))
(:action negated_exists :parameters (?x - person) :precondition (not (exists (?y - person) (p ?y))) :effect (done))
(:action implication :parameters (?x - person) :precondition (imply (p ?x) (exists (?y - person) (r ?x ?y))) :effect (done))
(:action disjunction :parameters (?x - person) :precondition (or (p ?x) (not (r ?x ?x))) :effect (done))
(:action equality :parameters (?x - person) :precondition (= ?x a) :effect (done))
(:action inequality :parameters (?x - person) :precondition (not (= ?x a)) :effect (done))
(:action all_exists :parameters (?x - person) :precondition (forall (?y - person) (exists (?z - person) (r ?y ?z))) :effect (done))
(:action exists_all :parameters (?x - person) :precondition (exists (?y - person) (forall (?z - person) (r ?y ?z))) :effect (done))
(:action shadowed_parameter :parameters (?x - person) :precondition (forall (?x - person) (or (p ?x) (r ?x a))) :effect (done))
(:action shadowed_nested :parameters (?x - person) :precondition (exists (?y - person) (and (p ?y) (forall (?y - person) (r ?y a)))) :effect (done))
(:action vacuous_all :parameters (?x - person) :precondition (forall (?y - vacant) (e ?y)) :effect (done))
(:action empty_exists :parameters (?x - person) :precondition (exists (?y - vacant) (e ?y)) :effect (done))
(:action negative_empty_exists :parameters (?x - person) :precondition (not (exists (?y - vacant) (e ?y))) :effect (done))
(:action negative_vacuous_all :parameters (?x - person) :precondition (not (forall (?y - vacant) (e ?y))) :effect (done)))