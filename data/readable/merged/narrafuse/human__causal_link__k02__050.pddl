          (human_1fe4b2f08d46fd1e_type_place ?m1)
          (human_1fe4b2f08d46fd1e_type_place ?m2)
          (and
            (shared_p_consensus_b3302490ec8a1b80 ?m0)
            (shared_p_consensus_96bdfd96597f2e41 ?m0 ?m1)
