        (not (shared_p_consensus_75f6259d8ccb68a4 ?giver ?item))
        (shared_p_consensus_75f6259d8ccb68a4 ?receiver ?item)
        (tiny_stories__story_066_p_gave-gift ?giver ?receiver ?item)
